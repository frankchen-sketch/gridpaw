node_modules/
dist/
.wrangler/
.dev.vars

# build id 生成物（scripts/gen-build-info.mjs 产出，不入库）
src/lib/app-build.generated.ts

# 删除缓冲（上级规则：删除先移 .trash/YYYY-MM-DD_原名，保留 30 天）。不入库，靠 git 历史 + 磁盘保留。
.trash/

# IndexNow key file: name == key, so committing it would defeat the protocol's
# unguessability (repo is public). Must exist locally to build/deploy.
# scripts/check-indexnow-key.mjs fails the build loudly if it is missing.
public/*.txt
!public/llms.txt
!public/robots.txt
!public/ads.txt
# funnel admin token（不入库）
.funnel-admin-token

# Astro 构建缓存（data-store/settings），2026-09-23 起不入库
.astro/
.hermes/
og-build

# R&D 原型（微信 wxapkg 解包素材，版权敏感 + 135MB，仅存盘不入库）
research/fkszw-prototype/
# 过程验证快照（before 态在 git 历史可重现，不入库）
scratch/

# 构建期生成（scripts/gen-build-info.mjs 每次 build 重写），不入库
public/*/gp-build.js
