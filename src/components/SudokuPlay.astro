---
// SudokuPlay — 大格数独可玩面板（契约：STYLE.md v1.0 §10.1 棋盘卡 / §10.2 控制条 / §11 图标）
// 引擎：/sudoku-engine.js，全局 SudokuEngine（另一路并行实现，这里只按签名调用）
//   generate(size, blockW, blockH, difficulty, seed, timeBudgetMs)
//     → { size, blockW, blockH, symbols[], givens:[[idx,val]], solution[], difficulty }
//   validate(p, vals) → { ok, errors }    hintLookup(p, idx) → 正确答案 / -1
// 盘面索引 = r*size + c；空值用 -1。
// JS 生成的 .sd-* 节点拿不到 scoped hash，样式必须 is:global（同 MeowdokuPlay 的坑）。
// 视觉：色值/圆角/阴影/动效全部取 src/styles/tokens.css 的 --gp-* / --r-* / --shadow-*，禁止 raw hex。
// 引导：§13 GameCoach（卡内 static 3 步；⋯ 抽屉里的 How to play 随时重开）
import GameCoach from './GameCoach.astro';

interface Props {
  gameKey: string;              // GA 事件里的 game 维度，如 '16x16-sudoku'
  size?: number;                // 初始格数：9 | 12 | 16 | 25
  blockW?: number;              // 区块宽
  blockH?: number;              // 区块高
  difficulty?: 'easy' | 'medium' | 'hard';
  allow25?: boolean;            // 面板内提供 16×16 / 25×25 切换（mega 页）
  letterMode?: boolean;         // 9×9 用 A–I 代替 1–9（sudoku-with-letters）
  label?: string;               // 徽标文案，如 '16×16'
  coachSteps?: string[];        // §13 引导三步（默认是大格数独通用文案）
}
const {
  gameKey,
  size = 16,
  blockW = 4,
  blockH = 4,
  difficulty = 'easy',
  allow25 = false,
  letterMode = false,
  label = `${size}×${size}`,
  coachSteps = [
    'Tap a cell, then a symbol below.',
    'Every row, column and box needs each symbol exactly once.',
    'Red cells clash — Undo takes it back.',
  ],
} = Astro.props;
const uid = 'sd-' + gameKey.replace(/[^a-z0-9]+/gi, '');
---
<div class="sd-play" id={`${uid}-wrap`}>
  {/* ── 上控制条（§10.2：44px 单行，禁止换行）── */}
  <div class="sd-toolbar">
    <div class="sd-tb-left">
      <span class="sd-badge" id={`${uid}-badge`}>{label} · Easy</span>
      <div class="sd-diffs sd-diffs-top" id={`${uid}-diffs`} role="group" aria-label="Difficulty">
        <button type="button" class="sd-chip" data-diff="easy" aria-pressed="true">Easy</button>
        <button type="button" class="sd-chip" data-diff="medium" aria-pressed="false">Medium</button>
        <button type="button" class="sd-chip" data-diff="hard" aria-pressed="false">Hard</button>
      </div>
      <span class="sd-progress" id={`${uid}-progress`}>0 / {size * size}</span>
      <span class="sd-timer">
        <svg class="sd-ico" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <circle cx="20" cy="20" r="12.5" fill="none" stroke="currentColor" stroke-width="2.5"></circle>
          <path d="M20 13.5 V20 l5 3.2" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
        </svg>
        <span id={`${uid}-timer`}>0:00</span>
      </span>
    </div>
    <div class="sd-tb-right">
      <button type="button" class="sd-iconbtn" id={`${uid}-undoicon`} aria-label="Undo" title="Undo" disabled>
        <svg class="sd-ico" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <path d="M16 11 L8 19 L16 27" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M8 19 H24 a7.5 7.5 0 0 1 0 15 H19" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
        </svg>
      </button>
      <button type="button" class="sd-iconbtn" id={`${uid}-redoicon`} aria-label="Redo" title="Redo" disabled>
        <svg class="sd-ico" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <path d="M24 11 L32 19 L24 27" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M32 19 H16 a7.5 7.5 0 0 0 0 15 H21" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
        </svg>
      </button>
      <button type="button" class="sd-iconbtn" id={`${uid}-hinticon`} aria-label="Hint" title="Hint">
        <svg class="sd-ico" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <path d="M20 6.5 a9 9 0 0 1 5.6 16.1 V26.5 h-11.2 v-3.9 A9 9 0 0 1 20 6.5 Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"></path>
          <path d="M15.5 30.5 h9 M17 34 h6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  {/* ── 棋盘视图切换（§14.1.5：手机必须能给放大镜 / 单宫放大；桌面不需要，只窄屏出）── */}
  <div class="sd-viewbar" id={`${uid}-viewbar`} role="group" aria-label="Board view">
    <button type="button" class="sd-view" data-view="grid" aria-pressed="true">Grid</button>
    <button type="button" class="sd-view" data-view="box" aria-pressed="false">Box</button>
    <button type="button" class="sd-view" data-view="loupe" aria-pressed="false">Zoom</button>
  </div>

  {/* ── §13 引导：卡内 static，上控制条之下、棋盘之上；首次进入才出现 ── */}
  <GameCoach game={gameKey} steps={coachSteps} />

  {/* ── 棋盘（与上下条间距 ≤16px，§10.1）── */}
  <div class="sd-boardwrap">
    <div class="sd-board" id={`${uid}-board`} role="grid" aria-label="Playable sudoku board"></div>
    <div class="sd-zoomwrap" id={`${uid}-zoomwrap`} hidden>
      <p class="sd-zoomcap" id={`${uid}-zoomcap`}></p>
      <div class="sd-zoom" id={`${uid}-zoom`} role="grid" aria-label="Zoomed board view"></div>
    </div>
    <div class="sd-loading" id={`${uid}-loading`} hidden>
      <span class="sd-spin" aria-hidden="true"></span>Building a fresh board…
    </div>
  </div>

  {/* ── 下主操作行（§10.1：Hint 实心 CTA / Undo·Restart 描边）── */}
  <div class="sd-actions">
    <button type="button" class="sd-btn sd-btn-primary" id={`${uid}-hint`}>
      Hint <span id={`${uid}-hintleft`}>(3)</span>
    </button>
    <button type="button" class="sd-btn sd-btn-ghost" id={`${uid}-undo`}>Undo</button>
    <button type="button" class="sd-btn sd-btn-ghost" id={`${uid}-restart`}>Restart</button>
    <button type="button" class="sd-btn sd-btn-ghost sd-more" id={`${uid}-more`} aria-expanded="false" aria-controls={`${uid}-menu`} aria-label="More options" title="More options">
      <svg class="sd-ico" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <circle cx="11" cy="20" r="2.6" fill="currentColor"></circle>
        <circle cx="20" cy="20" r="2.6" fill="currentColor"></circle>
        <circle cx="29" cy="20" r="2.6" fill="currentColor"></circle>
      </svg>
    </button>
  </div>

  {/* ── ⋯ 卡内抽屉（§10.2：低频动作收进 ⋯；卡内展开，不遮盘、不锁滚动）── */}
  <div class="sd-menu" id={`${uid}-menu`} hidden>
    <div class="sd-menu-row">
      <span class="sd-menu-label">Difficulty</span>
      <div class="sd-diffs" role="group" aria-label="Difficulty">
        <button type="button" class="sd-chip" data-diff="easy" aria-pressed="true">Easy</button>
        <button type="button" class="sd-chip" data-diff="medium" aria-pressed="false">Medium</button>
        <button type="button" class="sd-chip" data-diff="hard" aria-pressed="false">Hard</button>
      </div>
    </div>
    {allow25 && (
      <div class="sd-menu-row">
        <span class="sd-menu-label">Board size</span>
        <div class="sd-diffs" role="group" aria-label="Board size">
          <button type="button" class="sd-chip" data-size="16" aria-pressed="true">16×16</button>
          <button type="button" class="sd-chip" data-size="25" aria-pressed="false">25×25</button>
        </div>
      </div>
    )}
    <div class="sd-menu-row">
      <span class="sd-menu-label">Board</span>
      <button type="button" class="sd-btn sd-btn-ghost" id={`${uid}-new`}>New board</button>
    </div>
    <div class="sd-menu-row">
      <span class="sd-menu-label">Guide</span>
      <button type="button" class="sd-btn sd-btn-ghost" id={`${uid}-guide`}>How to play</button>
    </div>
  </div>

  <div class="sd-keys" id={`${uid}-keys`} role="group" aria-label="Symbol keypad"></div>

  <p class="sd-msg" id={`${uid}-msg`}>Tap a cell, then a symbol. Duplicates in the same row, column or box turn red; tap the same symbol again to clear a cell.</p>

  <div class="sd-win" id={`${uid}-win`} hidden>
    <strong id={`${uid}-wintitle`}>Solved!</strong>
    <span id={`${uid}-windetail`}></span>
    <button type="button" id={`${uid}-next`}>Next board →</button>
  </div>
</div>

<style is:global>
  /* 视觉合同：STYLE.md v1.0 —— 所有值取 tokens.css，raw hex 必须为 0 */
  .sd-play {
    box-sizing: border-box;
    max-width: var(--w-game); margin: 1rem auto 1.4rem; padding: var(--sp-6);
    background: var(--gp-white); border: 1px solid var(--gp-linen);
    border-radius: var(--r-card); box-shadow: var(--shadow-candy);
  }

  /* §10.2 控制条：44px 单行，禁止换行 */
  .sd-toolbar {
    display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4);
    height: var(--h-toolbar); min-height: var(--h-toolbar);
    flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden;
    margin-bottom: 12px; scrollbar-width: none;
  }
  .sd-toolbar::-webkit-scrollbar { display: none; }
  .sd-tb-left { display: flex; align-items: center; gap: var(--sp-3); min-width: 0; }
  .sd-tb-right { display: flex; align-items: center; gap: var(--sp-2); flex: 0 0 auto; }

  .sd-badge {
    background: var(--gp-cream-warm); color: var(--gp-cta-dark);
    font-size: var(--fs-tiny); font-weight: 800; border-radius: var(--r-full);
    padding: 4px 10px; white-space: nowrap;
  }
  .sd-progress { font-size: var(--fs-tiny); font-weight: 800; color: var(--gp-brown-600); white-space: nowrap; }
  .sd-timer { display: inline-flex; align-items: center; gap: 4px; font-size: var(--fs-tiny); font-weight: 700; color: var(--gp-brown-400); white-space: nowrap; }
  .sd-ico { width: 18px; height: 18px; display: block; }

  .sd-diffs { display: flex; gap: 2px; background: var(--gp-sand); border-radius: var(--r-full); padding: 3px; }
  .sd-chip {
    border: 0; background: transparent; color: var(--gp-ink);
    font: inherit; font-size: var(--fs-tiny); font-weight: 800; padding: 3px 10px;
    border-radius: var(--r-full); cursor: pointer; white-space: nowrap;
    transition: background var(--t-fast), color var(--t-fast);
  }
  .sd-chip[aria-pressed="true"] { background: var(--gp-cta); color: var(--gp-white); }

  /* §10.5 图标按钮：36px 圆，白底 + 2px linen 边，hover 边框 primary */
  .sd-iconbtn {
    width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--gp-white); border: 2px solid var(--gp-linen); border-radius: var(--r-full);
    color: var(--gp-brown-600); cursor: pointer; padding: 0;
    transition: border-color var(--t-fast), color var(--t-fast), transform var(--t-fast);
  }
  .sd-iconbtn:hover { border-color: var(--gp-primary); color: var(--gp-cta-dark); }
  .sd-iconbtn:active { transform: scale(0.92); }
  .sd-iconbtn:disabled { opacity: 0.4; cursor: default; transform: none; border-color: var(--gp-linen); color: var(--gp-stone); }

  .sd-boardwrap { position: relative; overflow-x: auto; overflow-y: hidden; padding: 2px; min-height: 140px; -webkit-overflow-scrolling: touch; }
  .sd-board {
    display: grid;
    grid-template-columns: repeat(var(--sd-n, 16), var(--sd-cell, 26px));
    grid-auto-rows: var(--sd-cell, 26px);
    width: max-content; margin: 0 auto;
    border: 2px solid var(--gp-brown-400); border-radius: var(--r-sm); overflow: hidden; background: var(--gp-white);
  }
  /* §14.1.5 视图切换条：桌面不出（大屏格子够大），≤699px 出 Grid / Box / Zoom */
  .sd-viewbar { display: none; }

  /* 放大视图（单宫 / 5×5 放大镜）：同一套 .sd-cell 皮肤，尺寸由 JS 算后写进 --sd-cell */
  .sd-board[hidden], .sd-zoomwrap[hidden] { display: none; }
  .sd-zoomwrap { display: flex; flex-direction: column; align-items: center; }
  .sd-zoomcap { margin: 0 0 6px; font-size: var(--fs-tiny); font-weight: 800; color: var(--gp-brown-400); text-align: center; }
  .sd-zoom {
    display: grid;
    grid-template-columns: repeat(var(--sd-zn, 5), var(--sd-cell, 56px));
    grid-auto-rows: var(--sd-cell, 56px);
    width: max-content; margin: 0 auto;
    border: 2px solid var(--gp-brown-400); border-radius: var(--r-sm);
    overflow: hidden; background: var(--gp-white);
  }

  .sd-cell {
    display: flex; align-items: center; justify-content: center; position: relative;
    font-weight: 700; color: var(--gp-ink);
    font-size: calc(var(--sd-cell, 26px) * 0.56); line-height: 1;
    border-right: 1px solid var(--gp-linen); border-bottom: 1px solid var(--gp-linen);
    cursor: pointer; user-select: none; -webkit-user-select: none; touch-action: manipulation;
    transition: background var(--t-fast);
  }
  .sd-cell.sd-edge-r { border-right: 0; }
  .sd-cell.sd-edge-b { border-bottom: 0; }
  .sd-cell.sd-box-r { border-right: 2px solid var(--gp-brown-400); }
  .sd-cell.sd-box-b { border-bottom: 2px solid var(--gp-brown-400); }
  .sd-cell.sd-given { color: var(--gp-brown-900); background: var(--gp-sand); font-weight: 800; cursor: default; }
  .sd-cell.sd-peer { background: var(--gp-parchment); }
  .sd-cell.sd-same { background: var(--gp-blush); }
  .sd-cell.sd-sel { background: var(--gp-white); box-shadow: var(--ring); z-index: 1; }
  .sd-cell.sd-conf { color: var(--gp-error); background: var(--gp-blush); }
  .sd-cell.sd-hinted { color: var(--gp-badge-easy-text); background: var(--gp-badge-easy-bg); }

  /* §10.1 下主操作行：Hint 实心 CTA / Undo·Restart 描边 */
  .sd-actions { display: flex; align-items: center; gap: var(--sp-4); margin-top: 12px; height: var(--h-toolbar); }
  .sd-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    min-height: 44px; padding: 0 16px; font: inherit; font-size: var(--fs-small);
    font-weight: var(--fw-btn); border-radius: var(--r-full); cursor: pointer;
    transition: background var(--t-fast), border-color var(--t-fast), transform var(--t-fast);
  }
  .sd-btn-primary { background: var(--gp-cta); color: var(--gp-white); border: 1.5px solid var(--gp-cta); flex: 1 1 auto; }
  .sd-btn-primary:hover { background: var(--gp-cta-dark); border-color: var(--gp-cta-dark); }
  .sd-btn-primary:disabled { opacity: 0.45; cursor: default; }
  .sd-btn-ghost { background: var(--gp-white); color: var(--gp-ink); border: 1.5px solid var(--gp-linen); }
  .sd-btn-ghost:hover { border-color: var(--gp-primary); color: var(--gp-cta-dark); }
  .sd-btn-ghost:disabled { opacity: 0.4; cursor: default; }
  .sd-btn:active { transform: translateY(1px); }
  .sd-more { padding: 0; width: 44px; flex: 0 0 44px; }

  /* ⋯ 卡内抽屉：插在操作行下方展开，棋盘永不被盖 */
  .sd-menu {
    display: flex; flex-direction: column; gap: var(--sp-4);
    margin-top: var(--sp-4); padding: var(--sp-5);
    background: var(--gp-cream-warm); border: 1.5px dashed var(--gp-primary);
    border-radius: var(--r-lg);
  }
  .sd-menu[hidden] { display: none; }
  .sd-menu-row { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4); flex-wrap: wrap; }
  .sd-menu-label { font-size: var(--fs-tiny); font-weight: 800; color: var(--gp-brown-600); text-transform: uppercase; letter-spacing: 0.04em; }

  .sd-keys {
    display: grid; grid-template-columns: repeat(var(--sd-kcols, 8), minmax(0, 1fr));
    gap: var(--sp-4); margin: 12px auto 0; max-width: var(--w-game);
  }
  .sd-key {
    width: 100%; height: 44px; padding: 0 4px;
    border: 1.5px solid var(--gp-linen); background: var(--gp-white); border-radius: var(--r-md);
    font: inherit; font-weight: 800; font-size: var(--fs-small);
    color: var(--gp-ink); cursor: pointer;
    transition: border-color var(--t-fast), color var(--t-fast), transform var(--t-fast);
  }
  .sd-key:hover { border-color: var(--gp-primary); color: var(--gp-cta-dark); }
  .sd-key:active { transform: scale(0.95); }

  .sd-loading {
    position: absolute; inset: 0; z-index: 2; display: flex; align-items: center;
    justify-content: center; gap: var(--sp-4); background: var(--gp-cream);
    font-size: var(--fs-small); font-weight: 700; color: var(--gp-brown-400);
  }
  .sd-loading[hidden] { display: none; }
  .sd-spin {
    width: 15px; height: 15px; border: 2px solid var(--gp-linen);
    border-top-color: var(--gp-cta); border-radius: 50%;
    animation: sdspin 0.7s linear infinite;
  }
  @keyframes sdspin { to { transform: rotate(360deg); } }

  .sd-msg { margin: 10px 0 0; font-size: var(--fs-tiny); line-height: 1.55; color: var(--gp-brown-400); text-align: center; }
  .sd-error { margin: 0; padding: 18px 10px; text-align: center; font-weight: 700; color: var(--gp-error); }

  .sd-win {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-4);
    margin-top: 10px; padding: 10px 12px; border-radius: var(--r-lg);
    background: var(--gp-cream-warm); border: 1.5px solid var(--gp-mint);
    font-size: var(--fs-small); color: var(--gp-brown-900);
  }
  .sd-win[hidden] { display: none; }
  .sd-win strong { font-size: var(--fs-body); }
  .sd-win button {
    margin-left: auto; min-height: 44px; padding: 0 14px; border: 0; border-radius: var(--r-full);
    background: var(--gp-success); color: var(--gp-white); font: inherit; font-weight: var(--fw-btn);
    font-size: var(--fs-small); cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .sd-cell, .sd-chip, .sd-btn, .sd-key, .sd-iconbtn { transition: none; }
    .sd-spin { animation: none; }
  }

  /* ── 手机（< 700px，§14/§15）：一行 44px、动作 ≤3 个，其余进 ⋯ ── */
  @media (max-width: 699px) {
    /* 面板在手机上贴边（抵消 SudokuPage 的 8px 侧距）：16×16 才拿得到 21px/格且不横向溢出 */
    .sd-play { padding: var(--sp-4); margin: 0.6rem -8px 1rem; }
    .sd-toolbar { gap: var(--sp-3); }
    .sd-diffs-top { display: none; }        /* 难度切换收进 ⋯（抽屉里同 data-diff 那组接管） */
    .sd-tb-right { display: none; }         /* 圆形图标按钮是桌面快捷方式；手机上由下方主操作行承担 */
    /* §14.1.5 视图条：44px 一行，三个等宽按钮，去掉一行就回到桌面版（display:none） */
    .sd-viewbar { display: flex; gap: var(--sp-2); height: var(--h-toolbar); margin-bottom: 12px; }
    .sd-view {
      flex: 1 1 0; height: 44px; padding: 0 4px;
      background: var(--gp-white); color: var(--gp-ink);
      border: 1.5px solid var(--gp-linen); border-radius: var(--r-full);
      font: inherit; font-size: var(--fs-body-m); font-weight: var(--fw-btn);
      cursor: pointer; touch-action: manipulation;
      transition: background var(--t-fast), color var(--t-fast), border-color var(--t-fast);
    }
    .sd-view[aria-pressed="true"] { background: var(--gp-cta); color: var(--gp-white); border-color: var(--gp-cta); }
    .sd-actions { gap: var(--sp-3); }
    .sd-btn { font-size: var(--fs-body-m); padding: 0 10px; }
    .sd-key { height: 44px; font-size: var(--fs-body-m); }
  }
</style>

<script is:inline src="/sudoku-engine.js"></script>
<script is:inline define:vars={{ uid, size, blockW, blockH, difficulty, allow25, letterMode, gameKey, label }}>
  (function () {
    var E = window.SudokuEngine;
    var wrap = document.getElementById(uid + '-wrap');
    if (!wrap) return;

    var boardEl = document.getElementById(uid + '-board');
    var keysEl = document.getElementById(uid + '-keys');
    var msgEl = document.getElementById(uid + '-msg');
    var timerEl = document.getElementById(uid + '-timer');
    var progEl = document.getElementById(uid + '-progress');
    var badgeEl = document.getElementById(uid + '-badge');
    var winEl = document.getElementById(uid + '-win');
    var winDetailEl = document.getElementById(uid + '-windetail');
    var loadEl = document.getElementById(uid + '-loading');
    var hintBtn = document.getElementById(uid + '-hint');
    var hintIconBtn = document.getElementById(uid + '-hinticon');
    var hintLeftEl = document.getElementById(uid + '-hintleft');
    var undoBtn = document.getElementById(uid + '-undo');
    var undoIconBtn = document.getElementById(uid + '-undoicon');
    var redoIconBtn = document.getElementById(uid + '-redoicon');
    var moreBtn = document.getElementById(uid + '-more');
    var menuEl = document.getElementById(uid + '-menu');
    var newBtn = document.getElementById(uid + '-new');
    var guideBtn = document.getElementById(uid + '-guide');
    var nextBtn = document.getElementById(uid + '-next');
    var restartBtn = document.getElementById(uid + '-restart');
    var viewbarEl = document.getElementById(uid + '-viewbar');
    var zoomWrapEl = document.getElementById(uid + '-zoomwrap');
    var zoomEl = document.getElementById(uid + '-zoom');
    var zoomCapEl = document.getElementById(uid + '-zoomcap');

    if (!E || !boardEl || !keysEl) {
      if (boardEl) boardEl.innerHTML = '<p class="sd-error">The sudoku engine did not load. Please refresh the page.</p>';
      return;
    }

    // 契约里的固定区块划分（§一 符号集表格）
    var BLOCKS = { 9: [3, 3], 12: [4, 3], 16: [4, 4], 25: [5, 5] };
    var LETTERS9 = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I'];
    var DIFF_LABEL = { easy: 'Easy', medium: 'Medium', hard: 'Hard' };

    var state = {
      size: size, bw: blockW, bh: blockH,
      diff: difficulty,
      puzzle: null, vals: null, given: null, hinted: null, symbols: null,
      sel: -1, hintsLeft: 3, solved: false, filled: 0,
      secs: 0, timerId: 0, token: 0, moved: false,
      past: [], future: [],
      view: 'grid',  // grid | box（单宫放大）| loupe（5×5 放大镜）—— §14.1.5
      narrow: false
    };
    var cells = [];
    var zoomCells = [];

    // ── GA4（与 star-battle / kenken 同款四通道）──
    function track(event, params) {
      var p = params || {};
      if (window.gpTrack) window.gpTrack(event, p);
      if (typeof window.gtag === 'function') window.gtag('event', event, p);
      if (window.posthog && typeof window.posthog.capture === 'function') {
        window.posthog.capture(event, Object.assign({ site: 'gridpaw' }, p));
      }
      if (typeof window.clarity === 'function') {
        window.clarity('event', event);
        Object.keys(p).forEach(function (k) { window.clarity('set', k, String(p[k])); });
      }
    }
    function detectSource() {
      var q = new URLSearchParams(location.search);
      if (q.get('embed')) return 'embed';
      var ref = document.referrer || '';
      if (!ref) return 'direct';
      if (ref.indexOf(location.hostname) !== -1) return 'internal';
      if (ref.indexOf('google') !== -1) return 'google';
      return 'referral';
    }

    function fmt(s) {
      var m = Math.floor(s / 60);
      var r = s % 60;
      return m + ':' + (r < 10 ? '0' : '') + r;
    }
    function startTimer() {
      stopTimer();
      state.secs = 0;
      timerEl.textContent = '0:00';
      state.timerId = setInterval(function () {
        state.secs++;
        timerEl.textContent = fmt(state.secs);
      }, 1000);
    }
    function stopTimer() {
      if (state.timerId) { clearInterval(state.timerId); state.timerId = 0; }
    }
    function msg(text) { msgEl.textContent = text; }
    function setLoading(on) { loadEl.hidden = !on; }

    function syncChips() {
      var chips = wrap.querySelectorAll('[data-diff]');
      for (var i = 0; i < chips.length; i++) {
        chips[i].setAttribute('aria-pressed', chips[i].getAttribute('data-diff') === state.diff ? 'true' : 'false');
      }
      var sc = wrap.querySelectorAll('[data-size]');
      for (var j = 0; j < sc.length; j++) {
        sc[j].setAttribute('aria-pressed', Number(sc[j].getAttribute('data-size')) === state.size ? 'true' : 'false');
      }
      var sizeText = letterMode ? label : state.size + '×' + state.size;
      badgeEl.textContent = sizeText + ' · ' + DIFF_LABEL[state.diff];
    }

    function updateHintBtns() {
      hintLeftEl.textContent = '(' + state.hintsLeft + ')';
      var off = state.hintsLeft <= 0;
      hintBtn.disabled = off;
      if (hintIconBtn) hintIconBtn.disabled = off;
    }

    // ── 撤销 / 重做（§10.1 上控制条三圆钮）──
    function pushHistory(entry) {
      state.past.push(entry);
      if (state.past.length > 200) state.past.shift();
      state.future.length = 0;
      updateHistoryBtns();
    }
    function updateHistoryBtns() {
      var canUndo = state.past.length > 0;
      var canRedo = state.future.length > 0;
      if (undoBtn) undoBtn.disabled = !canUndo;
      if (undoIconBtn) undoIconBtn.disabled = !canUndo;
      if (redoIconBtn) redoIconBtn.disabled = !canRedo;
    }
    function applyHistory(entry, forward) {
      var i = entry.i;
      if (forward) {
        state.vals[i] = entry.next;
        state.hinted[i] = entry.hintNext;
      } else {
        state.vals[i] = entry.prev;
        state.hinted[i] = entry.hintPrev;
      }
      state.sel = i;
      recalc();
      paint();
    }
    function doUndo() {
      if (!state.past.length) return;
      var entry = state.past.pop();
      state.future.push(entry);
      applyHistory(entry, false);
      updateHistoryBtns();
      updateHintBtns();
      track('undo_click', { game: gameKey, size: state.size });
    }
    function doRedo() {
      if (!state.future.length) return;
      var entry = state.future.pop();
      state.past.push(entry);
      applyHistory(entry, true);
      updateHistoryBtns();
      updateHintBtns();
      track('redo_click', { game: gameKey, size: state.size });
    }

    // ── 生成新盘（16/25 可能耗时：先让 loading 渲染，再同步跑引擎）──
    function newPuzzle(nextSize, via) {
      var s = nextSize || state.size;
      var b = BLOCKS[s] || [state.bw, state.bh];
      state.size = s;
      state.bw = b[0];
      state.bh = b[1];
      state.sel = -1;
      state.solved = false;
      state.hintsLeft = 3;
      state.moved = false;
      state.past.length = 0;
      state.future.length = 0;
      winEl.hidden = true;
      syncChips();
      updateHintBtns();
      updateHistoryBtns();
      if (via) track('puzzle_reset', { game: gameKey, via: via, size: s, difficulty: DIFF_LABEL[state.diff] });

      var token = ++state.token;
      setLoading(true);
      setTimeout(function () {
        var p = null;
        var tries = 0;
        while (!p && tries < 3) {
          tries++;
          var seed = (Date.now() ^ ((Math.random() * 0x7fffffff) | 0) ^ (tries * 2654435761)) | 0;
          try {
            p = E.generate(s, b[0], b[1], state.diff, seed, 8000);
          } catch (err) {
            p = null;
          }
        }
        if (state.token !== token) return;
        setLoading(false);
        if (!p) {
          msg('That board could not be generated. Press New to try again.');
          return;
        }
        state.puzzle = p;
        state.symbols = (letterMode && s === 9) ? LETTERS9 : p.symbols;
        state.given = new Uint8Array(s * s);
        state.hinted = new Uint8Array(s * s);
        state.vals = new Int8Array(s * s).fill(-1);
        for (var g = 0; g < p.givens.length; g++) {
          var pair = p.givens[g];
          state.given[pair[0]] = 1;
          state.vals[pair[0]] = pair[1];
        }
        buildBoard();
        recalc();
        paint();
        msg('Tap a cell, then a symbol. Duplicates in the same row, column or box turn red; tap the same symbol again to clear a cell.');
        startTimer();
        if (document.visibilityState === 'visible') {
          track('game_start', { game: gameKey, size: s, difficulty: DIFF_LABEL[state.diff], source: detectSource() });
        }
      }, 30);
    }

    function buildBoard() {
      var N = state.size;
      boardEl.style.setProperty('--sd-n', String(N));
      boardEl.innerHTML = '';
      cells = [];
      var frag = document.createDocumentFragment();
      for (var r = 0; r < N; r++) {
        for (var c = 0; c < N; c++) {
          var d = document.createElement('div');
          var cls = 'sd-cell';
          if (c === N - 1 || (c + 1) % state.bw === 0) cls += ' sd-box-r';
          if (r === N - 1 || (r + 1) % state.bh === 0) cls += ' sd-box-b';
          if (c === N - 1) cls += ' sd-edge-r';
          if (r === N - 1) cls += ' sd-edge-b';
          d.className = cls;
          d.__base = cls;
          d.__i = r * N + c;
          d.setAttribute('role', 'gridcell');
          d.setAttribute('data-i', String(r * N + c));
          frag.appendChild(d);
          cells.push(d);
        }
      }
      boardEl.appendChild(frag);
      buildKeys();
      sizeBoard();
      if (state.view !== 'grid') renderZoom();
    }

    function isNarrow() { return (wrap.clientWidth || 640) < 520; }

    function buildKeys() {
      keysEl.innerHTML = '';
      // §14.1.2 手机键位 ≥44×44 且相邻 ≥8px：窄屏减列数换宽度（9→5 / 12→4 / 16→6 / 25→7 列）
      var narrow = isNarrow();
      state.narrow = narrow;
      var kcols;
      if (narrow) kcols = state.size <= 9 ? 5 : (state.size <= 12 ? 4 : (state.size <= 16 ? 6 : 7));
      else kcols = state.size <= 9 ? state.size : (state.size <= 12 ? 6 : (state.size <= 16 ? 8 : 10));
      keysEl.style.setProperty('--sd-kcols', String(kcols));
      for (var v = 1; v <= state.size; v++) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'sd-key';
        b.textContent = state.symbols[v - 1];
        b.setAttribute('data-v', String(v));
        b.setAttribute('aria-label', 'Place ' + state.symbols[v - 1]);
        keysEl.appendChild(b);
      }
    }

    function sizeBoard() {
      var N = state.size;
      // 以棋盘滚动容器的真实宽度为基准（.sd-play 的 clientWidth 含内边距，会算出溢出）
      var host = boardEl.parentNode;
      var wide = host && host.clientWidth ? host.clientWidth : 320;
      var avail = Math.max(200, wide - 10); // 减去容器 padding 与棋盘边框
      // §10.1 格子 28–56px 是桌面口径；§14.1.5 手机下限 20px（明确禁止硬缩到 18px），
      // 实算优先 —— 宁可格子小一点也不让盘面横向溢出（溢出的部分靠 Box / Zoom 视图看）
      var maxCell = N >= 25 ? 32 : (N >= 16 ? 40 : (N >= 12 ? 48 : 56));
      var cell = Math.floor(avail / N);
      if (cell > maxCell) cell = maxCell;
      if (cell < 20) cell = 20;
      boardEl.style.setProperty('--sd-cell', cell + 'px');
    }

    function recalc() {
      var n = 0;
      for (var i = 0; i < state.vals.length; i++) if (state.vals[i] > 0) n++;
      state.filled = n;
      progEl.textContent = n + ' / ' + (state.size * state.size);
    }

    // 行 / 列 / 区块重复值 → 标记冲突
    function conflicts() {
      var N = state.size;
      var vals = state.vals;
      var conf = new Uint8Array(N * N);
      var bw = state.bw, bh = state.bh;
      var r, c, i, v, first;

      for (r = 0; r < N; r++) {
        first = new Int32Array(N + 1).fill(-1);
        for (c = 0; c < N; c++) {
          i = r * N + c; v = vals[i];
          if (v <= 0) continue;
          if (first[v] >= 0) { conf[i] = 1; conf[first[v]] = 1; } else { first[v] = i; }
        }
      }
      for (c = 0; c < N; c++) {
        first = new Int32Array(N + 1).fill(-1);
        for (r = 0; r < N; r++) {
          i = r * N + c; v = vals[i];
          if (v <= 0) continue;
          if (first[v] >= 0) { conf[i] = 1; conf[first[v]] = 1; } else { first[v] = i; }
        }
      }
      var boxesX = N / bw, boxesY = N / bh;
      for (var by = 0; by < boxesY; by++) {
        for (var bx = 0; bx < boxesX; bx++) {
          first = new Int32Array(N + 1).fill(-1);
          for (r = 0; r < bh; r++) {
            for (c = 0; c < bw; c++) {
              i = (by * bh + r) * N + (bx * bw + c); v = vals[i];
              if (v <= 0) continue;
              if (first[v] >= 0) { conf[i] = 1; conf[first[v]] = 1; } else { first[v] = i; }
            }
          }
        }
      }
      return conf;
    }

    function paintInto(list, conf) {
      var N = state.size;
      var vals = state.vals;
      var sel = state.sel;
      var selV = sel >= 0 ? vals[sel] : -1;
      var sr = sel >= 0 ? Math.floor(sel / N) : -1;
      var sc = sel >= 0 ? sel % N : -1;
      var bw = state.bw, bh = state.bh;

      for (var k = 0; k < list.length; k++) {
        var d = list[k];
        var i = d.__i;
        var v = vals[i];
        var txt = v > 0 ? state.symbols[v - 1] : '';
        if (d.textContent !== txt) d.textContent = txt;

        var cls = d.__base;
        if (state.given[i]) cls += ' sd-given';
        if (state.hinted[i]) cls += ' sd-hinted';
        var r = Math.floor(i / N), c = i % N;
        if (sel >= 0 && i !== sel) {
          var sameRow = r === sr, sameCol = c === sc;
          var sameBox = Math.floor(r / bh) === Math.floor(sr / bh) && Math.floor(c / bw) === Math.floor(sc / bw);
          if (sameRow || sameCol || sameBox) cls += ' sd-peer';
        }
        if (selV > 0 && v === selV && i !== sel) cls += ' sd-same';
        if (i === sel) cls += ' sd-sel';
        if (conf[i]) cls += ' sd-conf';
        if (d.className !== cls) d.className = cls;
      }
    }

    function paint() {
      if (!state.vals) return;
      var conf = conflicts();
      paintInto(cells, conf);
      if (state.view !== 'grid') paintInto(zoomCells, conf);
    }

    // ── §14.1.5 放大视图：box = 选中格所在宫；loupe = 以选中格为中心的 5×5 ──
    function zoomWindow() {
      var N = state.size;
      var sel = state.sel;
      var r = sel >= 0 ? Math.floor(sel / N) : 0;
      var c = sel >= 0 ? sel % N : 0;
      var idx = [], cols, rows, label;
      if (state.view === 'box') {
        var bw = state.bw, bh = state.bh;
        var br = Math.floor(r / bh) * bh;
        var bc = Math.floor(c / bw) * bw;
        for (var y = 0; y < bh; y++) {
          for (var x = 0; x < bw; x++) idx.push((br + y) * N + (bc + x));
        }
        cols = bw; rows = bh;
        var perRow = Math.floor(N / bw);
        label = 'Box ' + (Math.floor(br / bh) * perRow + Math.floor(bc / bw) + 1) + ' of ' + (perRow * Math.floor(N / bh));
      } else {
        var w = Math.min(5, N);
        var r0 = Math.min(Math.max(0, r - Math.floor(w / 2)), N - w);
        var c0 = Math.min(Math.max(0, c - Math.floor(w / 2)), N - w);
        for (var yy = 0; yy < w; yy++) {
          for (var xx = 0; xx < w; xx++) idx.push((r0 + yy) * N + (c0 + xx));
        }
        cols = w; rows = w;
        label = 'Rows ' + (r0 + 1) + '–' + (r0 + w) + ' · Cols ' + (c0 + 1) + '–' + (c0 + w);
      }
      return { cols: cols, rows: rows, cells: idx, label: label };
    }

    function renderZoom() {
      if (!state.puzzle) return;
      if (state.view === 'grid') {
        zoomWrapEl.hidden = true;
        boardEl.hidden = false;
        return;
      }
      var win = zoomWindow();
      var host = boardEl.parentNode;
      var avail = Math.max(200, (host && host.clientWidth ? host.clientWidth : 320) - 12);
      var cell = Math.floor(avail / win.cols);
      if (cell > 92) cell = 92;
      zoomEl.style.setProperty('--sd-zn', String(win.cols));
      zoomEl.style.setProperty('--sd-cell', cell + 'px');
      zoomEl.innerHTML = '';
      zoomCells = [];
      var frag = document.createDocumentFragment();
      var N = state.size;
      for (var k = 0; k < win.cells.length; k++) {
        var i = win.cells[k];
        var d = document.createElement('div');
        var cls = 'sd-cell';
        var r = Math.floor(i / N), c = i % N;
        if (c === N - 1 || (c + 1) % state.bw === 0) cls += ' sd-box-r';
        if (r === N - 1 || (r + 1) % state.bh === 0) cls += ' sd-box-b';
        if (c === N - 1) cls += ' sd-edge-r';
        if (r === N - 1) cls += ' sd-edge-b';
        d.className = cls;
        d.__base = cls;
        d.__i = i;
        d.setAttribute('data-i', String(i));
        d.setAttribute('role', 'gridcell');
        frag.appendChild(d);
        zoomCells.push(d);
      }
      zoomEl.appendChild(frag);
      zoomCapEl.textContent = win.label;
      zoomWrapEl.hidden = false;
      boardEl.hidden = true;
      paint();
    }

    function setView(v) {
      if (v === state.view) return;
      state.view = v;
      var btns = viewbarEl.querySelectorAll('[data-view]');
      for (var i = 0; i < btns.length; i++) {
        btns[i].setAttribute('aria-pressed', btns[i].getAttribute('data-view') === v ? 'true' : 'false');
      }
      if (v === 'grid') {
        zoomWrapEl.hidden = true;
        boardEl.hidden = false;
        paint();
        ensureVisible(state.sel);
      } else {
        renderZoom();
      }
      track('view_switch', { game: gameKey, view: v, size: state.size });
    }

    // 25×25 在手机上盘面横向可滚：选中格滚进可视区
    function ensureVisible(i) {
      if (i < 0) return;
      var host = boardEl.parentNode;
      if (!host || host.scrollWidth <= host.clientWidth + 1) return;
      var N = state.size;
      var cellPx = parseFloat(window.getComputedStyle(boardEl).getPropertyValue('--sd-cell')) || 30;
      var c = i % N;
      var left = c * cellPx;
      if (left < host.scrollLeft) host.scrollLeft = Math.max(0, left - cellPx);
      else if (left + cellPx > host.scrollLeft + host.clientWidth) host.scrollLeft = left + cellPx - host.clientWidth + cellPx;
    }

    function selectCell(i) {
      state.sel = i;
      if (state.view !== 'grid') renderZoom();
      else { paint(); ensureVisible(i); }
    }

    function setValue(v) {
      var i = state.sel;
      if (i < 0) { msg('Tap a cell first, then choose a symbol.'); return; }
      if (state.solved || state.given[i] || state.hinted[i]) return;
      if (!state.moved) {
        state.moved = true;
        track('first_move', { game: gameKey, size: state.size, difficulty: DIFF_LABEL[state.diff] });
        // §13.1.5 完成首个动作 → 引导永久收起
        window.dispatchEvent(new CustomEvent('gp-coach-complete', { detail: { game: gameKey } }));
      }
      var prev = state.vals[i];
      var next = prev === v ? -1 : v;
      pushHistory({ i: i, prev: prev, next: next, hintPrev: 0, hintNext: 0 });
      state.vals[i] = next;
      recalc();
      paint();
      maybeWin();
    }

    function maybeWin() {
      if (state.solved || !state.puzzle) return;
      if (state.filled !== state.size * state.size) return;
      var ok = false;
      try {
        var res = E.validate(state.puzzle, state.vals);
        ok = !!(res && res.ok);
      } catch (e) {
        ok = false;
      }
      if (!ok) {
        ok = true;
        for (var i = 0; i < state.vals.length; i++) {
          if (state.vals[i] !== state.puzzle.solution[i]) { ok = false; break; }
        }
      }
      if (!ok) {
        track('game_over', { game: gameKey, size: state.size, difficulty: DIFF_LABEL[state.diff] });
        msg('Every cell is filled, but some symbols break the rules — red cells show where.');
        return;
      }
      state.solved = true;
      stopTimer();
      winDetailEl.textContent = state.size + '×' + state.size + ' ' + DIFF_LABEL[state.diff] + ' solved in ' + fmt(state.secs) + '.';
      winEl.hidden = false;
      msg('All ' + (state.size * state.size) + ' cells are legal: every row, column and box holds each symbol exactly once.');
      track('level_up', { game: gameKey, size: state.size, difficulty: DIFF_LABEL[state.diff], seconds: state.secs });
    }

    function useHint() {
      var i = state.sel;
      if (i < 0) { msg('Tap the cell you want revealed, then press Hint.'); return; }
      if (state.given[i] || state.hinted[i]) { msg('That cell is already revealed.'); return; }
      if (state.hintsLeft <= 0) { msg('No hints left on this board — press New for three fresh ones.'); return; }
      var ans = -1;
      try { ans = E.hintLookup(state.puzzle, i); } catch (e) { ans = -1; }
      if (!ans || ans < 1) { ans = state.puzzle.solution[i]; }
      pushHistory({ i: i, prev: state.vals[i], next: ans, hintPrev: 0, hintNext: 1 });
      state.hintsLeft--;
      state.vals[i] = ans;
      state.hinted[i] = 1;
      updateHintBtns();
      recalc();
      paint();
      track('hint_click', { game: gameKey, size: state.size, difficulty: DIFF_LABEL[state.diff] });
      maybeWin();
    }

    function restart() {
      var N = state.size;
      state.vals = new Int8Array(N * N).fill(-1);
      state.hinted = new Uint8Array(N * N);
      for (var g = 0; g < state.puzzle.givens.length; g++) {
        state.vals[state.puzzle.givens[g][0]] = state.puzzle.givens[g][1];
      }
      state.sel = -1;
      state.solved = false;
      state.hintsLeft = 3;
      state.moved = false;
      state.past.length = 0;
      state.future.length = 0;
      winEl.hidden = true;
      updateHintBtns();
      updateHistoryBtns();
      recalc();
      paint();
      startTimer();
      track('puzzle_reset', { game: gameKey, via: 'restart', size: state.size, difficulty: DIFF_LABEL[state.diff] });
    }

    // ── ⋯ 抽屉（低频动作：难度 / 棋盘尺寸 / 新盘）──
    function setMenu(open) {
      menuEl.hidden = !open;
      moreBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    // ── 事件绑定 ──
    // 盘面点击（主网格与放大视图共用一套：data-i 指向同一份真实索引）
    function bindGridClicks(el) {
      if (!el) return;
      el.addEventListener('click', function (ev) {
        var t = ev.target;
        while (t && t !== el && !(t.className && String(t.className).indexOf('sd-cell') !== -1)) t = t.parentNode;
        if (!t || t === el) return;
        var i = Number(t.getAttribute('data-i'));
        if (isNaN(i)) return;
        selectCell(i);
      });
    }
    bindGridClicks(boardEl);
    bindGridClicks(zoomEl);

    // 视图切换（§14.1.5）：Grid / Box（单宫放大）/ Zoom（5×5 放大镜）
    if (viewbarEl) {
      viewbarEl.addEventListener('click', function (ev) {
        var t = ev.target;
        while (t && t !== viewbarEl && !(t.getAttribute && t.getAttribute('data-view'))) t = t.parentNode;
        if (!t || t === viewbarEl) return;
        setView(t.getAttribute('data-view'));
      });
    }

    keysEl.addEventListener('click', function (ev) {
      var t = ev.target;
      while (t && t !== keysEl && !(t.className && String(t.className).indexOf('sd-key') !== -1)) t = t.parentNode;
      if (!t || t === keysEl) return;
      var v = Number(t.getAttribute('data-v'));
      if (!isNaN(v)) setValue(v);
    });

    // 难度 / 尺寸 chips：根节点委托（工具栏那一组与抽屉那一组共用一套逻辑）
    wrap.addEventListener('click', function (ev) {
      var t = ev.target;
      while (t && t !== wrap && !(t.getAttribute && (t.getAttribute('data-diff') || t.getAttribute('data-size')))) t = t.parentNode;
      if (!t || t === wrap) return;
      var d = t.getAttribute('data-diff');
      if (d) {
        if (d === state.diff) return;
        state.diff = d;
        newPuzzle(state.size, 'difficulty');
        return;
      }
      var s = Number(t.getAttribute('data-size'));
      if (!s || s === state.size) return;
      newPuzzle(s, 'size');
    });

    hintBtn.addEventListener('click', useHint);
    if (hintIconBtn) hintIconBtn.addEventListener('click', useHint);
    undoBtn.addEventListener('click', doUndo);
    if (undoIconBtn) undoIconBtn.addEventListener('click', doUndo);
    if (redoIconBtn) redoIconBtn.addEventListener('click', doRedo);
    restartBtn.addEventListener('click', restart);
    newBtn.addEventListener('click', function () { setMenu(false); newPuzzle(state.size, 'new'); });
    if (guideBtn) {
      guideBtn.addEventListener('click', function () {
        setMenu(false);
        window.dispatchEvent(new CustomEvent('gp-coach-open', { detail: { game: gameKey } }));
      });
    }
    if (nextBtn) nextBtn.addEventListener('click', function () { winEl.hidden = true; newPuzzle(state.size, 'next'); });
    moreBtn.addEventListener('click', function (ev) {
      ev.stopPropagation();
      setMenu(menuEl.hidden);
    });
    document.addEventListener('click', function (ev) {
      if (menuEl.hidden) return;
      if (menuEl.contains(ev.target) || moreBtn.contains(ev.target)) return;
      setMenu(false);
    });

    // 键盘：Delete/Backspace 清格，符号键填数（原有行为，勿删）
    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape') {
        if (!menuEl.hidden) { setMenu(false); return; }
      }
      if (ev.metaKey || ev.ctrlKey || ev.altKey) return;
      if (ev.key === 'Backspace' || ev.key === 'Delete') {
        if (state.sel >= 0 && !state.given[state.sel] && state.vals[state.sel] > 0) {
          pushHistory({ i: state.sel, prev: state.vals[state.sel], next: -1, hintPrev: state.hinted[state.sel], hintNext: 0 });
          state.vals[state.sel] = -1;
          state.hinted[state.sel] = 0;
          recalc();
          paint();
        }
        return;
      }
      var k = ev.key.length === 1 ? ev.key.toUpperCase() : '';
      if (!k) return;
      var v = state.symbols.indexOf(k) + 1;
      if (v) { ev.preventDefault(); setValue(v); }
    });

    // 视口变化 → 重算格尺寸（§10.1 上限 56 / §14.1.5 下限），放大视图重排窗口
    var resizeId = 0;
    window.addEventListener('resize', function () {
      if (resizeId) clearTimeout(resizeId);
      resizeId = setTimeout(function () {
        if (!state.puzzle) return;
        if (isNarrow() !== state.narrow) buildKeys();   // 旋屏/缩放跨过 520px 门槛时重排键位
        if (state.view !== 'grid') renderZoom();
        else sizeBoard();
      }, 120);
    });

    updateHistoryBtns();
    newPuzzle(size, '');
  })();
</script>
