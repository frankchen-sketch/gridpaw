---
// HelpArticle — shared full-page wrapper for the /help/ guides.
// Emits a complete HTML document: SEOHead (+FAQPage JSON-LD) + GameNav header
// + breadcrumb, a content slot, the FAQ section (visible <details> matches the
// JSON-LD exactly), a play CTA back to the game page, and a site footer.
// Styles reuse the site's amber/cream tokens from the game pages.
import SEOHead from './SEOHead.astro';
import GameNav from './GameNav.astro';

export interface Props {
  title: string;
  description: string;
  canonical: string; // e.g. "/help/shikaku" (SEOHead normalizes trailing slash)
  breadcrumbTitle?: string; // last crumb label, e.g. "Shikaku"
  faqs?: { q: string; a: string }[];
  gameHref?: string; // CTA destination, e.g. "/akari/"
  ctaText?: string; // CTA label, e.g. "Play Akari free in your browser →"
}

const {
  title,
  description,
  canonical,
  breadcrumbTitle,
  faqs = [],
  gameHref = '/',
  ctaText = '',
} = Astro.props;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead title={title} description={description} canonical={canonical} type="article" breadcrumbTitle={breadcrumbTitle} />
  {faqs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  )}
  <style is:global>
    :root {
      --amber: #d97706;
      --amber-dark: #b45309;
      --cream: #fff8ef;
      --cream-2: #fdeed3;
      --ink: #3f2d1d;
      --muted: #8a6f55;
      --line: #e7d4b8;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--cream); color: var(--ink); font-family: -apple-system, 'Segoe UI', Roboto, sans-serif; line-height: 1.65; }
    .crumbs { max-width: 860px; margin: 0 auto; padding: 1rem 1.2rem; font-size: .9rem; color: var(--muted); }
    .crumbs a { color: var(--amber-dark); text-decoration: none; }
    .crumbs a:hover { text-decoration: underline; }
    .help-main { max-width: 860px; margin: 0 auto; padding: 1.2rem 1.2rem 3rem; }
    h1 { font-size: 1.9rem; line-height: 1.25; margin: .4rem 0 1rem; }
    .lede { font-size: 1.05rem; color: var(--ink); margin-bottom: 1.4rem; }
    .lede a { color: var(--amber-dark); }
    h2 { font-size: 1.35rem; margin: 2.4rem 0 .8rem; }
    h3 { font-size: 1.05rem; margin: 1.2rem 0 .5rem; }
    p { margin: .4rem 0 .8rem; }
    .help-main ol, .help-main ul { margin: .6rem 0 1rem; padding-left: 1.4rem; }
    .help-main li { margin-bottom: .5rem; }
    .help-main a { color: var(--amber-dark); }
    .help-main a:hover { text-decoration: underline; }
    table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: .95rem; }
    th, td { padding: .55rem .7rem; border: 1px solid var(--line); text-align: left; vertical-align: top; }
    th { background: var(--cream-2); color: var(--ink); font-weight: 700; }
    tbody tr:nth-child(even) { background: #fbf3e2; }
    .shot { margin: 1.3rem 0; }
    .shot img { max-width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); display: block; box-shadow: 0 2px 8px rgba(63,45,29,.08); }
    .shot figcaption { font-size: .85rem; color: var(--muted); margin-top: .45rem; }
    details { margin: .6rem 0; padding: .6rem .9rem; background: var(--cream-2); border: 1px solid var(--line); border-radius: 10px; }
    summary { cursor: pointer; font-weight: 700; color: var(--amber-dark); }
    .play-cta { display: block; max-width: 520px; margin: 2rem auto 1rem; padding: .95rem 1.2rem; background: var(--amber); color: #fff; border-radius: 12px; text-decoration: none; font-weight: 700; font-size: 1.08rem; text-align: center; }
    .play-cta:hover { background: var(--amber-dark); }
    .gp-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; margin: 1.5rem 0; }
    .gp-card { display: block; padding: 1rem 1.1rem; background: #fff; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; color: var(--ink); box-shadow: 0 2px 8px rgba(63,45,29,.06); }
    .gp-card:hover { border-color: var(--amber); box-shadow: 0 4px 14px rgba(63,45,29,.12); }
    .gp-card strong { display: block; font-size: 1.02rem; }
    .gp-card span { font-size: .85rem; color: var(--muted); }
    .gp-card-arrow { float: right; color: var(--amber-dark); }
    .help-foot { max-width: 860px; margin: 1rem auto 0; padding: 1rem; border-top: 1px solid var(--line); font-size: .85rem; color: var(--muted); text-align: center; }
    .help-foot a { color: var(--muted); text-decoration: none; }
    .help-foot a:hover { text-decoration: underline; }
    .help-foot p { margin: .35rem 0; }
  </style>
</head>
<body>
  <GameNav active="">
    <a href="/help/" style="text-decoration:none;color:#3f2d1d;font-size:.92rem">Help Center</a>
  </GameNav>

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true"> › </span><a href="/help/">Help</a><span aria-hidden="true"> › </span><span>{breadcrumbTitle || 'Help'}</span>
  </nav>

  <main class="help-main">
    <slot />
    {faqs.length > 0 && (
      <section>
        <h2>Frequently Asked Questions</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}
    {ctaText !== '' && (
      <a class="play-cta" href={gameHref}>{ctaText}</a>
    )}
  </main>

  <footer class="help-foot">
    <p>GridPaw — How to play guides for all six puzzle games.</p>
    <p><a href="/help/">Help Center</a> · <a href="/">Shikaku</a> · <a href="/akari/">Akari</a> · <a href="/kakuro/">Kakuro</a> · <a href="/nonogram/">Nonogram</a> · <a href="/nurikabe/">Nurikabe</a> · <a href="/pictomino/">Pictomino</a></p>
    <p><a href="https://www.pinterest.com/gridpaw/">Pinterest</a> · <a href="https://chromewebstore.google.com/detail/gridpaw-%E2%80%94-daily-akari-puz/mjdplaoanamjdbbpkgccjnhmlgnpcamj">Chrome Extension</a> · <a href="https://gridpaw-games.lovable.app">Lovable</a> · <a href="/community/">Community</a> · © 2026 GridPaw. All rights reserved.</p>
  </footer>
</body>
</html>