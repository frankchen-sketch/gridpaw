---
// InContentAd — 正文内 300x250 Banner（unit 31836413，key c3072bbb…；代码档 .adsterra/banner-300x250.snippet.md）
// 在流内（非悬浮），桌面+移动端同一位：视频正下方。暖色底固定 250px 高预留：
// 填充前不闪白、未填充也不出白块，CLS=0。
// invoke 域按官方 GET CODE（bauval.org/22/<key>，Adsterra 会轮换域名，以 API codes 为准）。
// ⚠ 同页可能与 SideAd（160x600）并存：两者都走全局 atOptions，必须经 __gpAdChain
// 串行注入（set atOptions → append invoke.js → 等 load），否则后注入方的尺寸会覆盖先注入方。
// 2026-10-22 起注入前过 AdGate（geo 黑名单 CN/HK + bot UA，fail-open）。
import AdGate from './AdGate.astro';
// 2026-11-07 恢复：法老拍板「先恢复 Adsterra 做收益」，站点转向攻略站。
// 只恢复静态 banner 类（本组件 300x250 iframe / SideAd 160x600 iframe）；
// AdSlot 的 Native 门保持 false（Native 卡片是 10-15 投诉的直接来源，不恢复）。
// 恢复闸：/changelog/ 公告 → 邮件 Peter(DLES.gg) → 才上线；任何一起跳转投诉=当天撤。
const ADSTERRA_OFF = false;
---
{!ADSTERRA_OFF && <AdGate />}
{!ADSTERRA_OFF && (
<div class="gp-incontent-ad" aria-hidden="true">
  <span class="gp-incontent-ad__label">Advertisement</span>
  <div class="gp-incontent-ad__slot"></div>
</div>
)}
{!ADSTERRA_OFF && (
<script is:inline>
(function () {
  if (new URLSearchParams(location.search).has('embed')) return;
  // 付费去广告（/ad-free/）：localStorage 有权益 token 就不注入，并把空盒子一起藏掉
  var free = false;
  try { free = !!localStorage.getItem('gp_ads_free'); } catch (e) {}
  if (free) { document.documentElement.classList.add('gp-ads-free'); return; }
  var KEY = 'c3072bbbf851bb748d0bc833da23e21e';
  var SRC = 'https://bauval.org/22/' + KEY;
  var slot = document.querySelector('.gp-incontent-ad__slot');
  if (!slot || slot.childElementCount > 0) return;
  window.__gpAdChain = window.__gpAdChain || Promise.resolve();
  function chain() {
    window.__gpAdChain = window.__gpAdChain.then(function () {
      return new Promise(function (resolve) {
        if (!slot.isConnected || slot.childElementCount > 0) return resolve();
        window.atOptions = { 'key': KEY, 'format': 'iframe', 'height': 250, 'width': 300, 'params': {} };
        var s = document.createElement('script');
        s.src = SRC;
        s.async = false;
        s.addEventListener('load', resolve);
        s.addEventListener('error', resolve);
        slot.appendChild(s);
      });
    });
  }
  window.__gpGeoGate.then(function (allow) { if (allow) chain(); });
})();
</script>
)}
<style>
  .gp-incontent-ad {
    width: 300px;
    height: 250px;
    margin: 0.9rem auto;
    background: #FFF8E6;
    border: 1.5px dashed #E8D5B5;
    border-radius: 10px;
    position: relative;
    overflow: hidden;
  }
  .gp-incontent-ad__label {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #C9B48F;
    background: #FBF1DC;
    padding: 2px 7px;
    border-radius: 0 0 6px 0;
    z-index: 1;
  }
  .gp-incontent-ad__slot { width: 300px; height: 250px; }
  /* 已购去广告：彻底不占位 */
  html.gp-ads-free .gp-incontent-ad { display: none !important; }
</style>
