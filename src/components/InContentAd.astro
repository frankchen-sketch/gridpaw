---
// InContentAd — 正文内 300×250（AdSense 接管，unit id 见 src/lib/adsense.ts 的 incontent）
// 在流内（非悬浮），桌面+移动端同一位：视频正下方 / 正文中段。
// 暖色底固定 250px 高预留：填充前不闪白、CLS=0；填充后撤掉虚线框（AdSense 自带白底创意框）。
//
// ── 2026-11-20 AdSense 接管 ────────────────────────────────────────────
// Adsterra 2026-11-17 全站撤除（`ADSTERRA_OFF = true`），AdSense 复审通过后同一个位换库存。
// SLOT 为空 = 这位直接不渲染（连 ins 都不出）——后台建好 unit 填进 src/lib/adsense.ts 即上线。
// 与 SideAd 同页并存时两边都往 window.adsbygoogle 队列 push，AdSense 按 DOM 顺序一一对应，
// 不需要 Adsterra 时代那个 __gpAdChain 串行锁（AdSense 没有 atOptions 全局变量竞态）。
import AdGate from './AdGate.astro';
import NativeAd from './NativeAd.astro';
import { NATIVE_TEST_PATHS } from '../data/native-test-pages';
import { ADSENSE_CLIENT, ADSENSE_SLOTS, ADSENSE_ENABLED } from '../lib/adsense';

const ADSTERRA_OFF = true; // 2026-11-17 法老撤除（全站零广告，与 SideAd 同一开关口径）
const ADSTERRA_ON = !ADSTERRA_OFF;
const ADSENSE_ON = ADSENSE_ENABLED;
const SLOT = ADSENSE_SLOTS.incontent;

// 2026-11-16 起：格式对账实验。命中清单的页把 300×250 iframe 换成 Native Banner（无 iframe）。
// 清单/分组/回滚方式见 src/data/native-test-pages.ts；实验结束清空数组即全站回 iframe。
const PAGE_PATH = Astro.url.pathname.replace(/\/+$/, '') || '/';
const useNative = ADSTERRA_ON && NATIVE_TEST_PATHS.has(PAGE_PATH);
---
{ADSTERRA_ON && <AdGate />}
{ADSTERRA_ON && useNative && <NativeAd />}
{ADSENSE_ON && SLOT && (
<div class="gp-incontent-ad">
  <span class="gp-incontent-ad__label">Advertisement</span>
  <ins class="adsbygoogle gp-ad-ins" data-gp-pos="incontent" style="display:inline-block;width:300px;height:250px"
       data-ad-client={ADSENSE_CLIENT} data-ad-slot={SLOT}
       data-full-width-responsive="false"></ins>
  <script is:inline>
  (function () {
    if (new URLSearchParams(location.search).has('embed')) {
      document.documentElement.classList.add('gp-ads-free');
      return;
    }
    var free = false;
    try { free = !!localStorage.getItem('gp_ads_free'); } catch (e) {}
    if (free) { document.documentElement.classList.add('gp-ads-free'); return; }
    var ins = document.currentScript.parentNode.querySelector('ins.adsbygoogle[data-gp-pos="incontent"]');
    if (!ins) return;
    window.adsbygoogle = window.adsbygoogle || [];
    // 填充判定：AdSense 填充后给 ins 打 data-ad-status="filled"
    function check() {
      var st = ins.getAttribute('data-ad-status');
      if (st === 'filled') { ins.closest('.gp-incontent-ad').classList.add('is-filled'); return true; }
      return false;
    }
    if (!check() && typeof MutationObserver === 'function') {
      var mo = new MutationObserver(function () { if (check()) mo.disconnect(); });
      mo.observe(ins, { attributes: true, attributeFilter: ['data-ad-status'] });
    }
    window.adsbygoogle.push({});
  })();
  </script>
</div>
)}
{ADSTERRA_ON && !useNative && (
<div class="gp-incontent-ad" aria-hidden="true">
  <span class="gp-incontent-ad__label">Advertisement</span>
  <div class="gp-incontent-ad__slot"></div>
</div>
)}
{ADSTERRA_ON && !useNative && (
<script is:inline>
(function () {
  if (new URLSearchParams(location.search).has('embed')) return;
  // 付费去广告（/ad-free/）：localStorage 有权益 token 就不注入，并把空盒子一起藏掉
  var free = false;
  try { free = !!localStorage.getItem('gp_ads_free'); } catch (e) {}
  if (free) { document.documentElement.classList.add('gp-ads-free'); return; }
  var KEY = 'c3072bbbf851bb748d0bc833da23e21e';
  var SRC = 'https://bauval.org/22/' + KEY;
  var slot = document.querySelector('.gp-incontent-ad__slot');
  if (!slot || slot.childElementCount > 0) return;
  window.__gpAdChain = window.__gpAdChain || Promise.resolve();
  function chain() {
    window.__gpAdChain = window.__gpAdChain.then(function () {
      return new Promise(function (resolve) {
        if (!slot.isConnected || slot.childElementCount > 0) return resolve();
        window.atOptions = { 'key': KEY, 'format': 'iframe', 'height': 250, 'width': 300, 'params': {} };
        var s = document.createElement('script');
        s.src = SRC;
        s.async = false;
        s.addEventListener('load', resolve);
        s.addEventListener('error', resolve);
        slot.appendChild(s);
      });
    });
  }
  window.__gpGeoGate.then(function (allow) { if (allow) chain(); });
})();
</script>
)}
<style>
  .gp-incontent-ad {
    width: 300px;
    max-width: 100%; /* 兜底：塞进窄容器时不许溢出压住旁边的卡片（answers 页 1440 曾实测重叠 66×250px） */
    height: 250px;
    margin: 0.9rem auto;
    background: #FFF8E6;
    border: 1.5px dashed #E8D5B5;
    border-radius: 10px;
    position: relative;
    overflow: hidden;
  }
  .gp-incontent-ad__label {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #C9B48F;
    background: #FBF1DC;
    padding: 2px 7px;
    border-radius: 0 0 6px 0;
    z-index: 1;
  }
  .gp-incontent-ad__slot { width: 300px; height: 250px; }
  /* AdSense 填充后：撤掉虚线占位装饰，只留 300×250 白底创意（尺寸不变 = 零 CLS） */
  .gp-incontent-ad.is-filled {
    background: transparent;
    border-color: transparent;
    border-radius: 0;
  }
  .gp-incontent-ad.is-filled .gp-incontent-ad__label { display: none; }
  /* 已购去广告：彻底不占位 */
  html.gp-ads-free .gp-incontent-ad { display: none !important; }
</style>
