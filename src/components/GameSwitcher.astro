---
// GameSwitcher — 头部 Games 下拉（全站唯一维护点）
// 2026-10-14 结构债清理：此前 switcher 是每页内联复制（30 份），新游戏要手工同步
// 全部页面，murdoku/kenken 上线时其余 8+ 页头部长期不同步。
// 规范值 = 主流 CSS 组（13 文件）+ murdoku 的 .open 全宽生效写法（触屏笔记本友好）；
// CSS 变量全部带 fallback（akari 系页面存在变量未定义的情况，fallback 取漂移字面量）。
// 新增游戏时只改这里。active 判定用前缀匹配，子页（/akari/daily/ 等）自动落在栏目上。
const GAMES = [
  { href: '/', emoji: '🟧', name: 'Shikaku', icon: 'shikaku', desc: 'Rectangle partition puzzle' },
  { href: '/akari/', emoji: '💡', name: 'Akari', icon: 'akari', desc: 'Light Up puzzle' },
  { href: '/kakuro/', emoji: '🔢', name: 'Kakuro', icon: 'kakuro', desc: 'Cross-sum puzzle' },
  { href: '/nonogram/', emoji: '🎨', name: 'Nonogram', icon: 'nonogram', desc: 'Picture logic puzzle' },
  { href: '/nurikabe/', emoji: '🏝️', name: 'Nurikabe', icon: 'nurikabe', desc: 'Islands and sea puzzle' },
  { href: '/pictomino/', emoji: '🧩', name: 'Pictomino', icon: 'pictomino', desc: 'Spatial reasoning puzzle' },
  { href: '/kenken/', emoji: '🧮', name: 'KenKen', icon: 'kenken', desc: 'Calcudoku math puzzle' },
  { href: '/binary/', emoji: '0️⃣1️⃣', name: 'Binary', icon: 'binary', desc: 'Takuzu 0/1 logic puzzle' },
  { href: '/star-battle/', emoji: '⭐', name: 'Star Battle', icon: 'starbattle', desc: 'Two Not Touch puzzle' },
  { href: '/hashi/', emoji: '🌉', name: 'Hashi', icon: 'hashi', desc: 'Bridges island puzzle' },
  { href: '/slitherlink/', emoji: '➰', name: 'Slitherlink', icon: 'slitherlink', desc: 'Loop logic puzzle' },
  { href: '/murdoku/', emoji: '🕵️', name: 'Murder Sudoku', icon: 'murdoku', desc: 'Cat mystery logic puzzle' },
  // 2026-10-16 起双写债：GameNav.astro 也有一份 games 数组（content 页头），加游戏时两处都要改，收敛待办见 NEWWORD-LEDGER.md
  { href: '/meowdoku/', emoji: '🧠', name: 'Meowdoku', icon: 'meowdoku', desc: 'Cat Queens-style puzzle (fan)' },
  { href: '/crazy-cleanup/', emoji: '🧹', name: 'Crazy Cleanup', icon: 'crazycleanup', desc: 'Tidy & sort puzzle' },
  { href: '/train-tracks-puzzle/', emoji: '🚂', name: 'Train Tracks', desc: 'Railway path puzzle' },
  { href: '/huepaw/', emoji: '🌈', name: 'Huepaw', desc: 'Daily colour gradient puzzle' },
];
const pathname = Astro.url.pathname;
const isActive = (href) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<div class="game-switcher">
  <button class="game-switcher-btn" onclick="this.nextElementSibling.classList.toggle('open')">Games</button>
  <div class="game-switcher-menu">
    {GAMES.map((g) => (
      <a href={g.href} class={isActive(g.href) ? 'active' : ''}>
        <strong>{g.icon ? <!-- 2026-11-19 UI-1: 隐藏菜单里的 lazy 图标不加载 → eager -->
        <img class="game-ico" src={`/assets/game-icons/${g.icon}.webp`} alt="" width="18" height="18" /> : g.emoji} {g.name}</strong>
        <span class="game-desc">{g.desc}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .game-switcher { position: relative; }
  .game-switcher-btn { font-size: 0.875rem; font-weight: 700; color: var(--text, #3D3D3D); background: none; border: none; cursor: pointer; padding: 0.5rem 0.75rem; border-radius: 0.375rem; display: flex; align-items: center; gap: 4px; }
  .game-switcher-btn::after { content: '▾'; font-size: 10px; }
  .game-switcher-btn:hover { background: var(--hover-bg, #F0EDF5); color: var(--ink, #3D3D3D); }
  .game-switcher-menu { display: none; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); background: white; border: 1.5px solid var(--gp-parchment, #E8DDD0); border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.12); min-width: 200px; padding: 6px 0; z-index: 300; }
  .game-switcher:hover .game-switcher-menu, .game-switcher-menu.open { display: block; }
  /* 2026-11-19 UI-1: 限高 + 内部滚动，滚轮在菜单里滚菜单（不再滚页面）
     注意：百分比 max-height 会按父级(按钮高度)求值 → 必须用 vh/min()，不能用 % */
  .game-switcher-menu { max-height: min(70vh, 460px); overflow-y: auto; overscroll-behavior: contain; }
  .game-ico { width: 18px; height: 18px; border-radius: 5px; vertical-align: -4px; margin-right: 2px; }
  .game-switcher-menu a { display: flex; flex-direction: column; padding: 10px 16px !important; font-size: 13px !important; gap: 2px; border-radius: 0 !important; }
  .game-switcher-menu a .game-desc { font-size: 11px; font-weight: 500; color: var(--gp-stone, #9E9590); }
  .game-switcher-menu a:hover { background: var(--gp-cream, #FFF8F0) !important; color: var(--ink, #3D3D3D) !important; }
  .game-switcher-menu a.active { color: var(--ink, #3D3D3D) !important; background: var(--gp-cream-warm, #FFF5F0) !important; font-weight: 800 !important; }
</style>

<script is:inline>
  // 2026-11-19 UI-1：外点 / Esc 关闭（此前 hover 展开 + 只能再点按钮关）
  (function () {
    function closeMenus() {
      var open = document.querySelectorAll('.game-switcher-menu.open');
      for (var i = 0; i < open.length; i++) open[i].classList.remove('open');
    }
    document.addEventListener('click', function (e) {
      if (e.target && e.target.closest && e.target.closest('.game-switcher')) return;
      closeMenus();
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeMenus(); });
  })();
</script>
