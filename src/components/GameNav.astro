---
// Hub navigation: sticky header with the six-game switcher.
// Self-contained styles (each page has its own palette). active = current page.
interface Props {
  active?: string; // current page href; '' (default) = no highlight, for content pages
}
const { active = '' } = Astro.props;
const games = [
  { href: '/', emoji: '🟧', name: 'Shikaku', desc: 'Rectangle partition puzzle' },
  { href: '/akari/', emoji: '💡', name: 'Akari', desc: 'Light Up puzzle' },
  { href: '/kakuro/', emoji: '🔢', name: 'Kakuro', desc: 'Cross-sum puzzle' },
  { href: '/nonogram/', emoji: '🎨', name: 'Nonogram', desc: 'Picture logic puzzle' },
  { href: '/nurikabe/', emoji: '🏝️', name: 'Nurikabe', desc: 'Islands and sea puzzle' },
  { href: '/pictomino/', emoji: '🧩', name: 'Pictomino', desc: 'Spatial reasoning puzzle' },
  { href: '/kenken/', emoji: '🧮', name: 'KenKen', desc: 'Calcudoku math puzzle' },
  { href: '/binary/', emoji: '0️⃣1️⃣', name: 'Binary', desc: 'Takuzu 0/1 logic puzzle' },
  { href: '/star-battle/', emoji: '⭐', name: 'Star Battle', desc: 'Two Not Touch puzzle' },
  { href: '/hashi/', emoji: '🌉', name: 'Hashi', desc: 'Bridges island puzzle' },
  { href: '/slitherlink/', emoji: '➰', name: 'Slitherlink', desc: 'Loop logic puzzle' },
  { { href: '/murdoku/', emoji: '🕵️', name: 'Murder Sudoku', desc: 'Cat mystery logic puzzle' },
  { href: '/meowdoku/', emoji: '🐱', name: 'Meowdoku', desc: 'Cat Queens-style puzzle (fan)' },
];
// ⚠️ 结构债：本组件与 GameSwitcher.astro 各有一份 games 数组（2026-10-16 加 meowdoku 时双写），
// 收敛方向：GameNav 切换为复用 GameSwitcher，见 NEWWORD-LEDGER.md 方案 C 节。
const guides = [
  { href: '/arrows-puzzle-walkthrough/', name: 'Arrows Puzzle Walkthrough', desc: 'Strategy for every level' },
  { href: '/arrows-puzzle/', name: 'Arrows Puzzle', desc: 'Rules & how to play' },
  { href: '/block-blast-hints/', name: 'Block Blast Hints', desc: '10+ score strategies' },
  { href: '/meowdoku-guide/', name: 'Meowdoku Guide', desc: 'Hints & games like it' },
  { href: '/cross-math-puzzle/', name: 'Cross Math Puzzle', desc: 'Rules & strategies' },
];
---
<header class="gp-nav" aria-label="Site navigation">
  <div class="gp-nav-inner">
    <a href="/" class="gp-nav-brand"><img src="/favicon.svg" alt="GridPaw cat puzzle icon" style="width:20px;height:20px;vertical-align:-4px"> <strong>GridPaw</strong></a>
    <div class="gp-nav-right">
      <div class="gp-switcher">
        <button class="gp-switcher-btn" onclick="this.nextElementSibling.classList.toggle('open')">Games</button>
        <div class="gp-switcher-menu">
          {games.map((g) => (
            <a href={g.href} class={g.href === active ? 'active' : ''}>
              <strong>{g.emoji} {g.name}</strong>
              <span class="gp-game-desc">{g.desc}</span>
            </a>
          ))}
          <a href="/help/" class="gp-menu-help">
            <strong>❓ Help Center</strong>
            <span class="gp-game-desc">How to play all 6 games</span>
          </a>
        </div>
      </div>
      <div class="gp-switcher">
        <button class="gp-switcher-btn" onclick="this.nextElementSibling.classList.toggle('open')">Guides</button>
        <div class="gp-switcher-menu">
          {guides.map((g) => (
            <a href={g.href} class={g.href === active ? 'active' : ''}>
              <strong>📚 {g.name}</strong>
              <span class="gp-game-desc">{g.desc}</span>
            </a>
          ))}
        </div>
      </div>
      <slot />
    </div>
  </div>
</header>
<style>
  .gp-nav { position: sticky; top: 0; z-index: 30; background: #fff8ef; border-bottom: 1px solid #e7d4b8; }
  .gp-nav-inner { max-width: 72rem; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; height: 3.2rem; padding: 0 1.2rem; }
  .gp-nav-brand { text-decoration: none; color: #3f2d1d; font-size: 1rem; }
  .gp-nav-right { display: flex; align-items: center; gap: 1rem; }
  .gp-switcher { position: relative; }
  .gp-switcher-btn {
    background: #d97706; color: #fff; border: none; border-radius: 8px;
    padding: .35rem .8rem; font-weight: 700; cursor: pointer; font-size: .9rem;
  }
  .gp-switcher-menu {
    display: none; position: absolute; right: 0; background: #fff; border: 1px solid #e7d4b8;
    border-radius: 10px; padding: .4rem; box-shadow: 0 8px 20px rgba(63,45,29,.15); min-width: 230px;
  }
  .gp-switcher-menu.open { display: block; }
  .gp-switcher-menu a {
    display: flex; flex-direction: column; padding: .5rem .7rem;
    border-radius: 8px; text-decoration: none; color: #3f2d1d;
  }
  .gp-switcher-menu a:hover { background: #fdeed3; }
  .gp-switcher-menu a.active { background: #fdeed3; }
  .gp-switcher-menu a.gp-menu-help { margin-top: .35rem; border-top: 1px solid #e7d4b8; }
  .gp-switcher-menu a.gp-menu-help:hover { background: #fdeed3; }
  .gp-game-desc { font-size: .78rem; color: #8a6f55; }
</style>
<script is:inline>
  (function () {
    document.addEventListener('click', function (e) {
      var t = e.target;
      while (t && t !== document) {
        if (t.matches && t.matches('.gp-switcher-menu a')) {
          var target = t.getAttribute('href');
          if (typeof window.gtag === 'function') window.gtag('event', 'game_nav_click', { target: target, from: 'dropdown', page: location.pathname });
          if (typeof window.clarity === 'function') window.clarity('event', 'game_nav_click');
          return;
        }
        if (t.classList && t.classList.contains('gp-switcher')) return;
        t = t.parentNode;
      }
    }, true);
  })();
</script>
