---
import RanksMenu from './RanksMenu.astro';
// Hub navigation: sticky header with the six-game switcher.
// Self-contained styles (each page has its own palette). active = current page.
interface Props {
  active?: string; // current page href; '' (default) = no highlight, for content pages
}
const { active = '' } = Astro.props;
const games = [
  { href: '/', emoji: '🟧', name: 'Shikaku', icon: 'shikaku', desc: 'Rectangle partition puzzle' },
  { href: '/akari/', emoji: '💡', name: 'Akari', icon: 'akari', desc: 'Light Up puzzle' },
  { href: '/kakuro/', emoji: '🔢', name: 'Kakuro', icon: 'kakuro', desc: 'Cross-sum puzzle' },
  { href: '/nonogram/', emoji: '🎨', name: 'Nonogram', icon: 'nonogram', desc: 'Picture logic puzzle' },
  { href: '/nurikabe/', emoji: '🏝️', name: 'Nurikabe', icon: 'nurikabe', desc: 'Islands and sea puzzle' },
  { href: '/pictomino/', emoji: '🧩', name: 'Pictomino', icon: 'pictomino', desc: 'Spatial reasoning puzzle' },
  { href: '/kenken/', emoji: '🧮', name: 'KenKen', icon: 'kenken', desc: 'Calcudoku math puzzle' },
  { href: '/binary/', emoji: '0️⃣1️⃣', name: 'Binary', icon: 'binary', desc: 'Takuzu 0/1 logic puzzle' },
  { href: '/star-battle/', emoji: '⭐', name: 'Star Battle', icon: 'starbattle', desc: 'Two Not Touch puzzle' },
  { href: '/hashi/', emoji: '🌉', name: 'Hashi', icon: 'hashi', desc: 'Bridges island puzzle' },
  { href: '/slitherlink/', emoji: '➰', name: 'Slitherlink', icon: 'slitherlink', desc: 'Loop logic puzzle' },
  { href: '/murdoku/', emoji: '🕵️', name: 'Murder Sudoku', icon: 'murdoku', desc: 'Cat mystery logic puzzle' },
  { href: '/meowdoku/', emoji: '🧠', name: 'Meowdoku', icon: 'meowdoku', desc: 'Cat Queens-style puzzle (fan)' },
  { href: '/train-tracks-puzzle/', emoji: '🚂', name: 'Train Tracks', desc: 'Railway path puzzle' },
  { href: '/16x16-sudoku/', emoji: '🔲', name: 'Sudoku 16', desc: 'Big-grid sudoku (16×16)' },
  { href: '/huepaw/', emoji: '🌈', name: 'Huepaw', desc: 'Daily color gradient game' },
  { href: '/room-sort-game-online/', emoji: '📦', name: 'Room Sort', desc: 'Fit rooms into a floor plan' },
];
// ⚠️ 结构债：本组件与 GameSwitcher.astro 各有一份 games 数组（2026-10-16 加 meowdoku 时双写），
// 收敛方向：GameNav 切换为复用 GameSwitcher，见 NEWWORD-LEDGER.md 方案 C 节。
const guides = [
  { href: '/arrows-puzzle-walkthrough/', name: 'Arrows Puzzle Walkthrough', desc: 'Strategy for every level' },
  { href: '/arrows-puzzle/', name: 'Arrows Puzzle', desc: 'Rules & how to play' },
  { href: '/block-blast-hints/', name: 'Block Blast Hints', desc: '10+ score strategies' },
  { href: '/meowdoku-guide/', name: 'Meowdoku Guide', desc: 'Hints & games like it' },
  { href: '/the-loop-puzzle/', name: 'The Loop Puzzle', desc: "Britannica's daily game, how to play" },
  { href: '/cross-math-puzzle/', name: 'Cross Math Puzzle', desc: 'Rules & strategies' },
  { href: '/brain-puzzle-3-answers/', name: 'Brain Puzzle 3 Answers', desc: 'All level walkthroughs' },
  { href: '/rooms-and-exits/', name: 'Rooms & Exits Walkthrough', desc: 'Chapter 1 level guides' },
  { href: '/rotate-rings/', name: 'Rotate Rings Guide', desc: 'Wave-verified level maps' },
  { href: '/amochiroom/', name: 'Amochiroom Room Sort', desc: 'Every level & box list' },
  { href: '/amochiroom/find/', name: 'Amochiroom Level Finder', desc: 'Which room am I in?' },
  { href: '/word-kitchen/', name: 'Word Kitchen Answers', desc: 'Every Bebinca level + solver' },
  { href: '/nonogram/solver/', name: 'Nonogram Solver', desc: 'Enter clues, get the solution' },
  { href: '/kenken/solver/', name: 'KenKen Solver', desc: 'Enter cages, get the grid' },
];
---
<header class="gp-nav" aria-label="Site navigation">
  <div class="gp-nav-inner">
    <a href="/" class="gp-nav-brand"><img src="/favicon.svg" alt="GridPaw cat puzzle icon" style="width:20px;height:20px;vertical-align:-4px"> <strong>GridPaw</strong></a>
    <div class="gp-nav-right">
      <div class="gp-switcher">
        <button class="gp-switcher-btn" onclick="this.nextElementSibling.classList.toggle('open')">Games</button>
        <div class="gp-switcher-menu">
          {games.map((g) => (
            <a href={g.href} class={g.href === active ? 'active' : ''}>
              <strong>{g.icon ? <!-- 2026-11-19 UI-1: 菜单初期 display:none，lazy 图标在 Chromium 下永不触发加载（实测 complete 一直 false）→ 必须 eager -->
              <img class="gp-game-ico" src={`/assets/game-icons/${g.icon}.webp`} alt="" width="18" height="18" /> : g.emoji} {g.name}</strong>
              <span class="gp-game-desc">{g.desc}</span>
            </a>
          ))}
          <a href="/leaderboard/" class="gp-menu-help">
            <strong>🏆 Leaderboard</strong>
            <span class="gp-game-desc">Today's fastest cats</span>
          </a>
          <a href="/badges/" class="gp-menu-help">
            <strong>🎖 Badges</strong>
            <span class="gp-game-desc">Every badge you can earn</span>
          </a>
          <a href="/help/" class="gp-menu-help">
            <strong>❓ Help Center</strong>
            <span class="gp-game-desc">How to play all 6 games</span>
          </a>
        </div>
      </div>
      <div class="gp-switcher">
        <button class="gp-switcher-btn" onclick="this.nextElementSibling.classList.toggle('open')">Guides</button>
        <div class="gp-switcher-menu">
          {guides.map((g) => (
            <a href={g.href} class={g.href === active ? 'active' : ''}>
              <strong>📚 {g.name}</strong>
              <span class="gp-game-desc">{g.desc}</span>
            </a>
          ))}
        </div>
      </div>
      <div class="gp-nav-lb"><RanksMenu /></div>
      <slot />
    </div>
  </div>
</header>
<style>
  .gp-nav { position: sticky; top: 0; z-index: 30; background: #fff8ef; border-bottom: 1px solid #e7d4b8; }
  .gp-nav-inner { max-width: 72rem; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; height: 3.2rem; padding: 0 1.2rem; }
  .gp-nav-brand { text-decoration: none; color: #3f2d1d; font-size: 1rem; }
  .gp-nav-right { display: flex; align-items: center; gap: 1rem; }
  .gp-switcher { position: relative; }
  .gp-switcher-btn {
    background: #d97706; color: #fff; border: none; border-radius: 8px;
    padding: .35rem .8rem; font-weight: 700; cursor: pointer; font-size: .9rem;
  }
  .gp-switcher-menu {
    display: none; position: absolute; right: 0; background: #fff; border: 1px solid #e7d4b8;
    border-radius: 10px; padding: .4rem; box-shadow: 0 8px 20px rgba(63,45,29,.15); min-width: 230px;
  }
  .gp-switcher-menu.open { display: block; }
  /* 2026-11-19 UI-1: 菜单曾无 max-height → 15 项 938px 顶到屏幕外、滚轮失效 */
  .gp-switcher-menu { max-height: min(70vh, 460px); overflow-y: auto; overscroll-behavior: contain; }
  .gp-game-ico { width: 18px; height: 18px; border-radius: 5px; vertical-align: -4px; margin-right: 2px; }
  .gp-switcher-menu a {
    display: flex; flex-direction: column; padding: .5rem .7rem;
    border-radius: 8px; text-decoration: none; color: #3f2d1d;
  }
  .gp-switcher-menu a:hover { background: #fdeed3; }
  .gp-switcher-menu a.active { background: #fdeed3; }
  .gp-switcher-menu a.gp-menu-help { margin-top: .35rem; border-top: 1px solid #e7d4b8; }
  .gp-switcher-menu a.gp-menu-help:hover { background: #fdeed3; }
  .gp-game-desc { font-size: .78rem; color: #8a6f55; }
  .gp-nav-lb {
    text-decoration: none; font-size: .84rem; font-weight: 700; color: #8a6f55;
    white-space: nowrap; padding: .25rem .1rem; border-radius: 6px;
  }
  .gp-nav-lb:hover { color: #d97706; }
  @media (max-width: 900px) { .gp-nav-lb { display: none; } }
</style>
<script is:inline>
  (function () {
    document.addEventListener('click', function (e) {
      var t = e.target;
      while (t && t !== document) {
        if (t.matches && t.matches('.gp-switcher-menu a')) {
          var target = t.getAttribute('href');
          if (typeof window.gtag === 'function') window.gtag('event', 'game_nav_click', { target: target, from: 'dropdown', page: location.pathname });
          if (typeof window.clarity === 'function') window.clarity('event', 'game_nav_click');
          return;
        }
        if (t.classList && t.classList.contains('gp-switcher')) return;
        t = t.parentNode;
      }
    }, true);
    // 外点 / Esc 关闭（2026-11-19 UI-1：菜单过去只能再点一次按钮才关）
    function closeMenus() {
      var open = document.querySelectorAll('.gp-switcher-menu.open');
      for (var i = 0; i < open.length; i++) open[i].classList.remove('open');
    }
    document.addEventListener('click', function (e) {
      if (e.target && e.target.closest && e.target.closest('.gp-switcher')) return;
      closeMenus();
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeMenus(); });
  })();
</script>
