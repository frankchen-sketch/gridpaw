---
// HomeTools — homepage tool clusters (Solvers / Walkthroughs / Help).
// 三簇布局：大簇给 Solvers 权重，右侧上下两小簇做辅助（2026-11-17 法老定稿版式：
// 「不像 v1 那么拥挤，更有规划感」）。
//
// ⚠️ 数据必须与站内真实存在的页面一致——这里只列已上线的工具页。
// 新增 solver/guide 页时，在本文件数组里加一条即可（不要改组件结构）。
// ⚠️ 图标用工具系 SVG（不是游戏 webp 插画）：法老明确要求「solver 的图标不能
// 用这版游戏图标形象」，游戏插画=入口语义、工具线稿=功能语义，两套体系分开。
interface ToolItem {
  href: string;
  icon: string;
  name: string;
  desc: string;
  wide?: boolean;
}
interface Props {
  solvers?: ToolItem[];
  walkthroughs?: ToolItem[];
  helps?: ToolItem[];
}

// ---- Solvers：站内真实存在的 4 个专用 solver + 索引页 ----
const solvers: ToolItem[] = [
  { href: '/solver/', icon: 'grid', name: 'All solvers', desc: 'Every solver in one index', wide: true },
  { href: '/akari/solver/', icon: 'bulb', name: 'Akari Solver', desc: 'Verify a bulb layout is unique' },
  { href: '/hashi/solver/', icon: 'bridge', name: 'Hashi Solver', desc: 'Check bridge connectivity' },
  { href: '/kenken/solver/', icon: 'cage', name: 'KenKen Solver', desc: 'Break down each arithmetic cage' },
  { href: '/nonogram/solver/', icon: 'pixel', name: 'Nonogram Solver', desc: 'Rebuild the picture from clues' },
];

// ---- Walkthroughs：已上线的攻略页 ----
const walkthroughs: ToolItem[] = [
  { href: '/arrows-puzzle-walkthrough/', icon: 'book', name: 'Arrows Puzzle Walkthrough', desc: 'Strategy for every level' },
  { href: '/the-loop-past-answers/', icon: 'loop', name: 'The Loop Answers', desc: "Today's answer & past rings" },
  { href: '/block-blast-hints/', icon: 'blocks', name: 'Block Blast Hints', desc: '10+ score strategies' },
  { href: '/meowdoku-guide/', icon: 'book', name: 'Meowdoku Guide', desc: 'Hints & games like it' },
];

// ---- Help：规则页 ----
const helps: ToolItem[] = [
  { href: '/help/shikaku/', icon: 'grid', name: 'Shikaku rules', desc: 'Rectangle partition, step by step' },
  { href: '/help/akari/', icon: 'bulb', name: 'Akari rules', desc: 'Light every cell, no crossfire' },
  { href: '/help/kakuro/', icon: 'sum', name: 'Kakuro rules', desc: 'Cross sums without repeats' },
  { href: '/help/nonogram/', icon: 'pixel', name: 'Nonogram rules', desc: 'Pixel pictures from clues' },
  { href: '/help/nurikabe/', icon: 'island', name: 'Nurikabe rules', desc: 'Islands and sea' },
  { href: '/help/pictomino/', icon: 'blocks', name: 'Pictomino rules', desc: 'Spatial block placement' },
  { href: '/rules/', icon: 'check', name: 'All rule cards', desc: 'Every game at a glance' },
];

// ---- 工具系 SVG（34×34，暖色线稿；与游戏插画图标明确区分）----
const ICONS: Record<string, string> = {
  grid: '<rect x="8.5" y="8.5" width="23" height="23" rx="2.5"/><path d="M8.5 19h23M19 8.5v23"/>',
  bulb: '<circle cx="20" cy="17" r="6"/><path d="M16 24.5h8M17.5 28h5"/><path d="M20 7.5v2M11.5 11l1.5 1.5M28.5 11L27 12.5M7.5 18h2M30.5 18h2"/>',
  bridge: '<circle cx="12" cy="12" r="3.4"/><circle cx="28" cy="12" r="3.4"/><circle cx="12" cy="28" r="3.4"/><circle cx="28" cy="28" r="3.4"/><path d="M15.6 11.4h8.8M15.6 14h8.8"/>',
  cage: '<rect x="8.5" y="8.5" width="23" height="23" rx="2.5"/><path d="M8.5 17h23M17 8.5v23"/><path d="M26.5 21v5M24 23.5h5"/>',
  pixel: '<rect x="9" y="9" width="9.5" height="9.5" rx="2" fill="currentColor" stroke="none"/><rect x="21.5" y="9" width="9.5" height="9.5" rx="2"/><rect x="9" y="21.5" width="9.5" height="9.5" rx="2"/><rect x="21.5" y="21.5" width="9.5" height="9.5" rx="2" fill="currentColor" stroke="none"/>',
  book: '<path d="M8.5 10.5h9a2.5 2.5 0 012.5 2.5v17a2 2 0 00-2-2h-9.5z"/><path d="M31.5 10.5h-9a2.5 2.5 0 00-2.5 2.5v17a2 2 0 012-2h9.5z"/>',
  loop: '<path d="M11 11h18v18H11z" stroke-dasharray="3.2 3.2"/><circle cx="20" cy="20" r="1.8" fill="currentColor" stroke="none"/>',
  blocks: '<rect x="8.5" y="8.5" width="11" height="11" rx="2"/><rect x="21" y="8.5" width="10.5" height="11" rx="2"/><rect x="21" y="21" width="10.5" height="10.5" rx="2" fill="currentColor" stroke="none"/>',
  sum: '<rect x="8.5" y="8.5" width="23" height="23" rx="2.5"/><path d="M13 15h6M13 22h6M24 13v8M20 17h8"/>',
  island: '<rect x="9" y="8.5" width="12" height="9" rx="2"/><path d="M9 25c2.2-2.4 4.3 2.4 6.5 0s4.3 2.4 6.5 0 4.3 2.4 6.5 0"/>',
  check: '<rect x="8.5" y="8.5" width="23" height="23" rx="2.5"/><path d="M13 20l4 4 8-8"/>',
};

const clusterSolvers = solvers;
const clusterWalks = walkthroughs;
const clusterHelps = helps;

function icon(svg: string) {
  return `<svg viewBox="0 0 40 40" width="32" height="32" aria-hidden="true"><rect width="40" height="40" rx="11" fill="var(--gp-tool-bg)"/><g fill="none" stroke="var(--gp-tool-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${svg}</g></svg>`;
}
---

<nav class="gp-tools" aria-label="Puzzle tools">
  <div class="gp-tools-grid">
    <section class="gp-cluster gp-cluster-main">
      <h2 class="gp-cluster-title">Solvers <span>Paste a board, get the answer</span></h2>
      <div class="gp-tool-list gp-tool-list-two">
        {clusterSolvers.map((t) => (
          <a href={t.href} class:list={['gp-tool', t.wide && 'gp-tool-wide']}>
            <Fragment set:html={icon(ICONS[t.icon] ?? ICONS.grid)} />
            <div><b>{t.name}</b><span>{t.desc}</span></div>
          </a>
        ))}
      </div>
    </section>
    <div class="gp-cluster-stack">
      <section class="gp-cluster">
        <h2 class="gp-cluster-title gp-title-walk">Walkthroughs <span>Level by level</span></h2>
        <div class="gp-tool-list">
          {clusterWalks.map((t) => (
            <a href={t.href} class="gp-tool">
              <Fragment set:html={icon(ICONS[t.icon] ?? ICONS.book)} />
              <div><b>{t.name}</b><span>{t.desc}</span></div>
            </a>
          ))}
        </div>
      </section>
      <section class="gp-cluster">
        <h2 class="gp-cluster-title gp-title-help">Help <span>Rules first</span></h2>
        <div class="gp-tool-list">
          {clusterHelps.map((t) => (
            <a href={t.href} class="gp-tool">
              <Fragment set:html={icon(ICONS[t.icon] ?? ICONS.check)} />
              <div><b>{t.name}</b><span>{t.desc}</span></div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</nav>

<style>
  .gp-tools {
    --gp-tool-bg: #FDF0E8;
    --gp-tool-ink: #C4703F;
    max-width: 1120px; /* UI 契约 --w-page：桌面页宽统一 1120（原 1020 自造第 4 种宽度） */
    margin: 1.4rem auto 0;
    padding: 0 1rem;
  }
  .gp-tools-grid {
    display: grid;
    grid-template-columns: 1.62fr 1fr;
    gap: 14px;
    align-items: start;
  }
  .gp-cluster {
    background: linear-gradient(160deg, #FFFCF9, #FDF4EC);
    border: 1px solid #F2E3D6;
    border-radius: 18px;
    padding: 14px 16px 16px;
  }
  .gp-cluster-title {
    font-size: 0.92rem;
    font-weight: 900;
    color: #C4703F;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .gp-cluster-title span {
    font-size: 0.74rem;
    font-weight: 500;
    color: #A99C90;
  }
  .gp-title-walk { color: #A8628C; }
  .gp-title-help { color: #8A7A5E; }
  .gp-tool-list { display: grid; gap: 8px; margin-top: 11px; }
  .gp-tool-list-two { grid-template-columns: 1fr 1fr; }
  /* 入口条横跨两列：Solvers 有 5 项，放 2 列会落单一张 */
  .gp-tool-wide {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, #FFF7F1, #FDEDE2);
    border-color: #F3D5BE;
  }
  .gp-tool {
    display: flex;
    align-items: center;
    gap: 9px;
    background: #fff;
    border: 1px solid #F0E4DA;
    border-radius: 12px;
    padding: 9px 11px;
    text-decoration: none;
    color: #3D3D3D;
    transition: border-color .15s, box-shadow .15s;
  }
  .gp-tool:hover,
  .gp-tool:focus-visible {
    border-color: #E8A888;
    box-shadow: 0 5px 16px rgba(201, 106, 66, 0.13);
  }
  .gp-tool b {
    display: block;
    font-size: 0.82rem;
    font-weight: 750;
    line-height: 1.28;
  }
  .gp-tool span {
    display: block;
    font-size: 0.72rem;
    color: #7E736A;
    line-height: 1.34;
  }
  .gp-cluster-stack { display: grid; gap: 14px; }
  /* 2026-11-19 UI-1: 桌面三列等宽（Solvers / Walkthroughs / Help 各一列）
     此前 1.62fr 1fr 两列 → Solvers 289px、Walkthroughs 182px 不等宽，Help 被挤到第二行右侧空一格 */
  @media (min-width: 1024px) {
    .gp-tools-grid { grid-template-columns: repeat(3, 1fr); }
    .gp-cluster-stack { display: contents; }
    .gp-tool-wide { grid-column: auto; }
  }
  @media (max-width: 860px) {
    .gp-tools-grid { grid-template-columns: 1fr; }
    .gp-tool-list-two { grid-template-columns: 1fr; }
  }
</style>
