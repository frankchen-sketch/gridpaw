---
// BadgeUnlock — 胜利弹层「新徽章」行（设计稿 ④A）：默认全隐藏，gp-badges.js 在
// 新徽章解锁时揭示对应行。11 枚全部 SSR（图标唯一来源 = src/lib/badge-icons.ts），
// 三处 winOverlay（index.astro / murdoku / akari）各插一份，被覆盖的弹层不可见无副作用。
// 自带 <script is:inline src="/gp-badges.js">（文件顶部幂等守卫，重复引入安全）。
import { BADGES } from '../lib/badge-icons';
---

<div class="gp-bu" data-gp-unlock hidden>
  {
    BADGES.map((b) => (
      <div class="gp-bu-row" data-gp-unlock-id={b.id} hidden>
        <span class="gp-bu-ic" set:html={b.svg} />
        <span class="gp-bu-tx">
          <b>Badge earned: {b.name}</b>
          <small>{b.how}</small>
          <a class="gp-bu-signin" data-gp-bu-signin href="/api/auth/login?provider=google" hidden>Sign in to save it forever →</a>
        </span>
      </div>
    ))
  }
</div>

<style>
  .gp-bu {
    display: flex;
    justify-content: center;
    width: 100%;
  }
  .gp-bu[hidden] {
    display: none;
  }
  .gp-bu-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 18px;
    background: #fff;
    border: 1px solid #e7d4b8;
    border-radius: 14px;
    box-shadow: 0 1px 3px rgba(61, 46, 31, 0.08);
  }
  .gp-bu-row[hidden] {
    display: none;
  }
  .gp-bu-ic {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #f7ebd9;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .gp-bu-ic :global(svg) {
    width: 34px;
    height: 34px;
  }
  .gp-bu-tx {
    text-align: left;
    line-height: 1.3;
  }
  .gp-bu-tx b {
    display: block;
    font-size: 14px;
    font-weight: 800;
    color: #3d2e1f;
  }
  .gp-bu-tx small {
    font-size: 12px;
    color: #8a7a62;
  }
  /* 未登录 CTA（guest 徽章只存在本机，登录才能永久保存） */
  .gp-bu-signin {
    display: block;
    margin-top: 6px;
    font-size: 11.5px;
    font-weight: 800;
    color: #b45309;
    background: #fdf3e3;
    border: 1px solid #e7d4b8;
    border-radius: 999px;
    padding: 4px 11px;
    text-decoration: none;
    text-align: center;
  }
  .gp-bu-signin[hidden] { display: none; }
  .gp-bu-signin:hover { background: #fbe7c9; color: #92400e; border-color: #d9b98a; }
</style>

<script is:inline>
  // 未登录才露出「Sign in to save it forever」；登录态整块不渲染（避免死点击）
  (function () {
    if (window.__gpBuSignin) return;
    window.__gpBuSignin = true;
    function apply(loggedIn) {
      var nodes = document.querySelectorAll('[data-gp-bu-signin]');
      for (var i = 0; i < nodes.length; i++) {
        var a = nodes[i];
        if (loggedIn) { a.setAttribute('hidden', ''); continue; }
        a.href = '/api/auth/login?provider=google&next=' + encodeURIComponent(location.pathname);
        a.removeAttribute('hidden');
      }
    }
    try {
      fetch('/api/auth/me', { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) { apply(!!(d && d.user)); })
        .catch(function () { /* 不显示按钮胜过显示死链 */ });
    } catch (e) { /* 静默 */ }
  })();
</script>
<script is:inline src="/gp-badges.js"></script>
