---
// Reusable SEO head component for all game sites
// Usage: <SEOHead title="..." description="..." canonical="/play" />
// Auto-generates Article + BreadcrumbList JSON-LD for article pages
// Requires site-config.ts in src/lib/ with ga4Id, clarityId, domain, brandName

import { siteConfig } from '../lib/site-config';
const { ga4Id, clarityId, posthogKey, domain, brandName } = siteConfig;

export interface Props {
  title: string;
  description: string;
  canonical: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  breadcrumbTitle?: string; // Override breadcrumb label (defaults to page title)
}

const {
  title,
  description,
  canonical,
  type = 'website',
  image = '/og-default.png',
  noindex = false,
  breadcrumbTitle,
} = Astro.props;

// Normalize: ensure trailing slash (match sitemap convention)
const normalizedCanonical = canonical === '/' ? '/' : (canonical.endsWith('/') ? canonical : `${canonical}/`);
const fullUrl = `https://${domain}${normalizedCanonical}`;
const fullTitle = canonical === '/' ? title : (title.includes(brandName) ? title : `${title} | ${brandName}`);

// Build BreadcrumbList from canonical path
const pathParts = normalizedCanonical.split('/').filter(Boolean);
const breadcrumbs = [
  { name: 'Home', url: `https://${domain}/` },
  ...pathParts.map((part, i) => {
    const url = `https://${domain}/` + pathParts.slice(0, i + 1).join('/') + '/';
    // Derive readable name from slug
    const name = part
      .replace(/^puzzle-/, 'Puzzle #')
      .replace(/-/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase());
    return { name, url };
  })
];

// Use breadcrumbTitle for the last crumb if provided
if (breadcrumbTitle && breadcrumbs.length > 1) {
  breadcrumbs[breadcrumbs.length - 1].name = breadcrumbTitle;
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
};

const articleJsonLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title.replace(new RegExp(` \\| ${brandName}$`), ''),
  description,
  url: fullUrl,
  image: `https://${domain}${image}`,
  author: { '@type': 'Organization', name: brandName, url: `https://${domain}/` },
  publisher: { '@type': 'Organization', name: brandName, url: `https://${domain}/` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': fullUrl },
} : null;
---

<!-- Primary Meta -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={fullUrl}>
{noindex && <meta name="robots" content="noindex">}

<!-- Open Graph -->
<meta property="og:type" content={type}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={fullUrl}>
<meta property="og:image" content={`https://${domain}${image}`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${brandName} — Free Puzzle Game`}>
<meta property="og:site_name" content={brandName}>
<meta property="og:locale" content="en_US">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`https://${domain}${image}`}>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#d97706">

<!-- Preconnect for performance -->
<link rel="preconnect" href={`https://${domain}`}>

<!-- llms.txt reference -->
<link rel="alternate" type="text/plain" href="/llms.txt" title="AI-friendly site map">

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
{articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}

<!-- Grow by Mediavine（Journey 前置：须先跑满 30 天才能申请评估）。
     与 GA4 同口径：非生产域名静默，避免预览/自测污染 Grow 端数据。 -->
<script is:inline data-grow-initializer="">
  (function () {
    if (!/(^|\.)gridpaw\.com$/.test(location.hostname)) return;
    !(function () {
      window.growMe || ((window.growMe = function (e) { window.growMe._.push(e); }), (window.growMe._ = []));
      var e = document.createElement('script');
      (e.type = 'text/javascript'), (e.src = 'https://faves.grow.me/main.js'), (e.defer = !0);
      e.setAttribute('data-grow-faves-site-id', 'U2l0ZTo4ODRiNzc0NC00NWU4LTQzMTctYTQ5Ny0zZTNlNjk4NzBiMzY=');
      var t = document.getElementsByTagName('script')[0];
      t.parentNode.insertBefore(e, t);
    })();
  })();
</script>

<!-- Analytics (GA4 + Clarity + PostHog) — 只有生产域名上报，dev/预览域静默 -->
<script define:vars={{ ga4Id, clarityId, posthogKey }}>
  (function () {
    // 口径铁律：只有 gridpaw.com / www.gridpaw.com 上报。
    // localhost、127.0.0.1、局域网 IP、*.pages.dev 预览域一律静默 ——
    // 否则自测与预览流量会混进 GA4（2026-09 实测污染约 9%，见 STATUS.md §一）。
    if (!/(^|\.)gridpaw\.com$/.test(location.hostname)) {
      // 保留同名 no-op，页面里的 track() / gtag() / clarity() 调用不会抛错
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {};
      window.clarity = function () {};
      window.posthog = { capture: function () {}, init: function () {} };
      return;
    }

    // Google Analytics 4
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date());
    gtag('config', ga4Id);
    var g = document.createElement('script');
    g.async = true;
    g.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
    document.head.appendChild(g);

    // Microsoft Clarity
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', clarityId);

    // PostHog (quota-friendly: autocapture off, session recording off, anonymous pageview-only)
    // posthogKey 为空 = 未启用，直接跳过（避免无意义加载 CDN 脚本）
    if (!posthogKey) return;
    (function (key) {
      var ph = window.posthog = window.posthog || [];
      if (ph.__SV) return;
      ph._i = ph._i || [];
      ph.init = function () { ph._i.push([].slice.call(arguments)); };
      ['capture','identify','alias','reset','register','unregister','people.set'].forEach(function (fn) {
        ph[fn] = function () { ph.push([fn].concat([].slice.call(arguments))); };
      });
      ph.init(key, {
        api_host: 'https://us.i.posthog.com',
        autocapture: false,
        capture_pageview: true,
        disable_session_recording: true,
        person_profiles: 'identified_only'
      });
      var s = document.createElement('script');
      s.async = true;
      s.crossOrigin = 'anonymous';
      s.src = 'https://us-assets.i.posthog.com/static/array.js';
      document.head.appendChild(s);
    })(posthogKey);
  })();
</script>

<!-- ⚠ gpTrack 先行 stub（2026-10-16 统一标准，事故背景见 game-event-tracking skill）：
     module 晚于所有内联脚本执行，内联脚本解析期发的事件（如首盘 game_start）会拿不到 gpTrack。
     此 stub 在 head 解析期就位、把调用缓冲进 __gpq；下方 module 就位后冲洗重放，事件不丢。
     顺序保证：冲洗在 trackVisit 之前，保持时间线。 -->
<script is:inline>
  window.__gpq = window.__gpq || [];
  if (typeof window.gpTrack !== 'function') {
    window.gpTrack = function (e, p) { window.__gpq.push([e, p]); };
  }
</script>

<!-- 自建漏斗（GRIDPAW-FUNNEL-VERSIONING.md §3.4）：Vite 打包脚本（非 is:inline），
     import 正常走 bundler，build id 从构建期生成文件 src/lib/app-build.generated.ts 读。
     dev/预览域在 trackVisit/trackFunnel 内部静默，与上面 GA4 守卫同口径。 -->
<script>
  import { trackFunnel, trackVisit } from '../lib/funnel-track';
  window.gpTrack = trackFunnel;
  if (window.__gpq && window.__gpq.length) {
    var __q = window.__gpq.splice(0);
    for (var __i = 0; __i < __q.length; __i++) trackFunnel(__q[__i][0], __q[__i][1] || {});
  }
  trackVisit(location.pathname);
</script>
<script is:inline src="/hof-banner.js"></script>
