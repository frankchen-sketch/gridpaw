---
// Reusable SEO head component for all game sites
// Usage: <SEOHead title="..." description="..." canonical="/play" />
// Auto-generates Article + BreadcrumbList JSON-LD for article pages
// Requires site-config.ts in src/lib/ with ga4Id, clarityId, domain, brandName

import { siteConfig } from '../lib/site-config';
import { ADSENSE_CLIENT, ADSENSE_LOADER } from '../lib/adsense';
import { loaderAllowed } from '../lib/ad-policy';
const { ga4Id, clarityId, posthogKey, domain, brandName, umamiId, umamiSrc, pvuvSite } = siteConfig;

// play surface（棋盘页/解题器/单关页）与永久零广告页连 adsbygoogle.js 都不加载 ——
// 自动广告因此物理上到不了这些页，不用去 AdSense 后台维护第二份排除清单。
const ADSENSE_LOADER_ALLOWED = ADSENSE_LOADER && loaderAllowed(Astro.url.pathname);

export interface Props {
  title: string;
  description: string;
  canonical: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  breadcrumbTitle?: string; // Override breadcrumb label (defaults to page title)
  locale?: string; // og:locale (default en_US)
  homeName?: string; // breadcrumb root label (default Home)
  segmentNames?: Record<string, string>; // override derived crumb names per path segment
}

const {
  title,
  description,
  canonical,
  type = 'website',
  image = '/og-default.png',
  noindex = false,
  breadcrumbTitle,
  locale = 'en_US',
  homeName = 'Home',
  segmentNames = {},
} = Astro.props;

// Normalize: ensure trailing slash (match sitemap convention)
const normalizedCanonical = canonical === '/' ? '/' : (canonical.endsWith('/') ? canonical : `${canonical}/`);
const fullUrl = `https://${domain}${normalizedCanonical}`;
const fullTitle = canonical === '/' ? title : (title.includes(brandName) ? title : `${title} | ${brandName}`);

// Build BreadcrumbList from canonical path
const pathParts = normalizedCanonical.split('/').filter(Boolean);
const breadcrumbs = [
  { name: homeName, url: `https://${domain}/` },
  ...pathParts.map((part, i) => {
    const url = `https://${domain}/` + pathParts.slice(0, i + 1).join('/') + '/';
    // Derive readable name from slug (segmentNames overrides for locale paths)
    const name = segmentNames[part] ?? part
      .replace(/^puzzle-/, 'Puzzle #')
      .replace(/-/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase());
    return { name, url };
  })
];

// Use breadcrumbTitle for the last crumb if provided
if (breadcrumbTitle && breadcrumbs.length > 1) {
  breadcrumbs[breadcrumbs.length - 1].name = breadcrumbTitle;
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
};

const articleJsonLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title.replace(new RegExp(` \\| ${brandName}$`), ''),
  description,
  url: fullUrl,
  image: `https://${domain}${image}`,
  author: { '@type': 'Organization', name: brandName, url: `https://${domain}/` },
  publisher: { '@type': 'Organization', name: brandName, url: `https://${domain}/` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': fullUrl },
} : null;
---

<!-- Primary Meta -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={fullUrl}>
<link rel="alternate" type="application/rss+xml" title="GridPaw Blog" href="/rss.xml">
{noindex && <meta name="robots" content="noindex">}

<!-- Open Graph -->
<meta property="og:type" content={type}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={fullUrl}>
<meta property="og:image" content={`https://${domain}${image}`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${brandName} — Free Puzzle Game`}>
<meta property="og:site_name" content={brandName}>
<meta property="og:locale" content={locale}>

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`https://${domain}${image}`}>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#d97706">

<!-- Preconnect for performance -->
<link rel="preconnect" href={`https://${domain}`}>

<!-- llms.txt reference -->
<link rel="alternate" type="text/plain" href="/llms.txt" title="AI-friendly site map">

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
{articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}

<!-- Grow by Mediavine（Journey 前置：须先跑满 30 天才能申请评估）。
     与 GA4 同口径：非生产域名静默，避免预览/自测污染 Grow 端数据。 -->
<script is:inline data-grow-initializer="">
  // oxlint-disable no-unused-expressions -- Mediavine Grow 官方初始化片段，原样粘贴以免偏离上游
  (function () {
    if (!/(^|\.)gridpaw\.com$/.test(location.hostname)) return;
    !(function () {
      window.growMe || ((window.growMe = function (e) { window.growMe._.push(e); }), (window.growMe._ = []));
      var e = document.createElement('script');
      (e.type = 'text/javascript'), (e.src = 'https://faves.grow.me/main.js'), (e.defer = !0);
      e.setAttribute('data-grow-faves-site-id', 'U2l0ZTo4ODRiNzc0NC00NWU4LTQzMTctYTQ5Ny0zZTNlNjk4NzBiMzY=');
      var t = document.getElementsByTagName('script')[0];
      t.parentNode.insertBefore(e, t);
    })();
  })();
</script>

<!-- Google AdSense（2026-11-20 复审通过，client ca-pub-5225990079437405）
     三道闸，缺一不可：
     ① ADSENSE_LOADER（src/lib/adsense.ts）：开了自动广告或任一手动位有 unit id 才注入；
     ② loaderAllowed()（src/lib/ad-policy.ts）：play surface 与永久零广告页**连脚本都不加载**——
        自动广告因此物理上到不了棋盘页，不必再去后台维护第二份「排除的网页」清单；
     ③ 运行时 hostname 门：只有 gridpaw.com / www 才真正插入脚本，
        localhost 与 *.pages.dev 预览域不加载（避免自测/预览流量进 AdSense 的无效流量判定）。
     后台口径：自动广告只留页内横幅（上限 6 / 间距 1000px），重叠式与意向驱动全关。 -->
{ADSENSE_LOADER_ALLOWED && (
<script define:vars={{ adsenseClient: ADSENSE_CLIENT }}>
  (function () {
    if (!/(^|\.)gridpaw\.com$/.test(location.hostname)) return;
    var s = document.createElement('script');
    s.async = true;
    s.crossOrigin = 'anonymous';
    s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + adsenseClient;
    document.head.appendChild(s);
  })();
</script>
)}

<!-- Analytics (GA4 + Clarity + PostHog) — 只有生产域名上报，dev/预览域静默 -->
<script define:vars={{ ga4Id, clarityId, posthogKey, umamiId, umamiSrc, pvuvSite }}>
  (function () {
    // 口径铁律：只有 gridpaw.com / www.gridpaw.com 上报。
    // localhost、127.0.0.1、局域网 IP、*.pages.dev 预览域一律静默 ——
    // 否则自测与预览流量会混进 GA4（2026-09 实测污染约 9%，见 STATUS.md §一）。
    if (!/(^|\.)gridpaw\.com$/.test(location.hostname)) {
      // 保留同名 no-op，页面里的 track() / gtag() / clarity() 调用不会抛错
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {};
      window.clarity = function () {};
      window.posthog = { capture: function () {}, init: function () {} };
      return;
    }

    // Google Analytics 4
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date());
    gtag('config', ga4Id);
    var g = document.createElement('script');
    g.async = true;
    g.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
    document.head.appendChild(g);

    // Microsoft Clarity
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', clarityId);

    // pvuv.ai（2026-11-18 起，接手 Umami）：真人访问 + bot/爬虫分层。
    // 口径真源：~/workspace/research/2026-11-18-data-caliber-and-human-detection.md
    if (pvuvSite) {
      var pv = document.createElement('script');
      pv.defer = true;
      pv.src = 'https://www.pvuv.ai/f.js';
      pv.setAttribute('data-api', 'https://in.pvuv.ai');
      pv.setAttribute('data-site', pvuvSite);
      document.head.appendChild(pv);
    }

    // PostHog (quota-friendly: autocapture off, session recording off, anonymous pageview-only)
    // posthogKey 为空 = 未启用，直接跳过（避免无意义加载 CDN 脚本）
    if (!posthogKey) return;
    (function (key) {
      var ph = window.posthog = window.posthog || [];
      if (ph.__SV) return;
      ph._i = ph._i || [];
      ph.init = function () { ph._i.push([].slice.call(arguments)); };
      ['capture','identify','alias','reset','register','unregister','people.set'].forEach(function (fn) {
        ph[fn] = function () { ph.push([fn].concat([].slice.call(arguments))); };
      });
      ph.init(key, {
        api_host: 'https://us.i.posthog.com',
        autocapture: false,
        capture_pageview: true,
        disable_session_recording: true,
        person_profiles: 'identified_only'
      });
      var s = document.createElement('script');
      s.async = true;
      s.crossOrigin = 'anonymous';
      s.src = 'https://us-assets.i.posthog.com/static/array.js';
      document.head.appendChild(s);
    })(posthogKey);
  })();
</script>

<!-- ⚠ gpTrack 先行 stub（2026-10-16 统一标准，事故背景见 game-event-tracking skill）：
     module 晚于所有内联脚本执行，内联脚本解析期发的事件（如首盘 game_start）会拿不到 gpTrack。
     此 stub 在 head 解析期就位、把调用缓冲进 __gpq；下方 module 就位后冲洗重放，事件不丢。
     顺序保证：冲洗在 trackVisit 之前，保持时间线。 -->
<script is:inline>
  window.__gpq = window.__gpq || [];
  if (typeof window.gpTrack !== 'function') {
    window.gpTrack = function (e, p) { window.__gpq.push([e, p]); };
  }
</script>

<!-- 自建漏斗（GRIDPAW-FUNNEL-VERSIONING.md §3.4）：Vite 打包脚本（非 is:inline），
     import 正常走 bundler，build id 从构建期生成文件 src/lib/app-build.generated.ts 读。
     dev/预览域在 trackVisit/trackFunnel 内部静默，与上面 GA4 守卫同口径。 -->
<script>
  import { trackFunnel, trackVisit } from '../lib/funnel-track';
  window.gpTrack = trackFunnel;
  if (window.__gpq && window.__gpq.length) {
    var __q = window.__gpq.splice(0);
    for (var __i = 0; __i < __q.length; __i++) trackFunnel(__q[__i][0], __q[__i][1] || {});
  }
  trackVisit(location.pathname);
</script>
<!-- YouTube click-to-load facade（2026-11-18 性能修复，实测省 7.2s/页）
     背景：324 个攻略页各嵌一个 YouTube iframe，实测 load 9,462ms 里 7,260ms 是 YouTube
     （iframe 拉起的 Mediavine/Reco/Snowplow 等 30+ 第三方请求）。改成缩略图 + 点击才载 iframe。
     用法：<div class="yt-facade" data-yt="VIDEO_ID" data-title="标题"><img ...></div>
     约束：缩略图走 i.ytimg.com（YouTube CDN），必须 loading="lazy" + 显式宽高（防 CLS）。 -->
<style is:global>
  .yt-facade {
    position: relative; display: block; width: 100%; aspect-ratio: 16 / 9;
    background: #0b0b0f; overflow: hidden; border-radius: 12px; cursor: pointer;
    border: 0; padding: 0; margin: 0; text-align: inherit;
  }
  .video-wrap .yt-facade { height: 100%; aspect-ratio: auto; }
  .yt-facade img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: 0.88; transition: opacity 0.15s; }
  .yt-facade:hover img, .yt-facade:focus-visible img { opacity: 1; }
  .yt-facade::after {
    content: ""; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 68px; height: 48px; border-radius: 12px; background-color: rgba(0,0,0,0.72);
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 68 48'%3E%3Cpath fill='%23fff' d='M26 34V14l18 10z'/%3E%3C/svg%3E");
    background-repeat: no-repeat; background-position: center; background-size: contain;
    pointer-events: none;
  }
  .yt-facade:hover::after, .yt-facade:focus-visible::after { background-color: #d33; }
  .yt-facade iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: 12px; }
  .yt-facade.is-loaded::after { display: none; }
</style>
<script>
  // 事件委托：一次绑定覆盖全站 all facade
  (function () {
    function load(el) {
      if (!el || el.dataset.loaded) return;
      var id = el.getAttribute('data-yt');
      if (!id) return;
      el.dataset.loaded = '1';
      el.classList.add('is-loaded');
      var ifr = document.createElement('iframe');
      ifr.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
      ifr.title = el.getAttribute('data-title') || 'Video walkthrough';
      ifr.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
      ifr.setAttribute('allowfullscreen', '');
      ifr.setAttribute('frameborder', '0');
      el.replaceChildren(ifr);
    }
    document.addEventListener('click', function (e) {
      var el = e.target && e.target.closest ? e.target.closest('.yt-facade') : null;
      if (el) load(el);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      var el = e.target;
      if (el && el.classList && el.classList.contains('yt-facade')) { e.preventDefault(); load(el); }
    });
  })();
</script>

<script is:inline src="/hof-banner.js"></script><!--
  攻略页截图点开放大（2026-11-22，法老拍板「全站统一」；source: ops #3176 的 dead click）
  背景：rooms-and-exits / de / rotate-rings 这些攻略页把游戏截图直接写成 <img>，
  玩家点图想放大读游戏里的小字，什么也不发生 → Clarity 记成 dead click。
  这里是唯一实现：点正文大图 → 全屏看图（原图比屏幕大时先按 1:1 像素铺开可拖动，
  再点一下切「整图」）；Esc / 点 × 关闭（整图模式下点图外空白也关）。
  不接管：?embed=1 与 iframe 内（嵌入页）、视频缩略图（自带播放）、广告容器、
  按钮里的图、href 指向别处的链接图（那种图本来就该跳转，不是死点击）。
  已知未覆盖：hero 图被包成 <a href="#video">（brain-puzzle-3-* / rotate-rings 的
  「跳到视频」锚点图）——那些图本来就能点，不抢它的跳转。
-->
<style is:global>
  html.gp-zoom-open, html.gp-zoom-open body { overflow: hidden; }
  .gp-zoom { position: fixed; inset: 0; z-index: 2147483200; display: block; background: #0e0b08; overflow: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; }
  .gp-zoom[hidden] { display: none !important; }
  .gp-zoom img { display: block; margin: 0 auto; width: auto; height: auto; max-width: none; max-height: none; cursor: zoom-out; background: #fff; }
  .gp-zoom.is-fit { display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .gp-zoom.is-fit img { max-width: 100%; max-height: 100%; cursor: zoom-in; }
  .gp-zoom-close { position: fixed; top: 8px; right: 8px; width: 42px; height: 42px; border: 0; border-radius: 50%; background: rgba(255,255,255,.2); color: #fff; font: 400 26px/1 system-ui, sans-serif; cursor: pointer; }
  .gp-zoom-close:hover, .gp-zoom-close:focus-visible { background: rgba(255,255,255,.34); }
</style>
<script>
  (function () {
    var MIN_SIDE = 600;                       // 自然尺寸任一边 ≥600 才算「大图」（logo/图标不动）
    var IMG_HREF = /\.(jpe?g|png|webp|gif|avif)(\?|#|$)/i;
    var overlay = null, opener = null, isFit = false;

    function embedded() {
      try { if (window.self !== window.top) return true; } catch (e) { return true; }
      return /[?&]embed=1/.test(location.search);
    }
    function eligible(img) {
      if (!img || !img.getAttribute('src')) return false;
      if (!img.closest('main')) return false;
      if (img.closest('.yt-facade,[role="button"],button,ins,iframe,[data-no-zoom]')) return false;
      if (img.closest('[class*="adsbygoogle"],[class*="gp-incontent-ad"]')) return false;
      var w = img.naturalWidth || 0, h = img.naturalHeight || 0;
      var rw = img.getBoundingClientRect().width || 0;
      if (rw < 220) return false;             // 屏幕上就很小（logo/图标/缩略图）不动
      if (w && h) return Math.max(w, h) >= MIN_SIDE;
      // lazy 图刚滚进视口、还没解码完时 naturalWidth 是 0：按屏幕上占的宽度判断
      return rw >= 260;
    }
    function build() {
      if (overlay) return overlay;
      overlay = document.createElement('div');
      overlay.className = 'gp-zoom';
      overlay.hidden = true;
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      var pic = document.createElement('img');
      pic.alt = '';
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'gp-zoom-close';
      btn.setAttribute('aria-label', 'Close');
      btn.textContent = '\u00D7';
      overlay.appendChild(pic);
      overlay.appendChild(btn);
      overlay.addEventListener('click', function (e) {
        if (e.target === pic) { toggleFit(); return; }
        close();
      });
      document.body.appendChild(overlay);
      return overlay;
    }
    function applyMode() {
      var pic = overlay.querySelector('img');
      var iw = pic.naturalWidth || 0, ih = pic.naturalHeight || 0;
      isFit = iw > 0 && iw <= window.innerWidth + 4 && ih <= window.innerHeight + 4;
      overlay.classList.toggle('is-fit', isFit);
    }
    function toggleFit() {
      isFit = !isFit;
      overlay.classList.toggle('is-fit', isFit);
    }
    function open(img) {
      build();
      var pic = overlay.querySelector('img');
      var src = img.currentSrc || img.src;
      pic.alt = img.alt || '';
      overlay.setAttribute('aria-label', img.alt || 'Screenshot');
      opener = img.closest('a') || img;
      overlay.hidden = false;
      document.documentElement.classList.add('gp-zoom-open');
      if (pic.getAttribute('src') !== src) { pic.onload = applyMode; pic.src = src; }
      // 原图本来就装得下 → 整图；比屏幕大 → 1:1（手机上是唯一能读清游戏里小字的方式）。
      // 图还没解码完（lazy）时先按 1:1 挂着，解码完 applyMode 再校正。
      applyMode();
      var btn = overlay.querySelector('.gp-zoom-close');
      try { btn.focus({ preventScroll: true }); } catch (e) { /* 老浏览器 */ }
    }
    function close() {
      if (!overlay || overlay.hidden) return;
      overlay.hidden = true;
      overlay.classList.remove('is-fit');
      document.documentElement.classList.remove('gp-zoom-open');
      overlay.querySelector('img').removeAttribute('src');
      if (opener && opener.focus) { try { opener.focus({ preventScroll: true }); } catch (e) {} }
      opener = null;
    }
    document.addEventListener('click', function (e) {
      if (embedded()) return;
      if (overlay && !overlay.hidden) return;            // 覆盖层内部自己处理
      var img = e.target && e.target.closest ? e.target.closest('img') : null;
      if (!img || !eligible(img)) return;
      var a = img.closest('a');
      if (a && !IMG_HREF.test(a.getAttribute('href') || '')) return;  // 指向别处的图照旧跳转
      if (a) e.preventDefault();
      open(img);
    }, true);
    document.addEventListener('keydown', function (e) {
      if (overlay && !overlay.hidden && (e.key === 'Escape' || e.key === 'Esc')) { e.preventDefault(); close(); }
    });
  })();
</script>

<!-- Service Worker registration (PWA: offline daily + install prompt). Prod-HTTPS only;
     skips localhost / *.pages.dev / ?embed=1. sw_registered fires once per browser (GA4-only). -->
<script is:inline>
  (function () {
    if (location.protocol !== 'https:' && location.hostname !== 'localhost') return;
    if (/(^|\.)pages\.dev$/.test(location.hostname)) return;
    if (location.hostname === '127.0.0.1') return;
    if (new URLSearchParams(location.search).get('embed')) return;
    if (!('serviceWorker' in navigator)) return;
    window.addEventListener('load', function () {
      navigator.serviceWorker.register('/sw.js').then(function () {
        try {
          if (!localStorage.getItem('gp_sw_registered')) {
            localStorage.setItem('gp_sw_registered', '1');
            if (typeof window.gtag === 'function') window.gtag('event', 'sw_registered');
            if (window.gpTrack) window.gpTrack('sw_registered', {});
          }
        } catch (e) {}
      }).catch(function () {});
    });
  })();
</script>
<script is:inline src="/gp-install.js" defer></script>
