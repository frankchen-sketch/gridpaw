---
// Reusable SEO head component for all game sites
// Usage: <SEOHead title="..." description="..." canonical="/play" />
// Auto-generates Article + BreadcrumbList JSON-LD for article pages
// Requires site-config.ts in src/lib/ with ga4Id, clarityId, domain, brandName

import { siteConfig } from '../lib/site-config';
const { ga4Id, clarityId, posthogKey, domain, brandName } = siteConfig;

export interface Props {
  title: string;
  description: string;
  canonical: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  breadcrumbTitle?: string; // Override breadcrumb label (defaults to page title)
}

const {
  title,
  description,
  canonical,
  type = 'website',
  image = '/og-default.png',
  noindex = false,
  breadcrumbTitle,
} = Astro.props;

// Normalize: ensure trailing slash (match sitemap convention)
const normalizedCanonical = canonical === '/' ? '/' : (canonical.endsWith('/') ? canonical : `${canonical}/`);
const fullUrl = `https://${domain}${normalizedCanonical}`;
const fullTitle = canonical === '/' ? title : (title.includes(brandName) ? title : `${title} | ${brandName}`);

// Build BreadcrumbList from canonical path
const pathParts = normalizedCanonical.split('/').filter(Boolean);
const breadcrumbs = [
  { name: 'Home', url: `https://${domain}/` },
  ...pathParts.map((part, i) => {
    const url = `https://${domain}/` + pathParts.slice(0, i + 1).join('/') + '/';
    // Derive readable name from slug
    const name = part
      .replace(/^puzzle-/, 'Puzzle #')
      .replace(/-/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase());
    return { name, url };
  })
];

// Use breadcrumbTitle for the last crumb if provided
if (breadcrumbTitle && breadcrumbs.length > 1) {
  breadcrumbs[breadcrumbs.length - 1].name = breadcrumbTitle;
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
};

const articleJsonLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title.replace(new RegExp(` \\| ${brandName}$`), ''),
  description,
  url: fullUrl,
  image: `https://${domain}${image}`,
  author: { '@type': 'Organization', name: brandName, url: `https://${domain}/` },
  publisher: { '@type': 'Organization', name: brandName, url: `https://${domain}/` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': fullUrl },
} : null;
---

<!-- Primary Meta -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={fullUrl}>
{noindex && <meta name="robots" content="noindex">}

<!-- Open Graph -->
<meta property="og:type" content={type}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={fullUrl}>
<meta property="og:image" content={`https://${domain}${image}`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${brandName} — Free Puzzle Game`}>
<meta property="og:site_name" content={brandName}>
<meta property="og:locale" content="en_US">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`https://${domain}${image}`}>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<!-- Preconnect for performance -->
<link rel="preconnect" href={`https://${domain}`}>

<!-- llms.txt reference -->
<link rel="alternate" type="text/plain" href="/llms.txt" title="AI-friendly site map">

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
{articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}

<!-- Analytics (GA4 + Clarity + PostHog) — 只有生产域名上报，dev/预览域静默 -->
<script define:vars={{ ga4Id, clarityId, posthogKey }}>
  (function () {
    // 口径铁律：只有 gridpaw.com / www.gridpaw.com 上报。
    // localhost、127.0.0.1、局域网 IP、*.pages.dev 预览域一律静默 ——
    // 否则自测与预览流量会混进 GA4（2026-09 实测污染约 9%，见 STATUS.md §一）。
    if (!/(^|\.)gridpaw\.com$/.test(location.hostname)) {
      // 保留同名 no-op，页面里的 track() / gtag() / clarity() 调用不会抛错
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {};
      window.clarity = function () {};
      window.posthog = { capture: function () {}, init: function () {} };
      return;
    }

    // Google Analytics 4
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date());
    gtag('config', ga4Id);
    var g = document.createElement('script');
    g.async = true;
    g.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
    document.head.appendChild(g);

    // Microsoft Clarity
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', clarityId);

    // PostHog (quota-friendly: autocapture off, session recording off, anonymous pageview-only)
    // posthogKey 为空 = 未启用，直接跳过（避免无意义加载 CDN 脚本）
    if (!posthogKey) return;
    (function (key) {
      var ph = window.posthog = window.posthog || [];
      if (ph.__SV) return;
      ph._i = ph._i || [];
      ph.init = function () { ph._i.push([].slice.call(arguments)); };
      ['capture','identify','alias','reset','register','unregister','people.set'].forEach(function (fn) {
        ph[fn] = function () { ph.push([fn].concat([].slice.call(arguments))); };
      });
      ph.init(key, {
        api_host: 'https://us.i.posthog.com',
        autocapture: false,
        capture_pageview: true,
        disable_session_recording: true,
        person_profiles: 'identified_only'
      });
      var s = document.createElement('script');
      s.async = true;
      s.crossOrigin = 'anonymous';
      s.src = 'https://us-assets.i.posthog.com/static/array.js';
      document.head.appendChild(s);
    })(posthogKey);
  })();
</script>
