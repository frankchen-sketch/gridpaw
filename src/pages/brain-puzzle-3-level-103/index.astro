const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is the answer to Brain Puzzle 3 Level 103?", "acceptedAnswer": {"@type": "Answer", "text": "In order: 1) Couple in wedding dresses choose to divorce; 2) Quarreling couple choose to get married; 3) Short-haired couple choose to divorce; 4) Couple in yellow dress choose to get married; 5) Otaku chooses to divorce; 6) Two children choose to get married; 7) Woman holding a dog divorces or marries; 8) White puppy chooses to marry or divorce; 9) Couple in wedding dresses choose to get married; 10) Quarreling couple choose to divorce; 11) Tap the passport in hand; 12) Short-haired couple choose to get married; 13) Swipe down the hair of the person in yellow dress; 14) Couple in yellow dress choose to divorce; 15) Drag the magic wand to the otaku; 16) Otaku chooses to get married; 17) Two children choose to divorce; 18) Drag the hammer to the woman holding a dog; 19) Tap the speaker in the upper right corner when the white puppy is present"}}, {"@type": "Question", "name": "Why does nothing happen when I tap in Level 103?", "acceptedAnswer": {"@type": "Answer", "text": "Level 103 mixes gestures: 2 drags, 2 taps, 1 swipes. Only the tap steps answer a single tap; the rest are drags or swipes. If a tap does nothing, try dragging the object onto the person or thing it belongs to."}}, {"@type": "Question", "name": "My Level 103 looks different from this page. Why?", "acceptedAnswer": {"@type": "Answer", "text": "Brain Puzzle 3 does not show every player the same scene at the same number, and both variants are on record. This page leads with “Guide”. If your game shows “Alley Danger” at level 103, use the second walkthrough on this page."}}]};
