    function applyCloudProgress(cloud) {
      // 用云端数据覆盖 UI 与 localStorage（服务端已合并，云端即真源）
      // 注意：云端 bestTime 单位是毫秒，localStorage bestTime 单位是秒
      if (!cloud) return;
      const local = loadState();
      const st = {
        date: getToday(),
        streak: cloud.streak || 0,
        bestStreak: cloud.bestStreak || 0,
        bestTime: (cloud.bestTime != null && cloud.bestTime <= 7200000) ? Math.round(cloud.bestTime / 1000) : null,
        solved: !!(local && local.solved),
        lastPlayedDate: cloud.lastSolvedDate || (local && local.lastPlayedDate) || null
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(st));
      updateStreakDisplay();
    }
    async function syncCloudOnLoad() {
      try {
        const meRes = await fetchWithTimeout('/api/auth/me');
        const me = await meRes.json();
        currentUser = me && me.user ? me.user : null;
        renderAccountArea();
        if (!currentUser) return;
        const cloudRes = await fetchWithTimeout('/api/progress');
        if (!cloudRes.ok) return;
        const cloudData = await cloudRes.json();
        const cloud = cloudData.progress;
        const local = loadState();
        const localBestSec = local && local.bestTime != null ? local.bestTime : null;
        const cloudBestMs = cloud && cloud.bestTime != null ? cloud.bestTime : null;
        const localHasMore = local && (!cloud ||
          (local.streak || 0) > (cloud.streak || 0) ||
          (local.bestStreak || 0) > (cloud.bestStreak || 0) ||
          (localBestSec != null && localBestSec * 1000 < (cloudBestMs ?? Infinity)));
        if (localHasMore) {
          // 本地领先 → 上传，服务端合并后以响应为准
          const post = await fetchWithTimeout('/api/progress', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              date: (local && (local.lastPlayedDate || local.date)) || null,
              streak: local.streak || 0,
              bestStreak: local.bestStreak || 0,
              bestTime: (local && local.bestTime != null) ? local.bestTime * 1000 : null
            })
          });
          if (post.ok) {
            const merged = (await post.json()).progress;
            applyCloudProgress(merged);
          }
        } else if (cloud) {
          applyCloudProgress(cloud);
        }
      } catch (e) { /* 静默降级：纯本地模式 */ }
    }
    async function syncWinToCloud(state, elapsedSeconds) {
      if (!currentUser) return;
      try {
        await fetchWithTimeout('/api/progress', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            date: getToday(),
            streak: state.streak || 0,
            bestStreak: state.bestStreak || 0,
            bestTime: (state.bestTime != null) ? state.bestTime * 1000 : null
          })
        });
        await fetchWithTimeout('/api/leaderboard', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ date: getToday(), timeMs: Math.round(elapsedSeconds * 1000) })
        });
        renderLeaderboard();
      } catch (e) { /* 静默 */ }
    }
    async function renderLeaderboard() {
      const list = document.getElementById('leaderboard-list');
      if (!list) return;
      try {
        const res = await fetchWithTimeout('/api/leaderboard?date=' + getToday());
        if (!res.ok) return;
        const data = await res.json();
        const entries = data.entries || [];
        if (!entries.length) {
          list.innerHTML = '<p style="text-align:center;font-size:.85rem;color:#9b726c;padding:.5rem 0">🐾 Be the first cat on the leaderboard today!</p>';
          return;
        }
        const medal = r => r === 1 ? '🥇' : r === 2 ? '🥈' : r === 3 ? '🥉' : '#' + r;
        list.innerHTML = entries.map(e =>
          '<div style="display:flex;justify-content:space-between;padding:.4rem .6rem;border-bottom:1px solid #f4dfdc;font-size:.85rem">'
          + '<span style="font-weight:700;color:#342421">' + medal(e.rank) + ' ' + String(e.name || 'Anonymous Cat').replace(/[<>&]/g, '') + '</span>'
          + '<span style="color:#559c68;font-weight:700">' + msToClock(e.timeMs) + '</span></div>'
        ).join('');
      } catch (e) { /* 静默 */ }
    }
    setInterval(renderLeaderboard, 60000);

    // 登录回跳错误提示
    try {
      const authErr = new URLSearchParams(window.location.search).get('auth_error');
      if (authErr) {
        const msg = authErr === 'access_denied' ? 'Sign-in was cancelled.' : 'Sign-in failed (' + authErr + '). Please try again.';
        showToast('⚠️ ' + msg, 'error');
        history.replaceState(null, '', window.location.pathname);
      }
    } catch (e) {}

    // Chrome Extension sync — post streak data to extension
    function syncToExtension() {
      try {
        var raw = localStorage.getItem('gridpaw-daily');
        if (!raw) return;
        var st = JSON.parse(raw);
        var today = new Date().toISOString().split('T')[0];
        window.postMessage({
          type: 'gridpaw_extension_sync',
          payload: {
            streak: st.streak || 0,
            bestStreak: st.bestStreak || 0,
            lastDate: st.lastPlayedDate || st.date || null,
            bestTime: st.bestTime || 0,
            puzzlesSolved: st.streak || 0,
            dailySolved: st.solved ? today : null,
            dailyTime: st.solved ? (st.bestTime || 0) : 0
          }
        }, '*');
      } catch(e) {}
    }
    syncToExtension();
  </script>
</body>
</html>
