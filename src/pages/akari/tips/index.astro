const title = "Akari Tips & Strategies — Solve Light Up Puzzles | GridPaw";
const description = "Akari tips and strategies for every level: how to read number cells, use elimination, spot forced bulbs, and avoid the mistakes that stall a Light Up solve.";
const tips = [
  { href: "/akari/tips/number-0/", icon: "0", name: "Number 0 Cells", note: "No adjacent bulbs. Mark all four neighbours as blocked the moment you see a 0." },
  { href: "/akari/tips/number-1/", icon: "1", name: "Number 1 Cells", note: "Exactly one neighbour gets a bulb. Line-of-sight usually tells you which one." },
  { href: "/akari/tips/number-2/", icon: "2", name: "Number 2 Cells", note: "Two neighbours light up. Corners and edges narrow the candidates fast." },
  { href: "/akari/tips/number-3/", icon: "3", name: "Number 3 Cells", note: "Three of four neighbours need bulbs — only one is blocked. Find the odd one out." },
  { href: "/akari/tips/number-4/", icon: "4", name: "Number 4 Cells", note: "All four neighbours get bulbs. Place them immediately, no thinking required." },
  { href: "/akari/tips/elimination/", icon: "🔍", name: "Elimination Technique", note: "Cross out impossible cells first; what survives is the answer." },
];
