          <tr style="border-bottom:1px solid #e7dacf;"><td style="padding:.4rem;">Reasoning type</td><td style="padding:.4rem;">Spatial + logical</td><td style="padding:.4rem;">Number logic</td><td style="padding:.4rem;">Counting + pattern</td></tr>
