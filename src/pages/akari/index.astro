      if (level <= 6)  return { label: 'Easy',        badge: 'badge-easy',        size: 6 };
      if (level <= 9)  return { label: 'Medium',      badge: 'badge-medium',      size: 7 };
      if (level <= 12) return { label: 'Medium-Hard', badge: 'badge-medium-hard', size: 8 };
      if (level <= 15) return { label: 'Hard',        badge: 'badge-hard',        size: 9 };
      if (level <= 18) return { label: 'Expert',      badge: 'badge-expert',      size: 10 };
      return                  { label: 'Master',      badge: 'badge-expert',      size: 12 };
    }
    let currentPuzzle = null, playerSolution = null, markX = null, won = false;
    let health = 3, level = 0;
    let consecErrors = 0;          // 卡关引导：连续违规落子计数（合规落子清零，换关清零）
    let nudgeShownThisLevel = false; // 每关只抖一次
    let lastPlacedCell = null;
    let gameStartTime = null;
    let historyStack = [], redoStack = [];
    let timerInterval = null, timerSeconds = 0;
    const timerEl = document.getElementById('timer');
    const bestTimeEl = document.getElementById('best-time');
    
    function startTimer() {
      stopTimer();
      timerSeconds = 0;
      timerEl.textContent = '⏱ 0:00';
      timerInterval = setInterval(() => {
        timerSeconds++;
        const m = Math.floor(timerSeconds / 60);
        const s = timerSeconds % 60;
        timerEl.textContent = '⏱ ' + m + ':' + String(s).padStart(2, '0');
      }, 1000);
    }
    function stopTimer() { if (timerInterval) { clearInterval(timerInterval); timerInterval = null; } }
    function formatTime(sec) { return Math.floor(sec/60) + ':' + String(sec%60).padStart(2,'0'); }
    function checkBestTime() {
      const diff = getDifficulty(level);
      const key = 'gridpaw-best-' + diff.label;
      const prev = localStorage.getItem(key);
      if (!prev || timerSeconds < parseInt(prev)) {
        localStorage.setItem(key, timerSeconds);
        return true; // new record
      }
      return false;
    }
    function showBestTime() {
      const diff = getDifficulty(level);
      const key = 'gridpaw-best-' + diff.label;
      const best = localStorage.getItem(key);
      if (best) {
        bestTimeEl.textContent = '🏆 ' + formatTime(parseInt(best));
        bestTimeEl.style.display = 'block';
      } else {
        bestTimeEl.style.display = 'none';
      }
    }
    
    function snapshot() {
      return { ps: playerSolution.map(r => r.slice()), mx: markX.map(r => r.slice()) };
    }
    function pushHistory() { historyStack.push(snapshot()); redoStack = []; }
    function undo() {
      if (!historyStack.length || won) return;
      redoStack.push(snapshot());
      const prev = historyStack.pop();
      playerSolution = prev.ps; markX = prev.mx;
      renderBoard(); updateProgress(); autoSave();
    }
    function redo() {
      if (!redoStack.length || won) return;
      historyStack.push(snapshot());
      const next = redoStack.pop();
      playerSolution = next.ps; markX = next.mx;
      renderBoard(); updateProgress(); autoSave();
    }
    
    function autoSave() {
      if (!currentPuzzle || won) return;
      const saveData = { level, health, puzzleId: currentPuzzle.id, puzzle: currentPuzzle, playerSolution, markX, timestamp: gameStartTime, savedAt: Date.now() };
      try { localStorage.setItem('gridpaw-autosave', JSON.stringify(saveData)); } catch(e) {}
    }
    function loadAutoSave() {
      const saved = localStorage.getItem('gridpaw-autosave');
      if (!saved) return false;
      try {
        const d = JSON.parse(saved);
        if (!d.puzzle || !d.playerSolution) return false;
        // Expire after 24 hours
        if (d.savedAt && Date.now() - d.savedAt > 24 * 60 * 60 * 1000) { clearAutoSave(); return false; }
        level = d.level || 0; health = d.health || 3; currentPuzzle = d.puzzle;
        playerSolution = d.playerSolution; markX = d.markX; gameStartTime = d.timestamp;
        CAT_IMG = getCatImg(level); updateLevel(); updateHealth(); renderBoard(); updateProgress();
        return true;
      } catch(e) { return false; }
    }
    function clearAutoSave() { localStorage.removeItem('gridpaw-autosave'); }

    const gridEl = document.getElementById('puzzle-grid');
    const progressEl = document.getElementById('progress');
    const toastEl = document.getElementById('toast');
    const winOverlay = document.getElementById('win-overlay');
    const healthDisplay = document.getElementById('health-display');
    const levelDisplay = document.getElementById('level-display');
    let toastTimer = null;

    function showToast(m, t) {
      toastEl.textContent = m; toastEl.className = 'toast show' + (t === 'success' ? ' success' : '');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { toastEl.className = 'toast'; }, 2500);
    }
    function spawnConfetti() {
      const c = document.getElementById('confetti-container');
      if (!c) return; c.innerHTML = '';
      const colors = ['#E8A888','#E8A888','#88C8A8','#F0E8FF','#FFB347','#A888C8'];
      for (let i = 0; i < 40; i++) {
        const el = document.createElement('div'); el.className = 'confetti';
        el.style.left = Math.random()*100+'%'; el.style.background = colors[Math.floor(Math.random()*colors.length)];
        el.style.animationDuration = (2+Math.random()*3)+'s'; el.style.animationDelay = Math.random()*1.5+'s';
        el.style.width = (8+Math.random()*8)+'px'; el.style.height = (8+Math.random()*8)+'px'; c.appendChild(el);
      }
      for (let i = 0; i < 12; i++) {
        const el = document.createElement('div'); el.className = 'paw-confetti'; el.textContent = '🐾';
        el.style.left = Math.random()*100+'%'; el.style.animationDuration = (3+Math.random()*3)+'s';
        el.style.animationDelay = Math.random()*2+'s'; c.appendChild(el);
      }
    }
    // ─── Level cloud sync（静默：登录态在 daily 页建立，这里只同步数据）───
    let currentUser = null;
    function mtFetch(url, opts, ms = 8000) {
      opts = opts || {};
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), ms);
      return fetch(url, Object.assign({}, opts, { signal: ctrl.signal })).finally(() => clearTimeout(t));
    }

    // ─── User Attribution (归因) ───────────────────────────────
    (function() {
      const ATTR_KEY = 'gp_attr';
      if (localStorage.getItem(ATTR_KEY)) return;
      const p = new URLSearchParams(location.search);
      const attr = {
        utm_source: p.get('utm_source') || null, utm_medium: p.get('utm_medium') || null,
        utm_campaign: p.get('utm_campaign') || null, utm_content: p.get('utm_content') || null,
        channel: p.get('channel') || null, referrer: document.referrer || null,
        landing: location.pathname + location.search, first_seen_at: Date.now()
      };
      if (attr.utm_source || attr.utm_medium || attr.utm_campaign || attr.utm_content || attr.channel || attr.referrer)
        localStorage.setItem(ATTR_KEY, JSON.stringify(attr));
    })();
    function sendAttribution() {
      const raw = localStorage.getItem('gp_attr'); if (!raw) return;
      try { const a = JSON.parse(raw);
        mtFetch('/api/auth/save-attr', { method: 'POST', headers: {'content-type':'application/json'}, body: JSON.stringify(a) }, 5000)
          .then(r => { if (r.ok) localStorage.removeItem('gp_attr'); }).catch(() => {});
      } catch(e) {}
    }
    function postLevel(lv) {
      mtFetch('/api/level', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ level: lv }) }).catch(() => {});
    }
    function syncLevelOnLoad() {
      mtFetch('/api/auth/me').then(r => r.json()).then(me => {
        currentUser = me && me.user ? me.user : null;
        if (currentUser && currentUser.googleSub && typeof window.gtag === 'function') {
          window.gtag('set', 'user_id', currentUser.googleSub);
        }
        if (!currentUser) return;
        sendAttribution();
        mtFetch('/api/level').then(r => r.ok ? r.json() : null).then(data => {
          if (!data) return;
          if (data.level == null) {
            if (level + 1 > 1) postLevel(level + 1);
          } else if (data.level > level + 1) {
            // 云端领先（换设备恢复）→ 跳关
            level = data.level - 1;
            updateLevel(); CAT_IMG = getCatImg(level);
            clearAutoSave(); newPuzzleSkip();
          } else if (level + 1 > data.level) {
            postLevel(level + 1);
          }
        }).catch(() => {});
      }).catch(() => {});
    }
    function newPuzzleSkip() {
      won = false; winOverlay.classList.remove('show'); health = 3; updateHealth();
      consecErrors = 0; nudgeShownThisLevel = false;
      const hbR1 = document.getElementById('hint-btn'); if (hbR1) hbR1.classList.remove('hint-nudge');
      historyStack = []; redoStack = [];
      startTimer(); showBestTime();
      const diff = getDifficulty(level); const s = diff.size;
      gridEl.innerHTML = '<div style="padding:2rem;color:var(--text-muted);font-size:0.9rem;">Generating...</div>';
      progressEl.textContent = '';
      setTimeout(() => {
        try {
          currentPuzzle = buildTutorialPuzzle(level) || generatePuzzle(s);
          playerSolution = Array.from({length:s}, () => Array(s).fill(false));
          markX = Array.from({length:s}, () => Array(s).fill(false));
          renderBoard(); updateProgress(); autoSave();
          akObMaybeCoach();
        } catch(e) {}
      }, 10);
    }

    function newPuzzle() {
      won = false; winOverlay.classList.remove('show'); health = 3; updateHealth();
      level++; updateLevel(); CAT_IMG = getCatImg(level); gameStartTime = Date.now();
      if (currentUser) postLevel(level + 1);
      historyStack = []; redoStack = [];
      startTimer(); showBestTime();
      const diff = getDifficulty(level); const s = diff.size;
      gridEl.innerHTML = '<div style="padding:2rem;color:var(--text-muted);font-size:0.9rem;">Generating...</div>';
      progressEl.textContent = '';
      setTimeout(() => {
        try {
          currentPuzzle = buildTutorialPuzzle(level) || generatePuzzle(s);
          playerSolution = Array.from({length:s}, () => Array(s).fill(false));
          markX = Array.from({length:s}, () => Array(s).fill(false));
          renderBoard(); updateProgress();
          akObMaybeCoach();
          if (!gaStarted) {
            gaStarted = true;
            const p = new URLSearchParams(location.search);
            const src = p.get('embed') ? 'embed' : p.get('daily') ? 'daily' : document.referrer ? 'referral' : 'direct';
            // 延迟到 DOMContentLoaded：gpTrack 由 module 脚本注入，太早调用会漏进 D1（同 index.astro 修复）
            const fireGS = () => track('game_start', { level: level, difficulty: diff.label, source: src });
            if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', fireGS); } else { fireGS(); }
          }
        } catch(e) { showToast('Failed to generate.', 'error'); }
      }, 10);
    }
    function resetPuzzle() {
      if (!currentPuzzle) return; won = false; winOverlay.classList.remove('show');
      track('puzzle_reset', { level: level, difficulty: getDifficulty(level).label });
      const s = currentPuzzle.size;
      playerSolution = Array.from({length:s}, () => Array(s).fill(false));
      markX = Array.from({length:s}, () => Array(s).fill(false));
      health = 3; updateHealth(); startTimer();
      consecErrors = 0; nudgeShownThisLevel = false;
      const hbR2 = document.getElementById('hint-btn'); if (hbR2) hbR2.classList.remove('hint-nudge');
      renderBoard(); updateProgress(); showToast('Board reset!', 'success'); autoSave();
    }
    function renderBoard() {
      if (!currentPuzzle) return;
      const g = currentPuzzle.grid, s = currentPuzzle.size;
      const lit = illuminate(g, playerSolution, s);
      const v = checkViolations(g, playerSolution, s);
      const vc = {}, cp = {};
      v.forEach(x => {
        if (x.type === 'number_excess') {
          vc[x.row+','+x.col] = true;
          DIRS.forEach(d => { const nr=x.row+d[0],nc=x.col+d[1]; if(nr>=0&&nr<s&&nc>=0&&nc<s&&playerSolution[nr][nc]) vc[nr+','+nc]=true; });
        } else if (x.type === 'cat_conflict') { cp[x.row+','+x.col]=true; cp[x.row2+','+x.col2]=true; }
      });
      const mw = Math.min(window.innerWidth-40,600);
      const cs = Math.max(30,Math.min(44,Math.floor((mw-(s+1)*2-8)/s)));
      gridEl.style.gridTemplateColumns = `repeat(${s},${cs}px)`;
      gridEl.style.gridTemplateRows = `repeat(${s},${cs}px)`;
      gridEl.innerHTML = '';
      for (let r=0;r<s;r++) for (let c=0;c<s;c++) {
        const cell = document.createElement('div');
        cell.className = 'cell'; cell.style.width = cs+'px'; cell.style.height = cs+'px';
        cell.dataset.row = r; cell.dataset.col = c;
        const val = g[r][c], key = r+','+c;
        if (val !== 9) {
          cell.classList.add('cell-black');
          if (val >= 0) { cell.classList.add('cell-number'); cell.textContent = val; cell.style.fontSize = Math.max(12,cs*.5)+'px'; if(vc[key]) cell.classList.add('cell-violation'); }
        } else {
          if (playerSolution[r][c]) {
            cell.classList.add('cell-cat');
            if (lastPlacedCell && lastPlacedCell.r === r && lastPlacedCell.c === c) cell.classList.add('cell-cat-new');
            cell.innerHTML = CAT_IMG;
            if(cp[key]) cell.classList.add('cell-shake');
          }
          else if (markX[r][c]) { cell.classList.add('cell-x'); cell.innerHTML = X_MARK; }
          else if (lit[r][c]) { cell.classList.add('cell-lit'); }
          else { cell.classList.add('cell-dark'); }
          cell.addEventListener('click', e => { e.preventDefault(); if(!won) handleClick(r,c); });
          cell.addEventListener('dblclick', e => { e.preventDefault(); if(!won){pushHistory();markX[r][c]=!markX[r][c];renderBoard();} });
          cell.addEventListener('contextmenu', e => { e.preventDefault(); if(!won){pushHistory();markX[r][c]=!markX[r][c];renderBoard();} });
          let lpt=null,dlp=false;
          cell.addEventListener('touchstart',()=>{dlp=false;lpt=setTimeout(()=>{dlp=true;if(!won){markX[r][c]=!markX[r][c];renderBoard();}},500);},{passive:true});
          cell.addEventListener('touchend',e=>{if(lpt)clearTimeout(lpt);if(dlp)e.preventDefault();});
          cell.addEventListener('touchmove',()=>{if(lpt)clearTimeout(lpt);},{passive:true});
        }
        gridEl.appendChild(cell);
      }
    }
    function handleClick(r, c) {
      if (!currentPuzzle) return;
      if (!window.__firstMoveTracked) { window.__firstMoveTracked = true; track('first_move', { level: level + 1 }); }
      const g = currentPuzzle.grid, s = currentPuzzle.size;
      pushHistory();
      if (playerSolution[r][c]) {
        playerSolution[r][c] = false; lastPlacedCell = null; SFX.remove();
      } else {
        markX[r][c] = false; playerSolution[r][c] = true; lastPlacedCell = {r, c}; SFX.place();
        consecErrors = 0;
        const v = checkViolations(g, playerSolution, s);
        let hasViolation = false;
        for (const x of v) { if(x.type==='number_excess'){ showToast('Too many cats around number '+x.number+'!','error'); hasViolation=true; break; } }
        for (const x of v) { if(x.type==='cat_conflict'){ showToast('Two cats are facing each other!','error'); hasViolation=true; break; } }
        if (hasViolation) { SFX.error(); loseHealth(); consecErrors++; if (consecErrors >= 2 && !nudgeShownThisLevel) { nudgeShownThisLevel = true; const hbN = document.getElementById('hint-btn'); if (hbN) hbN.classList.add('hint-nudge'); } }
        else akObOnPlace();
      }
      renderBoard(); updateProgress(); autoSave();
      setTimeout(() => { lastPlacedCell = null; }, 500);
      if (checkWin(g, playerSolution, s)) {
        won=true; clearAutoSave(); stopTimer();
        const isNewRecord = checkBestTime();
        SFX.win(); spawnConfetti();
        setTimeout(()=>{ winOverlay.classList.add('show');
          if (isNewRecord) {
            document.querySelector('.win-sub').textContent = '🏆 New Best Time: ' + formatTime(timerSeconds) + '!';
          }
          setTimeout(() => { if (won) { winOverlay.classList.remove('show'); newPuzzle(); } }, 3000);
        },300);
      }
    }
    function updateProgress() {
      if (!currentPuzzle) return;
      const catsPlaced = playerSolution.flat().filter(Boolean).length;
      const totalCats = currentPuzzle.solution.flat().filter(Boolean).length;
      progressEl.textContent = catsPlaced + ' / ' + totalCats + ' cats placed';
    }
    function updateHealth() {
      healthDisplay.querySelectorAll('.heart').forEach((heart, i) => {
        heart.classList.toggle('lost', i >= health);
      });
    }
    function updateLevel() {
      const diff = getDifficulty(level);
      levelDisplay.innerHTML = 'Level ' + level + ' <span class="difficulty-badge ' + diff.badge + '" id="diff-badge">' + diff.label + '</span>';
      const badgeEl = document.getElementById('level-badge-text');
      if (badgeEl) badgeEl.innerHTML = level + '<span style="color:var(--text-muted)"> / ∞</span>';
    }
    function loseHealth() {
      if (health > 0) { health--; updateHealth(); if (health === 0) { stopTimer(); showToast('Game Over! Try again.', 'error'); setTimeout(resetPuzzle, 1500); } }
    }
    document.getElementById('hint-btn').addEventListener('click', () => {
      if (!currentPuzzle || won) return;
      track('hint_click', { level: level });
      const hbU = document.getElementById('hint-btn'); if (hbU) hbU.classList.remove('hint-nudge');
      const h = getHint(currentPuzzle.grid, currentPuzzle.solution, playerSolution, currentPuzzle.size);
      if (h) {
        const cell = gridEl.querySelector('[data-row="'+h[0]+'"][data-col="'+h[1]+'"]');
        if (cell) { cell.classList.add('cell-hint'); setTimeout(()=>cell.classList.remove('cell-hint'),2000); }
        SFX.hint(); showToast('Hint: try row '+(h[0]+1)+', col '+(h[1]+1),'success');
      } else showToast('No hints!','error');
    });
    document.getElementById('reset-btn').addEventListener('click', resetPuzzle);
    // Clarity 录屏实锤：用户把难度徽章当帮助按钮狂点（1 分钟 17 次）→ 点它就滚到玩法指南
    document.getElementById('level-display').addEventListener('click', (e) => {
      const badge = e.target && e.target.closest ? e.target.closest('.difficulty-badge') : null;
      if (!badge) return;
      track('badge_help_click', { level: level, badge: badge.textContent.trim() });
      const guide = document.getElementById('strategy-guide');
      if (guide) guide.scrollIntoView({ behavior: 'smooth' });
      showToast('💡 Hint shows the next logical move — guide below.', 'success');
    });
    document.getElementById('new-btn').addEventListener('click', newPuzzle);
    document.getElementById('sound-btn').addEventListener('click', () => {
      const muted = SFX.toggle();
      document.getElementById('sound-btn').textContent = muted ? '🔇' : '🔊';
    });
    document.getElementById('undo-btn').addEventListener('click', undo);
    document.getElementById('redo-btn').addEventListener('click', redo);
    document.addEventListener('keydown', e => {
      if ((e.ctrlKey||e.metaKey) && e.key==='z') { e.preventDefault(); e.shiftKey ? redo() : undo(); }
      if ((e.ctrlKey||e.metaKey) && e.key==='y') { e.preventDefault(); redo(); }
    });
    document.getElementById('win-next').addEventListener('click', () => { track('level_up', { level: level, difficulty: getDifficulty(level).label }); if ([1,3,5,7,9,10,15,20].indexOf(level) !== -1) { track('level_complete_' + level, { difficulty: getDifficulty(level).label }); } winOverlay.classList.remove('show'); newPuzzle(); });
    async function captureBoardToClipboard() {
      try {
        const boardEl = document.getElementById('puzzle-grid');
        if (!boardEl || typeof html2canvas === 'undefined') return;
        const canvas = await html2canvas(boardEl, { backgroundColor: '#f8f6ef', scale: 2 });
        canvas.toBlob(async (blob) => {
          if (!blob) return;
          try { await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]); } catch(e) {}
        }, 'image/png');
      } catch(e) {}
    }
    document.getElementById('share-copy').addEventListener('click', () => {
      track('share_copy', { level: level, difficulty: getDifficulty(level).label });
      const diff = getDifficulty(level);
      const text = '🐱 Cleared GridPaw Level ' + level + ' (' + diff.label + ' ' + diff.size + '×' + diff.size + ') — can you beat my time?\ngridpaw.com';
      navigator.clipboard.writeText(text).then(() => showToast('📋 Copied to clipboard!', 'success'));
    });
    document.getElementById('share-twitter').addEventListener('click', () => {
      track('share_twitter', { level: level, difficulty: getDifficulty(level).label });
      const diff = getDifficulty(level);
      const timeStr = timerSeconds > 0 ? '⏱ ' + formatTime(timerSeconds) + ' — ' : '';
