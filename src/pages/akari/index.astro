---
import SEOHead from '../../components/SEOHead.astro';
const title = "Akari (Light Up) Puzzle — Play Free Online | GridPaw";
const description = "Play free Akari puzzles online. Place glowing cats to light up every cell. Multiple difficulty levels from beginner to master.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead title={title} description={description} canonical="/akari/" type="article" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <span class="brand-logo">🐱</span>
        <span class="brand-name">
          <span class="big">GridPaw</span>
          <span class="small">Cat Puzzle Games</span>
        </span>
      </a>
      <nav class="nav">
        <a href="/">Shikaku</a>
        <a href="/akari/">Akari</a>
        <a href="/daily/">Daily</a>
      </nav>
    </div>
  </header>

  <main>
    <h1>Akari (Light Up) Puzzle — Free Online</h1>
    <p>Place glowing cats on the grid so every empty cell is illuminated. Numbered walls tell you exactly how many cats are adjacent. No guessing required — pure logic.</p>

    <nav class="breadcrumb">
      <a href="/">Home</a> &gt; <span>Akari</span>
    </nav>

    <section>
      <h2>How to Play</h2>
      <ul>
        <li>Tap empty cells to place glowing cats</li>
        <li>Lights shine in all four directions until blocked by a wall</li>
        <li>Numbered cells show how many adjacent cats are needed</li>
        <li>No two cats can see each other in the same row or column</li>
        <li>Win when every empty cell is lit and all clues are satisfied</li>
      </ul>
    </section>

    <section>
      <h2>Difficulty Levels</h2>
      <ul>
        <li><a href="/levels/easy/">Easy (5×5)</a> — Perfect for beginners</li>
        <li><a href="/levels/medium/">Medium (7×7)</a> — Standard challenge</li>
        <li><a href="/levels/hard/">Hard (9×9)</a> — For experienced puzzlers</li>
      </ul>
    </section>
  </main>

  <footer>
    <p><a href="/">GridPaw</a> · Free Cat Puzzle Games</p>
    <p>© 2026 GridPaw. All rights reserved.</p>
  </footer>
</body>
</html>
