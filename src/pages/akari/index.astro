    document.getElementById('daily-btn').addEventListener('click', () => {
      track('daily_challenge_click');
    });
    function generateShareCard() {
      const s = currentPuzzle.size, g = currentPuzzle.grid;
      const lit = illuminate(g, playerSolution, s);
      const cardW = 600, cardH = 700, gridPadding = 20;
      const cellSize = Math.floor((cardW - gridPadding * 2 - (s + 1) * 2) / s);
      const gridW = cellSize * s + (s + 1) * 2, gridX = (cardW - gridW) / 2, gridY = 120;
      const canvas = document.createElement('canvas'); canvas.width = cardW; canvas.height = cardH;
      const ctx = canvas.getContext('2d');
      const gradient = ctx.createLinearGradient(0, 0, cardW, cardH);
      gradient.addColorStop(0, '#f8f6ef'); gradient.addColorStop(1, '#f8f6ef');
      ctx.fillStyle = gradient; ctx.fillRect(0, 0, cardW, cardH);
      ctx.fillStyle = '#342421'; ctx.font = 'bold 28px system-ui'; ctx.textAlign = 'center';
      ctx.fillText('🐱 GridPaw Challenge', cardW / 2, 40);
      ctx.font = '16px system-ui'; ctx.fillStyle = '#6f5651';
      const diff = getDifficulty(level);
      ctx.fillText(s + '×' + s + ' · ' + diff.label + ' · Level ' + level, cardW / 2, 65);
      ctx.font = 'bold 18px system-ui'; ctx.fillStyle = '#342421';
      const timeStr = gameStartTime ? (Math.floor((Date.now()-gameStartTime)/60000)+':'+String(Math.floor(((Date.now()-gameStartTime)/1000)%60)).padStart(2,'0')) : '--:--';
      ctx.fillText('⏱ '+timeStr+'   ❤️ '+health+' lives   🐱 '+currentPuzzle.solution.flat().filter(Boolean).length+' cats', cardW/2, 100);
      ctx.fillStyle = '#E8DDD8'; ctx.beginPath(); ctx.roundRect(gridX-4, gridY-4, gridW+8, gridW+8, 12); ctx.fill();
      for (let r=0;r<s;r++) for (let c=0;c<s;c++) {
        const x=gridX+c*(cellSize+2)+2, y=gridY+r*(cellSize+2)+2, val=g[r][c];
        if (val!==9) { ctx.fillStyle='#8B7B9A'; ctx.beginPath(); ctx.roundRect(x,y,cellSize,cellSize,6); ctx.fill();
          if(val>=0){ctx.fillStyle='#F0E8FF';ctx.font='bold '+Math.max(10,cellSize*0.4)+'px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(val,x+cellSize/2,y+cellSize/2);}
        } else if(playerSolution[r][c]){ctx.fillStyle='#F0E8FF';ctx.beginPath();ctx.roundRect(x,y,cellSize,cellSize,6);ctx.fill();ctx.font=(cellSize*0.6)+'px serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('🐱',x+cellSize/2,y+cellSize/2);}
        else if(lit[r][c]){ctx.fillStyle='#FFF8F0';ctx.beginPath();ctx.roundRect(x,y,cellSize,cellSize,6);ctx.fill();}
        else{ctx.fillStyle='#F0EBE5';ctx.beginPath();ctx.roundRect(x,y,cellSize,cellSize,6);ctx.fill();}
      }
      const ctaY=gridY+gridW+30; ctx.font='bold 16px system-ui';ctx.fillStyle='#6f5651';ctx.textAlign='center';ctx.fillText('Play free at gridpaw.com',cardW/2,ctaY);
      ctx.font='30px serif';ctx.fillText('🐾',40,ctaY+40);ctx.fillText('🐾',cardW-40,ctaY+40);
      return canvas.toDataURL('image/png');
    }
    document.getElementById('share-copy').addEventListener('click', () => {
      const cardData = generateShareCard();
      const link = document.createElement('a'); link.download = 'gridpaw-level-' + level + '.png'; link.href = cardData; link.click();
      showToast('📸 Share card downloaded!', 'success');
    });
    updateHealth(); updateLevel();
    function loadCustomPuzzle() {
      if (!window.location.hash) return false;
      const encoded = window.location.hash.substring(1), parts = encoded.split(':');
      if (parts.length !== 2) return false;
      const s = parseInt(parts[0]), data = parts[1];
      if (data.length !== s * s) return false;
      const g = Array.from({length: s}, () => Array(s).fill(9));
      for (let i = 0; i < data.length; i++) {
        const r = Math.floor(i / s), c = i % s, ch = data[i];
        if (ch === 'w') g[r][c] = 9; else if (ch === 'b') g[r][c] = -1;
        else if (ch >= '0' && ch <= '4') g[r][c] = parseInt(ch); else return false;
      }
      try {
        const result = solve(g, s, 2);
        if (result.count !== 1 || !result.solution) return false;
        currentPuzzle = { id: 'custom-' + Date.now(), size: s, grid: g, solution: result.solution, difficulty: 'custom', backtrackDepth: result.backtrackDepth };
        playerSolution = Array.from({length: s}, () => Array(s).fill(false));
        markX = Array.from({length: s}, () => Array(s).fill(false));
        health = 3; won = false; gameStartTime = Date.now();
        updateHealth(); renderBoard(); updateProgress(); showToast('Custom puzzle loaded!', 'success');
        return true;
      } catch (e) { return false; }
    }
    // Always start fresh from Level 1, then pull cloud level if signed in
    newPuzzle();
    // ─── 导航栏登录区（复用 daily 页的登录体系，静默同步）──────────────
    fetch('/api/auth/me', { signal: AbortSignal.timeout(8000) }).then(r => r.json()).then(me => {
      const me_ = me && me.user ? me.user : null;
      if (!me_) currentUser = null; else currentUser = me_;
      const area = document.getElementById('nav-account-area');
      if (!area) return;
      area.innerHTML = '';
      if (currentUser) {
        if (currentUser.picture && /^https:\/\/(lh3|lh4|lh5|lh6)\.googleusercontent\.com\//.test(currentUser.picture)) {
          const img = document.createElement('img');
          img.src = currentUser.picture; img.alt = ''; img.referrerPolicy = 'no-referrer';
          img.style.cssText = 'width:26px;height:26px;border-radius:50%';
          area.appendChild(img);
        }
        const name = document.createElement('span');
        name.textContent = currentUser.name || 'Cat Fan';
        name.style.cssText = 'font-size:0.8rem;font-weight:700;color:var(--text)';
        area.appendChild(name);
      } else {
        const btn = document.createElement('a');
        btn.href = '/api/auth/login?next=/';
        btn.style.cssText = 'display:inline-flex;align-items:center;gap:5px;background:#fff;border:1.5px solid #dadce0;border-radius:999px;padding:5px 12px;font-size:0.8rem;font-weight:700;color:#3c4043;text-decoration:none;box-shadow:0 1px 3px rgba(0,0,0,.08)';
        btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.6 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C36.9 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>Sign in';
        area.appendChild(btn);
      }
      // 登录态已确认，重新拉云端关卡（此时 currentUser 可用）
      if (currentUser) syncLevelOnLoad();
    }).catch(() => {});
    syncLevelOnLoad();

    /* ── 新手引导 Coach：真盘对错对照演示（2026-09-23，与 Shikaku 同款语言）── */
    // ⚠️ 不能包 if 块：module 严格模式下块内函数声明外部钩子调不到（已踩坑）
    const akObCard = document.getElementById('ak-coach');
    const akObStep = document.getElementById('ak-ob-step'), akObTitle = document.getElementById('ak-ob-title'), akObText = document.getElementById('ak-ob-text');
    const akObNext = document.getElementById('ak-ob-next'), akObSkip = document.getElementById('ak-ob-skip'), akObToastEl = document.getElementById('ak-toast');
    const akObDotEls = akObCard.querySelectorAll('.ob-dot');
    const AK_PAW_SVG = '<svg viewBox="0 0 96 96" style="width:100%;height:100%"><g transform="rotate(-5 48 48)">' +
      '<path d="M32 90 C22 90 17 83 19 74 C12 70 11 59 17 53 C11 45 14 33 22 28 C23 18 32 13 40 16 C43 10 52 9 56 14 C60 9 70 10 73 16 C81 13 89 19 89 28 C93 36 92 47 86 52 C90 60 87 72 78 76 C79 85 71 91 63 89 C56 94 44 94 40 90 C37 92 34 92 32 90 Z" fill="url(#gpFurG)" stroke="#D9BE9F" stroke-width="1.6"/>' +
      '<path d="M50 50 q8 -8 15 -2 q8 7 0 15 q-5 6 -12 11 q-1.5 1.4 -3 0 q-7 -5 -12 -11 q-8 -8 0 -15 q7 -6 12 2z" fill="url(#gpPadG)"/>' +
      '<g transform="rotate(-12 33 31)"><ellipse cx="33" cy="31" rx="7.8" ry="9.2" fill="url(#gpBeanG)"/></g>' +
      '<g transform="rotate(-3 49 24)"><ellipse cx="49" cy="24" rx="8" ry="9.4" fill="url(#gpBeanG)"/></g>' +
      '<g transform="rotate(8 65 26)"><ellipse cx="65" cy="26" rx="7.6" ry="9" fill="url(#gpBeanG)"/></g>' +
      '<g transform="rotate(20 77 37)"><ellipse cx="77" cy="37" rx="7" ry="8.2" fill="url(#gpBeanG)"/></g></g></svg>';
    let akObTut = {}; try { akObTut = JSON.parse(localStorage.getItem('akari_ob_tut') || '{}'); } catch(e) { akObTut = {}; }
    let akObPhase = null, akObIdle = null, akObPaw = null, akObT = [], akObLevel = -1;
    function akObSave() { try { localStorage.setItem('akari_ob_tut', JSON.stringify(akObTut)); } catch(e) {} }
    function akObCell(r, c) { return gridEl.children[r * currentPuzzle.size + c]; }
    function akObXY(cell) { const cb = cell.getBoundingClientRect(), hb = gridEl.getBoundingClientRect(); return { x: cb.left - hb.left + cb.width/2 - 25, y: cb.top - hb.top + cb.height/2 - 30, cx: cb.left - hb.left + cb.width/2, cy: cb.top - hb.top + cb.height/2 }; }
    function akObKillPaw() { akObT.forEach(clearTimeout); akObT = []; if (akObPaw) { akObPaw.remove(); akObPaw = null; } }
    function akObSpawnPaw() { akObKillPaw(); akObPaw = document.createElement('div'); akObPaw.className = 'ak-paw'; akObPaw.innerHTML = AK_PAW_SVG; gridEl.appendChild(akObPaw); return akObPaw; }
    function akObRipple(cell) { const p = akObXY(cell); const r = document.createElement('div'); r.className = 'ak-ripple'; r.style.left = p.cx + 'px'; r.style.top = p.cy + 'px'; gridEl.appendChild(r); setTimeout(() => r.remove(), 750); }
    function akObTap(cell, cb) { const p = akObXY(cell); akObPaw.style.left = p.x + 'px'; akObPaw.style.top = p.y + 'px'; akObT.push(setTimeout(() => { akObPaw.classList.add('press'); akObRipple(cell); }, 700)); akObT.push(setTimeout(() => { akObPaw.classList.remove('press'); if (cb) cb(); }, 1300)); }
    function akObFlash(cell) {
      cell.classList.add('cell-violation');
      const x = document.createElement('div'); x.className = 'ak-obx'; cell.appendChild(x);
      setTimeout(() => { cell.classList.remove('cell-violation'); x.remove(); }, 850);
    }
    function akObWrongCell() {
      // 优先选「放在已满数字旁边会超标」的格子（number_excess 教学价值最高），退回已亮格
      const s = currentPuzzle.size;
      const hyp = playerSolution.map(r => r.slice());
      for (let r = 0; r < s; r++) for (let c = 0; c < s; c++) {
        if (currentPuzzle.grid[r][c] !== 9 || playerSolution[r][c]) continue;
        hyp[r][c] = true;
        const v = checkViolations(currentPuzzle.grid, hyp, s);
        hyp[r][c] = false;
        if (v.some(x => x.type === 'number_excess')) return { r, c };
      }
      return akObLitCell();
    }
    function akObFirstBulb() { const s = currentPuzzle.size, sol = currentPuzzle.solution; for (let r = 0; r < s; r++) for (let c = 0; c < s; c++) if (sol[r][c] && !playerSolution[r][c]) return { r, c }; return null; }
    function akObLitCell() { const s = currentPuzzle.size; const lit = illuminate(currentPuzzle.grid, playerSolution, s); for (let r = 0; r < s; r++) for (let c = 0; c < s; c++) if (currentPuzzle.grid[r][c] === 9 && lit[r][c] && !playerSolution[r][c]) return { r, c }; return null; }
    function akObSetDots(n) { akObDotEls.forEach((d, i) => d.classList.toggle('on', i <= n)); }
    function akObToast() { akObToastEl.classList.add('show'); setTimeout(() => akObToastEl.classList.remove('show'), 1600); }
    function akObDemo() {
      const good = akObFirstBulb();
      if (!good) { akObFinish(false); return; }
      akObSpawnPaw();
      // ① 做对：真落子（handleClick 真实路径：SFX+渲染+autosave）
      akObTap(akObCell(good.r, good.c), () => {
        if (akObPhase !== 'demo') return;
        handleClick(good.r, good.c);
        akObText.textContent = 'See that? One tap — the cat lights its whole row and column until a wall blocks it!';
        // renderBoard 清掉了 paw → 重生后演示"做错"
        akObT.push(setTimeout(() => {
          if (akObPhase !== 'demo') return;
          const bad = akObWrongCell();
          const s2 = () => currentPuzzle.size;
          akObSpawnPaw();
          if (bad) akObTap(akObCell(bad.r, bad.c), () => {
            if (akObPhase !== 'demo') return;
            akObFlash(akObCell(bad.r, bad.c));
            const h = playerSolution.map(r => r.slice()); h[bad.r][bad.c] = true;
            const excess = checkViolations(currentPuzzle.grid, h, s2()).some(x => x.type === 'number_excess');
            akObText.textContent = excess
              ? 'Never here! That number already has all its cats — one more would be too many.'
              : 'Never here! This cell is already lit — two cats would SEE each other. That is the one rule to remember.';
            akObT.push(setTimeout(akObYourTurn, 1600));
          }); else akObYourTurn();
        }, 500));
      });
    }
    function akObYourTurn() {
      akObPhase = 'turn';
      akObStep.textContent = 'STEP 3 / 3'; akObTitle.textContent = 'Your turn 🐾';
      akObText.textContent = ({ 1: 'Tap all four cells around the 4 — the number tells you exactly how many cats touch it!',
        2: 'Place a cat on BOTH sides of the 2. They face each other — but the wall blocks their sight, so it is legal!',
        3: 'Three clues, three cats. Each number tells you exactly how many cats touch it.',
        4: 'Bigger board, same rules. Use every number as your anchor!' })[akObLevel] || 'Tap any unlit cell to place a cat. No two cats in the same row or column without a wall between them!';
      akObNext.style.display = 'none';
      akObScheduleIdle();
    }
    function akObScheduleIdle() {
      clearTimeout(akObIdle);
      akObIdle = setTimeout(() => {
        if (akObPhase === 'turn' && !akObPaw && currentPuzzle) {
          const nb = akObFirstBulb();
          if (nb) { akObSpawnPaw(); akObTap(akObCell(nb.r, nb.c), () => akObKillPaw()); }
        }
        akObScheduleIdle();
      }, 3000);
    }
    function akObFinish(complete) {
      if (akObLevel >= 0) { akObTut['t' + akObLevel] = true; akObSave(); }
      clearTimeout(akObIdle); akObKillPaw(); akObCard.classList.add('hidden');
      akObNext.style.display = ''; akObPhase = null;
      try { track(complete ? 'onboard_complete' : 'onboard_skip', { level: akObLevel + 1 }); } catch(e) {}
    }
    function akObOnPlace() { if (akObPhase === 'turn') { akObFinish(true); akObToast(); } }
    function akObMaybeCoach() {
      if (akObPhase !== null) akObFinish(false);
      if (!currentPuzzle || getDifficulty(level).label !== 'Tutorial') return;
      if (akObTut['t' + level]) return;
      akObLevel = level; akObPhase = 'rule';
      akObCard.classList.remove('hidden'); akObSetDots(0); akObNext.style.display = '';
      if (!Object.keys(akObTut).length) {
        akObStep.textContent = 'STEP 1 / 3'; akObTitle.textContent = 'Light up the room 🔍';
        akObText.textContent = 'Tap any cell to place a glowing cat. Cats light their whole row and column until a wall blocks the light.';
        akObNext.textContent = 'Watch how →';
        akObNext.onclick = () => { akObNext.style.display = 'none'; akObPhase = 'demo'; akObSetDots(1); akObStep.textContent = 'STEP 2 / 3'; akObTitle.textContent = 'Watch: right vs wrong 🐾'; akObText.textContent = 'The paw shows a correct tap, then a wrong one. Tap the board any time to take over.'; try { track('onboard_step', { step: 2, level: level + 1 }); } catch(e) {} akObDemo(); };
      } else {
        akObNext.style.display = 'none'; akObPhase = 'demo'; akObSetDots(1);
        akObStep.textContent = 'STEP 2 / 3'; akObTitle.textContent = 'Watch: right vs wrong 🐾';
        akObDemo();
      }
      try { track('onboard_start', { level: level + 1 }); } catch(e) {}
    }
    akObSkip.onclick = () => akObFinish(false);
    // 用户接管：demo 期间真点击 → 直接进 your turn（capture 先于格子 handler，随后那次落子自然毕业）
    gridEl.addEventListener('click', () => { if (akObPhase === 'demo') { akObKillPaw(); akObYourTurn(); } }, true);
    akObMaybeCoach();
  </script>
</body>
</html>
