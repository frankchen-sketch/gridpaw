        }).catch(function () {});
      } catch (e) {}

      // ── Dev 检测：is:inline 脚本不经 Vite，import.meta 会抛 SyntaxError，
      //    用 localhost 主机名等价判定 import.meta.env.DEV（生产域永远 false）──
      var IS_DEV = /^(localhost|127\.0\.0\.1|\[::1\])/.test(location.hostname);

      // ── GA4 track()（与 akari 同款；gpTrack 转发行是硬性要求）──
      function track(event, params) {
        if (window.gpTrack) window.gpTrack(event, params || {});
        if (typeof window.gtag === 'function') {
          var gtagParams = {};
          Object.keys(params || {}).forEach(function (k) {
            if (k === 'source') gtagParams['trigger'] = params[k];
            else if (k === 'medium') gtagParams['evt_medium'] = params[k];
            else if (k === 'campaign') gtagParams['evt_campaign'] = params[k];
            else gtagParams[k] = params[k];
          });
          window.gtag('event', event, gtagParams);
        }
        if (window.posthog && typeof window.posthog.capture === 'function') {
          window.posthog.capture(event, Object.assign({ site: 'gridpaw' }, params || {}));
        }
        if (typeof window.clarity === 'function') {
          window.clarity('event', event);
          if (params) Object.keys(params).forEach(function (k) { window.clarity('set', k, String(params[k])); });
        }
      }

      // ── Traffic source ──
      function detectSource() {
        var p = new URLSearchParams(location.search);
        if (p.get('embed')) return 'embed';
        if (p.get('daily')) return 'daily';
        var ref = document.referrer || '';
        if (!ref) return 'direct';
        if (ref.indexOf(location.hostname) !== -1) return 'internal';
        if (ref.indexOf('google') !== -1) return 'google';
        return 'referral';
      }

      // ── Puzzle state ──
      var DIFFS = { easy: { size: 5, label: 'Easy', badge: 'badge-easy', full: 'Easy 5×5' },
                    medium: { size: 7, label: 'Medium', badge: 'badge-medium', full: 'Medium 7×7' },
                    hard: { size: 10, label: 'Hard', badge: 'badge-hard', full: 'Hard 10×10' } };
      var state = {
        difficulty: 'easy',
        rows: 5,
        cols: 5,
        puzzle: null,
        edges: null,       // Uint8Array 长度 edgeCount(rows,cols)，0|1
        hintsLeft: 3,
        winShown: false,
        timerSec: 0,
        timerId: 0,
        gaStarted: false
      };
      var cellPx = 40;     // 格点间距（CSS px），驱动所有坐标

      // ── QA hook：暴露可 JSON 化的游戏状态（确认事件/边状态用）──
      window.__slState = function () {
        return {
          difficulty: state.difficulty,
          rows: state.rows,
          cols: state.cols,
          dotCount: (state.rows + 1) * (state.cols + 1),
          edgeCount: SlitherEngine.edgeCount(state.rows, state.cols),
          clues: state.puzzle ? Array.from(state.puzzle.clues) : null,
          onCount: state.edges ? Array.prototype.filter.call(state.edges, function (v) { return v === 1; }).length : 0,
          hintsLeft: state.hintsLeft,
          winShown: state.winShown,
          edges: state.edges ? Array.from(state.edges) : null,
          solution: state.puzzle ? Array.from(state.puzzle.solution) : null
        };
      };

      function toast(msg, type) {
        toastEl.textContent = msg;
        toastEl.className = 'toast' + (type ? ' ' + type : '');
        setTimeout(function () { toastEl.classList.remove('show'); }, 2600);
        requestAnimationFrame(function () { toastEl.classList.add('show'); });
      }

      function fmtTime(s) {
        var m = Math.floor(s / 60), ss = s % 60;
        return m + ':' + (ss < 10 ? '0' : '') + ss;
      }

      function startTimer() {
        if (state.timerId) clearInterval(state.timerId);
        state.timerSec = 0;
        timerEl.textContent = '0:00';
        state.timerId = setInterval(function () {
          state.timerSec++;
          timerEl.textContent = fmtTime(state.timerSec);
        }, 1000);
      }

      function stopTimer() {
        if (state.timerId) { clearInterval(state.timerId); state.timerId = 0; }
      }

      // ── Edge indexing helpers（包装 engine，r/c 即点阵坐标）──
      function hIdx(r, c) { return SlitherEngine.hIdx(state.rows, state.cols, r, c); }
      function vIdx(r, c) { return SlitherEngine.vIdx(state.rows, state.cols, r, c); }

      // ── Generation ──
      function newPuzzle(difficulty) {
        var d = DIFFS[difficulty];
        state.difficulty = difficulty;
        state.rows = d.size;
        state.cols = d.size;
        var seed = (Date.now() ^ ((Math.random() * 0x7fffffff) | 0)) | 0;
        var p;
        try {
          p = SlitherEngine.generate(state.rows, state.cols, difficulty, seed);
        } catch (e) {
          toast('Failed to generate puzzle.', 'error');
          return;
        }
        state.puzzle = p;
        state.edges = new Uint8Array(SlitherEngine.edgeCount(state.rows, state.cols));
        state.winShown = false;
        state.hintsLeft = 3;
        // 徽标 / 难度按钮
        diffBadge.className = 'difficulty-badge ' + d.badge;
        diffBadge.textContent = d.full;
        difficultyNameEl.textContent = d.label;
        var diffBtns = document.querySelectorAll('.diff-btn');
        for (var b = 0; b < diffBtns.length; b++) {
          var on = diffBtns[b].getAttribute('data-diff') === difficulty;
          diffBtns[b].classList.toggle('active', on);
          diffBtns[b].setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        updateHintBtn();
        updateCellSize(true);
        startTimer();
        fireGameStart();
      }

      var gaFiredOnce = false;
      function fireGameStart() {
        if (gaFiredOnce) return;
        gaFiredOnce = true;
        track('game_start', { difficulty: DIFFS[state.difficulty].label, source: detectSource() });
      }

      // ── Cell sizing ──
      function updateCellSize(forceRender) {
        var N = state.cols;
        var avail = Math.min(window.innerWidth - 32, 640);
        // wrap padding 10px×2 + 边框 3px×2
        cellPx = Math.max(18, Math.min(60, Math.floor((avail - 20 - 6 - 6) / N), Math.floor((window.innerHeight - 360) / Math.max(state.rows, 1))));
        boardEl.style.width = (N * cellPx) + 'px';
        boardEl.style.height = (state.rows * cellPx) + 'px';
        renderDots();
        renderClues();
        renderEdges();
      }

      // ── Dots（静态层：格点 (rows+1)×(cols+1)）──
      function renderDots() {
        var html = '';
        for (var r = 0; r <= state.rows; r++) {
          for (var c = 0; c <= state.cols; c++) {
            html += '<span class="sl-dot" data-v="' + (r * (state.cols + 1) + c) + '" style="left:' + (c * cellPx) + 'px;top:' + (r * cellPx) + 'px"></span>';
          }
        }
        dotsEl.innerHTML = html;
      }

      // ── Clues（静态层：单元格中心展示 0-3）──
      function renderClues() {
        var html = '';
        var fs = Math.max(11, Math.round(cellPx * 0.44));
        for (var r = 0; r < state.rows; r++) {
          for (var c = 0; c < state.cols; c++) {
            var v = state.puzzle.clues[r * state.cols + c];
            html += '<span class="sl-clue" style="left:' + ((c + 0.5) * cellPx) + 'px;top:' + ((r + 0.5) * cellPx) + 'px;font-size:' + fs + 'px">' + v + '</span>';
          }
        }
        cluesEl.innerHTML = html;
      }

      // ── Edges（动态层：全部边，含透明命中区）──
      function renderEdges() {
        var html = '';
        var H = 16; // 命中区厚度
        // 水平边：点 (r,c)-(r,c+1)，r in 0..rows，c in 0..cols-1
        for (var r = 0; r <= state.rows; r++) {
          for (var c = 0; c < state.cols; c++) {
            var ei = hIdx(r, c);
            html += '<div class="sl-edge h' + (state.edges[ei] ? ' on' : '') + '" data-ei="' + ei + '" style="left:' + (c * cellPx) + 'px;top:' + (r * cellPx - H / 2) + 'px;width:' + cellPx + 'px;height:' + H + 'px" role="button" aria-label="Horizontal edge ' + ei + '"><span class="bar"></span></div>';
          }
        }
        // 垂直边：点 (r,c)-(r+1,c)，r in 0..rows-1，c in 0..cols
        for (var r = 0; r < state.rows; r++) {
          for (var c = 0; c <= state.cols; c++) {
            var ei2 = vIdx(r, c);
            html += '<div class="sl-edge v' + (state.edges[ei2] ? ' on' : '') + '" data-ei="' + ei2 + '" style="left:' + (c * cellPx - H / 2) + 'px;top:' + (r * cellPx) + 'px;width:' + H + 'px;height:' + cellPx + 'px" role="button" aria-label="Vertical edge ' + ei2 + '"><span class="bar"></span></div>';
          }
        }
        edgesEl.innerHTML = html;
        applySoftDegrees();
      }

      // ── 软反馈：度数 >2 的顶点标红 ──
      function applySoftDegrees() {
        var deg = new Int16Array((state.rows + 1) * (state.cols + 1));
        var E = state.edges.length;
        for (var ei = 0; ei < E; ei++) {
          if (!state.edges[ei]) continue;
          var a, b;
          if (ei < (state.rows + 1) * state.cols) {
            var r = Math.floor(ei / state.cols), c = ei % state.cols;
            a = r * (state.cols + 1) + c;
            b = r * (state.cols + 1) + c + 1;
          } else {
            var i2 = ei - (state.rows + 1) * state.cols;
            var r2 = Math.floor(i2 / (state.cols + 1)), c2 = i2 % (state.cols + 1);
            a = r2 * (state.cols + 1) + c2;
            b = (r2 + 1) * (state.cols + 1) + c2;
          }
          deg[a]++; deg[b]++;
        }
        var dots = dotsEl.querySelectorAll('.sl-dot');
        for (var v = 0; v < dots.length; v++) {
          dots[v].classList.toggle('deg-bad', deg[v] > 2);
        }
      }

      // ── Hint（3 次/盘；dev/admin 无限）──
      function unlimitedHints() { return IS_DEV || isAdmin; }

      function updateHintBtn() {
        var unlimited = unlimitedHints();
        hintCountEl.textContent = unlimited ? '(∞)' : '(' + state.hintsLeft + ')';
        var empty = !unlimited && state.hintsLeft <= 0;
        hintBtn.classList.toggle('disabled', empty);
        hintBtn.setAttribute('aria-disabled', empty ? 'true' : 'false');
      }

      function useHint() {
        var ei = -1;
        // 优先提示悬停的边；否则随机挑一条状态未对的边
        var hov = edgesEl.querySelector('.sl-edge.hovering');
        if (hov) {
          ei = parseInt(hov.getAttribute('data-ei'), 10);
          if (state.edges[ei] === SlitherEngine.hintLookup(state.puzzle, ei)) {
            toast('That edge is already correct!');
            return;
          }
        } else {
          var wrong = [];
          for (var k = 0; k < state.edges.length; k++) {
            if (state.edges[k] !== SlitherEngine.hintLookup(state.puzzle, k)) wrong.push(k);
          }
          if (!wrong.length) { toast('Every edge is already correct!'); return; }
          ei = wrong[(Math.random() * wrong.length) | 0];
        }
        if (!unlimitedHints()) {
          if (state.hintsLeft <= 0) {
            toast('No hints left — a new puzzle gives you 3 fresh hints', 'error');
            return;
          }
          state.hintsLeft--;
        }
        state.edges[ei] = SlitherEngine.hintLookup(state.puzzle, ei);
        track('hint_click', { level: state.rows, difficulty: DIFFS[state.difficulty].label });
        updateHintBtn();
        renderEdges();
        // 高亮被提示的边
        var el = edgesEl.querySelector('.sl-edge[data-ei="' + ei + '"]');
        if (el) {
          el.classList.add('hinted');
          setTimeout(function () { el.classList.remove('hinted'); }, 1000);
        }
        maybeWin();
      }

      // ── Win detection（引擎 validate：顶点度数 0|2 + 线索匹配 + 单连通环）──
      function maybeWin() {
        if (state.winShown) return;
        var res = SlitherEngine.validate(state.puzzle, state.edges);
        if (res.ok) showWin();
      }

      function showWin() {
        state.winShown = true;
        stopTimer();
        winDetailEl.textContent = state.rows + '×' + state.cols + ' ' + DIFFS[state.difficulty].label + ' solved in ' + fmtTime(state.timerSec) + '!';
        winOverlay.classList.add('show');
        launchConfetti();
        // leaderboard：上报成绩 + 胜利面板当日榜
        if (window.GPLeaderboard) {
          GPLeaderboard.submit('slitherlink', state.timerSec * 1000).then(function () {
            return GPLeaderboard.mount('slitherlink', document.getElementById('gp-lb-win'));
          });
        }
        track('level_up', { level: state.rows, difficulty: DIFFS[state.difficulty].label, size: state.rows });
      }

      function launchConfetti() {
        if (!confettiEl) return;
        confettiEl.innerHTML = '';
        var colors = ['#E8A888', '#88C8A8', '#FDD09F', '#CFC2E8', '#D47A50', '#559C68', '#FFB3C6'];
        for (var i = 0; i < 60; i++) {
          var d = document.createElement('div');
          d.className = 'confetti';
          d.style.left = (Math.random() * 100) + '%';
          d.style.top = '-10px';
          d.style.background = colors[i % colors.length];
          d.style.animationDuration = (2.2 + Math.random() * 2) + 's';
          d.style.animationDelay = (Math.random() * 0.9) + 's';
          d.style.width = d.style.height = (6 + Math.random() * 8) + 'px';
          confettiEl.appendChild(d);
        }
      }

      function closeWin() { winOverlay.classList.remove('show'); }

      // ── 分享 ──
      function shareText() {
        return 'I solved a ' + state.rows + '×' + state.cols + ' ' + DIFFS[state.difficulty].label + ' Slitherlink puzzle on GridPaw in ' + fmtTime(state.timerSec) + '! Draw one closed loop, no crossings → https://gridpaw.com/slitherlink/';
      }

      // ── Events ──
      edgesEl.addEventListener('click', function (e) {
        var edge = e.target.closest('.sl-edge');
        if (!edge) return;
        var ei = parseInt(edge.getAttribute('data-ei'), 10);
        state.edges[ei] = state.edges[ei] ? 0 : 1;
        renderEdges();
        maybeWin();
      });

      // hover 状态：hint 优先提示悬停边
      edgesEl.addEventListener('mouseover', function (e) {
        var edge = e.target.closest('.sl-edge');
        if (!edge) return;
        var others = edgesEl.querySelectorAll('.sl-edge.hovering');
        for (var i = 0; i < others.length; i++) others[i].classList.remove('hovering');
        edge.classList.add('hovering');
      });
      edgesEl.addEventListener('mouseout', function (e) {
        var edge = e.target.closest('.sl-edge');
        if (!edge) return;
        edge.classList.remove('hovering');
      });

      hintBtn.addEventListener('click', useHint);

      document.getElementById('new-btn').addEventListener('click', function () {
        closeWin();
        newPuzzle(state.difficulty);
      });

      document.getElementById('reset-btn').addEventListener('click', function () {
        closeWin();
        // 同一盘：清空所有边，提示数保留（防止刷 hint）
        state.edges.fill(0);
        track('puzzle_reset', { level: state.rows, difficulty: DIFFS[state.difficulty].label });
        renderEdges();
        startTimer();
      });

      document.getElementById('win-next').addEventListener('click', function () {
        closeWin();
        newPuzzle(state.difficulty);
      });

      document.getElementById('howto-chip').addEventListener('click', function () { rulesOverlay.classList.add('show'); });
      document.getElementById('rules-close').addEventListener('click', function () { rulesOverlay.classList.remove('show'); });
      rulesOverlay.addEventListener('click', function (e) { if (e.target === rulesOverlay) rulesOverlay.classList.remove('show'); });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          if (winOverlay.classList.contains('show')) closeWin();
          else if (rulesOverlay.classList.contains('show')) rulesOverlay.classList.remove('show');
        }
      });

      document.getElementById('share-copy').addEventListener('click', function () {
        track('share_copy', { level: state.rows, difficulty: DIFFS[state.difficulty].label });
        navigator.clipboard.writeText(shareText()).then(function () {
          toast('📋 Copied to clipboard!', 'success');
        }).catch(function () {
          var ta = document.createElement('textarea');
          ta.value = shareText();
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); toast('📋 Copied to clipboard!', 'success'); } catch (e2) {}
          document.body.removeChild(ta);
        });
      });

      document.getElementById('share-twitter').addEventListener('click', function () {
        track('share_twitter', { level: state.rows, difficulty: DIFFS[state.difficulty].label });
        // 带图分享：系统分享面板优先（附棋盘截图）；不可用回退 web intent
        GPShare.shareWithImage({
          boardEl: document.getElementById('sl-board'),
          filename: 'gridpaw-slitherlink.png',
          text: shareText(),
          url: 'https://gridpaw.com/slitherlink/',
          fallback: function () {
            var url = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareText()) + '&url=' + encodeURIComponent('https://gridpaw.com/slitherlink/');
            window.open(url, '_blank', 'noopener,width=620,height=480');
          }
        }).then(function (shared) { if (shared) track('share_image', { game: 'slitherlink', via: 'system' }); });
      });

      document.getElementById('share-reddit').addEventListener('click', function () {
        track('share_reddit', { level: state.rows, difficulty: DIFFS[state.difficulty].label });
        var title = 'I solved a ' + state.rows + '×' + state.cols + ' ' + DIFFS[state.difficulty].label + ' Slitherlink puzzle on GridPaw!';
        GPShare.shareWithImage({
          boardEl: document.getElementById('sl-board'),
          filename: 'gridpaw-slitherlink.png',
          text: title,
          url: 'https://gridpaw.com/slitherlink/',
          fallback: function () {
            var url = 'https://www.reddit.com/submit?url=' + encodeURIComponent('https://gridpaw.com/slitherlink/') + '&title=' + encodeURIComponent(title);
            window.open(url, '_blank', 'noopener,width=680,height=520');
          }
        }).then(function (shared) { if (shared) track('share_image', { game: 'slitherlink', via: 'system' }); });
      });

      // 难度切换
      var diffBtns = document.querySelectorAll('.diff-btn');
      for (var b = 0; b < diffBtns.length; b++) {
        diffBtns[b].addEventListener('click', function () {
          if (this.getAttribute('data-diff') === state.difficulty) return;
          closeWin();
          newPuzzle(this.getAttribute('data-diff'));
        });
      }

      // ── Mobile nav ──
      document.getElementById('mobile-menu-btn').addEventListener('click', function () {
        document.getElementById('mobile-nav').style.display = 'block';
      });
      document.getElementById('mobile-nav-close').addEventListener('click', function () {
        document.getElementById('mobile-nav').style.display = 'none';
      });
      document.getElementById('mobile-nav').addEventListener('click', function (e) {
        if (e.target === this) this.style.display = 'none';
      });

      // ── 窗口尺寸变化时重算格子大小 ──
      window.addEventListener('resize', function () { updateCellSize(false); });

      // ── Start ──
      newPuzzle('easy');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

</body>
</html>