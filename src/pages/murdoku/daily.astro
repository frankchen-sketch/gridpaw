    function loadStreak() { return parseStreak(lsGet(STREAK_KEY)); }
    function saveStreak() { lsSet(STREAK_KEY, JSON.stringify(streakState)); }

    // ── GA4 track()（与 /murdoku/、/murdoku/trail/ 同款；gpTrack 转发行是硬性要求）──
    function track(event, params) {
      if (window.gpTrack) window.gpTrack(event, params || {});
      if (typeof window.gtag === 'function') {
        var gtagParams = {};
        Object.keys(params || {}).forEach(function (k) {
          if (k === 'source') gtagParams['trigger'] = params[k];
          else gtagParams[k] = params[k];
        });
        window.gtag('event', event, gtagParams);
      }
      if (window.posthog && typeof window.posthog.capture === 'function') {
        window.posthog.capture(event, Object.assign({ site: 'gridpaw' }, params || {}));
      }
      if (typeof window.clarity === 'function') {
        window.clarity('event', event);
        if (params) Object.keys(params).forEach(function (k) { window.clarity('set', k, String(params[k])); });
      }
    }
    function detectSource() {
      var p = new URLSearchParams(location.search);
      if (p.get('embed')) return 'embed';
      if (p.get('daily')) return 'daily';
      var ref = document.referrer || '';
      if (!ref) return 'direct';
      if (ref.indexOf(location.hostname) !== -1) return 'internal';
      if (ref.indexOf('google') !== -1) return 'google';
      return 'referral';
    }
    function levelTag() { return N === 4 ? '4x4' : '6x6'; }
    function trackGameStartWhenVisible(fire) {
      if (document.visibilityState === 'visible') { fire(); return; }
      var onVis = function () {
        if (document.visibilityState !== 'visible') return;
        document.removeEventListener('visibilitychange', onVis);
        startQueued = false;
        fire();
      };
      startQueued = true;
      document.addEventListener('visibilitychange', onVis);
    }
    // game_start / daily_start 同一门控：真看到棋盘才算开局（skill game-event-tracking 口径）。
    // first_move 前若还没发（gs 被压在 visibility 队里），同步补发，保事件单调性。
    function fireStartEventsNow() {
      if (startFired) return;
      startFired = true;
      track('game_start', { level: levelTag(), difficulty: 'daily', source: detectSource() });
      if (currentIsToday) track('daily_start', { level: levelTag(), size: N, day: currentKey });
    }
    function fireStartEvents() {
      if (startFired || startQueued) return;
      trackGameStartWhenVisible(fireStartEventsNow);
    }

    // ── 命名 / 渲染工具（与 /murdoku/、/murdoku/trail/ 同源）──
    var titleCase = function (s) { return s.split('-').map(function (w) { return w[0].toUpperCase() + w.slice(1); }).join(' '); };
    function roomName(i) { return titleCase(puzzle.layout.rooms[i].name); }
    function suspectName(i) { return SUSPECT_NAMES[i]; }
    function rowCol(c) { return 'row ' + (Math.floor(c / N) + 1) + ', column ' + (c % N + 1); }
    function clueText(cl) {
      var av = cl.suspect != null ? '<img class="cav" src="' + ASSETS['cat-' + suspectName(cl.suspect).toLowerCase()] + '" alt="">' : '';
      var S = '<b>' + (cl.suspect != null ? suspectName(cl.suspect) : '') + '</b>';
      var R = cl.room != null ? roomName(cl.room) : '';
      var PN = function (p) { return p != null ? (p < N - 1 ? suspectName(p) : VICTIM) : ''; };
      switch (cl.type) {
        case 'loc_in': return av + S + ' was in the <b>' + R + '</b>.';
        case 'loc_not_in': return av + S + ' was <span class="neg">NOT</span> in the <b>' + R + '</b>.';
        case 'on_rug': return av + S + ' was standing on a rug.';
        case 'at_table': return av + S + ' was beside a table.';
        case 'at_wall': return av + S + ' was at a wall.';
        case 'in_corner': return av + S + ' was in a corner.';
        case 'same_room': return av + S + ' was in the same room as <b>' + PN(cl.person) + '</b>.';
        case 'same_room_in': return av + S + ' was with <b>' + PN(cl.person) + '</b> in the <b>' + R + '</b>.';
        case 'only_me_and_x': return av + S + ' was alone with <b>' + PN(cl.person) + '</b>.';
        case 'room_has_k': return 'Exactly <b>' + cl.k + '</b> figure' + (cl.k > 1 ? 's' : '') + ' (victim included) were in the <b>' + R + '</b>.';
        case 'room_empty': return 'The <b>' + R + '</b> was locked — nobody inside.';
        default: return av + S + ': ' + cl.type;
      }
    }

    // ── 顶部日期条 / streak / 7 天存档 ──
    function fmtDayLabel(key) {
      try {
        return new Date(key + 'T00:00:00Z').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
      } catch (e) { return key; }
    }
    function fmtArcDay(key) {
      try {
        return new Date(key + 'T00:00:00Z').toLocaleDateString('en-US', { weekday: 'short', timeZone: 'UTC' });
      } catch (e) { return key.slice(5); }
    }
    function renderDaybar() {
      var size = sizeForDateKey(todayKey);
      document.getElementById('todayLabel').textContent = fmtDayLabel(todayKey);
      document.getElementById('sizeLabel').textContent = size + '×' + size + (size === 6 ? ' · Weekend' : ' · Weekday');
    }
    function renderStreak() {
      var cur = effectiveStreak(streakState, todayKey);
      var week = archiveKeys(todayKey, 7).filter(function (k) { return isSolvedOn(streakState, k); }).length;
      document.getElementById('statStreak').textContent = String(cur);
      document.getElementById('statBest').textContent = String(streakState.best);
      document.getElementById('statWeek').textContent = week + '/7';
      document.getElementById('statStreakBox').classList.toggle('hot', cur >= 3);
    }
    function renderSolvedBanner() {
      var el = document.getElementById('solvedBanner');
      if (!isSolvedOn(streakState, todayKey)) { el.style.display = 'none'; el.innerHTML = ''; return; }
      var cur = effectiveStreak(streakState, todayKey);
      el.style.display = '';
      var compact = window.matchMedia('(max-width: 640px)').matches;
      el.innerHTML = compact
        ? '✓ Today\'s case is closed · streak <b>' + cur + ' day' + (cur === 1 ? '' : 's') + '</b> · replay the last 7 days below'
        : '✓ Today\'s case is already closed. Streak: <b>' + cur + ' day' + (cur === 1 ? '' : 's') + '</b>. ' +
          'Tomorrow\'s case opens at 00:00 UTC — meanwhile you can replay <a href="#archive">any of the last 7 days</a>.';
    }
    function renderArchive() {
      var wrap = document.getElementById('archiveStrip');
      wrap.innerHTML = '';
      archiveKeys(todayKey, 7).forEach(function (key) {
        var isToday = key === todayKey;
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'arc-day' + (isToday ? ' today' : '') + (key === currentKey ? ' cur' : '');
        b.setAttribute('aria-label', (isToday ? 'Today\'s case, ' : 'Archive case, ') + fmtDayLabel(key));
        var size = sizeForDateKey(key);
        b.innerHTML = '<span class="ad-w">' + (isToday ? 'Today' : fmtArcDay(key)) + '</span>' +
          '<span class="ad-d">' + key.slice(5).replace('-', '/') + '</span>' +
          '<span class="ad-s">' + size + '×' + size + '</span>' +
          (isSolvedOn(streakState, key) ? '<span class="ad-tick" aria-hidden="true">✓</span>' : '');
        b.addEventListener('click', function () { loadDay(key, isToday); });
        wrap.appendChild(b);
      });
    }

    // ── 出题：4×4 同步（实测 7ms）；6×6 走 worker（实测 ~400ms / 最慢 1.3s）
    //    重试序列 = seed + tries*7919（与 public/murdoku/worker.js 逐字同序），
    //    40 次仍失败则整段后移 40 个步长再来一段（同序 → 所有人得到同一盘）。
    //    出题后必须 checkSolution 断言真人解（引擎生成期已含唯一解证明 + brute 复核）。──
    function verifyPuzzle(p) {
      try {
        if (!E.checkSolution(p.N, p.layout, p.clues, p.placement.personCell)) return false;
        if (p.N === 4 && typeof E.solveCount === 'function') {
          if (E.solveCount(p.N, p.layout, p.clues, 2, 6e6) !== 1) return false;
        }
        return true;
      } catch (e) { return false; }
    }
    function syncGen(n, seed, cb) {
      setTimeout(function () {
        var p = null;
        for (var i = 0; i < 40 && !p; i++) {
          try { p = E.generatePuzzle(n, seed + i * 7919); } catch (e) { /* null layout attempt */ }
        }
        cb(p);
      }, 20);
    }
    function genOnce(n, seed, cb) {
      if (n === 6 && typeof Worker !== 'undefined') {
        var w = new Worker('/murdoku/worker.js');
        var settled = false;
        w.onmessage = function (e) {
          if (settled) return;
          settled = true; w.terminate();
          cb(e.data && e.data.puzzle ? e.data.puzzle : null);
        };
        w.onerror = function () {
          if (settled) return;
          settled = true; w.terminate();
          syncGen(n, seed, cb);
        };
        w.postMessage({ N: n, seed: seed, id: 1 });
      } else {
        syncGen(n, seed, cb);
      }
    }
    function attemptGen(n, baseSeed, round, myGen, cb) {
      if (myGen !== genSeq) return; // 已被更晚的 loadDay 接管
      var seed = baseSeed + round * 40 * 7919;
      genOnce(n, seed, function (p) {
        if (myGen !== genSeq) return; // 慢回包（6×6 worker）晚到：丢弃，不写盘
        if (p && verifyPuzzle(p)) { cb(p); return; }
        if (round < 2) { attemptGen(n, baseSeed, round + 1, myGen, cb); return; }
        cb(null);
      });
    }

    function loadDay(key, isToday) {
      var myGen = ++genSeq;
      var dayChanged = key !== currentKey;
      currentKey = key;
      currentIsToday = !!isToday;
      N = sizeForDateKey(key);
      // 换日（UTC 零点自动切 / 点「新案已就绪」）时复位开局打点：新的一天必须重新发 daily_start，
      // 否则同日跨夜解题只有 daily_solved 没有 daily_start，卡片停手判据（solved/start）失真。
      if (dayChanged) { startFired = false; startQueued = false; }
      selSuspect = 0; hintsUsed = 0; placed = new Array(N - 1).fill(-1); startTs = Date.now();
      puzzle = null;
      window.__firstMoveTracked = false;
      var chip = document.getElementById('caseChip');
      chip.textContent = (isToday ? 'TODAY ' : 'ARCHIVE ') + key + ' · ' + N + '×' + N;
      chip.className = 'case-chip' + (isToday ? '' : ' archive');
      document.getElementById('clueList').innerHTML = '';
      document.getElementById('suspects').innerHTML = '';
      document.getElementById('hintbox').textContent = isToday ? '' : 'Past case — closing it will not extend your streak.';
      document.getElementById('board').innerHTML =
        '<div class="loading"><span class="paws"><span></span><span></span><span></span><span></span></span><div class="lt">' +
        (N === 6 ? 'Unlocking the 6×6 mansion…' : 'Reopening the case file…') + '</div></div>';
      renderArchive();
      if (!isToday) renderSolvedBanner();
      attemptGen(N, seedForDateKey(key), 0, myGen, function (p) {
        if (myGen !== genSeq) return; // 双保险：旧代次的盘绝不画进当前日期
        if (!p || p.N !== N) {
          document.getElementById('board').innerHTML = '<div class="loading">Case generation failed — tap Restart</div>';
          return;
        }
        puzzle = p;
        placed = new Array(N - 1).fill(-1);
        selSuspect = 0;
        renderAll();
        fireStartEvents();
      });
    }

    function renderAll() { renderBoard(); renderClues(); }

    function renderBoard() {
      var lay = puzzle.layout, board = document.getElementById('board');
      board.style.gridTemplateColumns = 'repeat(' + N + ', 1fr)';
      board.dataset.n = String(N);
      board.innerHTML = '';
      var texIdx = {};
      var texKeys = [];
      Object.keys(ROOM_TEX).forEach(function (n) {
        if (texKeys.indexOf(ROOM_TEX[n]) < 0) texKeys.push(ROOM_TEX[n]);
      });
      var combos = [];
      for (var ti = 0; ti < texKeys.length; ti++)
        for (var ci = 0; ci < TINTS.length; ci++) combos.push([texKeys[ti], TINTS[ci]]);
      // 视觉也用盘面 seed 派生：同一案在所有设备上贴图/色调一致（同盘不同皮的错觉要避免）
      var sh = E.mulberry32(puzzle.seed ^ (N * 7919));
      for (var k = combos.length - 1; k > 0; k--) {
        var jk = (sh() * (k + 1)) | 0;
        var tmp = combos[k]; combos[k] = combos[jk]; combos[jk] = tmp;
      }
      lay.rooms.forEach(function (r, i) {
        var combo = combos[i % combos.length];
        texIdx[r.id] = { tex: ASSETS[combo[0]], tint: combo[1] };
      });
      var seen = {};
      var victimCell = puzzle.placement.personCell[N - 1];
      for (var c = 0; c < lay.C; c++) {
        var div = document.createElement('div');
        div.className = 'cell'; div.dataset.idx = c;
        div.setAttribute('role', 'button');
        div.tabIndex = 0;
        var room = lay.cellRoom[c], t = texIdx[room];
        div.style.backgroundImage = 'url("' + t.tex + '")';
        div.style.backgroundSize = N === 4 ? '56px' : '44px';
        var html = '<span class="tint" style="background:' + t.tint + '"></span>';
        if (!seen[room]) { seen[room] = 1; html += '<span class="rlabel">' + roomName(room) + '</span>'; }
        var o = lay.obj[c];
        if (o === 1) html += '<span class="prop">' + SVG_CRATE + '</span>';
        if (o === 2) html += '<span class="prop">' + SVG_RUG + '</span>';
        if (o === 3) html += '<span class="prop">' + SVG_TABLE + '</span>';
        if (c === victimCell) {
          div.classList.add('victim');
          html += '<img class="fig" src="' + ASSETS['cat-victim'] + '" alt="' + VICTIM + '"><span class="vbadge">V</span>';
          div.title = VICTIM + ' (the victim)';
        }
        var si = placed.indexOf(c);
        if (si >= 0) { html += '<img class="fig" src="' + ASSETS['cat-' + suspectName(si).toLowerCase()] + '" alt="">'; if (si === selSuspect) div.classList.add('placed-sel'); }
        if (selSuspect >= 0 && placed[selSuspect] < 0 && o !== 1 && c !== victimCell) div.classList.add('sel-target');
        div.setAttribute('aria-label', rowCol(c) + ', ' + roomName(room) + (si >= 0 ? ', ' + suspectName(si) : ''));
        div.innerHTML = html;
        div.addEventListener('click', (function (idx) { return function () { onCell(idx); }; })(c));
        div.addEventListener('keydown', (function (idx) {
          return function (e) {
            if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') { e.preventDefault(); onCell(idx); }
          };
        })(c));
        board.appendChild(div);
      }
      renderSuspects();
    }

    function renderClues() {
      var el = document.getElementById('clueList');
      el.innerHTML = '';
      for (var i = 0; i < puzzle.clues.length; i++) {
        var d = document.createElement('div');
        d.className = 'clue';
        d.innerHTML = clueText(puzzle.clues[i]);
        el.appendChild(d);
      }
    }

    function renderSuspects() {
      var el = document.getElementById('suspects');
      el.innerHTML = '';
      for (var s = 0; s < N - 1; s++) {
        var b = document.createElement('button');
        b.type = 'button';
        b.dataset.si = s;
        b.className = 'suss' + (s === selSuspect ? ' sel' : '') + (placed[s] >= 0 ? ' done' : '');
        b.setAttribute('aria-label', 'Select ' + suspectName(s));
        b.innerHTML = '<img src="' + ASSETS['cat-' + suspectName(s).toLowerCase()] + '" alt="' + suspectName(s) + '"><span class="sn">' + suspectName(s) + '</span>';
        b.addEventListener('click', (function (si) { return function () { selSuspect = si; renderBoard(); }; })(s));
        el.appendChild(b);
      }
    }

    function onCell(c) {
      if (!puzzle) return;
      var lay = puzzle.layout;
      var victimCell = puzzle.placement.personCell[N - 1];
      var cur = placed.indexOf(c);
      if (cur >= 0) { placed[cur] = -1; selSuspect = cur; renderBoard(); return; }
      if (c === victimCell) { flashCell(c, 'bad-flash'); setHint("That's the victim — nobody can stand there. Tap an empty floor cell.", true); return; }
      if (lay.obj[c] === 1) { flashCell(c, 'bad-flash'); setHint("That's furniture — suspects can't stand there. Tap an empty floor cell.", true); return; }
      if (selSuspect >= 0 && placed[selSuspect] < 0) {
        var occ = placed.filter(function (x) { return x >= 0; }).concat([victimCell]);
        var conflict = occ.some(function (x) { return Math.floor(x / N) === Math.floor(c / N) || x % N === c % N; });
        if (conflict) { flashCell(c, 'bad-flash'); setHint('The sudoku rule: no two figures share a row or column!', true); return; }
        placed[selSuspect] = c;
        if (!window.__firstMoveTracked) {
          window.__firstMoveTracked = true;
          if (!startFired) fireStartEventsNow();
          track('first_move', { level: levelTag() });
        }
        if (placed.every(function (x) { return x >= 0; })) checkWin(true);
        else { var nxt = placed.findIndex(function (x) { return x < 0; }); selSuspect = nxt; renderBoard(); }
      }
    }

    function flashCell(c, cls) {
      var el = document.querySelector('.cell[data-idx="' + c + '"]');
      if (el) { el.classList.add(cls); setTimeout(function () { el.classList.remove(cls); }, 800); }
    }
    function setHint(t, err) {
      var h = document.getElementById('hintbox');
      h.textContent = t;
      h.classList.toggle('err', !!err);
      h.style.color = err ? '#C0392B' : '';
    }

    function doHint() {
      if (!puzzle) return;
      if (!startFired) fireStartEventsNow();
      track('hint_click', { level: levelTag(), mode: currentIsToday ? 'today' : 'archive' });
      var s = placed[selSuspect] < 0 ? selSuspect : placed.findIndex(function (x) { return x < 0; });
      if (s < 0) { setHint('Everyone is placed — hit Accuse!', false); return; }
      var target = puzzle.placement.personCell[s];
      hintsUsed++;
      var el = document.querySelector('.cell[data-idx="' + target + '"]');
      if (el) { el.classList.add('hint-flash'); setTimeout(function () { el.classList.remove('hint-flash'); }, 1700); }
      setHint(suspectName(s) + ' goes at ' + rowCol(target) + ' (' + roomName(puzzle.layout.cellRoom[target]) + ').');
    }

    function checkWin(auto) {
      if (!puzzle) return;
      if (!startFired) fireStartEventsNow();
      var full = placed.concat([puzzle.placement.personCell[N - 1]]);
      var ok = placed.every(function (x) { return x >= 0; }) && E.checkSolution(N, puzzle.layout, puzzle.clues, full);
      if (!ok) {
        if (!auto) {
          setHint('Not quite — a statement or the sudoku rule is violated. Recheck!', true);
          placed.forEach(function (c) { if (c >= 0) flashCell(c, 'bad-flash'); });
        }
        return;
      }
      var killer = puzzle.placement.killer;
      var secs = Math.round((Date.now() - startTs) / 1000);
      var solvedStreak = effectiveStreak(streakState, todayKey);
      if (currentIsToday) {
        streakState = recordSolve(streakState, currentKey);
        saveStreak();
        solvedStreak = streakState.streak;
        track('daily_solved', { streak: solvedStreak, size: N, day: currentKey });
        if ([3, 7, 14, 30].indexOf(solvedStreak) !== -1) track('streak_milestone', { streak: solvedStreak });
        renderStreak();
        renderArchive();
        renderSolvedBanner();
      }
      track('level_up', { level: levelTag(), difficulty: 'daily', mode: currentIsToday ? 'today' : 'archive' });

      document.getElementById('culpritImg').src = ASSETS['cat-' + suspectName(killer).toLowerCase()];
      document.getElementById('culpritImg').alt = suspectName(killer);
      document.getElementById('winText').innerHTML =
        '<span class="culprit">' + suspectName(killer) + '</span> was alone with ' + VICTIM + '.<br>' +
        'Solved in ' + secs + 's · ' + hintsUsed + ' hint' + (hintsUsed === 1 ? '' : 's') + '.';
      document.getElementById('winStreak').innerHTML = currentIsToday
        ? '🔥 Daily streak: <b>' + solvedStreak + ' day' + (solvedStreak === 1 ? '' : 's') + '</b> · best ' + streakState.best
        : 'Archive case closed — your streak still only counts today\'s case.';
      document.getElementById('winNext').textContent = 'Next case in ' + formatCountdown(msUntilNextUtcMidnight());
      document.getElementById('winOverlay').classList.add('show');
      document.getElementById('winOverlay').dataset.secs = String(secs);
      document.getElementById('winOverlay').dataset.killer = suspectName(killer);
    }

    function closeWin() { document.getElementById('winOverlay').classList.remove('show'); }

    function shareText(src) {
      var ov = document.getElementById('winOverlay');
      var secs = ov.dataset.secs || '?';
      var url = 'https://gridpaw.com/murdoku/daily/?utm_source=' + (src || 'copy') + '&utm_medium=social&utm_campaign=murdoku_daily';
      return 'Murdoku Daily ' + currentKey + ' (' + N + '×' + N + '): case closed in ' + secs + 's. Today\'s case is the same for everyone — can you catch the culprit? ' + url;
    }
    function bindShare(id, trackName, openFn) {
      document.getElementById(id).addEventListener('click', function () {
        if (!startFired) fireStartEventsNow();
        track(trackName, { level: levelTag(), mode: currentIsToday ? 'today' : 'archive' });
        if (trackName === 'share_copy') {
          navigator.clipboard.writeText(shareText('copy')).then(function () { setHint('Copied to clipboard!', false); }).catch(function () {});
        } else { openFn(); }
      });
    }

    // ── 倒计时 + UTC 换日 ──
    function tick() {
      var ms = msUntilNextUtcMidnight();
      var cd = formatCountdown(ms);
      document.getElementById('countdown').textContent = cd;
      var wn = document.getElementById('winNext');
      if (document.getElementById('winOverlay').classList.contains('show')) wn.textContent = 'Next case in ' + cd;
      var nowKey = dateKeyUtc();
      if (nowKey !== todayKey) onNewDay(nowKey);
    }
    function onNewDay(newKey) {
      todayKey = newKey;
      renderDaybar();
      renderStreak();
      renderArchive();
      renderSolvedBanner();
      var untouched = placed.every(function (x) { return x < 0; });
      var overlayOpen = document.getElementById('winOverlay').classList.contains('show');
      if (currentIsToday && untouched && !overlayOpen) {
        document.getElementById('newDayBanner').style.display = 'none';
        loadDay(todayKey, true);
      } else {
        document.getElementById('newDayBanner').style.display = '';
      }
    }

    // ── 事件绑定 ──
    document.getElementById('hintBtn').addEventListener('click', doHint);
    document.getElementById('hintBtn2').addEventListener('click', doHint);
    document.getElementById('checkBtn').addEventListener('click', function () { checkWin(false); });
    document.getElementById('restartBtn').addEventListener('click', function () { closeWin(); loadDay(currentKey, currentIsToday); });
    document.getElementById('closeWinBtn').addEventListener('click', closeWin);
    document.getElementById('newDayBtn').addEventListener('click', function () {
      document.getElementById('newDayBanner').style.display = 'none';
      loadDay(todayKey, true);
    });
    bindShare('shCopy', 'share_copy', null);
    bindShare('shX', 'share_twitter', function () {
      window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareText('twitter')), '_blank', 'noopener,width=620,height=480');
    });
    bindShare('shReddit', 'share_reddit', function () {
      var url = 'https://www.reddit.com/submit?url=' +
        encodeURIComponent('https://gridpaw.com/murdoku/daily/?utm_source=reddit&utm_medium=social&utm_campaign=murdoku_daily') +
        '&title=' + encodeURIComponent('Murdoku Daily ' + currentKey + ': today\'s murder sudoku case');
      window.open(url, '_blank', 'noopener,width=680,height=520');
    });

    // ── Mobile nav ──
    document.getElementById('mobile-menu-btn').addEventListener('click', function () {
      document.getElementById('mobile-nav').style.display = 'block';
    });
    document.getElementById('mobile-nav-close').addEventListener('click', function () {
      document.getElementById('mobile-nav').style.display = 'none';
    });
    document.getElementById('mobile-nav').addEventListener('click', function (e) {
      if (e.target === this) this.style.display = 'none';
    });

    // ── 断签上报（一次断签只报一次：以 lastSolved 为去重键）──
    (function reportStreakBreak() {
      if (!streakState.lastSolved || streakState.streak <= 0) return;
      if (isSolvedOn(streakState, todayKey)) return;
      if (streakState.lastSolved === archiveKeys(todayKey, 2)[1]) return; // 昨天完成，未断
      if (lsGet('murdoku_daily_break_logged') === streakState.lastSolved) return;
      lsSet('murdoku_daily_break_logged', streakState.lastSolved);
      track('streak_break', { broken_streak: streakState.streak, last_day: streakState.lastSolved });
    })();

    // ── Init ──
    renderDaybar();
    renderStreak();
    renderArchive();
    renderSolvedBanner();
    loadDay(todayKey, true);
    tick();
    setInterval(tick, 1000);
    if (IS_DEV) window.__murdokuDaily = { dateKeyUtc: dateKeyUtc, sizeForDateKey: sizeForDateKey, seedForDateKey: seedForDateKey, state: function () { return streakState; } };
  })();
</script>

</body>
</html>
