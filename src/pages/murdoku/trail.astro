    // ── 案件链配置（构建期注入）：{n, seed, hash}；hash = 答案房间名(小写)的 SHA-256。
    // 明文答案不进源码——运行时从解盘推导。wordHash = 藏宝词(小写)的 SHA-256。
    var TRAIL = {
      cases: [
        { n: 4, seed: 12, hash: "1e9b2f93b41c7da7792a48dab8978d1f26b5177421c95682e7d9367d8d83d833" },
        { n: 4, seed: 5, hash: "ca6ff5fa11e3e97eb2c364ebdd7ea17589f27a28fe88f7bb77785db1e493ee6e" },
        { n: 6, seed: 5, hash: "87bb1701ee74015d2546ef91a664e520950e78581ed6e48ff98770f95a1d2854" },
        { n: 6, seed: 4, hash: "529fbc6518d5f4ef8c12b0b5a5bfb4cc1cd2a1344b4b3d0c353803e088399c72" },
        { n: 6, seed: 29, hash: "ed990ff6103f3b53e64285ea4a6e8b4dabdf4824671620aae49902c04d890d98" }
      ],
      wordHash: "d5fde054c77089694a31575462d47ddfba2cddc97bfeb977bf08631f40a51973"
    }
;

    var puzzle = null, N = 4, placed = [], selSuspect = 0, caseIdx = 0, hintsUsed = 0, startTs = 0;
    var gaFiredOnce = false;
    var progress = Math.max(0, Math.min(5, parseInt(lsGet("murdoku_trail_progress") || "0", 10) || 0));
    var inits = lsGet("murdoku_trail_inits") || "";
    if (inits.length > progress) inits = inits.slice(0, progress); // 防脏数据

    function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
    function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

    // ── GA4 track()（与 /murdoku/ 同款）──
    function track(event, params) {
      if (window.gpTrack) window.gpTrack(event, params || {});
      if (typeof window.gtag === 'function') {
        var gtagParams = {};
        Object.keys(params || {}).forEach(function (k) {
          if (k === 'source') gtagParams['trigger'] = params[k];
          else gtagParams[k] = params[k];
        });
        window.gtag('event', event, gtagParams);
      }
      if (window.posthog && typeof window.posthog.capture === 'function') {
        window.posthog.capture(event, Object.assign({ site: 'gridpaw' }, params || {}));
      }
      if (typeof window.clarity === 'function') {
        window.clarity('event', event);
        if (params) Object.keys(params).forEach(function (k) { window.clarity('set', k, String(params[k])); });
      }
    }
    function detectSource() {
      var p = new URLSearchParams(location.search);
      if (p.get('embed')) return 'embed';
      var ref = document.referrer || '';
      if (!ref) return 'direct';
      if (ref.indexOf(location.hostname) !== -1) return 'internal';
      if (ref.indexOf('google') !== -1) return 'google';
      return 'referral';
    }
    function levelTag() { return N === 4 ? '4x4' : '6x6'; }
    function trackGameStartWhenVisible(fire) {
      if (document.visibilityState === 'visible') { fire(); return; }
