    }

    // ── SHA-256（答案门比对；crypto.subtle 需安全上下文，线上 https / 本地 localhost 均满足）──
    function sha256Hex(s) {
      return crypto.subtle.digest('SHA-256', new TextEncoder().encode(s)).then(function (buf) {
        return Array.prototype.map.call(new Uint8Array(buf), function (b) { return ('0' + b.toString(16)).slice(-2); }).join('');
      });
    }

    // ── 命名 / 渲染工具（与 /murdoku/ 同源）──
    var titleCase = function (s) { return s.split("-").map(function (w) { return w[0].toUpperCase() + w.slice(1); }).join(" "); };
    function roomName(i) { return titleCase(puzzle.layout.rooms[i].name); }
    function suspectName(i) { return SUSPECT_NAMES[i]; }
    function rowCol(c) { return "row " + (Math.floor(c / N) + 1) + ", column " + (c % N + 1); }
    function clueText(cl) {
      var av = cl.suspect != null ? '<img class="cav" src="' + ASSETS["cat-" + suspectName(cl.suspect).toLowerCase()] + '" alt="">' : "";
      var S = "<b>" + (cl.suspect != null ? suspectName(cl.suspect) : "") + "</b>";
      var R = cl.room != null ? roomName(cl.room) : "";
      var PN = function (p) { return p != null ? (p < N - 1 ? suspectName(p) : VICTIM) : ""; };
      switch (cl.type) {
        case "loc_in": return av + S + " was in the <b>" + R + "</b>.";
        case "loc_not_in": return av + S + " was <span class=\"neg\">NOT</span> in the <b>" + R + "</b>.";
        case "on_rug": return av + S + " was standing on a rug.";
        case "at_table": return av + S + " was beside a table.";
        case "at_wall": return av + S + " was at a wall.";
        case "in_corner": return av + S + " was in a corner.";
        case "same_room": return av + S + " was in the same room as <b>" + PN(cl.person) + "</b>.";
        case "same_room_in": return av + S + " was with <b>" + PN(cl.person) + "</b> in the <b>" + R + "</b>.";
        case "only_me_and_x": return av + S + " was alone with <b>" + PN(cl.person) + "</b>.";
        case "room_has_k": return "Exactly <b>" + cl.k + "</b> figure" + (cl.k > 1 ? "s" : "") + " (victim included) were in the <b>" + R + "</b>.";
        case "room_empty": return "The <b>" + R + "</b> was locked — nobody inside.";
        default: return av + S + ": " + cl.type;
      }
    }

    // ── Trail 进度条 ──
    function renderTrailBar() {
      var el = document.getElementById("trailBar");
      el.innerHTML = "";
      for (var i = 0; i < 5; i++) {
        var d = document.createElement("div");
        var cls = "trail-node " + (i < progress ? "done" : (i === progress && progress < 5 ? "cur" : "locked"));
        d.className = cls;
        var inner = '<div class="tn-t">Case ' + (i + 1) + '</div>';
        if (i < progress) {
          inner += '<div class="tn-i">' + (inits[i] ? inits[i] : "✓") + '</div><div class="tn-s">Solved</div>';
        } else if (i === progress && progress < 5) {
          inner += '<div class="tn-s">▶ ' + TRAIL.cases[i].n + '×' + TRAIL.cases[i].n + '</div>';
        } else {
          inner += '<div class="tn-s">🔒 ' + TRAIL.cases[i].n + '×' + TRAIL.cases[i].n + '</div>';
        }
        d.innerHTML = inner;
        el.appendChild(d);
      }
    }

    // ── 案件生成：固定 seed（全网同一盘）。6×6 走 Worker，失败兜底同步（seed+i 确定性序列）──
    var genWorker = null;
    function loadCase(idx) {
      caseIdx = idx;
      var cfg = TRAIL.cases[idx];
      N = cfg.n; selSuspect = 0; hintsUsed = 0; startTs = Date.now();
      puzzle = null;
      document.getElementById("hintbox").textContent = "";
      document.getElementById("caseChip").textContent = "CASE №" + (idx + 1) + "/5 · " + N + "×" + N;
      var board = document.getElementById("board");
      board.innerHTML = '<div class="loading"><span class="paws"><span></span><span></span><span></span><span></span></span><div class="lt">Reopening the case file…</div></div>';
      document.getElementById("suspects").innerHTML = "";
      function done(p) {
        if (!p) {
          document.getElementById("board").innerHTML = '<div class="loading">Generation failed — tap Restart</div>';
          return;
        }
        puzzle = p;
        placed = new Array(N - 1).fill(-1);
        window.__firstMoveTracked = false;
        renderAll();
        fireGameStart();
      }
      if (N === 6 && typeof Worker !== 'undefined') {
        if (genWorker) genWorker.terminate();
        genWorker = new Worker('/murdoku/worker.js');
        genWorker.onmessage = function (e) {
          var p = e.data.puzzle;
          genWorker.terminate(); genWorker = null;
          done(p);
        };
        genWorker.onerror = function () {
          genWorker.terminate(); genWorker = null;
          syncFixed(cfg.seed, done);
        };
        genWorker.postMessage({ N: N, seed: cfg.seed, id: 1 });
      } else {
        syncFixed(cfg.seed, done);
      }
    }
    function syncFixed(seed, cb) {
      setTimeout(function () {
        var p = null;
        for (var i = 0; i < 40 && !p; i++) {
          try { p = E.generatePuzzle(N, seed + i); } catch (e) { /* retry next seed in deterministic sequence */ }
        }
        cb(p);
      }, 30);
    }

    function renderAll() { renderBoard(); renderClues(); }

    function renderBoard() {
      var lay = puzzle.layout, board = document.getElementById("board");
      board.style.gridTemplateColumns = "repeat(" + N + ", 1fr)";
      board.innerHTML = "";
      var texIdx = {};
      var texKeys = [];
      Object.keys(ROOM_TEX).forEach(function (n) {
        if (texKeys.indexOf(ROOM_TEX[n]) < 0) texKeys.push(ROOM_TEX[n]);
      });
      var combos = [];
      for (var ti = 0; ti < texKeys.length; ti++)
        for (var ci = 0; ci < TINTS.length; ci++) combos.push([texKeys[ti], TINTS[ci]]);
      var sh = MurdokuEngine.mulberry32(puzzle.seed ^ (N * 7919));
      for (var k = combos.length - 1; k > 0; k--) {
        var jk = (sh() * (k + 1)) | 0;
        var tmp = combos[k]; combos[k] = combos[jk]; combos[jk] = tmp;
      }
      lay.rooms.forEach(function (r, i) {
        var combo = combos[i % combos.length];
        texIdx[r.id] = { tex: ASSETS[combo[0]], tint: combo[1] };
      });
      var seen = {};
      var victimCell = puzzle.placement.personCell[N - 1];
      for (var c = 0; c < lay.C; c++) {
        var div = document.createElement("div");
        div.className = "cell"; div.dataset.idx = c;
        var room = lay.cellRoom[c], t = texIdx[room];
        div.style.backgroundImage = 'url("' + t.tex + '")';
        div.style.backgroundSize = N === 4 ? "56px" : "44px";
        var html = '<span class="tint" style="background:' + t.tint + '"></span>';
        if (!seen[room]) { seen[room] = 1; html += '<span class="rlabel">' + roomName(room) + '</span>'; }
        var o = lay.obj[c];
        if (o === 1) html += '<span class="prop">' + SVG_CRATE + '</span>';
        if (o === 2) html += '<span class="prop">' + SVG_RUG + '</span>';
        if (o === 3) html += '<span class="prop">' + SVG_TABLE + '</span>';
        if (c === victimCell) {
          div.classList.add("victim");
          html += '<img class="fig" src="' + ASSETS["cat-victim"] + '" alt="' + VICTIM + '"><span class="vbadge">V</span>';
          div.title = VICTIM + " (the victim)";
        }
        var si = placed.indexOf(c);
        if (si >= 0) { html += '<img class="fig" src="' + ASSETS["cat-" + suspectName(si).toLowerCase()] + '" alt="">'; if (si === selSuspect) div.classList.add("placed-sel"); }
        if (selSuspect >= 0 && placed[selSuspect] < 0 && o !== 1 && c !== victimCell) div.classList.add("sel-target");
        div.innerHTML = html;
        div.addEventListener("click", (function (idx) { return function () { onCell(idx); }; })(c));
        board.appendChild(div);
      }
      renderSuspects();
    }

    function renderClues() {
      var el = document.getElementById("clueList");
      el.innerHTML = "";
      for (var i = 0; i < puzzle.clues.length; i++) {
        var d = document.createElement("div");
        d.className = "clue";
        d.innerHTML = clueText(puzzle.clues[i]);
        el.appendChild(d);
      }
    }

    function renderSuspects() {
      var el = document.getElementById("suspects");
      el.innerHTML = "";
      for (var s = 0; s < N - 1; s++) {
        var b = document.createElement("button");
        b.dataset.si = s;
        b.className = "suss" + (s === selSuspect ? " sel" : "") + (placed[s] >= 0 ? " done" : "");
        b.innerHTML = '<img src="' + ASSETS["cat-" + suspectName(s).toLowerCase()] + '" alt="' + suspectName(s) + '"><span class="sn">' + suspectName(s) + '</span>';
        b.addEventListener("click", (function (si) { return function () { selSuspect = si; renderBoard(); }; })(s));
        el.appendChild(b);
      }
    }

    function onCell(c) {
      var lay = puzzle.layout;
      var victimCell = puzzle.placement.personCell[N - 1];
      var cur = placed.indexOf(c);
      if (cur >= 0) { placed[cur] = -1; selSuspect = cur; renderBoard(); return; }
      if (c === victimCell) { flashCell(c, "bad-flash"); setHint("That's the victim — nobody can stand there. Tap an empty floor cell.", true); return; }
      if (lay.obj[c] === 1) { flashCell(c, "bad-flash"); setHint("That's furniture — suspects can't stand there. Tap an empty floor cell.", true); return; }
      if (selSuspect >= 0 && placed[selSuspect] < 0) {
        var occ = placed.filter(function (x) { return x >= 0; }).concat([victimCell]);
        var conflict = occ.some(function (x) { return Math.floor(x / N) === Math.floor(c / N) || x % N === c % N; });
        if (conflict) { flashCell(c, "bad-flash"); setHint("The sudoku rule: no two figures share a row or column!", true); return; }
        placed[selSuspect] = c;
        if (!window.__firstMoveTracked) {
          window.__firstMoveTracked = true;
          track('first_move', { level: 'trail' });
        }
        if (placed.every(function (x) { return x >= 0; })) checkWin(true);
        else { var nxt = placed.findIndex(function (x) { return x < 0; }); selSuspect = nxt; renderBoard(); }
      }
    }

    function flashCell(c, cls) {
      var el = document.querySelector('.cell[data-idx="' + c + '"]');
      if (el) { el.classList.add(cls); setTimeout(function () { el.classList.remove(cls); }, 800); }
    }
    function setHint(t, err) { var h = document.getElementById("hintbox"); h.textContent = t; h.classList.toggle("err", !!err); }

    function doHint() {
      if (!puzzle) return;
      track('hint_click', { level: 'trail' });
      var s = placed[selSuspect] < 0 ? selSuspect : placed.findIndex(function (x) { return x < 0; });
      if (s < 0) { setHint("Everyone is placed — hit Accuse!", false); return; }
      var target = puzzle.placement.personCell[s];
      hintsUsed++;
      var el = document.querySelector('.cell[data-idx="' + target + '"]');
      if (el) { el.classList.add("hint-flash"); setTimeout(function () { el.classList.remove("hint-flash"); }, 1700); }
      setHint(suspectName(s) + " goes at " + rowCol(target) + " (" + roomName(puzzle.layout.cellRoom[target]) + ").");
    }

    // ── 过案：不弹房间名（那是答案门的答案）→ 直接开答案门 ──
    function checkWin(auto) {
      var full = placed.concat([puzzle.placement.personCell[N - 1]]);
      var ok = placed.every(function (x) { return x >= 0; }) && E.checkSolution(N, puzzle.layout, puzzle.clues, full);
      if (ok) {
        var k = puzzle.placement.killer;
        var secs = Math.round((Date.now() - startTs) / 1000);
        document.getElementById("culpritImg").src = ASSETS["cat-" + suspectName(k).toLowerCase()];
        document.getElementById("culpritImg").alt = suspectName(k);
        document.getElementById("winText").innerHTML =
          '<span class="culprit">' + suspectName(k) + '</span> was alone with ' + VICTIM + '.<br>' +
          'Solved in ' + secs + 's · ' + hintsUsed + ' hint' + (hintsUsed === 1 ? "" : "s") + '. Now point to the scene:';
        showGate();
        document.getElementById("winOverlay").classList.add("show");
      } else if (!auto) {
        setHint("Not quite — statements or the sudoku rule are violated. Recheck!", true);
        placed.forEach(function (c) { if (c >= 0) flashCell(c, "bad-flash"); });
      }
    }

    // ── 答案门：从解盘推答案（引擎房间名小写）→ SHA-256 比对，明文不进源码 ──
    function answerRoomName() {
      var vr = puzzle.layout.cellRoom[puzzle.placement.personCell[N - 1]];
      return puzzle.layout.rooms[vr].name;
    }
    function showGate() {
      var el = document.getElementById("gateRooms");
      el.innerHTML = "";
      puzzle.layout.rooms.forEach(function (r) {
        var b = document.createElement("button");
        b.textContent = titleCase(r.name);
        b.addEventListener("click", function () { pickRoom(r.name, b); });
        el.appendChild(b);
      });
      document.getElementById("gateBlock").style.display = "";
      document.getElementById("gateNext").style.display = "none";
      document.getElementById("gateMsg").textContent = "";
      document.getElementById("gateMsg").classList.remove("err");
    }
    function pickRoom(name, btn) {
      sha256Hex(name).then(function (h) {
        if (h === TRAIL.cases[caseIdx].hash) {
          track('hunt_answer', { result: 'correct', case: caseIdx + 1 });
          var letter = name[0].toUpperCase();
          if (inits.length <= caseIdx) inits = inits.slice(0, caseIdx) + letter;
          progress = Math.max(progress, caseIdx + 1);
          lsSet("murdoku_trail_progress", String(progress));
          lsSet("murdoku_trail_inits", inits);
          renderTrailBar();
          track('hunt_case_solved', { case: caseIdx + 1, level: levelTag() });
          document.getElementById("gateBlock").style.display = "none";
          document.getElementById("gateMsg").textContent = "";
          if (caseIdx < 4) {
            document.getElementById("initReveal").textContent = letter;
            document.getElementById("gateNext").style.display = "";
          } else {
            closeWin();
            openFinal();
          }
        } else {
          track('hunt_answer', { result: 'wrong', case: caseIdx + 1 });
          var m = document.getElementById("gateMsg");
          m.textContent = "That's not where the killer was caught — reread the victim's room on the board.";
          m.classList.add("err");
          if (btn) { btn.classList.add("shake"); setTimeout(function () { btn.classList.remove("shake"); }, 450); }
        }
      }).catch(function () {
        var m = document.getElementById("gateMsg");
        m.textContent = "Verification failed — check your connection and try again.";
        m.classList.add("err");
      });
    }

    // ── 终局：藏宝词门 ──
    function openFinal() {
      var row = document.getElementById("initRow");
      row.innerHTML = "";
      for (var i = 0; i < 5; i++) {
        var d = document.createElement("div");
        d.className = "init-cell" + (inits[i] ? "" : " empty");
        d.textContent = inits[i] ? inits[i] : "·";
        row.appendChild(d);
      }
      var wordDone = lsGet("murdoku_trail_word") === "1";
      document.getElementById("finalMsg").textContent = "";
      document.getElementById("finalMsg").classList.remove("err");
      document.getElementById("wordRow").style.display = wordDone ? "none" : "";
      document.getElementById("doneBlock").style.display = wordDone ? "" : "none";
      document.getElementById("finalOverlay").classList.add("show");
      if (!wordDone) setTimeout(function () { var w = document.getElementById("wordInput"); if (w) w.focus(); }, 150);
    }
    function submitWord() {
      var v = (document.getElementById("wordInput").value || "").trim().toLowerCase();
      if (!v) return;
      sha256Hex(v).then(function (h) {
        if (h === TRAIL.wordHash) {
          lsSet("murdoku_trail_word", "1");
          track('hunt_completed', {});
          if (window.GPBadges) GPBadges.win();
          document.getElementById("finalMsg").textContent = "";
          document.getElementById("wordRow").style.display = "none";
          document.getElementById("doneBlock").style.display = "";
          showTrailDone();
        } else {
          var m = document.getElementById("finalMsg");
          m.textContent = "Not it — read the five initials in order. You can retry as often as you like.";
          m.classList.add("err");
          var wr = document.getElementById("wordRow");
          wr.classList.add("shake"); setTimeout(function () { wr.classList.remove("shake"); }, 450);
        }
      }).catch(function () {
        var m = document.getElementById("finalMsg");
        m.textContent = "Verification failed — check your connection and try again.";
        m.classList.add("err");
      });
    }
    function showTrailDone() {
      var el = document.getElementById("trailDone");
      el.innerHTML = '🏆 Trail solved — you cracked the Case Trail and caught the Cat Burglar! <a href="/murdoku/" style="color:var(--accent-deep);text-decoration:underline">Play random cases →</a>';
      el.style.display = "";
    }

    function shareText(src) {
      // 分享链接带 UTM：点击打开时 GA4 才能归因到 social × trail_share
      var url = "https://gridpaw.com/murdoku/trail/?utm_source=" + (src || "copy") + "&utm_medium=social&utm_campaign=trail_share";
      return "I'm on the Murder Sudoku Case Trail at GridPaw — five linked cases, one Cat Burglar. Can you crack it before me? " + url;
    }
    function bindShare(id, trackName, openFn) {
      document.getElementById(id).addEventListener("click", function () {
        track(trackName, { level: 'trail' });
        if (trackName === "share_copy") {
          navigator.clipboard.writeText(shareText("copy")).then(function () {
            setHint("Copied to clipboard!");
          }).catch(function () {});
        } else {
          openFn();
        }
      });
    }
    bindShare("shCopy", "share_copy", null);
    bindShare("shX", "share_twitter", function () {
      var url = "https://twitter.com/intent/tweet?text=" + encodeURIComponent(shareText("twitter"));
      window.open(url, "_blank", "noopener,width=620,height=480");
    });
    bindShare("shReddit", "share_reddit", function () {
      var url = "https://www.reddit.com/submit?url=" + encodeURIComponent("https://gridpaw.com/murdoku/trail/?utm_source=reddit&utm_medium=social&utm_campaign=trail_share") + "&title=" + encodeURIComponent("The Murder Sudoku Case Trail: five linked cases, one Cat Burglar");
      window.open(url, "_blank", "noopener,width=680,height=520");
    });

    document.getElementById("hintBtn").addEventListener("click", doHint);
    document.getElementById("hintBtn2").addEventListener("click", doHint);
    document.getElementById("checkBtn").addEventListener("click", function () { checkWin(false); });
    document.getElementById("restartBtn").addEventListener("click", function () { closeWin(); loadCase(caseIdx); });
    document.getElementById("nextCaseBtn").addEventListener("click", function () {
      closeWin();
      loadCase(Math.min(caseIdx + 1, 4));
    });
    document.getElementById("wordBtn").addEventListener("click", submitWord);
    document.getElementById("wordInput").addEventListener("keydown", function (e) {
      if (e.key === "Enter") submitWord();
    });

    function closeWin() {
      document.getElementById("winOverlay").classList.remove("show");
    }

    // ── Mobile nav ──
    document.getElementById("mobile-menu-btn").addEventListener("click", function () {
      document.getElementById("mobile-nav").style.display = "block";
    });
    document.getElementById("mobile-nav-close").addEventListener("click", function () {
      document.getElementById("mobile-nav").style.display = "none";
    });
    document.getElementById("mobile-nav").addEventListener("click", function (e) {
      if (e.target === this) this.style.display = "none";
    });

    // ── Init ──
    renderTrailBar();
    if (progress >= 5) {
      showTrailDone();
      loadCase(4); // 终案可复盘重玩
      if (lsGet("murdoku_trail_word") !== "1") openFinal(); // 破了 5 案还没猜中词 → 续上词门
    } else {
      loadCase(progress);
    }
  })();
</script>

</body>
</html>
