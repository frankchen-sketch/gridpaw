    }

    // ── 矢量道具命名 ──
    var titleCase = function (s) { return s.split("-").map(function (w) { return w[0].toUpperCase() + w.slice(1); }).join(" "); };
    function roomName(i) { return titleCase(puzzle.layout.rooms[i].name); }
    function suspectName(i) { return SUSPECT_NAMES[i]; }
    function rowCol(c) { return "row " + (Math.floor(c / N) + 1) + ", column " + (c % N + 1); }
    function catImg(name, cls) { return '<img class="' + (cls || "cav") + '" src="' + ASSETS["cat-" + name.toLowerCase()] + '" alt="' + name + '">'; }

    function clueText(cl) {
      var av = cl.suspect != null ? catImg(suspectName(cl.suspect)) : "";
      var S = "<b>" + (cl.suspect != null ? suspectName(cl.suspect) : "") + "</b>";
      var R = cl.room != null ? roomName(cl.room) : "";
      var PN = function (p) { return p != null ? (p < N - 1 ? suspectName(p) : VICTIM) : ""; };
      switch (cl.type) {
        case "loc_in": return av + S + " was in the <b>" + R + "</b>.";
        case "loc_not_in": return av + S + " was <span class=\"neg\">NOT</span> in the <b>" + R + "</b>.";
        case "on_rug": return av + S + " was standing on a rug.";
        case "at_table": return av + S + " was beside a table.";
        case "at_wall": return av + S + " was at a wall.";
        case "in_corner": return av + S + " was in a corner.";
        case "same_room": return av + S + " was in the same room as <b>" + PN(cl.person) + "</b>.";
        case "same_room_in": return av + S + " was with <b>" + PN(cl.person) + "</b> in the <b>" + R + "</b>.";
        case "only_me_and_x": return av + S + " was alone with <b>" + PN(cl.person) + "</b>.";
        case "room_has_k": return "Exactly <b>" + cl.k + "</b> figure" + (cl.k > 1 ? "s" : "") + " (victim included) were in the <b>" + R + "</b>.";
        case "room_empty": return "The <b>" + R + "</b> was locked — nobody inside.";
        default: return av + S + ": " + cl.type;
      }
    }

    // ── 生成：6×6 走 Worker（~470ms/次 + 重试 1-2s，阻塞主线程卡 UI）；4×4 可同步 ──
    var genWorker = null;
    function generateCase(size, cb) {
      var seed = (Date.now() ^ ((Math.random() * 0x7fffffff) | 0)) | 0;
      if (size === 6 && typeof Worker !== 'undefined') {
        if (genWorker) { genWorker.terminate(); }
        genWorker = new Worker('/murdoku/worker.js');
        genWorker.onmessage = function (e) {
          var p = e.data.puzzle;
          genWorker.terminate(); genWorker = null;
          cb(p);
        };
        genWorker.onerror = function () {
          // Worker 失败兜底：同步生成
          syncGenerate(size, seed, cb);
        };
        genWorker.postMessage({ N: size, seed: seed, id: 1 });
      } else {
        syncGenerate(size, seed, cb);
      }
    }
    function syncGenerate(size, seed, cb) {
      setTimeout(function () {
        var p = null;
        for (var i = 0; i < 40 && !p; i++) {
          try { p = E.generatePuzzle(size, seed + i * 7919); } catch (e) { /* null layout attempt */ }
        }
        cb(p);
      }, 30);
    }

    function newCase(size) {
      N = size; selSuspect = 0; hintsUsed = 0; startTs = Date.now();
      document.getElementById("hintbox").textContent = "";
      document.getElementById("caseChip").textContent = "CASE №" + caseNo + " · " + N + "×" + N;
      document.getElementById("d4").classList.toggle("on", N === 4);
      document.getElementById("d6").classList.toggle("on", N === 6);
      var board = document.getElementById("board");
      board.innerHTML = '<div class="loading"><span class="paws"><span></span><span></span><span></span><span></span></span><div class="lt">Calling the detectives in…</div></div>';
      document.getElementById("suspects").innerHTML = "";
      // 等待演出：分阶段文案（6×6 兜底生成 1-2s；预热命中时这里只闪一瞬）
      var stages = ["Laying out the house…", "Taking witness statements…", "Hiding the evidence…"];
      var si = 0, stageTimer = setInterval(function () {
        si = (si + 1) % stages.length;
        var el = document.querySelector("#board .loading .lt");
        if (el) el.textContent = stages[si]; else clearInterval(stageTimer);
      }, 750);
      function done(p) {
        clearInterval(stageTimer);
        if (!p) {
          document.getElementById("board").innerHTML = '<div class="loading">Generation failed — try New Case</div>';
          return;
        }
        puzzle = p;
        placed = new Array(N - 1).fill(-1);
        window.__firstMoveTracked = false;
        renderAll();
        fireGameStart();
        // 4×4 玩到第 2 案起，后台预热一个 6×6 案（Worker 空闲，零成本），点 6×6 秒开
        if (N === 4) pregenSix();
      }
      if (size === 6 && cachedSix) {
        var p0 = cachedSix; cachedSix = null;
        done(p0);
        return;
      }
      generateCase(size, done);
    }

    // ── 6×6 预热：独立后台 Worker，与按需生成互不干扰；失败静默（兜底走 generateCase）──
    var cachedSix = null, pregenTried = false;
    function pregenSix() {
      if (cachedSix || pregenTried || typeof Worker === 'undefined') return;
      pregenTried = true;
      try {
        var w = new Worker('/murdoku/worker.js');
        var seed = (Date.now() ^ ((Math.random() * 0x7fffffff) | 0)) | 0;
        w.onmessage = function (e) { cachedSix = e.data.puzzle; w.terminate(); };
        w.onerror = function () { w.terminate(); };
        w.postMessage({ N: 6, seed: seed, id: 1 });
      } catch (e) { /* Worker 不可用 = 走兜底 */ }
    }
    function renderAll() { renderBoard(); renderClues(); }

    function renderBoard() {
      var lay = puzzle.layout, board = document.getElementById("board");
      board.style.gridTemplateColumns = "repeat(" + N + ", 1fr)";
      board.innerHTML = "";
      var texIdx = {};
      lay.rooms.forEach(function (r, i) {
        texIdx[r.id] = { tex: ASSETS[ROOM_TEX[r.name] || "floor-hardwood"], tint: TINTS[i % TINTS.length] };
      });
      var seen = {};
      var victimCell = puzzle.placement.personCell[N - 1];
      for (var c = 0; c < lay.C; c++) {
        var div = document.createElement("div");
        div.className = "cell"; div.dataset.idx = c;
        var room = lay.cellRoom[c], t = texIdx[room];
