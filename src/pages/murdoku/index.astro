        var si = placed.indexOf(c);
        if (si >= 0) { html += '<img class="fig" src="' + ASSETS["cat-" + suspectName(si).toLowerCase()] + '" alt="">'; if (si === selSuspect) div.classList.add("placed-sel"); }
        if (selSuspect >= 0 && placed[selSuspect] < 0 && o !== 1 && c !== victimCell) div.classList.add("sel-target");
        div.innerHTML = html;
        div.addEventListener("click", (function (idx) { return function () { onCell(idx); }; })(c));
        board.appendChild(div);
      }
      renderSuspects();
    }

    function renderClues() {
      var el = document.getElementById("clueList");
      el.innerHTML = "";
      for (var i = 0; i < puzzle.clues.length; i++) {
        var d = document.createElement("div");
        d.className = "clue";
        d.innerHTML = clueText(puzzle.clues[i]);
        el.appendChild(d);
      }
    }

    function renderSuspects() {
      var el = document.getElementById("suspects");
      el.innerHTML = "";
      for (var s = 0; s < N - 1; s++) {
        var b = document.createElement("button");
        b.className = "suss" + (s === selSuspect ? " sel" : "") + (placed[s] >= 0 ? " done" : "");
        b.innerHTML = '<img src="' + ASSETS["cat-" + suspectName(s).toLowerCase()] + '" alt="' + suspectName(s) + '"><span class="sn">' + suspectName(s) + '</span>';
        b.addEventListener("click", (function (si) { return function () { selSuspect = si; renderBoard(); }; })(s));
        el.appendChild(b);
      }
    }

    function onCell(c) {
      var lay = puzzle.layout;
      var victimCell = puzzle.placement.personCell[N - 1];
      var cur = placed.indexOf(c);
      if (cur >= 0) { placed[cur] = -1; selSuspect = cur; renderBoard(); return; }
      if (lay.obj[c] === 1 || c === victimCell) { flashCell(c, "bad-flash"); return; }
      if (selSuspect >= 0 && placed[selSuspect] < 0) {
        var occ = placed.filter(function (x) { return x >= 0; }).concat([victimCell]);
        var conflict = occ.some(function (x) { return Math.floor(x / N) === Math.floor(c / N) || x % N === c % N; });
        if (conflict) { flashCell(c, "bad-flash"); setHint("The sudoku rule: no two figures share a row or column!", true); return; }
        placed[selSuspect] = c;
        // first_move 首次放猫（__firstMoveTracked 防重，与 akari 同款）
        if (!window.__firstMoveTracked) {
          window.__firstMoveTracked = true;
          track('first_move', { level: levelTag() });
        }
        if (placed.every(function (x) { return x >= 0; })) checkWin(true);
        else { var nxt = placed.findIndex(function (x) { return x < 0; }); selSuspect = nxt; renderBoard(); }
      }
    }

    function flashCell(c, cls) {
      var el = document.querySelector('.cell[data-idx="' + c + '"]');
      if (el) { el.classList.add(cls); setTimeout(function () { el.classList.remove(cls); }, 800); }
    }
    function setHint(t, err) { var h = document.getElementById("hintbox"); h.textContent = t; h.classList.toggle("err", !!err); }

    // ── 过案：level_up 记录刚完成的关（4x4/6x6）──
    function checkWin(auto) {
      var full = placed.concat([puzzle.placement.personCell[N - 1]]);
      var ok = placed.every(function (x) { return x >= 0; }) && E.checkSolution(N, puzzle.layout, puzzle.clues, full);
      if (ok) {
        var k = puzzle.placement.killer;
        var kr = puzzle.layout.cellRoom[puzzle.placement.personCell[N - 1]];
        var secs = Math.round((Date.now() - startTs) / 1000);
        document.getElementById("culpritImg").src = ASSETS["cat-" + suspectName(k).toLowerCase()];
        document.getElementById("culpritImg").alt = suspectName(k);
        document.getElementById("winText").innerHTML =
          '<span class="culprit">' + suspectName(k) + '</span> was alone with ' + VICTIM + ' in the <b>' + roomName(kr) + '</b>.<br>' +
          'Solved in ' + secs + 's · ' + hintsUsed + ' hint' + (hintsUsed === 1 ? "" : "s");
        document.getElementById("winOverlay").classList.add("show");
        track('level_up', { level: levelTag() });
        showPromo();
      } else if (!auto) {
        setHint("Not quite — statements or the sudoku rule are violated. Recheck!", true);
        placed.forEach(function (c) { if (c >= 0) flashCell(c, "bad-flash"); });
      }
    }

    // ── 4×4→6×6 难度平滑：第 3 次破 4×4 案时弹晋升（一次性，localStorage 防重）──
    function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
    function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
    function showPromo() {
      var promo = document.getElementById("promoBlock");
      var again = document.getElementById("againBtn");
      if (N === 4) {
        var wins = parseInt(lsGet("murdoku_wins4") || "0", 10) + 1;
        lsSet("murdoku_wins4", String(wins));
        if (wins >= 3 && lsGet("murdoku_promoted") !== "1") {
          promo.style.display = "block";
          again.style.display = "none";
          return;
        }
      }
      promo.style.display = "none";
      again.style.display = "";
    }

    function doHint() {
      if (!puzzle) return;
      track('hint_click', { level: levelTag() });
      var s = placed[selSuspect] < 0 ? selSuspect : placed.findIndex(function (x) { return x < 0; });
      if (s < 0) { setHint("Everyone is placed — hit Accuse!", false); return; }
      var target = puzzle.placement.personCell[s];
      hintsUsed++;
      var el = document.querySelector('.cell[data-idx="' + target + '"]');
      if (el) { el.classList.add("hint-flash"); setTimeout(function () { el.classList.remove("hint-flash"); }, 1700); }
      setHint(suspectName(s) + " goes at " + rowCol(target) + " (" + roomName(puzzle.layout.cellRoom[target]) + ").");
    }

    function shareText(src) {
      var k = puzzle ? suspectName(puzzle.placement.killer) : "?";
      // 分享出去的链接带 UTM：真实帖子被点开时 GA4/自建漏斗才能归因到 twitter/reddit × murdoku_share
      var url = "https://gridpaw.com/murdoku/?utm_source=" + (src || "copy") + "&utm_medium=social&utm_campaign=murdoku_share";
      return "I solved a " + N + "×" + N + " murder sudoku case on GridPaw — " + k + " did it! Can you catch the killer? " + url;
    }
    function bindShare(id, trackName, openFn) {
      document.getElementById(id).addEventListener("click", function () {
        track(trackName, { level: levelTag() });
        if (trackName === "share_copy") {
          navigator.clipboard.writeText(shareText("copy")).then(function () {
            setHint("Copied to clipboard!");
          }).catch(function () {});
        } else {
          openFn();
        }
      });
    }
    bindShare("shCopy", "share_copy", null);
    bindShare("shX", "share_twitter", function () {
      var url = "https://twitter.com/intent/tweet?text=" + encodeURIComponent(shareText("twitter"));
      window.open(url, "_blank", "noopener,width=620,height=480");
    });
    bindShare("shReddit", "share_reddit", function () {
      var url = "https://www.reddit.com/submit?url=" + encodeURIComponent("https://gridpaw.com/murdoku/?utm_source=reddit&utm_medium=social&utm_campaign=murdoku_share") + "&title=" + encodeURIComponent("I solved a murder sudoku case on GridPaw!");
      window.open(url, "_blank", "noopener,width=680,height=520");
    });

    document.getElementById("hintBtn").addEventListener("click", doHint);
    document.getElementById("hintBtn2").addEventListener("click", doHint);
    document.getElementById("checkBtn").addEventListener("click", function () { checkWin(false); });
    document.getElementById("newBtn").addEventListener("click", function () { caseNo++; closeWin(); newCase(N); });
    document.getElementById("againBtn").addEventListener("click", function () { caseNo++; closeWin(); newCase(N); });
    document.getElementById("d4").addEventListener("click", function () { closeWin(); newCase(4); });
    document.getElementById("d6").addEventListener("click", function () { closeWin(); newCase(6); });
    document.getElementById("nextBig").addEventListener("click", function () {
      lsSet("murdoku_promoted", "1");
      caseNo++; closeWin(); newCase(6);
    });
    document.getElementById("staySmall").addEventListener("click", function () {
      lsSet("murdoku_promoted", "1");
      document.getElementById("promoBlock").style.display = "none";
      document.getElementById("againBtn").style.display = "";
    });

    function closeWin() { document.getElementById("winOverlay").classList.remove("show"); }

    // ── Mobile nav ──
    document.getElementById("mobile-menu-btn").addEventListener("click", function () {
      document.getElementById("mobile-nav").style.display = "block";
    });
    document.getElementById("mobile-nav-close").addEventListener("click", function () {
      document.getElementById("mobile-nav").style.display = "none";
    });
    document.getElementById("mobile-nav").addEventListener("click", function (e) {
      if (e.target === this) this.style.display = "none";
    });

    newCase(4);
  })();
</script>

</body>
</html>
