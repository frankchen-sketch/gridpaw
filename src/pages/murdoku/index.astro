        if (o === 2) html += '<span class="prop">' + SVG_RUG + '</span>';
        if (o === 3) html += '<span class="prop">' + SVG_TABLE + '</span>';
        if (c === victimCell) {
          div.classList.add("victim");
          html += '<img class="fig" src="' + ASSETS["cat-victim"] + '" alt="' + VICTIM + '"><span class="vbadge">V</span>';
          div.title = VICTIM + " (the victim)";
