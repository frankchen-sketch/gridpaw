    var SVG_RUG = '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><ellipse cx="32" cy="32" rx="28" ry="22" fill="#D98E7E" opacity=".75"/><ellipse cx="32" cy="32" rx="21" ry="15.5" fill="#F2D5BC" opacity=".8"/><ellipse cx="32" cy="32" rx="13" ry="9.5" fill="#D98E7E" opacity=".8"/><ellipse cx="32" cy="32" rx="6" ry="4.5" fill="#B45309" opacity=".6"/><g stroke="#B45309" stroke-width="1.4" stroke-linecap="round" opacity=".45" stroke-dasharray="3 4"><line x1="3" y1="26" x2="3" y2="38"/><line x1="61" y1="26" x2="61" y2="38"/></g></svg>';
    var SVG_TABLE = '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><circle cx="33" cy="35" r="24" fill="#8A6238" opacity=".22"/><circle cx="32" cy="31" r="24" fill="#C9A87C" opacity=".9"/><circle cx="32" cy="31" r="18" fill="none" stroke="#A98B62" stroke-width="1.4" opacity=".6" stroke-dasharray="5 6"/><circle cx="32" cy="31" r="5" fill="#A98B62" opacity=".7"/></svg>';

    var puzzle = null, N = 4, placed = [], selSuspect = 0, caseNo = 1, hintsUsed = 0, startTs = 0;
    var gaFiredOnce = false;
    var IS_DEV = /^(localhost|127\.0\.0\.1|\[::1\])/.test(location.hostname);

    // ── GA4 track()（与 kenken 同款；gpTrack 转发行是硬性要求）──
    function track(event, params) {
      if (window.gpTrack) window.gpTrack(event, params || {});
      if (typeof window.gtag === 'function') {
        var gtagParams = {};
        Object.keys(params || {}).forEach(function (k) {
          if (k === 'source') gtagParams['trigger'] = params[k];
          else gtagParams[k] = params[k];
        });
        window.gtag('event', event, gtagParams);
      }
      if (window.posthog && typeof window.posthog.capture === 'function') {
        window.posthog.capture(event, Object.assign({ site: 'gridpaw' }, params || {}));
      }
      if (typeof window.clarity === 'function') {
        window.clarity('event', event);
        if (params) Object.keys(params).forEach(function (k) { window.clarity('set', k, String(params[k])); });
      }
    }

    // ── Traffic source ──
    function detectSource() {
      var p = new URLSearchParams(location.search);
      if (p.get('embed')) return 'embed';
      var ref = document.referrer || '';
      if (!ref) return 'direct';
      if (ref.indexOf(location.hostname) !== -1) return 'internal';
      if (ref.indexOf('google') !== -1) return 'google';
      return 'referral';
    }
    function levelTag() { return N === 4 ? '4x4' : '6x6'; }
    function diffLabel() { return N === 4 ? 'Easy' : 'Tricky'; }

    // game_start 口径（2026-10-13 Clarity 取证）：页面可见才算开局——后台标签加载不计，
    // visibilitychange 转可见时补发；直接关掉后台标签 = 不发
    function trackGameStartWhenVisible(fire) {
      if (document.visibilityState === 'visible') { fire(); return; }
      var onVis = function () {
        if (document.visibilityState !== 'visible') return;
