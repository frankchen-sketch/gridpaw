const title = "Brain Puzzle 3: Alle Lösungen (Level 1-137)";
const description = "Brain Puzzle 3 Lösung für jedes Level: Zugfolge, Videowalkthrough und die richtige Geste. Alle 137 Level auf Deutsch, inoffizieller Fan-Leitfaden.";
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Was ist Brain Puzzle 3: Crazy Mind?", "acceptedAnswer": {"@type": "Answer", "text": "Brain Puzzle 3: Crazy Mind ist ein kostenloses Denkspiel von Joygame mit kurzen, storyhaften Szenen: In jedem Level tippst, ziehst oder wischst du das richtige Objekt an die richtige Person und löst damit ein Mini-Rätsel. Es ist der dritte Teil der Reihe, nach Tricky Quest und Logic Twist."}}, {"@type": "Question", "name": "Wie viele Level hat Brain Puzzle 3?", "acceptedAnswer": {"@type": "Answer", "text": "Zum Start waren es deutlich über hundert Story-Level, und mit Updates kommen weitere dazu. Diese Seite deckt Level 1 bis 137 ab. Wo unter derselben Level-Nummer zwei verschiedene Szenen im Umlauf sind, behandelt die jeweilige Lösungsseite beide Fälle."}}, {"@type": "Question", "name": "Ist Brain Puzzle 3 kostenlos?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, Brain Puzzle 3 ist kostenlos für iOS und Android erhältlich und finanziert sich über Werbung. Hinweise lassen sich per Werbevideo freischalten, aber jede Lösung hier ist so geschrieben, dass du ohne Hinweis auskommst."}}, {"@type": "Question", "name": "Warum stimmt mein Level nicht mit der Nummer überein?", "acceptedAnswer": {"@type": "Answer", "text": "Die Level-Nummern sind nicht bei allen Installationen identisch: Spieler berichten dieselbe Szene unter verschiedenen Nummern, und die Walkthrough-Videos von Dritten sind oft anders nummeriert. Deshalb nennt jede Seite den Zielsatz der Szene (“Hilf …”) — such danach, nicht nach der Zahl."}}]};
