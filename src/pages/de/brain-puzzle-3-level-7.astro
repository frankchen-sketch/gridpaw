    description={description}
    canonical="/de/brain-puzzle-3-level-7"
    type="article"
    breadcrumbTitle="Brain Puzzle 3 Level 7"
  />
  <link rel="alternate" hreflang="de" href="https://gridpaw.com/de/brain-puzzle-3-level-7/" />
  <link rel="alternate" hreflang="en" href="https://gridpaw.com/brain-puzzle-3-level-7/" />
  <link rel="alternate" hreflang="x-default" href="https://gridpaw.com/brain-puzzle-3-level-7/" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style is:global>
    :root {
      --amber: #D97706; --cream: #FFFBF5; --green: #15803D;
      --text: #3A2F28; --light: #9C8B7B; --border: #F2E4D4;
      --shadow: 0 2px 8px rgba(217,119,6,0.08);
