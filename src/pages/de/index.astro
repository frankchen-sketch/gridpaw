---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import AdSlot from '../../components/AdSlot.astro';

const title = "Logikrätsel & Denkspiele kostenlos online spielen";
const description = "Kostenlose Logikrätsel direkt im Browser: Shikaku, Akari und weitere Denkspiele mit Katzen-Charme. Regeln in einer Minute verstanden, ohne Download, ohne Anmeldung.";

const faqJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Sind die Denkspiele auf GridPaw kostenlos?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Ja, alle Rätsel auf GridPaw sind kostenlos und laufen direkt im Browser – ohne Download und ohne Anmeldung. Einfach ein Spiel auswählen und losrätseln."
        }
      },
      {
        "@type": "Question",
        name: "Welches Logikrätsel passt für Anfänger?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Shikaku ist der freundlichste Einstieg: Die Regel hat einen Satz, die ersten Rätsel lösen sich in wenigen Minuten. Auch Akari (Light Up) erklärt sich schnell, verlangt aber etwas mehr Planung."
        }
      },
      {
        "@type": "Question",
        name: "Was sind japanische Logikrätsel?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Japanische Logikrätsel sind Gitterrätsel, die sich vollständig durch reines Nachdenken lösen lassen – ohne Wissen und ohne Raten. Die meisten stammen oder wurden popularisiert vom Tokioter Verlag Nikoli, darunter Sudoku, Shikaku und Akari."
        }
      },
      {
        "@type": "Question",
        name: "Brauche ich ein Konto, um Fortschritt zu speichern?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nein. Der Spielfortschritt bleibt im Browser gespeichert, eine Registrierung gibt es nicht. Auf dem Smartphone und am Rechner kannst du sofort weiterspielen, wo du aufgehört hast."
        }
      }
    ]
  }
];
import SideAd from '../../components/SideAd.astro';
