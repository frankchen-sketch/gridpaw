const title = "Brain Puzzle 3 Level 2 Lösung: Den Mann aufwärmen";
const description = "Brain Puzzle 3 Level 2 Lösung: Wärme den Mann mit allen Wärmequellen im Raum auf. Alle 10 Schritte in Reihenfolge plus komplettes Video.";
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Wie lautet die Lösung für Brain Puzzle 3 Level 2?", "acceptedAnswer": {"@type": "Answer", "text": "In dieser Reihenfolge: 1) Ziehe die heiße Suppe zum Protagonisten; 2) Ziehe die Katze zum Protagonisten; 3) Ziehe das Spray am Boden zum Protagonisten; 4) Ziehe das Poster an der Wand zum Protagonisten; 5) Ziehe den Protagonisten in die Badewanne; 6) Tippe auf das Telefon neben dem Protagonisten; 7) Tippe auf die Klimaanlage; 8) Wische nach links auf dem Bedienfeld der Klimaanlage; 9) Doppeltippe, um den Kleiderschrank zu öffnen; 10) Ziehe die Kleidung aus dem Kleiderschrank zum Protagonisten"}}, {"@type": "Question", "name": "Warum passiert nichts, wenn ich in Level 2 tippe?", "acceptedAnswer": {"@type": "Answer", "text": "Sechs der zehn Züge sind Ziehen. Getippt wird nur auf Telefon und Klimaanlage, und an der Klimaanlage folgt direkt der Wisch über das Bedienfeld."}}, {"@type": "Question", "name": "Ist dieser Walkthrough für Level 2 aktuell?", "acceptedAnswer": {"@type": "Answer", "text": "Geprüft gegen die aktuelle Version; die zehn Züge stimmen, nur die Levelnummer kann in älteren Videos abweichen."}}]};
---
<!DOCTYPE html>
<html lang="de">
<head>
  <SEOHead
