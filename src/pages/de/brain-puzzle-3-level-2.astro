    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;margin:1.2rem 0;font-weight:700;font-size:0.95rem">
      <a href="/de/brain-puzzle-3-level-1/" style="text-decoration:none">← Level 1</a>
      <a href="/de/brain-puzzle-3-level-3/" style="text-decoration:none">Level 3 →</a>
