---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import ExtensionPromo from '../../components/ExtensionPromo.astro';
import AdSlot from '../../components/AdSlot.astro';

const title = "How to Play Murder Sudoku: Rules + Example";
const description = "Murder sudoku rules in five minutes: rooms, suspects, witness statements, and how to finger the killer. A solved 4x4 case walks through every deduction. Free.";

const faqJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What is murder sudoku?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Murder sudoku is a hybrid of sudoku and a whodunit mystery. You place named suspects on a grid carved into rooms, guided by witness statements, while a sudoku rule keeps any two figures out of the same row or column. The suspect who ends up alone in the room with the victim is the killer."
        }
      },
      {
        "@type": "Question",
        name: "Is murder sudoku the same as Murdoku?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Not exactly. Murdoku is a popular puzzle-book series that helped drive the murder sudoku trend, similar to how KenKen is one brand of calcudoku. Murder sudoku is the general puzzle type, and several sites and book series publish their own versions of it."
        }
      },
      {
        "@type": "Question",
        name: "Do the clues in a murder sudoku ever contradict each other?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "No. A well-made case is guaranteed to have exactly one arrangement that satisfies every witness statement, every room rule, and the sudoku row and column rule. If your grid stops working, an earlier placement needs to be reconsidered, not the case itself."
        }
      },
      {
        "@type": "Question",
        name: "Where can I play murder sudoku online?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Dedicated sites such as Cluedoku publish a new case every day, Murdoku adds new cases weekly, and a wave of printed puzzle books covers the genre too. GridPaw is building its own cat-flavored take on the formula. In the meantime, GridPaw's free browser puzzles, Shikaku and Akari, scratch a similar pure-deduction itch."
        }
      }
    ]
  }
];
