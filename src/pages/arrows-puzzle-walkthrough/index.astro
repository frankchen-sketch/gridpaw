const title = "Arrows Puzzle Walkthrough: Escape Every Level with These Strategies";
const description = "A complete Arrows Puzzle Escape walkthrough: general strategy for early, mid, and late levels, how to unstick common arrow deadlocks, level progression tips, and answers to the most-asked questions.";

const faqJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What is the arrows puzzle?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "The arrows puzzle (Arrows – Puzzle Escape) is a mobile logic game where you drag directional arrows into empty grid cells so that every arrow points at a matching target. Each level is a sliding-tile-style placement puzzle: you move arrows around the board and every arrow must end up pointing at its goal. Levels grow from a 3x3 warm-up all the way to dense multi-colored grids with locked tiles and teleporters."
        }
      },
      {
        "@type": "Question",
        name: "How many levels are in Arrows Puzzle Escape?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "There are well over 1,000 hand-made levels in Arrows – Puzzle Escape, organized into themed level packs. New packs are added regularly, so the exact count keeps growing. Most players consider the first 100 levels a tutorial: they teach placement, rotation, and color rules one concept at a time."
        }
      },
      {
        "@type": "Question",
        name: "What should I do when I get stuck on an arrows puzzle level?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "First, look for an arrow that has only one legal landing spot left — that is your forcing move. If that does not help, try working backward from the targets: imagine an arrow already placed and ask which arrow could possibly point at the remaining targets. A deadlock usually means a chain trigger happened in the wrong order, so undo your last few moves and re-trigger the chain differently. When all else fails, reset the level and follow the color rule first: place the locked colored arrows before touching movable tiles."
        }
      },
      {
        "@type": "Question",
        name: "Are arrows puzzle levels the same for everyone?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes, in Arrows – Puzzle Escape the levels are hand-designed and identical for every player. You can look up a solution for a specific level number and it will match your board exactly. That is different from procedurally generated puzzles, where every player sees a different layout."
        }
      },
      {
        "@type": "Question",
        name: "Can I play an arrows puzzle online instead of on mobile?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "The official Arrows – Puzzle Escape by Ecffri is a mobile app (Android and iOS) with 100M+ installs, and the levels themselves are not officially available on the web. If you want a similar direction-pointing logic puzzle you can play right in your browser for free, GridPaw's Shikaku game trains the same spatial reasoning with no download and no signup."
        }
      },
      {
        "@type": "Question",
        name: "Is there a trick to solving arrows puzzles faster?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "The fastest solvers use three habits: scan for single-choice arrows first, resolve color-locked tiles before free tiles, and never move an arrow twice. Every move should place a final arrow. If you are sliding arrows around experimentally, you are training to be slow — instead, plan the landing spot before you touch the tile."
        }
      }
    ]
  }
];
