const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is the answer to Brain Puzzle 3 Level 61?", "acceptedAnswer": {"@type": "Answer", "text": "In order: 1) Drag the mop to the boy in the middle.; 2) Drag the trash in the cubicle to the trash can.; 3) Drag the cigarette pack to the trash can.; 4) Drag the water bottle from behind to the trash can.; 5) Drag the fire extinguisher to the man in the restroom.; 6) Drag the fire extinguisher to the fly.; 7) Drag the plunger to the boy in the middle.; 8) Swipe right on the window.; 9) Drag the spider to the crack in the wall.; 10) Drag the feces to the potted plant.; 11) Drag the potted plant to the boy.; 12) Click the boy's backpack.; 13) Drag the toothbrush to the urinal.; 14) Drag the garbage bag to the smoking man."}}, {"@type": "Question", "name": "Why does nothing happen when I tap in Level 61?", "acceptedAnswer": {"@type": "Answer", "text": "Because nothing on this screen answers a plain tap: all 14 moves are 12 drags, 1 swipes. Hold, then drag or swipe exactly as the step card says. In Brain Puzzle 3 a drag that starts on the wrong prop simply snaps back, which looks like a tap doing nothing."}}, {"@type": "Question", "name": "My Level 61 looks different from this page. Why?", "acceptedAnswer": {"@type": "Answer", "text": "Brain Puzzle 3 does not show every player the same scene at the same number, and both variants are on record. This page leads with “Can't hold it anymore!”. If your game shows “Corgi Bath” at level 61, use the second walkthrough on this page."}}]};
