const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is the answer to Brain Puzzle 3 Level 130?", "acceptedAnswer": {"@type": "Answer", "text": "In order: 1) Drag the scissors in the milk tea shop to the light sign's wire; 2) Swipe up the trash can lid; 3) Drag the trash can to the guy; 4) Drag the pen in the waiter's breast pocket to the poster; 5) Tap the guy's pants pocket; 6) Tap the phone; 7) Tap the voice message bar; 8) Drag the guy's stinky shoe to the manhole cover; 9) Drag the cockroaches on the shoe to the guy; 10) Drag the girl's saliva to the queuing machine at the reception.; 11) Drag the flyer in the clerk's hand to the poster; 12) Tap the girl's backpack.; 13) Drag the lollipop in the backpack to the kid; 14) Drag the game token given by the kid to the arcade machine; 15) Drag Sadako from the arcade machine to the boy."}}, {"@type": "Question", "name": "Why does nothing happen when I tap in Level 130?", "acceptedAnswer": {"@type": "Answer", "text": "Level 130 mixes gestures: 10 drags, 4 taps, 1 swipes. Only the tap steps answer a single tap; the rest are drags or swipes. If a tap does nothing, try dragging the object onto the person or thing it belongs to."}}, {"@type": "Question", "name": "My Level 130 looks different from this page. Why?", "acceptedAnswer": {"@type": "Answer", "text": "Brain Puzzle 3 does not show every player the same scene at the same number, and both variants are on record. This page leads with “Queue Dine”. If your game shows “Wanted Sketch” at level 130, use the second walkthrough on this page."}}]};
