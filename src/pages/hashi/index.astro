            else if (k === 'campaign') gtagParams['evt_campaign'] = params[k];
            else gtagParams[k] = params[k];
          });
          window.gtag('event', event, gtagParams);
        }
        if (window.posthog && typeof window.posthog.capture === 'function') {
          window.posthog.capture(event, Object.assign({ site: 'gridpaw' }, params || {}));
        }
        if (typeof window.clarity === 'function') {
          window.clarity('event', event);
          if (params) Object.keys(params).forEach(function (k) { window.clarity('set', k, String(params[k])); });
        }
      }

      // ── Traffic source ──
      function detectSource() {
        var p = new URLSearchParams(location.search);
        if (p.get('embed')) return 'embed';
        if (p.get('daily')) return 'daily';
        var ref = document.referrer || '';
        if (!ref) return 'direct';
        if (ref.indexOf(location.hostname) !== -1) return 'internal';
        if (ref.indexOf('google') !== -1) return 'google';
        return 'referral';
      }

      // ── Puzzle state ──
      var DIFFS = { easy: { rows: 8, cols: 8, islands: 10, label: 'Easy', badge: 'badge-easy', full: 'Easy 8×8' },
                    medium: { rows: 10, cols: 10, islands: 14, label: 'Medium', badge: 'badge-medium', full: 'Medium 10×10' },
                    hard: { rows: 12, cols: 12, islands: 18, label: 'Hard', badge: 'badge-hard', full: 'Hard 12×12' } };
      var state = {
        difficulty: 'easy',
        rows: 8, cols: 8, islandCount: 10,
        puzzle: null,
        counts: null,   // Int8Array per edge 0|1|2
        selA: -1,       // first (anchor) selected island
        selB: -1,       // second selected island
        hintsLeft: 3,
        winShown: false,
        timerSec: 0,
        timerId: 0,
        gaStarted: false
      };

      function toast(msg, type) {
        toastEl.textContent = msg;
        toastEl.className = 'toast' + (type ? ' ' + type : '');
        setTimeout(function () { toastEl.classList.remove('show'); }, 2600);
        requestAnimationFrame(function () { toastEl.classList.add('show'); });
      }

      function fmtTime(s) {
        var m = Math.floor(s / 60), ss = s % 60;
        return m + ':' + (ss < 10 ? '0' : '') + ss;
      }

      function startTimer() {
        if (state.timerId) clearInterval(state.timerId);
        state.timerSec = 0;
        timerEl.textContent = '0:00';
        state.timerId = setInterval(function () {
          state.timerSec++;
          timerEl.textContent = fmtTime(state.timerSec);
        }, 1000);
      }

      function stopTimer() {
        if (state.timerId) { clearInterval(state.timerId); state.timerId = 0; }
      }

      // ── Edge helpers ──
      // (a,b) 之间的候选边索引；不存在返回 -1
      function edgeIndex(a, b) {
        var edges = state.puzzle.edges;
        for (var i = 0; i < edges.length; i++) {
          var e = edges[i];
          if ((e.a === a && e.b === b) || (e.a === b && e.b === a)) return i;
        }
        return -1;
      }
      // 岛 i 的当前桥数总和
      function islandTotal(i) {
        var t = 0;
        var edges = state.puzzle.edges;
        for (var k = 0; k < edges.length; k++) {
          var e = edges[k];
          if (e.a === i || e.b === i) t += state.counts[k];
        }
        return t;
      }
      // 候选边上的两岛之间是否有其它岛挡住（引擎保证不会有，防御性检查）
      function isDirectNeighbor(a, b) {
        return edgeIndex(a, b) !== -1;
      }

      // ── Generation ──
      function newPuzzle(difficulty) {
        var d = DIFFS[difficulty];
        state.difficulty = difficulty;
        state.rows = d.rows; state.cols = d.cols; state.islandCount = d.islands;
        var seed = (Date.now() ^ ((Math.random() * 0x7fffffff) | 0)) | 0;
        var p;
        try {
          p = HashiEngine.generate(d.rows, d.cols, d.islands, difficulty, seed);
        } catch (e) {
          toast('Failed to generate puzzle.', 'error');
          return;
        }
        state.puzzle = p;
        state.counts = new Int8Array(p.edges.length);
        state.selA = -1; state.selB = -1;
        state.winShown = false;
        state.hintsLeft = 3;
        diffBadge.className = 'difficulty-badge ' + d.badge;
        diffBadge.textContent = d.full;
        difficultyNameEl.textContent = d.label;
        islandCountEl.textContent = '🏝️ ' + p.islands.length + ' islands · 🌉 ' + p.edges.length + ' possible bridges';
        var diffBtns = document.querySelectorAll('.diff-btn');
        for (var b = 0; b < diffBtns.length; b++) {
          var on = diffBtns[b].getAttribute('data-diff') === difficulty;
          diffBtns[b].classList.toggle('active', on);
          diffBtns[b].setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        updateHintBtn();
        updateCellSize();
        renderBoard();
        startTimer();
        fireGameStart();
      }

      var gaFiredOnce = false;
      function fireGameStart() {
        if (gaFiredOnce) return;
        gaFiredOnce = true;
        track('game_start', { difficulty: DIFFS[state.difficulty].label, source: detectSource() });
      }

      // ── 布局：格子点阵尺寸（对齐 kenken：上限 72px + 视口高度约束，保证棋盘单屏可见）──
      function updateCellSize() {
        var cols = state.cols, rows = state.rows;
        var avail = Math.min(window.innerWidth - 24, 620);
        var cellByW = Math.floor((avail - 24) / (cols - 1));
        // 高度预算：视口高减去 header/标题/工具栏/状态栏 ≈ 360px
        var cellByH = Math.floor((window.innerHeight - 360) / (rows - 1));
        var cell = Math.max(30, Math.min(72, cellByW, cellByH));
        var radius = Math.max(16, Math.min(34, Math.round(cell * 0.42)));
        var pad = radius + 10;
        var w = (cols - 1) * cell + pad * 2;
        var h = (rows - 1) * cell + pad * 2;
        wrapEl.style.width = w + 'px';
        wrapEl.style.height = h + 'px';
        wrapEl.style.backgroundSize = cell + 'px ' + cell + 'px';
        wrapEl.style.backgroundPosition = pad + 'px ' + pad + 'px';
        // 保存供 renderBoard 使用
        state._cell = cell; state._radius = radius; state._pad = pad;
        state._w = w; state._h = h;
      }

      function islandCenter(i) {
        var isl = state.puzzle.islands[i];
        return { x: state._pad + isl.c * state._cell, y: state._pad + isl.r * state._cell };
      }

      // ── 状态着色：红 = 离谱（未达标），amber = 已达标 ──
      function islandStatus(i) {
        var total = islandTotal(i);
        var need = state.puzzle.islands[i].degree;
        if (total === need) return 'ok';
        if (total > need) return 'err';            // 超了 → 强红
        if (total > 0) return 'err-soft';          // 未达标但已动手 → 浅红
        return '';
      }

      // ── Board render ──
      function renderBoard() {
        var p = state.puzzle;
        var islandsHtml = '';
        var svgParts = [];
        var rad = state._radius;

        // 桥线（先画桥，岛在上面覆盖端点）
        for (var i = 0; i < p.edges.length; i++) {
          var e = p.edges[i];
          var cnt = state.counts[i];
          var A = islandCenter(e.a), B = islandCenter(e.b);
          var horiz = A.y === B.y;
          var x1 = A.x, y1 = A.y, x2 = B.x, y2 = B.y;
          svgParts.push('<line class="hj-hit-line" data-e="' + i + '" x1="' + x1 + '" y1="' + y1 + '" x2="' + x2 + '" y2="' + y2 + '"/>');
          if (cnt > 0) {
            var off = 4;
            if (horiz) {
              if (cnt === 1) {
                svgParts.push('<line class="hj-bridge" x1="' + (x1 + Math.sign(x2 - x1) * rad) + '" y1="' + y1 + '" x2="' + (x2 - Math.sign(x2 - x1) * rad) + '" y2="' + y2 + '"/>');
              } else {
                svgParts.push('<line class="hj-bridge" x1="' + (x1 + Math.sign(x2 - x1) * rad) + '" y1="' + (y1 - off) + '" x2="' + (x2 - Math.sign(x2 - x1) * rad) + '" y2="' + (y2 - off) + '"/>');
                svgParts.push('<line class="hj-bridge" x1="' + (x1 + Math.sign(x2 - x1) * rad) + '" y1="' + (y1 + off) + '" x2="' + (x2 - Math.sign(x2 - x1) * rad) + '" y2="' + (y2 + off) + '"/>');
              }
            } else {
              if (cnt === 1) {
                svgParts.push('<line class="hj-bridge" x1="' + x1 + '" y1="' + (y1 + Math.sign(y2 - y1) * rad) + '" x2="' + x2 + '" y2="' + (y2 - Math.sign(y2 - y1) * rad) + '"/>');
              } else {
                svgParts.push('<line class="hj-bridge" x1="' + (x1 - off) + '" y1="' + (y1 + Math.sign(y2 - y1) * rad) + '" x2="' + (x2 - off) + '" y2="' + (y2 - Math.sign(y2 - y1) * rad) + '"/>');
                svgParts.push('<line class="hj-bridge" x1="' + (x1 + off) + '" y1="' + (y1 + Math.sign(y2 - y1) * rad) + '" x2="' + (x2 + off) + '" y2="' + (y2 - Math.sign(y2 - y1) * rad) + '"/>');
              }
            }
          }
        }
        svgEl.innerHTML = svgParts.join('');
        svgEl.setAttribute('viewBox', '0 0 ' + state._w + ' ' + state._h);

        // 岛
        for (var ii = 0; ii < p.islands.length; ii++) {
          var isl = p.islands[ii];
          var c = islandCenter(ii);
          var cls = 'hj-island';
          var st = islandStatus(ii);
          if (st === 'ok') cls += ' st-ok';
          else if (st === 'err') cls += ' st-err';
          else if (st === 'err-soft') cls += ' st-err-soft';
          if (ii === state.selA) cls += ' sel-a';
          else if (ii === state.selB) cls += ' sel-b';
          var size = rad * 2;
          islandsHtml += '<button type="button" class="' + cls + '" data-i="' + ii + '" aria-label="Island ' + ii + ', needs ' + isl.degree + ' bridges" style="left:' + (c.x - rad) + 'px;top:' + (c.y - rad) + 'px;width:' + size + 'px;height:' + size + 'px;font-size:' + Math.round(rad * 1.15) + 'px">' + isl.degree + '</button>';
        }
        // 岛盖在 SVG 上：把岛的 DOM 插到 wrap（svg 之后）
        var existing = wrapEl.querySelectorAll('.hj-island');
        for (var x = 0; x < existing.length; x++) existing[x].remove();
        var div = document.createElement('div');
        div.style.position = 'absolute';
        div.style.inset = '0';
        div.style.zIndex = '3';
        div.style.pointerEvents = 'none';
        div.innerHTML = islandsHtml;
        wrapEl.appendChild(div);
        state._islandLayer = div;
        // pointer-events 需要岛自己可点
        var btns = div.querySelectorAll('.hj-island');
        for (var y = 0; y < btns.length; y++) btns[y].style.pointerEvents = 'auto';
      }

      // ── Hint（3 次/盘；dev/admin 无限）──
      function unlimitedHints() { return IS_DEV || isAdmin; }

      function updateHintBtn() {
        var unlimited = unlimitedHints();
        hintCountEl.textContent = unlimited ? '(∞)' : '(' + state.hintsLeft + ')';
        var empty = !unlimited && state.hintsLeft <= 0;
        hintBtn.classList.toggle('disabled', empty);
        hintBtn.setAttribute('aria-disabled', empty ? 'true' : 'false');
      }

      function useHint() {
        var p = state.puzzle;
        if (!p) return;
        var target = -1;
        if (state.selA !== -1 && state.selB !== -1 && edgeIndex(state.selA, state.selB) !== -1) {
          target = edgeIndex(state.selA, state.selB);
        } else if (state.selA !== -1) {
          // 找 selA 的第一条未正确填写的邻接边
          for (var i = 0; i < p.edges.length; i++) {
            var e = p.edges[i];
            if ((e.a === state.selA || e.b === state.selA) && state.counts[i] !== p.solution[i]) {
              target = i; break;
            }
          }
        }
        if (target === -1) {
          if (state.selA !== -1) toast('That island\'s bridges are all correct already.');
          else toast('Select an island first!');
          return;
        }
        if (!unlimitedHints()) {
          if (state.hintsLeft <= 0) {
            toast('No hints left — a new puzzle gives you 3 fresh hints', 'error');
            return;
          }
          state.hintsLeft--;
        }
        state.counts[target] = p.solution[target];
        var e2 = p.edges[target];
        track('hint_click', { islands: p.islands.length, difficulty: DIFFS[state.difficulty].label });
        updateHintBtn();
        renderBoard();
        maybeWin();
      }

      // ── 桥循环 0→1→2→0 ──
      function cycleEdge(idx) {
        var next = (state.counts[idx] + 1) % 3;
        state.counts[idx] = next;
        renderBoard();
        maybeWin();
      }

      function setEdge(idx, v) {
        if (v < 0 || v > 2) v = 0;
        state.counts[idx] = v;
        renderBoard();
        maybeWin();
      }

      // ── Win detection（度全满足 + validate 连通性）──
      function maybeWin() {
        if (state.winShown) return;
        var p = state.puzzle;
        var allMatched = true;
        for (var i = 0; i < p.islands.length; i++) {
          if (islandTotal(i) !== p.islands[i].degree) { allMatched = false; break; }
        }
        if (!allMatched) return;
        var check = HashiEngine.validate(p, state.counts);
        if (!check.ok) {
          toast('All islands are matched — but the network is not fully connected!', 'error');
          return;
        }
        showWin();
      }

      function showWin() {
        state.winShown = true;
        stopTimer();
        winDetailEl.textContent = DIFFS[state.difficulty].label + ' Hashi with ' + state.puzzle.islands.length + ' islands solved in ' + fmtTime(state.timerSec) + '!';
        winOverlay.classList.add('show');
        launchConfetti();
        track('level_up', { islands: state.puzzle.islands.length, difficulty: DIFFS[state.difficulty].label });
        // leaderboard：上报成绩 + 胜利面板当日榜
        if (window.GPLeaderboard) {
          GPLeaderboard.submit('hashi', state.timerSec * 1000).then(function () {
            return GPLeaderboard.mount('hashi', document.getElementById('gp-lb-win'));
          });
        }
      }

      function launchConfetti() {
        if (!confettiEl) return;
        confettiEl.innerHTML = '';
        var colors = ['#E8A888', '#88C8A8', '#FDD09F', '#CFC2E8', '#D47A50', '#559C68', '#FFB3C6'];
        for (var i = 0; i < 60; i++) {
          var d = document.createElement('div');
          d.className = 'confetti';
          d.style.left = (Math.random() * 100) + '%';
          d.style.top = '-10px';
          d.style.background = colors[i % colors.length];
          d.style.animationDuration = (2.2 + Math.random() * 2) + 's';
          d.style.animationDelay = (Math.random() * 0.9) + 's';
          d.style.width = d.style.height = (6 + Math.random() * 8) + 'px';
          confettiEl.appendChild(d);
        }
      }

      function closeWin() { winOverlay.classList.remove('show'); }

      // ── 分享 ──
      function shareText() {
        return 'I solved a ' + DIFFS[state.difficulty].label + ' Hashi (Bridges) puzzle with ' + state.puzzle.islands.length + ' islands on GridPaw in ' + fmtTime(state.timerSec) + '! 🌉 Play free, no download → https://gridpaw.com/hashi/';
      }

      // ── Events ──
      // 岛点击：先选 A，再点相邻岛 → 循环；再点非相邻岛 → toast
      wrapEl.addEventListener('click', function (e) {
        var island = e.target.closest('.hj-island');
        if (!island) return;
        var i = parseInt(island.getAttribute('data-i'), 10);
        if (state.selA === -1) {
          state.selA = i; state.selB = -1;
          renderBoard();
          return;
        }
        if (i === state.selA) {
          state.selA = -1; state.selB = -1;
          renderBoard();
          return;
        }
        var idx = edgeIndex(state.selA, i);
        if (idx !== -1) {
          // 相邻候选对 → 循环该边；选中跟随到第二个岛（方便连点循环 1→2→0）
          cycleEdge(idx);
          state.selB = i;
          renderBoard();
          return;
        }
        // 非相邻：重新锚定到新岛，并提示
        state.selA = i; state.selB = -1;
        toast('No bridge can connect those two islands — pick a straight-line neighbor.');
        renderBoard();
      });

      // 直接点击两岛之间的空隙（可见高亮区）→ 循环该桥
      svgEl.addEventListener('click', function (e) {
        var line = e.target.closest('.hj-hit-line');
        if (!line) return;
        var idx = parseInt(line.getAttribute('data-e'), 10);
        if (isNaN(idx)) return;
        cycleEdge(idx);
        var p = state.puzzle, ed = p.edges[idx];
        state.selA = ed.a; state.selB = ed.b;
        renderBoard();
      });

      document.addEventListener('keydown', function (e) {
        if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
        if (e.key === 'Escape') {
          if (winOverlay.classList.contains('show')) { closeWin(); return; }
          if (rulesOverlay.classList.contains('show')) { rulesOverlay.classList.remove('show'); return; }
          state.selA = -1; state.selB = -1;
          renderBoard();
          return;
        }
        if (winOverlay.classList.contains('show') || rulesOverlay.classList.contains('show')) return;

        // Enter：以 selA 为锚，向 selB 方向放桥；无 selB 时选中 selA
        if (e.key === 'Enter') {
          e.preventDefault();
          if (state.selA === -1) { toast('Select an island with the arrow keys first!'); return; }
          if (state.selB !== -1 && edgeIndex(state.selA, state.selB) !== -1) {
            cycleEdge(edgeIndex(state.selA, state.selB));
            renderBoard();
          }
          return;
        }
        // 1/2/0：直接设置当前 (selA, selB) 对的桥数
        if (e.key === '1' || e.key === '2' || e.key === '0') {
          if (state.selA !== -1 && state.selB !== -1 && edgeIndex(state.selA, state.selB) !== -1) {
            e.preventDefault();
            setEdge(edgeIndex(state.selA, state.selB), parseInt(e.key, 10));
          }
          return;
        }
        // 方向键：selA 未选时移动选中第一个岛；已选时把 selB 往方向移动
        var dir = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }[e.key];
        if (dir) {
          e.preventDefault();
          moveSelection(dir[0], dir[1]);
        }
      });

      // 从当前锚点 (selA 或 selB) 向 (dc, dr) 方向找最近的岛
      function moveSelection(dc, dr) {
        var p = state.puzzle;
        if (!p) return;
        var base = state.selA;
        if (state.selA === -1) {
          // 还没有选择：朝方向选最靠边的岛
          var best = -1, bestD = Infinity;
          for (var i = 0; i < p.islands.length; i++) {
            var isl = p.islands[i];
            var d = isl.c * dc + isl.r * dr;
            if (d < bestD) { bestD = d; best = i; }
          }
          if (best !== -1) { state.selA = best; state.selB = -1; renderBoard(); }
          return;
        }
        var ax = p.islands[base].c, ay = p.islands[base].r;
        var cand = -1, candD = Infinity;
        for (var j = 0; j < p.islands.length; j++) {
          if (j === base) continue;
          var isl2 = p.islands[j], ddx = isl2.c - ax, ddy = isl2.r - ay;
          // 同轴（左右 → 同行；上下 → 同列）且方向一致
          if (dc !== 0 && ddy === 0 && Math.sign(ddx) === dc && Math.abs(ddx) < candD) { candD = Math.abs(ddx); cand = j; }
          else if (dr !== 0 && ddx === 0 && Math.sign(ddy) === dr && Math.abs(ddy) < candD) { candD = Math.abs(ddy); cand = j; }
        }
        if (cand !== -1) {
          state.selB = cand;
          renderBoard();
        }
      }

      hintBtn.addEventListener('click', useHint);

      document.getElementById('new-btn').addEventListener('click', function () {
        closeWin();
        newPuzzle(state.difficulty);
      });

      document.getElementById('reset-btn').addEventListener('click', function () {
        closeWin();
        // 同一盘：清空所有桥，提示数保留（防止刷 hint）
        state.counts.fill(0);
        state.selA = -1; state.selB = -1;
        track('puzzle_reset', { islands: state.puzzle.islands.length, difficulty: DIFFS[state.difficulty].label });
        renderBoard();
        startTimer();
      });

      document.getElementById('win-next').addEventListener('click', function () {
        closeWin();
        newPuzzle(state.difficulty);
      });

      document.getElementById('howto-chip').addEventListener('click', function () { rulesOverlay.classList.add('show'); });
      document.getElementById('rules-close').addEventListener('click', function () { rulesOverlay.classList.remove('show'); });
      rulesOverlay.addEventListener('click', function (e) { if (e.target === rulesOverlay) rulesOverlay.classList.remove('show'); });

      document.getElementById('share-copy').addEventListener('click', function () {
        track('share_copy', { islands: state.puzzle.islands.length, difficulty: DIFFS[state.difficulty].label });
        navigator.clipboard.writeText(shareText()).then(function () {
          toast('📋 Copied to clipboard!', 'success');
        }).catch(function () {
          var ta = document.createElement('textarea');
          ta.value = shareText();
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); toast('📋 Copied to clipboard!', 'success'); } catch (e2) {}
          document.body.removeChild(ta);
        });
      });

      document.getElementById('share-twitter').addEventListener('click', function () {
        track('share_twitter', { islands: state.puzzle.islands.length, difficulty: DIFFS[state.difficulty].label });
        // 带图分享：系统分享面板优先（附棋盘截图）；不可用回退 web intent
        GPShare.shareWithImage({
          boardEl: document.getElementById('hj-board-wrap'),
          filename: 'gridpaw-hashi.png',
          text: shareText(),
          url: 'https://gridpaw.com/hashi/',
          fallback: function () {
            var url = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareText()) + '&url=' + encodeURIComponent('https://gridpaw.com/hashi/');
            window.open(url, '_blank', 'noopener,width=620,height=480');
          }
        }).then(function (shared) { if (shared) track('share_image', { game: 'hashi', via: 'system' }); });
      });

      document.getElementById('share-reddit').addEventListener('click', function () {
        track('share_reddit', { islands: state.puzzle.islands.length, difficulty: DIFFS[state.difficulty].label });
        var title = 'I solved a ' + DIFFS[state.difficulty].label + ' Hashi (Bridges) puzzle on GridPaw!';
        GPShare.shareWithImage({
          boardEl: document.getElementById('hj-board-wrap'),
          filename: 'gridpaw-hashi.png',
          text: title,
          url: 'https://gridpaw.com/hashi/',
          fallback: function () {
            var url = 'https://www.reddit.com/submit?url=' + encodeURIComponent('https://gridpaw.com/hashi/') + '&title=' + encodeURIComponent(title);
            window.open(url, '_blank', 'noopener,width=680,height=520');
          }
        }).then(function (shared) { if (shared) track('share_image', { game: 'hashi', via: 'system' }); });
      });

      // 难度切换
      var diffBtns = document.querySelectorAll('.diff-btn');
      for (var b = 0; b < diffBtns.length; b++) {
        diffBtns[b].addEventListener('click', function () {
          if (this.getAttribute('data-diff') === state.difficulty) return;
          closeWin();
          newPuzzle(this.getAttribute('data-diff'));
        });
      }

      // ── Mobile nav ──
      document.getElementById('mobile-menu-btn').addEventListener('click', function () {
        document.getElementById('mobile-nav').style.display = 'block';
      });
      document.getElementById('mobile-nav-close').addEventListener('click', function () {
        document.getElementById('mobile-nav').style.display = 'none';
      });
      document.getElementById('mobile-nav').addEventListener('click', function (e) {
        if (e.target === this) this.style.display = 'none';
      });

      // ── 窗口尺寸变化时重算格子大小 ──
      window.addEventListener('resize', function () { updateCellSize(); renderBoard(); });

      // ── 调试钩子：QA 用（dev/admin only 语义与 kenken 一致，但暴露无害状态对象）──
      window.__hashiDebug = function () {
        var p = state.puzzle;
        return {
          difficulty: state.difficulty,
          rows: state.rows, cols: state.cols,
          islands: p ? p.islands.length : -1,
          edges: p ? p.edges.map(function (e) { return { a: e.a, b: e.b }; }) : [],
          coords: p ? p.islands.map(function (isl) { return { r: isl.r, c: isl.c }; }) : [],
          counts: state.counts ? Array.prototype.slice.call(state.counts) : [],
          solution: p ? Array.prototype.slice.call(p.solution) : [],
          selA: state.selA, selB: state.selB,
          hintsLeft: state.hintsLeft,
          winShown: state.winShown
        };
      };

      // ── Start ──
      newPuzzle('easy');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

</body>
</html>