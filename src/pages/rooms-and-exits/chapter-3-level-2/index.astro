---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 2 Walkthrough: Living Room";
const description = "Rooms & Exits Chapter 3 Level 2 Living Room walkthrough: the 3x3 sliding-tile lid on the bookshelf box opens to give the Key at 2:03, and that Key opens the white door at 5:53 — this level has no numeric keypad, and the run finishes with +50 at a 10:29 in-game time.";

const faq = [
  {
    q: "Does the Living Room have a number code or a keypad?",
    a: "No. We checked all 358 frames of the run and there is no keypad, dial or numeric lock anywhere in the room. Chapter 3 Level 2 is a mechanical level: a <b>3x3 sliding-tile puzzle</b> built into a wooden box lid, a shelf of labelled bottles, a decoder-style <b>Ring with numbers</b> item, and finally a <b>Key</b> used on the white door. If you are hunting for a four-digit code in this room, it does not exist — that is why nothing you type works.",
  },
  {
    q: "How do I open the wooden box on the bookshelf?",
    a: "The box sits on the tall dark-wood bookshelf next to the door, and its lid is a <b>3x3 grid of nine wooden tiles</b> with one tile carrying a small knob. Treat it as a sliding-tile puzzle: slide the tiles with the knob until the pattern resolves, and the box opens. In the run the player starts on it at <b>1:50</b> and has it open by <b>2:03</b>, which is <b>13 seconds</b> of sliding — it is the quickest puzzle in the level.",
  },
  {
    q: "What is inside the box?",
    a: "The <b>Key</b>. At 2:03 the item name <b>Key</b> appears over the open box with the usual sparkle, and the box interior is empty afterwards. That key is the one that ends the level: it is used on the white door on the left wall at <b>5:53</b> and the level completes four seconds later.",
  },
  {
    q: "What is the Ring with numbers for?",
    a: "It is an inventory item you pick up at about <b>1:08</b>, labelled <b>Ring with numbers</b>. It is a ring with digits printed around its circumference — the game's own label says so — and it functions as a decoder rather than a lock. The recording never uses it on anything, so we cannot tell you which prop it decodes. It is not needed to finish the level: the door opens with the Key alone.",
  },
  {
    q: "What are the bottles on the shelf?",
    a: "Five bottles on the narrow shelf unit on the right wall, each with a printed label. Four are legible in the footage: <b>CARA</b>, <b>ICO</b>, <b>ANTARES</b> and <b>PANIAN</b>. The fifth reads as something like <b>CHT ALE</b> and we could not settle it. The player handles them between <b>2:39</b> and <b>3:06</b> — around 27 seconds of picking up, reading and putting back — but nothing opens as a result within the run.",
  },
  {
    q: "What is written on the books on the shelf?",
    a: "Three spines are readable: <b>Impressionism</b>, <b>NCE DE DAMPIERRE</b> (the tail of a longer French title, read consistently in every frame from 0:33 to 0:52), and <b>ci. Genius is made, not born.</b> There are also books printed <b>Wiseman</b> / <b>WISEMAN GROUP.</b>, <b>Dreaming of Sweden</b> and <b>The Future that Disappeared</b>. These are set dressing with real titles, not a cipher — nothing in the level refers back to them.",
  },
  {
    q: "What is on the coffee table?",
    a: "A <b>scribbled note</b> — a sheet of white paper covered in dense dark scribble — plus a marble tray with dark biscuits and green grapes and a folded newspaper. Examining the note at about <b>4:00</b> is where the run spends most of its second half, and the characters showing through the scribble are not reliably readable; we tried at 4x and got a different answer every frame.",
  },
  {
    q: "How long is the level and what is the reward?",
    a: "The recording runs <b>5:58</b>. The LEVEL COMPLETED card appears at <b>5:57</b> with <b>Reward +50</b> coins and <b>Time: 10:29</b> on the in-game clock. The level is marked <b>Hard</b> on the chapter map. That 10:29 is the game's own timer, not the video length — the player had already been in the room before the capture started.",
  },
  {
    q: "Where is the exit door?",
    a: "On the <b>left wall</b>, next to the tall bookshelf — a plain white panelled door with a lever handle and no keypad, no dial and no number plate. It is opened with the Key from the bookshelf box and nothing else.",
  },
  {
    q: "What do the window blinds do?",
    a: "Nothing, as far as this run shows. The back wall has a wide window with horizontal blinds and the player examines it at <b>1:44</b>, but the blinds do not move and nothing is hidden behind them. They are the one big piece of scenery in the room that is not interactive.",
  },
  {
    q: "Do I need the glass of water?",
    a: "A <b>Glass of water</b> is in the inventory at <b>1:21</b>, and the inventory strip reads Use / Combine / Dismantle / Examine. We never see it used on anything in the footage — no plant, no fire, no powder. Treat it as a carried item, not a step.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead
    title={title}
    description={description}
    canonical="/rooms-and-exits/chapter-3-level-2"
    type="article"
    breadcrumbTitle="Rooms & Exits Chapter 3 Level 2"
  />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --amber: #D97706; --cream: #FFFBF5; --green: #15803D;
      --text: #3A2F28; --light: #9C8B7B; --border: #F2E4D4;
      --shadow: 0 2px 8px rgba(217,119,6,0.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Nunito', -apple-system, sans-serif; background: var(--cream); color: var(--text); min-height: 100vh; }
