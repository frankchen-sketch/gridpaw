const title = "Rooms & Exits Chapter 1 Level 8 Walkthrough: Log Cabin";
const description = "Rooms & Exits Chapter 1 Level 8 Log Cabin walkthrough: the laptop display that wants 1746, the six animal portraits hiding a red safe, the two collection sets (8 stained glass, 5 tiles) and the door keypad code 358429 that ends the level.";
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {"@type": "Question", "name": "What is the code for the door at the end of Log Cabin?", "acceptedAnswer": {"@type": "Answer", "text": "358429. It is written on the piece of paper you pick up at the very end of the level, after the last puzzle is solved, and the six-digit keypad beside the door takes it."}},
  {"@type": "Question", "name": "What is the four-digit code on the laptop in Level 8?", "acceptedAnswer": {"@type": "Answer", "text": "1746. The laptop on the desk by the window shows 0000 when you open it; the recording sets it to 1746 and the display takes it. We read the seven-segment digits twice at high zoom because OCR tends to confuse 7 with 0 and 6 with 3 on that font."}},
  {"@type": "Question", "name": "How many stained glass pieces and tiles are there in Log Cabin?", "acceptedAnswer": {"@type": "Answer", "text": "Two separate collections: eight stained glass pieces, which reach 8/8 at 3:22, and five coloured tiles, which reach 5/5 at 2:46. They feed the two last puzzles, not the door."}},
  {"@type": "Question", "name": "What is behind the animal portraits in Log Cabin?", "acceptedAnswer": {"@type": "Answer", "text": "A red safe with twelve paw-print buttons, green and red buttons underneath them, and a gold dial on the right. Solving the wall opens the compartment; the safe itself opens after the paw-print sequence from the desk drawer."}},
  {"@type": "Question", "name": "Does Log Cabin have a timed puzzle?", "acceptedAnswer": {"@type": "Answer", "text": "No. Nothing in Level 8 is on a clock. The longest single puzzle is the hexagonal glass panel in the last third, which took the recording about ninety seconds."}}]};
