import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 13 Walkthrough: Grocery Store";
const description = "Rooms & Exits Chapter 2 Level 13 walkthrough for the Grocery Store: the wallet that dismantles into a coin and the 58431267 code card, the vent's eight-button panel, the five-dial drinks-fridge code 02725, the barcode chores and the exit code 65219.";
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {"@type": "Question", "name": "What is the final code in Rooms & Exits Chapter 2 Level 13?", "acceptedAnswer": {"@type": "Answer", "text": "65219. It goes into the five-slot plate under the self-checkout counter near the self-scan tills, and that plate starts at 00000. Our recording dials 6-5-2-1-9, reads the last slot turning from 8 to 9, and the plate closes the moment it reads 65219; a second recording of the same level also ends on that number. Under the plate is one big red button, and pressing it finishes the level."}},
  {"@type": "Question", "name": "What is the code on the drinks fridge dials?", "acceptedAnswer": {"@type": "Answer", "text": "02725. The fridge with five square buttons under its shelves hides one digit inside each row of cans: tap a row, the cans spin, and one can shows a number. The five digits are 0-2-7-2-5, and the five dials under that fridge start at 00000 and take them one slot at a time. Accepted, the fridge drops a key."}},
  {"@type": "Question", "name": "Where do I get the coin and the code card?", "acceptedAnswer": {"@type": "Answer", "text": "From the wallet in the blue shopping basket by the self-scan tills. Take the wallet, open the inventory, select it and press Dismantle: it splits into a Coin and a printed card labelled Code that reads 58431267. The coin is the only tool that opens the vent, and the card is what the eight vent buttons are for."}},
  {"@type": "Question", "name": "How do I get the vent cover off?", "acceptedAnswer": {"@type": "Answer", "text": "Select the coin from the inventory and tap each of the four screws on the grey vent cover. The cover comes away and exposes a brushed panel with eight round buttons along the bottom and eight modules with lamps along the top, wired together with yellow tangles. The buttons do not correspond to the modules directly above them, so work from the order the Code card gives, not from the layout."}},
  {"@type": "Question", "name": "Where is the green shovel?", "acceptedAnswer": {"@type": "Answer", "text": "In the blue locker bank in the back-right corner of the store, under the yellow-framed screen. Tap the lockers, let the bank open, and take the green shovel. It is the only item in the lockers, and you need it later on the flower pot beside them."}},
  {"@type": "Question", "name": "How do I fix the juicer and get the receipt?", "acceptedAnswer": {"@type": "Answer", "text": "Four things, in this order: drop the orange into the hopper on top, open the small door under the hopper and seat the combined gear in the empty socket, set the bottle under the spout, then press the button. It runs, fills the bottle and prints a receipt. Read the receipt with the hand barcode reader to log the last barcode."}},
  {"@type": "Question", "name": "Where are the two gear parts?", "acceptedAnswer": {"@type": "Answer", "text": "One is inside the chest freezer at the back, behind the cracked pane that only the hammer will break. The other is buried in the flower pot beside the lockers: pour the bottle into the soil first, then dig with the green shovel. Combine the two parts in the inventory and you get the gear the juicer is missing."}},
  {"@type": "Question", "name": "How long does the Grocery Store take and what does it pay?", "acceptedAnswer": {"@type": "Answer", "text": "The recording finishes it in 16:02 of level time for +50 coins; a second, faster recording clears the same room in 15:03. There is no timer and no fail state. The length comes from four barcodes and two five-digit panels, not from difficulty."}}
]};
