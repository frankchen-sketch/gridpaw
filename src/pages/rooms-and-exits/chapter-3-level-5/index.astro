---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 5 Walkthrough: Workshop";
const description = "Rooms & Exits Chapter 3 Level 5 walkthrough for the Workshop: the five-column panel on the red machine that settles on 41018, the Morse paper, the laptop that unlocks to 14:00, and the Roman-numeral clock — with an honest note on what the recording does not show.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 5 Workshop?",
    a: "The one numeric answer the room gives you outright is <b>41018</b>, on the <b>five-column display of the red machine with the two glass tubes</b>. Read the middle row of the 3x5 grid left to right and you get <b>4 1 0 1 8</b>; the columns stop moving there, the view closes and the machine is done. The other lock in the Workshop is the <b>laptop</b>, which asks for a text password rather than digits — its characters are masked on screen, so this page does not print a value for it.",
  },
  {
    q: "Where is the 41018 panel?",
    a: "On the red machine that sits on the bench under the shelves, the one flanked by two clear glass tubes full of wire. Tap it and the room zooms in on a grid of dark tiles, five columns wide and three rows tall, each tile carrying one white digit. It sits at the end of the bench near the safe, and it is easy to mistake for a label rather than a lock the first time you pass it.",
  },
  {
    q: "How should I read the 3x5 grid?",
    a: "By columns, not by rows, and only the <b>middle</b> one counts. Each column is a wheel showing the digit above, the digit you have selected and the digit below — the same three-window arrangement as a padlock. In the settled frame the five columns read <b>5/4/3</b>, <b>2/1/0</b>, <b>1/0/9</b>, <b>2/1/0</b> and <b>9/8/7</b>, so the middle row is <b>4 1 0 1 8</b>. Reading the top row instead gives 5 2 1 2 9 and nothing happens.",
  },
  {
    q: "What is the laptop password?",
    a: "We could not read it. The laptop opens on a blue login window with a question-mark avatar and a field that says <b>Enter Password</b>; at <b>1:40</b> the avatar changes to a smiling face and the field shows a short masked string, and by <b>1:42</b> the machine has unlocked. The mask hides the characters, and the room's only text clue — the crumpled piece of paper — is a row of Morse marks rather than a word this page can pin to a keyboard.",
  },
  {
    q: "What does the laptop show once it opens?",
    a: "A digital clock reading <b>14:00</b> on a black screen with a green display. That is the laptop's payoff and it is a clue, not a lock: the Workshop's other time puzzle is the big wooden wall clock with Roman numerals on its face, and 14:00 is the only time value the room hands you. On a twelve-hour dial that is two o'clock.",
  },
  {
    q: "What is written on the wall note?",
    a: "Two lines in white chalk on the dark panelled wall beside the safe: <b>XC=3</b> and <b>4=XL-10</b>. It is not standard Roman notation — XC is 90 and XL is 40 — which is the point: the note is asking you to treat the numerals as values to manipulate rather than to read. The walkthrough video annotates the same wall in red with <b>XC=90</b>, <b>X=10</b> and <b>L=50</b> as it works the puzzle out.",
  },
  {
    q: "What is on the piece of paper?",
    a: "A single row of Morse marks. The clearest frame is at <b>1:20</b>, where the game labels it <b>Piece of paper</b>: the marks read <b>..- .--. . ...</b> — four groups, which in standard Morse are U, P, E and S. It is the only written clue in the Workshop that is not a number, and the laptop is the only lock in the Workshop that takes text, so the two belong together even though the masked field stops us confirming the exact string.",
  },
  {
    q: "How do I open the safe?",
    a: "The safe is the green-grey box on the blue shelf unit on the left wall. Its door carries a large circular dial marked <b>0 to 90</b> in tens, with nine fine ticks between each number, plus a smaller lock above it and a latch handle on the right. In the recording the dial is turned repeatedly from <b>4:28</b> onwards; the video ends before the door swings, so this page does not print a combination for it.",
  },
  {
    q: "What is the birdcage for?",
    a: "At <b>3:15</b> the camera settles on a large empty birdcage hanging beside the window, with a small wooden box sitting inside it. The cage is a container puzzle: you have to get the box out. The recording opens the cage and takes the box but never holds a frame long enough to show how the latch works, so treat it as a place to look with a tool rather than a code.",
  },
  {
    q: "Is Workshop the fifth room of Chapter 3?",
    a: "Yes. Chapter 3 is <i>Murder Dressed in White</i>, and Workshop is room <b>5 of 15</b> — the first room of the chapter after the level-select screen, before Guest Bedroom (6) and Master Bathroom (7). It is the chapter's most mechanical room: a pegboard wall of tools, a workbench with a red toolbox, a bench-mounted machine with two glass tubes, a green safe on a blue shelf, a birdcage, a cuckoo clock and a big Roman-numeral wall clock.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
