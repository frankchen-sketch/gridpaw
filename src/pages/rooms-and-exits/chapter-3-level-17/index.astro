import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 17 Walkthrough: Terrace";
const description = "Rooms & Exits Chapter 3 Level 17 walkthrough for the Terrace: the padded white crate with the yellow padlock whose four-digit lock ends on 7432, the misspelled Balance cushion-scale puzzle whose display reads 7435, the five-colour button panel, the 'Count the number for each symbol' dials, the Medallion and the crowbar. Every printed number was read twice from separate frames.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 17 Terrace?",
    a: "The code the level actually types is <b>7432</b>, entered on the four-digit lock on the padded white crate. It is on screen at 3:12, with a red button on the left and a green button on the right under the four digit cells. A separate display above the balance-scale puzzle reads <b>7435</b> at 0:42. The two numbers are not the same and they are not interchangeable: 7432 goes into the crate lock, and 7435 is what the scale's panel shows while you are loading cushions.",
  },
  {
    q: "What is the Balance puzzle on the Terrace?",
    a: "At 0:36 the game opens a two-pan balance with red bowls hanging from a white frame, and the title printed on the panel is <b>BLANACE</b> — a misspelling of Balance that is in the game itself, not in this guide. Both pans hold stacks of cushions, spare cushions sit to the right, and a white display above the pans shows four digits plus four small red indicator lights. The run we worked from leaves the panel reading <b>7435</b>.",
  },
  {
    q: "Where do I find the Medallion?",
    a: "The <b>Medallion</b> is the first named item in the level, picked up around <b>0:24</b>. It is an olive-green disc with a raised three-arrow symbol in the middle, and the game shows it on its own card with the word <b>Medallion</b> under it. By 1:36 it is sitting in the inventory, where a second, chair-shaped medallion is also visible.",
  },
  {
    q: "What is the five-button panel on the dining wall?",
    a: "The dining area has a brushed-metal panel with <b>five round buttons</b>. Read left to right the colours are <b>green, yellow, red, brown, red</b> — the fourth is a dull brown-orange, not a bright orange, and the fifth is red again. There are no letters printed above them; earlier notes claiming a G-Y-R-B-O row do not survive a second read. The recording presses them in different orders between 1:00 and 1:12 without showing a stamped solution.",
  },
  {
    q: "What does 'Count the number for each symbol' want?",
    a: "A framed puzzle at <b>1:48</b> shows three yellow symbols in a row — a faceted star or gem, a plain ring, and a chair — with one number dial under each and the instruction <b>COUNT THE NUMBER FOR EACH SYMBOL</b>. You count how many times each symbol appears in the room, not how many objects there are. The dials start at 0 0 0 and are being turned from 2:18. The final three digits are the one thing on this page we could not read twice; see the last section.",
  },
  {
    q: "How do I turn the lights on in the Terrace?",
    a: "There is a lever switch on the wall by the blue French doors, close-up at <b>2:33</b>. Throw it and the scene changes at 2:42: the windows and shutters are open, the terrace is lit, and the hanging pod chairs sparkle. That switch is the level's only obvious light control, and it is easy to walk past because the wall around it is plain beige tile.",
  },
  {
    q: "What is in the barrel by the sofa?",
    a: "At <b>2:48</b> the game zooms a weathered wooden barrel behind the outdoor sofa, painted with faded yellow and blue-grey bands, and a <b>red crowbar</b> is leaning against it. The crowbar is the interaction, not the barrel: it is the only red object in that corner and the camera holds on it. What it pries open is not shown in the part of the recording we can read.",
  },
  {
    q: "Where is the locked crate?",
    a: "The padded white crate with the yellow padlock sits in the garden bed at the front of the terrace — it is the first thing the camera zooms, at <b>0:12</b>, and it comes back as a full close-up at <b>3:00</b>. Its four-digit lock is the <b>7432</b> lock. The crate is white-painted wood with worn edges and a brass-yellow padlock hanging on the front hasp.",
  },
  {
    q: "What is the striped chair clue?",
    a: "At <b>0:54</b> the game zooms one of the white wire dining chairs. Its back is a lattice of white grid with five vertical colour stripes — <b>red, orange, yellow, green, blue</b>, in that order from the left. It is the only striped object in the level and the five-stripe count matches the five-button panel, which is why most players read the chair as the button clue.",
  },
  {
    q: "What is the white box with five golden circles?",
    a: "At <b>1:24</b> a distressed white-painted wooden box is pulled up, and its lid holds a brass insert with <b>five round golden depressions</b> in a row. They are shallow wells, not buttons and not digits — the shape is the same as a medallion, and the inventory already holds at least one Medallion by then. The recording never shows the box being filled.",
  },
  {
    q: "Does the recording show Level 17 being completed?",
    a: "No. The file runs <b>3:20</b> and the last frames are the terrace at 3:18 with sparkles around the pod chairs, right after the 7432 entry. There is no results card, no <i>level completed</i> banner and no coin reward anywhere in the video, so this page prints no reward figure for the Terrace.",
  },
  {
    q: "Is the Terrace room 17 of Chapter 3?",
    a: "Yes. Chapter 3 is <i>Murder Dressed in White</i> and the Terrace is room <b>17</b>, between the Attic (16) and the Basement (18). It is the first room in the chapter that is fully outdoors, which is why it has an awning, a garden bed and a lawn instead of walls on four sides.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
