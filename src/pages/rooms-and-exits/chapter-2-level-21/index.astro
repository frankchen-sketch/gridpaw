const title = "Rooms & Exits Chapter 2 Level 21 Walkthrough: Household Appliances";
const description = "Rooms & Exits Chapter 2 Level 21 walkthrough for the Household Appliances showroom: the note that counts circles, the TV that prints 1286, the pink four-dial lock, the key it hides and the exit worth +50 coins.";

const faq = [
  {
    q: "What is the exit code in Rooms & Exits Chapter 2 Level 21?",
    a: "<b>1286</b>. It is shown on one of the televisions in the electronics corner of the showroom: four large digits in a row, each with a small symbol underneath. The digits are printed on the screen; the symbols tie them to the pictogram buttons of the remote that sits in the same corner. All three recordings we broke down show the same four digits, and the pink four-dial lock accepts them.",
  },
  {
    q: "Where exactly does 1286 come from?",
    a: "The television, not the remote. A purple screen in the TV wall shows <b>1 2 8 6</b>, with a different small pictogram under each digit. The remote in the same corner carries those pictograms instead of numbers, which is how the level ties the screen to its buttons. What this page can vouch for is the digits themselves: all three recordings agree on 1-2-8-6, and the pink four-dial lock accepts them.",
  },
  {
    q: "What does the four-dial lock open?",
    a: "A small compartment, not the door. The lock is a pink panel with four purple tumblers and two padlock icons — red closed, green open. Turn the tumblers to <b>1 2 8 6</b> and the padlock flips to green; the panel then opens on a pink-lined box with a single silver <b>Key</b> inside. Take the key and the box is empty.",
  },
  {
    q: "What do I do with the key?",
    a: "Use it on the exit. Open the inventory, select <b>Key</b>, press <b>Use</b>, then tap the white door with the red <b>EXIT</b> sign on the far left wall of the showroom. That is the last action of the level; the camera pulls back and the results panel appears.",
  },
  {
    q: "What is the coin reward for Household Appliances?",
    a: "<b>+50 coins</b>. The results panel reads <i>Reward! +50</i> next to a pile of gold coins, with an efficiency bar of ten squares and a completion time. On the longest of our three recordings the clock reads <b>21:34</b>, and the reward is the same +50 the level card advertises before you start.",
  },
  {
    q: "What does the note with 6636, 8118 and 2212 mean?",
    a: "Count the closed loops in each group of digits. <b>6636</b> has three loops (each 6 is one), so it reads 3. <b>8118</b> has four (each 8 is two), so it reads 4. <b>2212</b> has none, so it reads 0. That gives <b>8688 = 7</b> (2+1+2+2) and <b>5971 = 1</b> (the 9 is the only loop). The note never asks you to type the answers anywhere we could find — it is a clue, not a keypad.",
  },
  {
    q: "How long does the Household Appliances level take?",
    a: "The slowest of our three recordings finished in <b>21:34</b> of in-game time; a tighter run cleared the same room in about nine minutes of real time. Nothing in the level is timed and there is no fail state, so the only thing that stretches it is the number of separate locks standing between you and the door — this is one of the densest rooms in Chapter 2.",
  },
  {
    q: "Do I need the mixer and its beaters?",
    a: "Not in any run we captured. The yellow-and-grey hand <b>Mixer</b> is a real pickup with a real label and two chrome beaters, and one recording's caption ties the beaters to a clock-face mechanism on a door. Our own completing run never uses them: it takes the key out of the 1286 compartment and finishes. Treat the mixer as optional unless your build shows you a socket for it.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
