import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 25 Walkthrough: Restroom";
const description = "Rooms & Exits Chapter 2 Level 25 walkthrough for the Restroom: the drain ring that has to total 61, the four grid papers and the twenty-nine clicks they add up to, the two restrooms on either side of the corridor, and the +50 coin finish.";

const faq = [
  {
    q: "How do you complete Rooms & Exits Chapter 2 Level 25, the Restroom?",
    a: "Take the <b>Key</b> out of the potted plant in the corridor and open the men's door. Inside, the room hands you a chain of small tools, and every one of them is spent on a different fixture: the <b>Hook</b> fishes a key out of the floor drain, the <b>Soap</b> and a <b>Towel</b> clean the mirrors, a <b>Light bulb</b> relights one of them, and a <b>Utensil</b> digs a second key out of the plant in the corridor. The drain lid is the level's one arithmetic puzzle — <b>each of its four sides must total 61</b> — and the exit is a 4x4 mosaic panel beside the doorway that wants a fixed number of clicks per cell, written on four <b>Piece of paper</b> items. Solve the panel and the level ends on <b>+50 coins</b>.",
  },
  {
    q: "What is the rule for the drain puzzle in Level 25?",
    a: "Each side of the circular drain cover must add up to <b>61</b>, and the numbers are two-digit tiles whose digits are added separately — the game's own instruction text says a tile reading 78 counts as <b>7 + 8</b>, not as seventy-eight. The centre of the lid is fixed at <b>61</b> and does not rotate; the concentric rings around it do. Read every tile on one side, add the digits, and rotate the rings until that side reaches 61. Work side by side rather than ring by ring: a single ring turn changes four sides at once.",
  },
  {
    q: "What are the numbers for the 4x4 panel at the exit?",
    a: "The panel wants this many clicks per cell, top row to bottom row: <b>3, 0, 2, 1 / 2, 4, 0, 0 / 3, 1, 3, 0 / 2, 2, 2, 4</b>. That is twenty-nine clicks in all, and four cells that are never touched. The game's own instruction under the panel reads <i>Click on each cell / As mentioned on papers</i>, and the four papers in the inventory between them mark exactly twelve cells — the twelve non-zero values above.",
  },
  {
    q: "Where do the four grid papers come from?",
    a: "They are not in one place. One is dismantled out of the <b>Crumpled piece of paper</b> that comes out of the sink basin, another out of the <b>Rolled piece of paper</b> in the wall compartment behind the torn <b>PIPES</b> poster, and the rest are ordinary pick-ups around the two restrooms. Every one is labelled <b>Piece of paper</b> once it is flat, and the four we could read cleanly in both recordings are the ones that produce the click table on this page.",
  },
  {
    q: "How much does Chapter 2 Level 25 pay out?",
    a: "<b>+50 coins</b>, with the results screen reading <b>Time: 9:01</b> underneath an efficiency meter whose segment count we could not read consistently enough to print. A second reward panel below it shows <b>200</b> with the piggy bank text — that is the bank filling up, not a second payout for this level.",
  },
  {
    q: "Do I have to solve both restrooms?",
    a: "Both rooms are part of the level and the items are split between them, but the order is yours. The men's room holds the drain, the sink, the soap dispenser and the cleaning cart; the women's room holds the pouch, the trash can, the wall lamp and the hand dryer. The light switch in the corridor is what lets you see the women's side properly, so most players flip it before they go in.",
  },
  {
    q: "Is there a keypad code in the Restroom level?",
    a: "No. There is no number pad anywhere in Level 25. The only written numbers are the <b>61</b> in the middle of the drain and the digits on the four papers, and neither is typed into anything — one is a target sum, the other is a click count. If you are hunting for a four- or six-digit code, you are thinking of a different room.",
  },
  {
    q: "How long does the Restroom take?",
    a: "The recording this guide is built from finishes in <b>9:01</b> of level time, and the drain ring alone eats about eighty seconds of it. Nothing in the level is timed and there is no fail state, so the only real cost is walking back and forth between the two restrooms because a tool was left behind.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
