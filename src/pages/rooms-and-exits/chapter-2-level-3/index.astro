---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 3 Walkthrough: Pharmacy";
const description = "Rooms & Exits Chapter 2 Level 3 Pharmacy walkthrough, step by step with screenshots: the pills 16, 23, 43 and 56 that make keypad code 16234356, the HEALTH word lock, the six vitamins and the 438 colour lock.";

const faqs = [
  {
    q: "What is the keypad code in Chapter 2 Level 3 Pharmacy?",
    a: "16234356. The four numbered pills in the white dish read 16, 23, 43 and 56, and the keypad wants them as one eight-digit run in ascending order. Type 16234356 and confirm: the glass display cabinet next to the reception desk unlocks and the VITAMIN B bottle inside it becomes takeable."
  },
  {
    q: "Where is the HEALTH word lock and what does it open?",
    a: "It is the steel panel with a QWERTY keyboard on it, on the wall side of the reception area. Tap it, type HEALTH on the on-screen keyboard and press the tick. The locker under the panel swings open and the vitamin bottles inside it can be picked up."
  },
  {
    q: "How many vitamin bottles are there and where do they go?",
    a: "Six: A, B, C, D, E and K. They come out of the two cabinets rather than off the shelves, and they all go onto the VITAMINS shelf, which has six round pads in six different colours. Each bottle stands on one pad; the multivitamin poster on the door is the sheet that tells you which colour belongs to which letter."
  },
  {
    q: "What is the code on the three-digit colour lock at the end?",
    a: "438. The lock shows three digits and each digit also carries a colour, and the bar above the display stays red until the whole thing matches. Our footage ends with 438 and a green bar. We could not read the three target colours off the recording reliably, so if the bar stays red on 438, cycle the colour on each digit rather than changing the numbers."
  },
  {
    q: "What do you get for finishing the Pharmacy?",
    a: "+50 coins. The end screen shows LEVEL COMPLETED!, a reward of +50 coins, a full efficiency bar and a level time of 7:46 in our recording, plus the usual Claim x2 advert button."
  },
  {
    q: "Does the Pharmacy have a timed puzzle?",
    a: "No. The clock in the top right is a running level timer, not a countdown, and nothing in the room fails you for being slow. The only thing that punishes you is entering a code on a keypad before you have read the clue that produces it."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
