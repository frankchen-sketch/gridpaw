const title = "Rooms & Exits Chapter 4 Level 1 Walkthrough: Pharaoh's Tomb";
const description = "Rooms & Exits Chapter 4 Level 1 walkthrough for Pharaoh's Tomb, the first room of Pharaoh's Bride: the 4x4 papyrus sliding tiles, the gold key, the shard jigsaw, the two-panel spot-the-difference with its 10 counter, the four canopic jars, the twelve-step arrow panel that pays out a clay sculpture, the display case with the scarab, the collar and a 3x3 keypad, the four eye-and-mouth blocks, the Anubis head, and the door that the recording finishes on while it is still locked. Every screen on this page was read from a 1080p frame capture, twice per prop.";

const faq = [
  {
    q: "What is Rooms & Exits Chapter 4 Level 1 called?",
    a: "Chapter 4 is <b>Pharaoh's Bride</b> and its first room is <b>Pharaoh's Tomb</b>. It is the opening room of the chapter, straight after Chapter 3 (<i>Murder Dressed in White</i>) and before Level 2, Power and Security. The room is an Egyptian tomb exhibit: a painted burial chamber with a sarcophagus on a plinth, a seated statue, murals in blue and gold, and a work area off to one side.",
  },
  {
    q: "Does this page give the exit code for Pharaoh's Tomb?",
    a: "No, and that is deliberate. The 7:06 recording this page is built from ends with the room's own banner reading <b>This is the exit. Locked!</b> — the player never opens the door on camera. There is a real keypad in the level, inside the glass display case, but the run's two independent crops of its tiny display do not agree on the digits, so we print no code rather than a guessed one.",
  },
  {
    q: "What is the first puzzle in Pharaoh's Tomb?",
    a: "A <b>4x4 board of papyrus tiles</b> with Egyptian symbols on them — an ankh, the Eye of Horus, a woman's profile and a seated figure all appear — and one empty slot, so it is a sliding puzzle rather than a rotate-and-place one. It opens at about <b>0:16</b> and the run is off it by <b>0:34</b>.",
  },
  {
    q: "What is the two-panel puzzle with the 10 counter?",
    a: "At about <b>2:00</b> the game opens two framed papyrus paintings side by side — the same banquet scene twice, one with a pharaoh and one with a jackal-headed figure — and a counter that runs from <b>0/10</b> to <b>10/10</b>. It is a spot-the-difference board: ten differences between the left and right panel. The two readings we took at 2:10 and 2:15 show <b>2/10</b> and <b>5/10</b>, so the counter is counting found differences.",
  },
  {
    q: "What is the twelve-step arrow panel?",
    a: "The longest puzzle in the room: five vertical tracks of round stone buttons with arrows stamped on them, an artifact sitting on a wooden stand to the right, and a counter that runs to <b>12</b>. The counter reads <b>1/12</b> at 4:10, <b>6/12</b> at 5:20 and <b>7/12</b> at 5:40, and the screen later labels the reward <b>Clay sculpture</b>. Because the recording is sampled at one frame per second, we do not print the twelve moves — the button states change between frames, so any sequence we wrote out would be reconstruction, not observation.",
  },
  {
    q: "How many canopic jars are there?",
    a: "Four, standing in a row on a shelf inside a wall niche, each with a carved lid and a band of hieroglyphs around the body. The run inspects them at about <b>2:40</b>. Nothing in the recording pairs them with a code, so treat them as part of the tomb's dressing plus a clue source, not a lock.",
  },
  {
    q: "What is in the glass display case?",
    a: "A winged <b>blue scarab</b> with a red sun disc on the left, a broad <b>collar</b> in blue and pale green on the right, and a <b>3x3 keypad</b> between them, all under glass. The run types into that keypad between about <b>5:55</b> and <b>6:10</b>, and the case is what the level builds to before its last three puzzles.",
  },
  {
    q: "What are the four wooden blocks at the end?",
    a: "Four square blocks lined up on a track, each with dark rounded cut-outs: two with vertical slots, one with a horizontal slot above two vertical slots, and the last with two slots of its own. Put together they read as <b>a pair of eyes over a mouth</b> — a face built out of holes. They appear from about <b>6:35</b>.",
  },
  {
    q: "Does the recording show the level being completed?",
    a: "No. The file runs <b>7:06</b> (426 seconds) and the last second shows the room with an orange door icon and the banner <b>This is the exit. Locked!</b> There is no door animation, no results card and no reward payout on camera, so this page prints no completion figure for Pharaoh's Tomb.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
