---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 3 Walkthrough: Study Room";
const description = "Rooms & Exits Chapter 3 Level 3 Study Room walkthrough: the laptop password is 20062015 (the date on the Photograph), the 2-step verification code is 45837 from the phone message, the laptop then shows 62850 for the final keypad, and the hidden wall safe turns 30 anti-clockwise, 40 clockwise, 55 anti-clockwise, 70 clockwise.";

const faq = [
  {
    q: "What is the laptop password in Rooms & Exits Chapter 3 Level 3 Study Room?",
    a: "It is <b>20062015</b> — eight digits, the date on the <b>Photograph</b> item. Open the Photograph in your inventory and the date reads <b>20.06.2015</b>; strip the dots and you have the password. We read it twice: full-frame OCR of the login screen shows the field filled with <b>20062015</b>, and a 3x crop of the same field reads the same eight digits. The build-up is visible frame by frame too — 20, then 20062, then 2006201, then 20062015 — so there is no ambiguity about the digits.",
  },
  {
    q: "What is the 2-step verification code?",
    a: "<b>45837</b>, five digits. It is on the <b>phone</b>: pick it up and the message bubble shows 45837. Type it into the laptop's <i>2-Step Verification — ENTER YOUR VERIFICATION CODE</i> screen. We read it twice from two different places: the phone message itself at 4:23, and the verification field at 4:44 with the digits already typed in. Both give the same five digits.",
  },
  {
    q: "What is the code 62850 for?",
    a: "<b>62850</b> is the final lock — the five-digit keypad. You do not find it written on a wall: the <b>laptop displays it</b> once you are past the password and the 2-step code. Then you walk to the keypad and enter <b>62850</b>. Confirmed twice: the laptop screen at 4:46 and the keypad display at 5:08 both read 62850.",
  },
  {
    q: "What is the combination for the hidden wall safe?",
    a: "The safe behind the hinged panel opens on <b>30 anti-clockwise, 40 clockwise, 55 anti-clockwise, 70 clockwise</b>. That sequence is the game's own hint text for this level, shown as four numbered lines — <i>1. 30 anti clockwise / 2. 40 clockwise / 3. 55 anti clockwise / 4. 70 clockwise</i> — and it matches the dial the player works between 2:51 and 3:05. Note the directions: two turns anticlockwise, two clockwise, alternating.",
  },
  {
    q: "Where is the safe?",
    a: "Behind a hinged white panel on the wood-panelled wall, beside a wall sconce with a warm glow. The panel is already open when the player reaches it at <b>0:54</b> and the safe inside is dark grey with a rotary dial. It is not in the desk, not behind a painting and not under the floor — it is a wall safe, high enough that the sconce sits to its right.",
  },
  {
    q: "How do I get the phone message?",
    a: "The phone is on the desk. Pick it up and the screen shows a search bar and a grey message bubble with <b>45837</b> in it — that is the whole interaction. There is no unlock step and no second message; the code is simply sitting in the bubble at <b>4:22</b> in the recording.",
  },
  {
    q: "What does the book with the economy text do?",
    a: "It is the level's biggest red herring. A thick book on the desk opens on a printed page headed <i>The economy may be considered as having developed through the following phases or degrees of precedence</i>, followed by a numbered list — 1 Consumer spending, 2 Exchange rate, 3 Gross domestic product, 4 GDP per capita, 5 GNP, 6 Stock market, 7 Interest rate, 8 Government debt, 9 Rate of inflation, 10 Unemployment, 11 Balance of trade. It reads like a key to an eleven-symbol cipher. It is not used: nothing in the run refers to any of the eleven entries.",
  },
  {
    q: "What are the items Blanket, Shovel, Brush, Ash and Light bulb for?",
    a: "They are inventory items picked up around the room — <b>Blanket</b>, <b>Shovel</b>, <b>Brush</b>, <b>Ash</b> and a <b>Light bulb</b> are all confirmed in the bag at different points. None of them is used on a lock in this run. The Brush and the <b>Fingerprint</b> it produces are examined, but no lock consumes either, so treat the collection as optional.",
  },
  {
    q: "The books on the shelf have numbers — are they a code?",
    a: "They have titles, not a code. Readable spines include <b>RUDYARD KIPLING</b>, <b>JUNGLE BOOK</b>, <b>BOLTON</b> and <b>BERTHA RUNKLE</b>, and one spine carries a stamped number that OCRs as <b>1745</b> but stays unstable between frames. The game's own hint for this shelf talks about the blue books and how they stand, using Roman numerals — <i>IV = 4, III = 3, VI = 7</i> — so the books are a counting puzzle, not a printed code.",
  },
  {
    q: "What is the circular glowing thing at 0:44?",
    a: "A round mechanism set into dark wood with a bright white square at its centre. The player touches it early and it is never explained in the run. It is not the safe — the safe is the separate wall panel at 0:54 — and it is not the keypad used at the end, which is a flat five-digit pad. We list it as an unexplained interactive.",
  },
  {
    q: "How long is Study Room and what is the reward?",
    a: "The recording is <b>5:13</b>. The in-game timer reads <b>17:53</b> at 5:09, so this was a long session by the player before the capture. The video ends at 5:12 on a completion animation with a gold emblem and a green progress bar, and <b>no readable reward figure</b> — so this page prints no coin amount for the level.",
  },
  {
    q: "What order should I do the locks in?",
    a: "Password first, then 2-step, then keypad. Specifically: read the <b>Photograph</b> (20.06.2015) → laptop password <b>20062015</b> → the laptop blocks you with <i>2-Step Verification</i> → find the <b>phone</b>, read <b>45837</b> → enter it → the laptop displays <b>62850</b> → enter <b>62850</b> on the keypad. The wall safe (30/40/55/70) is a side branch on the same level and does not feed this chain.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
