import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 23 Walkthrough: Bakery";
const description = "Rooms & Exits Chapter 2 Level 23 walkthrough for the Bakery: the two three-window drawer locks (421 on the coloured dial, 693 from the slip of paper in the cake case), the cupcake recipe at 35 minutes and 250 degrees, the six-switch fuse box, and the silver stand that hands you the exit key for +50 coins.";

const faq = [
  {
    q: "What are the codes in Rooms & Exits Chapter 2 Level 23?",
    a: "There are two, and they are on the same piece of furniture. The drawer with the <b>green, red and orange</b> windows takes <b>4 · 2 · 1</b> — our two recordings both dial it there and the drawer releases. The drawer with the three plain windows takes <b>6 · 9 · 3</b>, which is written on the <b>Piece of paper</b> you pick up inside the cake display case. Both codes were read off the screen twice, in two separate playthroughs.",
  },
  {
    q: "Where do I find the 693 code?",
    a: "In the cake display case on the shop floor. The case holds six small cakes on two shelves; tap through them and a folded slip appears on the middle shelf. Take it and the label reads <b>Piece of paper</b>, with <b>693</b> handwritten on it in black. In the second recording the same slip is sitting in the inventory with the same three digits, so this one is fixed.",
  },
  {
    q: "Which drawer does 421 open, and what is inside?",
    a: "The left drawer of the wooden console against the brick wall — the one whose three windows are framed in <b>green, red and orange</b>. Dial <b>4 · 2 · 1</b> and it slides out. In our main recording the drawer gives up the <b>Recipe</b> card for cupcakes; in the second recording the same drawer is opened and a screwdriver comes out of it first. Treat the drawer as a container you empty, not as a single fixed reward.",
  },
  {
    q: "What does the cupcake recipe say?",
    a: "The card is titled <b>Cupcakes</b> and lists five illustrated ingredients: <b>3</b> eggs, <b>1/3</b> of a block of butter, <b>4 tbs</b> of flour, <b>2 tbs</b> of sugar and <b>0,6 l</b> of milk. Under the list it prints the bake: <b>35'</b> and <b>250°</b>. Those two numbers are the ones the oven panel wants, and the card is the only place in the level where they are written down.",
  },
  {
    q: "How do I work the oven?",
    a: "The oven panel has a <b>TIMER</b> button, a green digital display, a big ring marked <b>OFF, 100, 150, 200, 250, 300, 350, 400</b>, and a <b>START</b> button. Set the display to <b>35</b> and turn the ring to the temperature the card prints (<b>250</b>), then press START. One honest caveat: in our main recording the ring ends up reading nearer <b>350</b> on the frame before the bake and the cupcakes still come out, so the timer is clearly the value that matters most.",
  },
  {
    q: "What is the six-switch panel in the kitchen for?",
    a: "It is the fuse box that brings the kitchen back to life. Open the grey door on the tiled wall and you get two rows of three coloured toggle switches — <b>red, green, red</b> on top and <b>blue, yellow, blue</b> underneath — wired down to a small unit with a red and a green indicator light. The inside of the door has a photo of a cupcake taped to it, which is the only hint in the room. The recording works the toggles until the panel is live; we could not derive a rule that ties the switch colours to the photo, so this page does not pretend there is one.",
  },
  {
    q: "How many cupcakes do I have to bake?",
    a: "Three. You collect three silicone <b>Baking cups</b> around the level — the stack in the inventory reads <b>2/3</b> for most of the run and <b>3/3</b> once the last one is picked up. Combining the <b>Bowl with mixed ingredients</b> with the cups produces <b>Filled baking cups</b> (purple, green and red), and those are what go into the oven. The finished cupcakes are green, red and purple.",
  },
  {
    q: "What is the silver stand on the counter for?",
    a: "It is the delivery point. Once the cupcakes are baked, place them on the empty single-tier silver stand on the shop counter — next to the two-tier stand of pastries. When the stand is filled the counter rewards you: sparkles, a <b>Key</b> on the wood, and the drawer below sliding open. That key is the exit key.",
  },
  {
    q: "How long does the Bakery take, and what is the reward?",
    a: "The results panel reads <b>Time: 4:54</b> with a full ten-segment efficiency bar and <b>+50 coins</b>. That is the shortest Chapter 2 room we have recorded so far — the level is small and the puzzles are two locks, one fuse box and one bake, so once you know the two codes there is almost no walking.",
  },
  {
    q: "Do I need the key from the bread shelf for anything?",
    a: "Yes — it opens the <b>Kitchen</b> door. The key is hidden in a loaf on the bread shelf: the loaf with the X scored into its crust sparkles when you get close, and tapping it hands you <b>Bread</b> first and then the <b>Key</b>. Without it the kitchen door stays shut, and the whole second half of the level — the fuse box, the oven, the actual baking — is behind that door.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
