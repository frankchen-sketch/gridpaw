---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 1 Level 11 Walkthrough: Lighthouse";
const description = "Rooms & Exits Chapter 1 Level 11 walkthrough: the Lighthouse finale. The four-colour cable board, the lettered books, the node board and the five-fuse colour code that disarms the bomb.";
const fuses = [
  ['red', 'yellow'], ['orange', 'red'], ['purple', 'blue'], ['yellow', 'orange'], ['blue', 'pink'],
];
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {"@type": "Question", "name": "How do you disarm the bomb in Rooms & Exits Lighthouse?", "acceptedAnswer": {"@type": "Answer", "text": "Use the Piece of paper in your inventory. It shows five fuses, each paired with a dot of a different colour: red with yellow, orange with red, purple with blue, yellow with orange, blue with pink. On the bomb panel the five wires hang in the same order, so the five round buttons want yellow, red, blue, orange and pink from top to bottom."}},
  {"@type": "Question", "name": "What does the Piece of paper in Lighthouse show?", "acceptedAnswer": {"@type": "Answer", "text": "Two columns of five. On the left are five fuses, coloured red, orange, purple, yellow and blue from top to bottom. On the right are five dots, coloured yellow, red, blue, orange and pink in the same rows. It is a wiring table, not decoration: each row pairs the fuse on the left with the button colour on the right."}},
  {"@type": "Question", "name": "How many levels are in Rooms & Exits Chapter 1?", "acceptedAnswer": {"@type": "Answer", "text": "Chapter 1, Wicked Games, has eleven rooms. Lighthouse is the eleventh and the last one; finishing it returns you to the level map and closes the chapter."}},
  {"@type": "Question", "name": "Does Lighthouse have a timer or a fail state?", "acceptedAnswer": {"@type": "Answer", "text": "No. The man tied to the chair is carrying dynamite and a display, which reads as a countdown, but the room never fails you. There is no restart screen and the puzzles wait for you. Our recording clears the level with an in-game time of 12:51."}},
  {"@type": "Question", "name": "Is there a number code in Lighthouse?", "acceptedAnswer": {"@type": "Answer", "text": "No. Lighthouse is the one Chapter 1 room with no keypad and no digit code. Every lock in it is either a path to trace, a row of icons to set or the colour pairing from the Piece of paper. If you are searching for four digits, you are in the wrong room."}}]};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead
    title={title}
    description={description}
    canonical="/rooms-and-exits/chapter-1-level-11"
    type="article"
    breadcrumbTitle="Rooms & Exits Chapter 1 Level 11"
  />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --amber: #D97706; --cream: #FFFBF5; --green: #15803D;
      --text: #3A2F28; --light: #9C8B7B; --border: #F2E4D4;
      --shadow: 0 2px 8px rgba(217,119,6,0.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Nunito', -apple-system, sans-serif; background: var(--cream); color: var(--text); min-height: 100vh; }
    .breadcrumb { font-size: 12px; color: var(--light); padding: 14px 16px 0; text-align: center; }
    .breadcrumb a { color: var(--light); text-decoration: none; }
