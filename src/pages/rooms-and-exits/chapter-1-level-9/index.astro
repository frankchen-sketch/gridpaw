const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {"@type": "Question", "name": "What is the letter lock code in Level 9?", "acceptedAnswer": {"@type": "Answer", "text": "JWFMI. It is written on a piece of paper lying in a crate in the yard, and it goes into the five-column letter lock on the trailer door. It is not a word, so there is nothing to guess."}},
  {"@type": "Question", "name": "What is the code for the yellow keypad panel?", "acceptedAnswer": {"@type": "Answer", "text": "99452. The five digits are written on the white border of the polaroid Fiona hands you near the end of the level. The panel is the yellow box beside the crane, and entering the code opens a tray of crane parts."}},
  {"@type": "Question", "name": "Where do you get the bolt cutters?", "acceptedAnswer": {"@type": "Answer", "text": "In the yard, once the crane is assembled. Our recording picks them up at 6:43, right after the crane goes up, and the item is labelled \"Bolt cutters\" on pickup. The frames either side are a jump cut, so we cannot point at the exact spot. But they are the tool the exit wants."}},
  {"@type": "Question", "name": "How does the Junkyard level end?", "acceptedAnswer": {"@type": "Answer", "text": "Cut the chain on the EXIT barrier in the middle of the yard with the bolt cutters. In our recording the level completed right after that, and the reward screen gave 50 coins."}},
  {"@type": "Question", "name": "Is there a timed puzzle in Junkyard?", "acceptedAnswer": {"@type": "Answer", "text": "Nothing in our recording of Level 9 ran on a clock. The yard maze, the ring puzzle, the dial and the tread tray all wait for you. A change from the timed arcade maze in Level 4."}}]};
