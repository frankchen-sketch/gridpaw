const title = "Rooms & Exits Chapter 4 Level 4 Walkthrough: Planetarium";
const description = "Rooms & Exits Chapter 4 Level 4 Planetarium walkthrough: the dome auditorium with its six planet displays, the metal plate whose numbered contacts and movable knob open the cabinet, the telescope and the six-panel constellation board that pays out the Key, the periodic table poster and the H / N / Mg notes, and the graph-paper subtraction 41268 − 7935 = 33333 behind the wall passcode. Every printed number was read more than once.";

const faq = [
  {
    q: "What is the passcode in the Planetarium?",
    a: "It is a four-digit number taken from the graph-paper subtraction on the desk: <b>4 1 2 6 8 − 7 9 3 5 = 3 3 3 3 3</b>, with the four digits of the subtracted row boxed and shaded blue. Those four digits read <b>7 9 3 5</b>, and the arithmetic checks out exactly (41268 − 7935 = 33333). Start with <b>7935</b>. One caveat we have to state: the four circles on the wall keypad read <b>7 9 3 6</b> across five consecutive frames of our capture, one digit away from the paper. See the last section of this page.",
  },
  {
    q: "Where do I find the four-digit code for the wall keypad?",
    a: "On the study desk, on a sheet of graph paper: a column subtraction with the top row, the subtracted row and a result of <b>33333</b>. Four digits of the subtracted row are boxed and filled in pale blue — that is the number the wall panel wants. If the desk is not lit up for you yet, you have not finished the constellation board: solving it is what makes the study's interactive items start sparkling.",
  },
  {
    q: "How do I open the cabinet in the planetarium hall?",
    a: "There is a metal plate screwed to a wooden cabinet near the seating. Its upper half is a network of numbered contacts with <b>one movable knob</b>; its lower half is a red keypad with the digits <b>1 to 9</b> in two rows and a row of small indicator lights along the bottom of the plate. You move the knob along the track to connect the contacts in order, and the keypad takes the matching digits. The run finishes it at about <b>1:12</b> and the cabinet opens on the spot.",
  },
  {
    q: "What is in the cabinet?",
    a: "A single pickup. The run lifts it at about <b>1:17</b> and the cabinet is left empty. Treat the cabinet as a one-shot container rather than a puzzle you can re-enter: once the plate is solved there is nothing else to find in it.",
  },
  {
    q: "What is the telescope for?",
    a: "It is the constellation board's answer key. The telescope stands on the window sill in the study, pointed at a star-filled night sky over a city skyline; looking through it shows the star field. The board on the wall holds six framed panels of star fields — turning the panels to rebuild the sky the telescope is pointed at is the puzzle. The telescope itself takes no item and is never adjusted.",
  },
  {
    q: "What do I get for solving the constellation board?",
    a: "A <b>Key</b>. At <b>2:52</b> the six panels line up, the board clears and the game awards an item simply labelled <b>Key</b> — a silver key with a round bow. It is the only key-shaped reward in the level, so if your inventory has no key you have not finished the star field.",
  },
  {
    q: "What do the three yellow notes say?",
    a: "<b>H</b>, <b>N</b> and <b>Mg</b> — three chemical symbols on three square sticky notes, pinned in a row on the pale yellow wall to the right of the bookshelf. They are element symbols (hydrogen, nitrogen, magnesium), and they sit right above a fan of rolled-up blueprints. The periodic table poster hangs on the same wall, in the room's other corner, which is why the two belong together.",
  },
  {
    q: "Where is the disc, and what do I do with it?",
    a: "The disc lies flat on the top shelf of the bookshelf, next to the pink binders. Pick it up (about <b>4:00</b>) and take it to the laptop on the study desk: at <b>5:44</b> the disc is loaded and the game renames it <b>Burned disc</b>. The laptop's screen shows a disc icon the whole time, so the disc is the only thing that machine is waiting for.",
  },
  {
    q: "What is the solar system model on the desk?",
    a: "A brass orrery: a sun in the middle and thin arms carrying small planets — a tan one, an orange-red one, a banded brown one, a ringed one, a pale blue one and a darker blue one. It is a placement puzzle, not a display piece: at least one planet starts off the arms, and you have to seat each planet on its arm in the right order. The run finishes it at about <b>7:56</b>.",
  },
  {
    q: "Do I need the globe?",
    a: "No. The small Earth globe sits on the window sill beside the telescope and is never picked up, used or combined in this run. It is the kind of prop that looks like an inventory item and is not one — the same goes for the rolled-up charts and the space posters.",
  },
  {
    q: "Does the recording show the level being completed?",
    a: "Yes. The run goes from the orrery straight to the exit, and the video ends on a <b>LEVEL COMPLETED!</b> card at <b>8:46</b>. Our capture stops on that card, so this page does not print a coin count or a clock time for the level: those numbers are on the reward screen that follows, and it is not in the recording.",
  },
  {
    q: "Where does Planetarium sit in Chapter 4?",
    a: "Chapter 4 is <i>Pharaoh's Bride</i> and it has <b>15 rooms</b>. Planetarium is room <b>4 of 15</b>, right after <a href=\"/rooms-and-exits/chapter-4-level-3/\">The Office</a> and before Dino World. It is the first room in the chapter that splits into two connected spaces — the dome auditorium and the study behind it — instead of being one set.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
