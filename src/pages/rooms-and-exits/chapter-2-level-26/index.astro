import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 26 Walkthrough: Parking";
const description = "Rooms & Exits Chapter 2 Level 26 walkthrough for Parking: the paperclip and the lift hatch, the three plates 1876 / 3542 / 2002 on floor -2, the five-fader panel, the C B A D keypad that takes 0243, and the ride to P that ends Chapter 2.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 2 Level 26 Parking?",
    a: "There are two, and they do different jobs. The <b>C B A D</b> keypad on the service box takes <b>0 · 2 · 4 · 3</b> — the parking-bay numbers of cars C, B, A and D, read off the locator board on floor -1. The twelve-button panel on floor -2 takes three four-digit rows: <b>1876</b>, <b>3542</b> and <b>2002</b>, the plates of the cars parked at bays E6, G1 and H3. Both sets were read twice, in two separate recordings.",
  },
  {
    q: "Where does 0243 come from?",
    a: "From the car-locator board mounted on the wall of floor -1, next to the <b>-1</b> sign. It has four colour rows — A red, B cyan, C green, D yellow — and a red seven-segment column reading <b>4, 2, 0, 3</b> top to bottom. That gives A=4, B=2, C=0, D=3. The service-box keypad is labelled <b>C B A D</b>, so you read the same board in that order: C=0, B=2, A=4, D=3, which is <b>0243</b>.",
  },
  {
    q: "Where do 1876, 3542 and 2002 come from?",
    a: "From the <b>Piece of paper</b> in your bag. It is a photograph of a vintage car with three bay codes written on it: <b>E6</b>, <b>G1</b> and <b>H3</b>. On floor -2 the wall plaque spells the same thing out — <i>Car at E parking: 1876</i>, <i>G: 3542</i>, <i>H: 2002</i> — and the three cars at those bays carry exactly those plates. The twelve-button panel has three rows of four digits for those three numbers.",
  },
  {
    q: "How do I get down to floor -2?",
    a: "With the lift's own keyhole. The floor panel inside the elevator has <b>3, 2, 1, P, -1 and -2</b>, and the <b>-2</b> button is the one with a keyhole beside it. The key that clears it is the one you pick up in the course of the level; once it is in the bag the lift will take you down. Our footage shows the key being collected and then the ride to -2, but not the moment the key turns in the lock, so treat the keyhole as the gate rather than a separate puzzle.",
  },
  {
    q: "How do I solve the five-fader panel?",
    a: "It is not a code and it does not want a number. The panel has five vertical faders and one indicator lamp above each; a lamp turns green when its fader sits at the right height, and the puzzle is finished when all five are green at the same time. In our recordings the lamps come on one at a time as each fader is set, and the panel is left with five green lamps before the player returns to the lift. Move one fader at a time and watch its own lamp — the faders do not appear to reset each other.",
  },
  {
    q: "How do I actually finish the level?",
    a: "Restore the power, then ride the lift to <b>P</b>. The service box on floor -1 has a red toggle switch under the keypad; with <b>0243</b> accepted the switch can be thrown, and the lift's floor panel then lights <b>P</b>. Press P, ride up, and the level ends on the results panel with <b>+50 coins</b> and <b>6:13</b> on the clock in the run we captured.",
  },
  {
    q: "What do I get for finishing Parking?",
    a: "The standard results panel pays <b>+50 coins</b>, shows a full ten-block Efficiency bar and reads <b>Time: 6:13</b> in our recording. The piggy-bank strip underneath reads <b>200</b> and there is a <b>Claim ×2</b> button in the corner. The panel does not mention your items; the only thing it reports is the reward, the clock and the efficiency bar.",
  },
  {
    q: "Is Parking the last level of Chapter 2?",
    a: "Yes. Chapter 2, <i>No Honor Among Thieves</i>, runs twenty-six rooms and Parking is number 26 — the level list in the game's own data ends here. What that means in practice surprised us: the results panel after Parking is the same LEVEL COMPLETED card as every other room, with no chapter-summary screen, no story card and no next-level button in the footage we captured.",
  },
  {
    q: "Do I need the paperclip at the start?",
    a: "Yes — it is the first lock of the level. The paperclip is clipped to the fast-food poster on the right wall of the lift you start in. Take it, examine it, and it becomes a <b>Modified paperclip</b>: a pick. That pick opens the small hatch under the handrail, and the hatch is what exposes the bank of round buttons that opens the lift doors.",
  },
  {
    q: "Do I need the wrench?",
    a: "For the service box, yes. The wrench is the tool that engages the bolt on the metal service panel — our close-up shows the wrench head on the bolt with the cover partly swung. You can walk the whole garage without it, but the C B A D keypad and the red power switch sit behind that cover.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
