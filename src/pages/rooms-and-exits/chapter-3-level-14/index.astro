import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 14 Walkthrough: Storage Room";
const description = "Rooms & Exits Chapter 3 Level 14 walkthrough for the Storage Room: the open switchboard whose door reads blue x red + green, the paint-stain dial printed 5, 7, 8 and 8 around a question mark, the wine rack of coloured bottle caps, and the four-quadrant dial that reads 6-0-3-7 then 2-4-1-5. Every printed number was read twice from separate frames.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 14 Storage Room?",
    a: "There is no single typed code that opens the room. The numbers the level actually prints are on the paint stain on the floor: <b>5</b> top-left, <b>7</b> top-right, <b>8</b> bottom-left and <b>8</b> bottom-right, arranged around a green centre that holds a <b>question mark</b>. That reading was taken twice, from two separate seconds, and both passes agreed. The other number surface in the room is a four-quadrant circular dial that was seen in two states: <b>6 / 0 / 3 / 7</b> and then <b>2 / 4 / 1 / 5</b>.",
  },
  {
    q: "What do the numbers 5, 7, 8 and 8 around the question mark mean?",
    a: "They are four values around one missing centre value, and the level never states the rule in words. The frame shows a translucent brown ring divided into four segments with a solid green circle in the middle carrying a white <b>?</b>. Green lines separate the segments from each other and from the centre. Because the operation is never written down anywhere in the decodable part of the recording, this page prints the four numbers exactly as read and does not invent an arithmetic answer for the centre.",
  },
  {
    q: "What is on the open switchboard?",
    a: "The panel is mounted on the wall above the lower floor and its door swings open to the left. On the inside of the door are three coloured circles with operators between them: <b>blue, a multiplication sign, red, a plus sign, green</b>. Inside the box there is a row of red toggle switches and, below them, a row of vertical level bars, each in a different colour. In the sampled frames the bars read red, magenta-purple, green, yellow, blue and orange, at different fill heights.",
  },
  {
    q: "Where is the protected lighter?",
    a: "The <b>Protected lighter</b> is an inventory pickup, shown at 0:45 as a pink disposable lighter sealed inside a clear foil wrapper with crimped edges. The label under it reads exactly <b>Protected lighter</b>. It sits in the inventory grid alongside a dustpan, a white stick, a pink candle and a small shovel.",
  },
  {
    q: "What is the wine rack and why do the bottle caps matter?",
    a: "The wine cabinet is set into the upper wall: a glass-fronted door on each side and an open rack in the middle with two rows of six square bottle slots, plus an X-shaped divider below that holds one white ball and one dark ball with a red centre. The bottles sit neck-out, so their caps are what you see, and the caps are different colours — in the frames sampled, the top row alternates green and black, and the second row mixes green, blue and yellow. Colour is clearly the variable the puzzle is built on, which is why the caps are painted rather than plain.",
  },
  {
    q: "What is the four-quadrant dial?",
    a: "It is a circular face with a thick white outer ring, divided into four yellowish-green quadrants by a dark cross, with one large digit in each quadrant. Unlike a keypad it does not seem to take typed input — the quadrants are the display. It was read at two separate seconds: <b>6 / 0 / 3 / 7</b> at 5:29 and <b>2 / 4 / 1 / 5</b> at 5:49. Both readings were checked twice and both passes agreed each time.",
  },
  {
    q: "Does the recording show the level being completed?",
    a: "Yes, and this is one of the few Chapter 3 rooms where the ending survives. The results card appears at <b>6:02</b>: <b>LEVEL COMPLETED!</b>, a coin reward of <b>+50</b>, an efficiency bar <b>nine of ten</b> segments filled, <b>Time: 6:50</b>, and a piggy-bank contribution of <b>300</b> with the piggy bank showing <b>Full!</b>. The +50 and the 6:50 were each read twice, once from the whole frame and once from a crop of the results panel.",
  },
  {
    q: "How long is the Storage Room run and is it edited?",
    a: "The source file runs 6:03. It is not a continuous take: the in-game clock jumps between sampled frames — for example from 0:34 at 0:45 to 1:48 at 1:29 — so the upload is cut and sped up in places. That is why the timestamps on this page are video time, not the in-game clock, and why a puzzle can look like it solves itself between two cards.",
  },
  {
    q: "How many rooms does Chapter 3 have, and where is Storage Room?",
    a: "Chapter 3, <i>Murder Dressed in White</i>, lists twenty-four rooms. Storage Room is room <b>14 of 24</b>, straight after Kids Bedroom 1 and immediately before the Garage.",
  },
  {
    q: "Is there a keypad or a safe in this room?",
    a: "No keypad on a wall and no safe. Storage Room does its locking with object state instead: a switch panel with coloured bars, a dial with four quadrants, a wine rack whose caps are colour-coded, and a painted floor stain carrying four numbers. If you are hunting for a number pad, you are looking for something the room does not have.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
