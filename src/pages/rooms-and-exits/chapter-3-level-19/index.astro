---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 19 Walkthrough: Garden Shed";
const description = "Rooms & Exits Chapter 3 Level 19 walkthrough for the Garden Shed, rebuilt from the full 8:24 recording: the jerrycan and the mower, the generator rated 4000 starting / 3500 running watts, the radio tuned to 91.8, the 918 dial lock on the red toolbox, the 3x3 sliding-tile board that takes four in-game minutes, the Box opener, the Lighter and candle, the RC truck with the Key on it, and the +50 coin results card.";

const faq = [
  {
    q: "What are the codes in Rooms & Exits Chapter 3 Level 19 Garden Shed?",
    a: "Two numbers matter. The three-dial lock on the red toolbox is set to <b>918</b> — three digits, read twice from separate frames, once at 2:06 mid-entry and once at 2:10 settled. The radio on the shelf displays <b>91.8</b>, read twice at two crop scales. There is no four-digit keypad anywhere in this level: its other locks are a 3x3 sliding-tile board and a physical key.",
  },
  {
    q: "What is the generator for?",
    a: "The generator sits on the red steel shelf unit against the left wall, and its plate reads <b>4000</b> starting watts over <b>3500</b> running watts. It has a horizontal charge bar on the top cover, a rocker switch marked I and O, a pull starter labelled PULL, two outlets and two red breaker buttons. The recording fills the mower first and comes back to the generator, but the shed's power never comes on in the footage — the lights stay off until the candle at 7:45.",
  },
  {
    q: "What does the radio show?",
    a: "A portable radio with a cassette deck, sitting on the shelf beside the generator. Its small LCD reads <b>91.8</b>, and a pencil lies on the shelf next to a loose cassette. 91.8 is the level's one piece of broadcast information, and it is the sort of number this game uses for a three-dial lock — which is exactly what turns up on the red toolbox at 2:06.",
  },
  {
    q: "How do I open the red toolbox?",
    a: "Three number dials on the front of the case. The player works them from about 1:48, and by <b>2:10</b> the display reads <b>9 1 8</b>; the lid is up at 2:12 with the tray visible. The dials are stacked vertically, each with the current digit in a window and two flanking digits visible above and below, so you can see how far each wheel has travelled.",
  },
  {
    q: "What is the 3x3 sliding-tile puzzle?",
    a: "At <b>3:19</b> the game opens a 3x3 sliding-tile board on a wooden panel: eight numbered or pictured tiles and one empty slot. It is the slowest puzzle in the level — the recording shows it still scrambled at 7:13, roughly four in-game minutes later, and only solves it at <b>7:15</b>. Solving it releases the <b>Box opener</b>, a yellow utility knife with a red blade, which appears with its own item card.",
  },
  {
    q: "What does the Box opener open?",
    a: "The red metal locker, at <b>7:18</b>. The Box opener is consumed on it — it is in the inventory at 7:30 but the locker is already standing open with its door swung wide. This is the level's last container: everything after it is inventory management and the bike at the door.",
  },
  {
    q: "What is the candle for?",
    a: "At <b>7:45</b> a lit taper candle stands in the middle of the shed floor and the room is almost black — you can just make out the shelves and the workbench. Lighting it takes the shed from dark to dim, which is the point: the last three pickups (the truck, its key and the exit) all happen in a room you can barely see. The candle is the only light source in the level that actually works.",
  },
  {
    q: "Where is the Key?",
    a: "On top of the red remote-control monster truck, on the shed floor, at <b>8:06</b>. The truck's own label reads <b>SAVAGE X4.6</b>, and the key is a large ornate silver key that glows when the camera lands on it; the label under it simply reads <b>Key</b>. Take it, then turn around to the back door.",
  },
  {
    q: "What is the reward for Level 19?",
    a: "The results card at 8:24 pays <b>+50</b> coins, shows an Efficiency bar with nine of its ten segments filled, records <b>Time: 8:12</b>, and adds <b>300</b> to the piggy bank with the note that the piggy bank fills as you complete levels. This is the only room in the Chapter 3 batch whose completion screen is inside the recording, so it is the only one on this site with a printed reward.",
  },
  {
    q: "How long does this level take?",
    a: "The in-game clock on the results card says <b>8:12</b>. The YouTube recording is 8:24 because it includes the title card and about ten seconds of standing still after the door opens. Roughly four of those in-game minutes are spent on the sliding-tile board alone — it is the single biggest time sink in the room, and everything you need for it is available by 3:19.",
  },
  {
    q: "Is the Garden Shed room 19 of Chapter 3?",
    a: "Yes. Chapter 3 is <i>Murder Dressed in White</i>, and the Garden Shed is room <b>19</b> — after the Basement (18) and before Kids Bedroom 2 (20). It is the last outdoor-adjacent room in the chapter and the only one where the exit is a garden door rather than an interior one.",
  },
  {
    q: "Do I need the jerrycan and the mower to finish?",
    a: "The mower is one of the level's two fuel-driven machines, and the jerrycan comes out of a grey bucket at <b>0:19</b>. Pouring the fuel into the mower's tank at 0:41 is a required step in the run we followed — the mower's engine is what the level uses to get you moving between the shed's two halves. Skip it and the generator sequence has nothing to build on.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
