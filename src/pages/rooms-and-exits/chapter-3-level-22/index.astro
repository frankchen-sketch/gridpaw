---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 22 Walkthrough: Master Bedroom";
const description = "Rooms & Exits Chapter 3 Level 22 walkthrough for the Master Bedroom: the wooden path board with the white ball and green star, the 4x4 number board with its side column of 2, 6, 7 and 8, the walk-in closet, the four red buttons and their coloured light modules, the 3x8 shape grid, the twelve-gem circle, the tablet's 3x3 dot pattern and the shape-algebra screen where a green circle is 8, a blue square 2, a purple star 0 and a yellow pentagon 1. The recording stops at 8:27 with no results card.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 22 Master Bedroom?",
    a: "There is no single typed code. The Master Bedroom uses four separate locks: a wooden <b>path board</b> (roll a white ball from the top right to a green star), a <b>4x4 number board</b> with a side column of 2, 6, 7 and 8, a <b>3x8 shape grid</b> with eight plungers, and a <b>tablet</b> that holds both a 3x3 dot pattern and a shape-algebra screen. The only hard numbers the game prints are on the tablet: <b>green circle = 8</b>, <b>blue square = 2</b>, <b>purple star = 0</b>, <b>yellow pentagon = 1</b>.",
  },
  {
    q: "How do I solve the path board?",
    a: "It is a maze on a wooden board, five cells wide and three high, with a <b>white ball</b> parked near the top right and a <b>green starburst</b> near the bottom centre. Three shape ports run down the left edge and three match on the right — a circle, a square and a star — so the ball's route has to leave through the port that matches its shape. You tilt and turn the board rather than dragging the ball; the ball follows the grey channels.",
  },
  {
    q: "What are the numbers on the 4x4 board?",
    a: "The grid reads <b>4, 5, 1, 10</b> on the top row, then 3 and 17, then 9 and 18, then <b>17, 17, 11</b> with a left-arrow delete key in the bottom-right corner. A separate vertical column of four keys runs down the right side: <b>2, 6, 7, 8</b>. The blank cells on the main grid are part of the puzzle — you fill them — and the green outlines mark the two cells currently selected.",
  },
  {
    q: "What is behind the door on the right?",
    a: "A <b>walk-in closet</b>. It is a built-in dressing room with shoes on open shelves, hanging rails with coats and dresses, magenta drawers, stacked hatboxes, a Hollywood-style bulb mirror over a white vanity, a tablet propped on the counter and a pearl necklace on a display bust. A centre island holds folded clothes and white gloves.",
  },
  {
    q: "How do the four red buttons work?",
    a: "Four large red buttons sit in a row across a dark wooden panel, and under each one is a module of <b>four coloured lights</b> — blue, green, orange and pink in the left-hand module, pink, orange, green and blue in the second, then back to blue, green, orange, pink for the last two. The buttons drive those lights, so treat it as a sequence-and-state puzzle rather than a colour-matching one: you are trying to make each module show a required order.",
  },
  {
    q: "What is the 3x8 shape grid?",
    a: "A metal panel with eight columns and three rows of coloured shapes: <b>red triangles</b> on top, <b>green squares</b> in the middle, <b>blue circles</b> on the bottom. Eight round grey plungers sit under the columns, and there are shift arrows on both sides — green pointing right on the left edge, blue pointing left on the right edge. The arrows move whole columns, and the plungers lock them.",
  },
  {
    q: "What is the twelve-gem circle?",
    a: "A large off-white disc set into the wood, ringed by <b>twelve faceted gems</b>. Going clockwise from the top the colours run green, red, yellow, pink, orange, blue — and then repeat the same six colours a second time around the ring. That doubled sequence is the clue: the disc is asking you to pair positions, not to sort colours.",
  },
  {
    q: "What does the tablet show?",
    a: "Two screens. First a <b>3x3 dot pattern lock</b> — nine dots, with the bottom row lit as the pattern is drawn. Then a <b>shape-algebra grid</b>: a 4x4 arrangement of green circles, purple stars, blue squares and yellow pentagons, with the values printed beside it — green circle <b>8</b>, blue square <b>2</b>, purple star <b>0</b>, yellow pentagon <b>1</b> — row totals of <b>26, 4, 4, 8</b> down the right side and column totals of <b>10, 17, 11, 4</b> along the bottom.",
  },
  {
    q: "Does the shape algebra check out?",
    a: "Yes, completely. With circle 8, square 2, star 0 and pentagon 1, every row and every column lands exactly on the printed total. Row one is three circles and a square: 3 x 8 + 2 = <b>26</b>. Row two is two stars and two squares: 0 + 0 + 2 + 2 = <b>4</b>. Row three is a square and two pentagons: 2 + 1 + 1 + 0 = <b>4</b>. Row four is a circle and three stars: 8. The columns give <b>10</b> (8 + 0 + 2 + 0), <b>17</b> (8 + 0 + 1 + 8), <b>11</b> (8 + 2 + 1 + 0) and <b>4</b> (2 + 2 + 0 + 0). That full reconciliation is why the four values are printed on this page as fact.",
  },
  {
    q: "Does the recording show the level being completed?",
    a: "No. This copy runs <b>8:27</b> and the last frame is still the bedroom, with the in-game clock at <b>17:44</b> and an interaction arrow on the right-hand door. There is no results card, no coin reward and no piggy-bank figure for the Master Bedroom in this footage, so this page prints none.",
  },
  {
    q: "Why is the in-game timer so much longer than the video?",
    a: "The upload is time-lapsed. At 4:22 of video the in-game clock already reads 11:24, and by the last frame at 8:27 it reads 17:44. That is roughly a 2:1 compression, so the video timestamps on this page are for navigation only — do not read them as the level's real duration.",
  },
  {
    q: "Where does the Master Bedroom sit in Chapter 3?",
    a: "It is room <b>22 of 24</b> in Chapter 3, <i>Murder Dressed in White</i>: straight after the Hobby Room (Level 21) and before the Entertainment Room (Level 23).",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
