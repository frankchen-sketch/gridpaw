---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 1 Walkthrough: Dining Room";
const description = "Rooms & Exits Chapter 3 Level 1 walkthrough for Dining Room: the three-dial lock that takes 358 from the equation 13 × 3 × 9 − 2 + 9, the four-dial safe that takes 8563 off the crumpled paper, the fruit-bowl light projection, and the playing cards in the sideboard drawer.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 1 Dining Room?",
    a: "There are two locks and two codes. The <b>three-dial combination lock</b> takes <b>358</b> — the answer to the equation printed above it, <b>13 × 3 × 9 − 2 + 9</b>. The <b>four-dial safe</b> takes <b>8563</b>, the number written on the crumpled white <b>Piece of paper</b> you pick up in the room. Both were read twice from separate frames of the same recording.",
  },
  {
    q: "Where does 358 come from?",
    a: "From the white text above the lock itself. It reads <b>13 X 3 X 9 - 2 + 9</b>. Multiply first: 13 × 3 = 39, then 39 × 9 = 351. Then 351 − 2 = 349, and 349 + 9 = <b>358</b>. The lock has three dials, which matches a three-digit answer. Set each dial to the matching digit and the shackle releases.",
  },
  {
    q: "Where do I find the number 8563?",
    a: "On a <b>Piece of paper</b> in your inventory. It is a crumpled white scrap with the four digits written in red marker. You pick it up during the level; when you open the inventory and examine it, the digits are legible. The four-digit safe in the room is the lock that takes it. The digits are 8, 5, 6, 3 read left to right.",
  },
  {
    q: "What is the fruit bowl on the dining table for?",
    a: "It is a clue, not a container. Partway through the level a blue light projects a pattern onto the bowl and the fruit on it, and the bowl itself carries symbols — an X, a heart and a banana shape are visible. We treat it as a visual clue rather than a code we can read with confidence: the projection is legible as a smiley-face pattern, but we could not establish which lock it feeds, so this page does not print a number for it.",
  },
  {
    q: "What are the playing cards in the drawer for?",
    a: "The sideboard drawer near the window opens to reveal <b>playing cards and poker chips</b>. The cards go into your inventory — in the recording we captured the bag holds a 2 of Clubs, a King of Spades and a 7 of Diamonds. We could not establish which lock consumes them, so we do not present them as a code. If you are stuck, they are worth a second look, but we are not going to invent a sequence for them.",
  },
  {
    q: "What does the nutcracker do?",
    a: "A <b>Nutcracker</b> figure ends up in the inventory around the same time as a second Piece of paper. Our footage shows the item being collected and the paper being examined immediately afterwards, so the nutcracker is plausibly the tool that reveals the paper — but we never see the exact action in a single clear shot, so treat that as a probable chain rather than a confirmed one.",
  },
  {
    q: "What is Chapter 3 called, and is Dining Room the first room?",
    a: "Chapter 3 is <i>Murder Dressed in White</i>, and Dining Room is room 1 of it. The chapter moves the game indoors: instead of storefronts the rooms are the rooms of a house — dining room, living room, study, guest toilet, workshop, and so on. The room count for Chapter 3 in the game's own level list is fifteen.",
  },
  {
    q: "How do I open the four-dial safe?",
    a: "The safe is the brown metal box with four rotating dials, each showing three digits stacked vertically. Set the four dials to <b>8 5 6 3</b> from left to right. In our footage the dials rest on 8-5-7-0 before the code is entered, which is a useful confirmation that you are looking at the right object — if your dials do not start near those values, you are at a different lock.",
  },
  {
    q: "What is the reward for finishing Dining Room?",
    a: "We cannot tell you. The recording we sampled ends on a <b>THANKS FOR WATCHING</b> card at 2:42, before the results panel appears. Rather than quote a reward from another level's footage, this page leaves it blank. Every other Rooms &amp; Exits room we have documented pays a flat coin reward on a LEVEL COMPLETED card, so expect the usual card, but the figure for this room is unverified here.",
  },
  {
    q: "Do I need to do the locks in a particular order?",
    a: "No single order is enforced by the game, but the recording we sampled does the three-dial lock first (around 1:54) and the four-dial safe later (around 2:30). That order matches the clues: the equation is printed on the lock itself, so it can be solved on sight, while 8563 requires finding the paper first. If you are speedrunning, solve the equation as soon as you see the lock and keep an eye out for the paper while you work the rest of the room.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
