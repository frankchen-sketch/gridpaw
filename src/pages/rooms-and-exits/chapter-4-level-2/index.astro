import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 4 Level 2 Walkthrough: Power and Security";
const description = "Rooms & Exits Chapter 4 Level 2 Power and Security walkthrough: the 149 note and the dial on the red tool chest, the sliding-block board in the locker room, the work lamp and pegboard, the 5×5 circuit board inside the high-voltage panel, the wall outlet that boots the monitor wall, and the fifteen-card table that feeds the exit keypad. Every printed number was read twice from separate frames.";

const faq = [
  {
    q: "What is the code for the dial on the red tool chest in Power and Security?",
    a: "It is <b>149</b>. Three separate reads agree on it: the assembled note shows <b>149</b> in coloured segments at 2:18 (1 purple, 4 green, 9 pink), the three-digit dial is turned to <b>149</b> at 2:35, and the note sits in the inventory labelled <b>Note(149)</b> at 5:14. Setting the dial to 149 pops the top drawer of the red rolling tool chest.",
  },
  {
    q: "Where does the 149 note come from?",
    a: "The locker room hands it to you in pieces. The sliding-block board's reward at 1:25 is a <b>Piece of paper</b>, and by 2:18 the inventory holds a note assembled from <b>three scraps</b>. The assembled note is the only place the three digits appear together; the individual scraps on their own are line drawings, not numbers. Read the finished note, not the pieces.",
  },
  {
    q: "What do I do with the duct tape and the scissors?",
    a: "Combine them. At 4:02 the inventory shows <b>Duct tape</b> and <b>Scissors</b> side by side, and the run produces a <b>Piece of tape</b> from them. What the video does <i>not</i> show is where that piece of tape gets stuck: the player taps the electrical panel at 4:20, gets the message <b>It's too dangerous right now!</b>, and the tile board opens two seconds later. Taping the panel's exposed wiring is the obvious reading, but no frame shows the tape on anything, so this page does not print it as a confirmed step.",
  },
  {
    q: "How do I solve the tile board in the electrical panel?",
    a: "The panel's interior holds a <b>5×5 grid of square tiles</b>, each printed with a blue line segment. Rotating the tiles re-joins those segments, and the goal is one unbroken run of blue line across the board. The run works it from 4:22 and finishes at about 4:38: the line turns <b>red</b> when the loop closes, the panel's indicator light goes from red to <b>green</b>, and the room's power is on. It is a rotation puzzle, not a code — there is nothing to type.",
  },
  {
    q: "How do I turn the monitors on?",
    a: "There is a wall outlet to the left of the blue exit door, with a black cable plugged into it and a white toggle switch beside the socket. When you find it the <b>red</b> indicator is lit and the switch is <b>down</b>. Flip the switch up at 4:49 and the green indicator lights instead; at 4:53 the whole monitor wall boots and shows a security-camera feed and a door status panel.",
  },
  {
    q: "What is the J=12 clue for?",
    a: "It is handwritten in black on the yellow wall on the left side of the control room, near the overflowing trash can and the blue plastic bag — visible at 2:06 and again at 5:26. It tells you how to read the playing cards on the round table: a <b>Jack counts as 12</b>, not 11. Without that rule the three face-down cards cannot be turned into keypad digits at all, which is why the level bothers to write it on the wall.",
  },
  {
    q: "What is the answer to the card puzzle?",
    a: "This page does not print the digits, because the video never shows them being typed and our two reads of the card ranks do not agree. What the layout does give you is reliable: <b>fifteen cards in three rows of five</b>, each row a single suit — diamonds on top, spades in the middle, hearts at the bottom — with exactly <b>one face-down card per row</b>. Combine that with J=12 and the keypad on the exit door, and the three hidden values are what the lock is waiting for.",
  },
  {
    q: "What is the exit door code?",
    a: "Unknown. The exit door raises a numeric <b>ENTER PASSCODE</b> keypad at 5:32, and the run clears it, but the digits are never legible in any frame we pulled — the entry is masked. So the code is on the page as a method, not as a number.",
  },
  {
    q: "Does the recording show the level being completed?",
    a: "Yes, and this one ends properly. The run is complete to the last frame: the keypad closes, the door opens, and at <b>5:44</b> the game cuts to <b>LEVEL COMPLETED!</b> with <b>10/10 efficiency</b>, <b>Time 5:42</b> and a <b>+50</b> coin reward. That is a cleaner ending than most of the Chapter 3 pages on this site, where the video fades on the exit arrow.",
  },
  {
    q: "Where does Power and Security sit in Chapter 4?",
    a: "Chapter 4 is <i>Pharaoh's Bride</i> and it has <b>15 rooms</b>. Power and Security is room <b>2 of 15</b> — straight after Pharaoh's Tomb and before The Office. Mechanically it is a two-room level: a yellow control room with the exit door, the monitor wall and the electrical panel, and a green locker room where most of the items and both paper pickups live.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
