---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 20 Walkthrough: Furniture Store";
const description = "Rooms & Exits Chapter 2 Level 20 walkthrough for the Furniture Store: the four carpet parts and the round rug, the yellow safe that takes 693, the oven panel that takes 12:08, the tangram board that yields the Mirror, the mirrored paper that turns 12850 into the till code 02851, and the ID card that opens the exit.";

const faq = [
  {
    q: "How do I open the exit door in Rooms & Exits Chapter 2 Level 20?",
    a: "With a card, not a code. The exit is the grey door on the right-hand wall with a keyhole on the left leaf and a card reader on the right; insert the <b>ID card</b> into the reader and its indicator goes from <b>red to green</b>, then the door swings open. Our second recording shows the whole sequence: red at 14:10, card in at 14:11, green at 14:12, door open at 14:13. There is nothing to type at the door — no keypad, no dials, no pane digits.",
  },
  {
    q: "What is the till code in the Furniture Store?",
    a: "<b>02851</b>, five digits. It is not written anywhere: the <b>Piece of paper</b> in your bag reads <b>12850</b>, and once you have combined it with the <b>Mirror</b> into the <b>Mirrored piece of paper</b>, the reflection reads <b>02851</b>. Type that into the till keypad at the reception desk and the register prints a receipt. Our footage shows the display rolling 0 → 0285 → 02851 on consecutive frames and the receipt appearing four seconds later.",
  },
  {
    q: "What is the safe code?",
    a: "<b>693</b>. The yellow safe panel in the kitchen display has a five-spoke dial and three digit windows tinted white, green and brown. Our run walks the windows through 695, 699, 692 and stops on <b>693</b>, and the door gives up a pair of <b>Batteries</b>. We never find the clue that produces 693 in any of our four recordings, so treat it as a number to try rather than a number to understand.",
  },
  {
    q: "What time does the digital clock want?",
    a: "<b>12:08</b>. The panel is the oven's control display in the kitchen showroom — a yellow-green readout with hour chevrons on the left, minute chevrons on the right and an <b>OK</b> button between them. Set 12:08 and press OK, and the oven door drops open on a baking tray with two crescent-shaped bakes on it. Our footage reads 12:06 one frame before the accepted 12:08, which is the frame everyone screenshots.",
  },
  {
    q: "What are the four Carpet parts for?",
    a: "They build the round rug in the living-room display. Four rolled carpet pieces are scattered around the showroom floor, and the inventory counts them up as you take them — the counter reads <b>3/4</b> on the frames just before the last one goes in. Lay them around the coffee table and the circular rug assembles itself into the patterned disc you can see in every wide shot afterwards. It is the level's opening chore, not a lock.",
  },
  {
    q: "Where does the Mirror come from?",
    a: "The tangram board. A white tablet-shaped board with coloured geometric pieces and four controls down its right edge — rotate left, rotate right, flip horizontally, flip vertically — takes up the middle of the level from about 10:00. Clear it and the <b>Mirror</b> goes into the bag at 10:33. Without the mirror the paper is just a five-digit number that fits nothing in the room.",
  },
  {
    q: "What is the receipt for?",
    a: "It is the printout from the till after you enter 02851, and it is a reward rather than a clue: six stars at the top, the date <b>21/02</b>, a <b>15:11</b> timestamp, seven grocery lines — Milk 1.59, Apple 1.63, Juice 1.23, Sausage 4.67, Bread 0.4x, Cheese 2.99, Carrot 3.45 — and a barcode at the bottom. The moment it prints, the showroom lights up with new hotspots; our run picks the ID card off the reception desk seven seconds later.",
  },
  {
    q: "How long does the Furniture Store take?",
    a: "Our fastest full recording finishes in <b>11:13</b> and the only run that reaches the results panel shows <b>14:10</b> on the level clock. Nothing is timed and there is no fail state, so the difference is entirely how long you spend looking for a code at the door that does not exist.",
  },
  {
    q: "What do I get for finishing Chapter 2 Level 20?",
    a: "The results panel we captured pays <b>+5 coins</b> with a Time field of <b>14:10</b> and an efficiency bar about seven tenths full. That panel comes from a build that numbers this room <b>Level 24</b> rather than 20, so the first-clear payout on the current build may well be larger — the +5 is what we could actually read, and it is printed here as read rather than as a guess.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
---
