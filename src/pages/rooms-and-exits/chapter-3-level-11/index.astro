import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 11 Walkthrough: Kitchen";
const description = "Rooms & Exits Chapter 3 Level 11 walkthrough for Kitchen: the three-letter cabinet lock that takes UAV from the coloured tile-lines above the stove, the breaker panel that wants the T5 switch, the sliding-block pantry puzzle, and the boiled kettle step. Both key answers were read twice from separate frames.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 11 Kitchen?",
    a: "Two things get you through this room. The <b>three-letter cabinet lock</b> takes <b>U A V</b>, read left to right, and it is the answer to the coloured tile-lines puzzle above the stove. The <b>breaker panel</b> is not a typed code at all: the panel's on-screen instruction reads <b>TURN ON THE T5 SWITCH</b>, and T5 is one of the eight labelled switches in the row. Both were read at least twice from separate frames of the same recording.",
  },
  {
    q: "How do I get U A V from the coloured lines?",
    a: "The instruction printed over the backsplash reads <b>PUT LINES OF THE SAME COLOR TOGETHER TO FORM LETTERS</b>. The tiles start scattered, so at a glance the wall looks like fragments of an L, an H and a third shape. Read by colour instead: the red segments assemble into <b>U</b>, the olive-yellow segments into <b>A</b>, and the dark green segments into <b>V</b>. The lock's three dials are coloured the same way — red, olive, dark green — which is what ties the wall to the lock.",
  },
  {
    q: "What are the letters on the lock when it opens?",
    a: "In the frame immediately before the cabinet swings open the three dials read <b>U</b> (red), <b>A</b> (olive green) and <b>V</b> (dark green). We read that frame three ways: whole frame, a 4× crop of the panel, and a 6× crop of each individual letter. All three passes agreed. Frames a few seconds earlier show the dials mid-scroll (G-M-N, then U-T-N, then U-A-N), which is what a player cycling to the answer looks like.",
  },
  {
    q: "What is the T5 switch for?",
    a: "Power. The breaker panel sits on the wall by the counter and carries a row of eight labelled switches: <b>C5, C6, S2, H7, M3, T5, E2, P4</b>. A caption over the panel reads <b>TURN ON THE T5 SWITCH</b>. Flipping T5 brings the kitchen's electrics back, which is what lets you use the electric kettle later in the run. The separate pop-up at the stove also mentions a clue label, H7 — the same naming scheme, used for a different switch.",
  },
  {
    q: "What does the pop-up at the stove say?",
    a: "At roughly 0:46 the stove refuses an action and prints: <b>THE STOVE MUST BE TURNED OFF FIRST, SO THE WALLS CAN BE CLEANED. (CLUE H7)</b>. So the cleaning chain is gated behind the stove, and the game is pointing you at the switch named H7. We could not see the exact moment the stove is switched off in a single clean shot, so treat the H7 link as the game's own hint rather than something we watched happen.",
  },
  {
    q: "How do I open the tall pantry cabinet?",
    a: "With the sliding-block puzzle on its front. From about 0:54 the recording is inside that puzzle: a square frame of stone-like rectangular blocks with one gap, the classic sliding-tile arrangement. The recording works it for roughly half a minute and the cabinet is open by 2:07, revealing a bowl, a toaster and the kettle. We are not going to hand you a move list for it — the footage is sped up and cut, and a wrong move sequence would waste more of your time than solving it yourself.",
  },
  {
    q: "Where do I find the handle and the detergent?",
    a: "The <b>Handle</b> comes off the tall cabinet unit on the right at about 0:14 — it is the first item in the bag. The <b>Detergent</b> is the yellow bottle standing on the counter by the sink, picked up at about 0:38, and a <b>Soapy sponge</b> is in the bag by 1:36. Those three are the cleaning kit, which is why the stove has to be off before the walls can be wiped.",
  },
  {
    q: "What is the 325 on the mug?",
    a: "There is a dark mug on the cutting board next to two sugared doughnuts near the end of the recording, and the mug carries a printed design with the digits <b>3 2 5</b> on it. We read it twice at high zoom and both reads gave 325. What we could not do is find a lock in this room that accepts three digits — no keypad appears anywhere in the footage we sampled — so this page lists 325 as a lead, not as a code to type.",
  },
  {
    q: "Is Kitchen room 11 of Chapter 3?",
    a: "Yes. Chapter 3 is <i>Murder Dressed in White</i> and its room list runs: Dining Room, Living Room, Study Room, Guest Toilet, Workshop, Guest Bedroom, Master Bathroom, Kids Playroom, Backyard, Garden, <b>Kitchen</b>, Driveway, Kids Bedroom, Storage Room, Garage. Kitchen is room <b>11 of 15</b>, directly before the Driveway.",
  },
  {
    q: "Does the recording show the level being completed?",
    a: "Not the copy we worked from. The clip runs 3:43 in total but our sampled copy cut out around 3:20, before any results card, so this page does not print a coin reward or an exit animation for Kitchen. Everything above comes from the part we could decode frame by frame.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
