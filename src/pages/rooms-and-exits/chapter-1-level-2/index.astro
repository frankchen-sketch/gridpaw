const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is the code for the wall safe in Rooms & Exits Chapter 1 Level 2?", "acceptedAnswer": {"@type": "Answer", "text": "514. Turn on the neon light above the mirror and count the fingers on the three glowing handprints: five on the first, one on the second, four on the third. Enter 5-1-4 on the wall safe beside the cell bars; its door opens onto the colour panel."}}, {"@type": "Question", "name": "Where is the knife in Rooms & Exits Level 2?", "acceptedAnswer": {"@type": "Answer", "text": "Inside the desk drawer that has no handle. Solve the four book spines on the left shelf to get the Handle, fit it on the drawer, pull it open and the Knife is the only item inside."}}, {"@type": "Question", "name": "How do I get the crumpled paper in Level 2?", "acceptedAnswer": {"@type": "Answer", "text": "Select the Knife in your inventory, then use it on the hanging sack that dangles from the chain above the radiator on the left wall. The sack tears open and the Crumpled paper drops out."}}, {"@type": "Question", "name": "Does this walkthrough match the current version of the game?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The order was rebuilt frame by frame from two independent playthroughs recorded in July and August 2025. One widely copied instruction still tells players to cut open a green armchair cushion; there is no armchair in this room, and the knife target is the hanging sack."}}]};
