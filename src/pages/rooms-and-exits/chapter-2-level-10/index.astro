import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 10 Walkthrough: Restaurant";
const description = "Rooms & Exits Chapter 2 Level 10 walkthrough for the Restaurant: the four-drink chalkboard, the briefcase code 6743, the plate-and-fork total of 18, the nut-sort board, the pizza assembly, the oven panel and the four-letter FOOD lock, worth +50 coins.";
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {"@type": "Question", "name": "What is the four-digit code in the Restaurant in Rooms & Exits Chapter 2?", "acceptedAnswer": {"@type": "Answer", "text": "6743. The code goes into the burgundy briefcase that sits on the dining-room floor with a cocktail-glass emblem on its front. The case has four golden drums with a row of buttons underneath; our capture shows the drums settled on 6, 7, 4, 3 before the case is put away, and the four digits are the same four prices written on the chalkboard menu behind the bar."}},
  {"@type": "Question", "name": "What number goes into the plate-and-fork panel?", "acceptedAnswer": {"@type": "Answer", "text": "18. The teal panel has a white plate, a plus sign and a white fork above two digit boxes that start at 0 and 0. Count every plate and every fork laid out on the dining tables and add them: one setting gives 8 plates and 5 forks, which is 13, a second gives 4 plates and 1 fork, which is 5, and 13 plus 5 is 18. Both recordings we checked finish on 18."}},
  {"@type": "Question", "name": "What is the four-letter code in the Restaurant?", "acceptedAnswer": {"@type": "Answer", "text": "FOOD. The grey panel beside the service doorway holds four letter wheels that you turn one at a time; when you first reach it in our recording it already reads F, O, O, D, and the level ends once the wheels are back on that word after being scrambled."}},
  {"@type": "Question", "name": "How do I build the pizza?", "acceptedAnswer": {"@type": "Answer", "text": "Open the bag, select Dough, press Combine, then tap Tomato, and the pair becomes a Pizza. Select the Pizza and press Combine again for each topping in turn — Onion, Chili pepper and Cheese are the order the labels appear in our second recording. Olives go in as well. The finished pizza is the item you carry to the oven."}},
  {"@type": "Question", "name": "How do I use the oven?", "acceptedAnswer": {"@type": "Answer", "text": "The oven is missing its control knob, so fit the Oven button item first. The panel then has two dials — the left one runs 0 to 7 and the right one is a timer marked 15, 30, 45, 60 and 75 — plus a degrees-Celsius button and a pink ON button. Turn the timer to its top setting, set the heat dial and press ON. Our two reads of the heat dial disagreed, so this page does not publish a heat number."}},
  {"@type": "Question", "name": "How long does the Restaurant take?", "acceptedAnswer": {"@type": "Answer", "text": "Our capture finishes it in 24:13 of level time, but the clip is sped up to roughly double speed, so it is eleven and a half minutes of footage. Nothing is timed and there is no fail state, so the only thing that stretches the level is walking between the dining room and the kitchen without a list."}}
]};
