const title = "Rooms & Exits Chapter 2 Level 18 Walkthrough: Sports Store";
const description = "Rooms & Exits Chapter 2 Level 18 walkthrough for the Sports Store: the seven cap colours that give the till passcode 6273519, the gym slide puzzle that drops a Key, the hoodie-and-ball icon puzzle and the five billiard balls 8-4-3-7-1 that set the exit keypad to 84371.";

const faq = [
  {
    q: "What is the exit code in Rooms & Exits Chapter 2 Level 18?",
    a: "<b>84371</b>. The keypad on the stand beside the glass ball display takes five digits, and the display itself is the clue: five billiard balls in a row, left to right <b>8 · 4 · 3 · 7 · 1</b>. Our two recordings of this level both finish with the same five balls in the same order and both type <b>84371</b>, so on the evidence this is a fixed display and not something you assemble yourself.",
  },
  {
    q: "What is the till passcode in the Sports Store?",
    a: "<b>6273519</b>, seven digits, typed into the blue ENTER PASSCODE screen on the checkout monitor. Both recordings enter the same seven digits, and our frame-by-frame read of the input field agrees across four separate readings. The digits come from the wall of baseball caps: seven caps left to right, their colours matched to the seven coloured keys of the twelve-key pad on the counter.",
  },
  {
    q: "How do the caps give the passcode?",
    a: "There are seven caps on the slatwall above the folded shirts, and seven coloured keys on the twelve-key pad beside the counter. Read the caps left to right — red, orange, yellow, blue, green, pink, pale blue — and press the matching colour on the pad: red is <b>6</b>, orange is <b>2</b>, yellow is <b>7</b>, blue is <b>3</b>, green is <b>5</b>, pink is <b>1</b>, pale blue is <b>9</b>. That reads <b>6-2-7-3-5-1-9</b>. The grey keys (4, 8, 0) are not used, which is the tell that the mapping is colours, not positions.",
  },
  {
    q: "Where does the exit code 84371 come from?",
    a: "From the billiard balls. Five numbered balls sit in a glass-fronted display on a wooden stand in the shop, and the keypad is bolted to the same stand. Read the balls the way they sit — <b>8, 4, 3, 7, 1</b> — and type that into the keypad. Our second recording shows the display filling ball by ball during the run and ending in exactly that order, which is why we treat it as a fixed arrangement rather than a puzzle you solve.",
  },
  {
    q: "How many billiard balls are in the level?",
    a: "Six. The inventory counter runs <b>5/6</b> when you first open the bag at 1:55 and reaches <b>6/6</b> at 5:26 after the last one is cut out of the base of the punching bag with the Knife. The display that gives the exit code only uses five of them, so the sixth is spare — do not keep hunting for a sixth slot once the counter reads 6/6.",
  },
  {
    q: "What does the gym picture puzzle give me?",
    a: "A <b>Key</b>. The square panel on the gym wall is a scrambled picture of the gym floor with one empty square — a sliding-block puzzle. Rearrange it until the picture is whole and a silver Key goes into the bag at 5:18. In our footage we never see that key turn a lock: the exit takes the five-digit code, not a key, so treat the Key as a collectible rather than the way out.",
  },
  {
    q: "How long does the Sports Store take, and what do I get?",
    a: "The results panel in our first recording reads <b>Time: 8:39</b> and pays <b>+5 coins</b>, with a full Efficiency bar and the piggy bank at <b>600/700</b>. It is one of the shorter Chapter 2 rooms — there is no timer, no fail state and no penalty for wandering, so the only thing that really costs you minutes is hunting for the exit code before the ball display makes sense.",
  },
  {
    q: "Why does my title card say Level 22?",
    a: "Because the build in our first recording prints <b>Level 22 — Sports Store</b> on the title card, while the game's own level list and this site's chapter index call the same room Level 18. The room, its layout and both codes are identical across our recordings, so treat the number on the card as numbering drift between builds rather than a different level.",
  },
  {
    q: "Do I need the tennis racket count?",
    a: "Only for the four-dial panel on the shop floor, which our second recording settles on <b>5216</b> — one count per colour bay. The game's own hint for that panel reads \"Count the courts\", and the panel takes the count of rackets in each of the four bays, red through green. Our first recording sets the same panel without a hint and we could not read its readout, so <b>5216</b> is printed here as that player's answer, not as a constant we confirmed twice.",
  },
  {
    q: "What are the eight letters on the skate display?",
    a: "A strip of eight letters — <b>FDEOMZYH</b> — runs along the top of the inline-skate display at 6:14. We read it twice off the same frame (optical character recognition and a visual pass) and it agreed, but we never saw it typed anywhere in either recording, so we cannot tell you what it unlocks. If your room shows a different string, trust your screen, not this page.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
