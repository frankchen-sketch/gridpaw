const title = "Rooms & Exits Chapter 3 Level 16 Walkthrough: Attic";
const description = "Rooms & Exits Chapter 3 Level 16 walkthrough for the Attic: the red hexagonal wall clock and its missing hand, the four-digit display that reads 3549, the octagon plate and the 5x5 shape grid, the birdcage that ends the room, and the full results card at 8:55 — +50 coins, Time 8:43, piggy bank 300.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 16 Attic?",
    a: "The room's number lock is a four-digit display with an up arrow above it and a down arrow below it. At <b>4:39</b> it reads <b>3549</b>, left to right. That reading was taken twice — once from the whole frame and once from a crop — and both passes agreed. The Attic also carries a shape grid and an octagon plate, and those are state puzzles rather than typed codes.",
  },
  {
    q: "What is the clock hand for?",
    a: "The <b>Clock hand</b> is an inventory pickup shown at <b>0:19</b>, and the room contains a red hexagonal wall clock on a shelf at <b>1:39</b>. The name of the item and the shape of the clock match each other exactly, which is the strongest single hint in the level: a clock with a hand missing, and a hand sitting in your inventory. The recording never holds on the clock while a hand is being fitted, so the fitting itself is not on camera.",
  },
  {
    q: "What does the red hexagonal wall clock look like?",
    a: "A red hexagonal case with a white face, a gold bezel and a short brass pendulum hanging beneath it, sitting on a shelf between a stack of books and dark bottles. The face carries hour markers rather than numerals. In the sampled frame one hand is present and the other position is empty, which is what makes the Clock hand pickup relevant.",
  },
  {
    q: "What is the row of letters in the inventory?",
    a: "At <b>2:59</b> the inventory shows a strip with the letters <b>R N G N D P A O B E C K L</b> laid out over a tile grid, below the usual Use, Combine, Dismantle and Examine buttons. It is an inventory view rather than a lock you walk up to, which is unusual — the game is showing you the material you have collected rather than a panel to solve. Because the row is small in frame and reads as a loose sequence, this page lists it as observed but does not present it as an ordered answer.",
  },
  {
    q: "What is the octagon plate puzzle?",
    a: "At <b>4:59</b> the camera holds on a square plate carrying a grid of small coloured octagons — orange, red, green, yellow and dark ones in a repeating pattern. Like the shape grid later in the run, it is an attribute puzzle: the pieces differ by colour, not by number, and the plate is the board rather than a keypad.",
  },
  {
    q: "What is the 5x5 shape grid?",
    a: "At <b>5:59</b> a five-by-five grid of tiles appears full-screen. Each tile holds a flat shape in one of several colours; the shapes vary across the grid rather than repeating one motif. Nothing in the sampled frames shows the grid being solved, so this page describes the board and not a sequence.",
  },
  {
    q: "Why does the attic suddenly light up?",
    a: "At <b>8:23</b> the room is bright and the white birdcage in the middle of the floor is clearly visible with a yellow bird inside it. Earlier frames of the same room are dim and lamp-lit. The change coincides with the end of the level, and the birdcage is the last object the camera settles on before the results card — which is why it reads as the room's final action rather than a mid-level puzzle.",
  },
  {
    q: "Does the recording show the Attic being completed?",
    a: "Yes, and completely. The results card at <b>8:55</b> reads <b>LEVEL COMPLETED!</b> with a coin reward of <b>+50</b>, <b>eight of ten</b> efficiency segments filled, <b>Time: 8:43</b>, and a piggy-bank contribution of <b>300</b> with the bank flagged <b>Full!</b>. The +50, the 8:43 and the 300 were each read twice from separate passes and agreed both times.",
  },
  {
    q: "How long is the Attic run?",
    a: "The source file runs 8:56, which makes it the longest of the three Chapter 3 utility rooms — roughly three minutes longer than the Storage Room and three and a half longer than the Garage. It is also the least cut of the three: the room is revisited several times, so you get repeated looks at the same props in different light.",
  },
  {
    q: "Where does the Attic sit in Chapter 3?",
    a: "Chapter 3, <i>Murder Dressed in White</i>, lists twenty-four rooms. Attic is room <b>16 of 24</b>, straight after the Garage and immediately before the Terrace. It closes the chapter's run of three utility spaces — cellar, garage, attic.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
