const title = "Rooms & Exits Chapter 1 Level 6 Walkthrough: Amusement Park";
const description = "Rooms & Exits Chapter 1 Level 6 walkthrough: the 1496 keypad on the blue ticket machine, the 20 / 67 / 81 photo strips that unlock the strength tester, the 2000-score key, the arcade cabinet and the ring toss that ends Amusement Park.";
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {"@type": "Question", "name": "What is the keypad code in Rooms & Exits Chapter 1 Level 6?", "acceptedAnswer": {"@type": "Answer", "text": "1496. The keypad is on the blue ticket machine in the north-east corner of the park. The same number is painted on the blue ride structure behind the control panel next to it."}},
  {"@type": "Question", "name": "What are the three numbers in the photo booth in Amusement Park?", "acceptedAnswer": {"@type": "Answer", "text": "20, 67 and 81. The photo strips pinned in the booth carry them in that order, and they go into the three two-digit fields on top of the strength tester."}},
  {"@type": "Question", "name": "How do you get the key in Level 6?", "acceptedAnswer": {"@type": "Answer", "text": "Fill the strength tester's top panel with 20 / 67 / 81, then hit the punching bag until the score reaches 2000. The silver key drops out of the same booth."}},
  {"@type": "Question", "name": "What do you do with the ring at the end of Amusement Park?", "acceptedAnswer": {"@type": "Answer", "text": "The ring is the prize from the bumper-car grid inside the arcade cabinet. Take it to the ring-toss board: the board is already at 112 and the target is 150, so hang the remaining rings on the numbered pegs to push the score over the line."}},
  {"@type": "Question", "name": "How long is Level 6 in Rooms & Exits?", "acceptedAnswer": {"@type": "Answer", "text": "About five minutes for a player who knows the park. The recorded run this page is built from finishes in 5:06, and most of that is the bumper-car grid and the ring toss."}}
]};
