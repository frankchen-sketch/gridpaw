import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 11 Walkthrough: DIY Shop";
const description = "Rooms & Exits Chapter 2 Level 11 walkthrough for the DIY Shop: the sticky note 51432, the five-dial combination lock 42130, the blueprint letters GDC, the tracing paper 954 and the three gas valves worth +50 coins.";
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the five-digit code in the DIY Shop in Rooms & Exits Chapter 2 Level 11?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "42130. It opens the five-dial combination lock inside the hole you knock in the brick wall with the hammer. Read the dials left to right: 4, 2, 1, 3, 0. The lock sits on a green cabinet door behind the bricks, and inside is the Blowtorch part."
      }
    },
    {
      "@type": "Question",
      "name": "What does the sticky note 51432 open?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The blue panel with five round yellow buttons and five indicator lights. Count the buttons 1 to 5 from the left and press them in the order written on the note: 5, then 1, then 4, then 3, then 2. When all five lights turn green the drawer of the blue tool chest underneath opens and the Hammer is inside."
      }
    },
    {
      "@type": "Question",
      "name": "What is the three-letter code on the green toolbox?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GDC. It comes from the blueprint: the plan is divided into lettered rooms and its labels include G, D and C, which is the order the lock takes. Set the three wheels of the yellow letter lock to G, D and C and the toolbox opens on a Crowbar."
      }
    },
    {
      "@type": "Question",
      "name": "What is the code for the keypad behind the DIY Shop?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "954. It is written on the folded tracing paper you find under the loose floorboards, and it goes into the grey keypad panel on the wall of the back room. Three digits, entered in order, then the tick. The panel releases and exposes the three red gas valves."
      }
    },
    {
      "@type": "Question",
      "name": "How do I get the key out of the floor grate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Three steps. First build the Blowtorch in the bag: Combine the Blowtorch part from the green cabinet with the nozzle and the fuel canister you already carry. Then Combine that Blowtorch with the Lighter to make the Lit blowtorch and use it on the metal floor grate to burn it open. The key is down the hole but the grate is too narrow for fingers: Dismantle the Hanger into a Hook, use the hook on the drain, and the key comes up."
      }
    },
    {
      "@type": "Question",
      "name": "Where is the blueprint and what do I do with it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The key from the floor grate opens a drawer of the blue tool chest and the blueprint is inside, rolled up. Take it to the blank drawing board on the wall and use it there: the plan unfolds into a floor plan of the building with lettered rooms. That picture is the clue for the three-letter lock on the green toolbox."
      }
    },
    {
      "@type": "Question",
      "name": "How do I stop the gas leak and finish the level?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Open the keypad panel with 954, then turn all three red valve wheels on the gas pipes. Our capture leaves them pointing left, up and right, in that order, and the moment the third one is turned the leak stops and the level ends on the results screen: +50 coins and a time of 5:21."
      }
    },
    {
      "@type": "Question",
      "name": "How long does the DIY Shop take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The recorded run finishes in 5:56 of footage and the game clocks the level at 5:21. Nothing is timed and there is no fail state. The two things that stretch it are the five-button panel before you have read the sticky note, and the blueprint before you have opened the blue tool chest drawer with the key."
      }
    }
  ]
};
