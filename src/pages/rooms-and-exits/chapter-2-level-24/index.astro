---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 24 Walkthrough: Toy Store";
const description = "Rooms & Exits Chapter 2 Level 24 walkthrough for the Toy Store: the block train, the semaphore chart that spells TRAIN, the heart-box colour grid, the balloon tunnel gate and the key that opens the exit.";

const faq = [
  {
    q: "How do you complete Rooms & Exits Chapter 2 Level 24, the Toy Store?",
    a: "There is no keypad and no door code. The exit is the double wooden door under the red <b>EXIT</b> banner, and it opens with a <b>Key</b> taken from a wardrobe in the dollhouse corner. Everything before that is feeding the room: the 3x3 shape panel on the toy dump truck, the semaphore chart and the toy typewriter that takes the word <b>TRAIN</b>, the fruit stand matched to the dolls' dresses, the heart-shaped box whose lid hides a colour grid, the four-by-four colour panel, the dollhouse lights, the balloon wall that opens the tunnel gate and the block train assembled from the <b>2-5</b> reference card.",
  },
  {
    q: "What word do you type on the toy typewriter?",
    a: "<b>TRAIN</b>. The typewriter has a full alphabet plus a piano-style number row, and its display fills in one letter at a time as you press keys. Our two independent recordings both end on <b>TRAIN</b>, read straight off the device's display, so this is the one word in the level we are willing to print as fixed.",
  },
  {
    q: "What is the exit code for the Toy Store?",
    a: "There isn't one. The exit door in this level has no dials, no panes and no digits — our recordings show the inventory opened with <b>Key</b> selected, the key used on the door, and the level completing immediately after. If you are hunting for a four-digit code, you are thinking of the Jewelry Store two chapters of rooms earlier.",
  },
  {
    q: "How do I open the tunnel gate in the Toy Store?",
    a: "With the hot-air balloons on the left wall. The game's own hint card says the balloons are an arrangement puzzle and that arranging them opens the tunnel gate, and a second recording's hint phrases it the same way. Five balloons hang above the tree-shaped shelf; tap them and put them in the order the hint shows.",
  },
  {
    q: "What does the 3x3 panel on the dump truck do?",
    a: "It releases the truck. The panel sits on the dump truck's bed and shows a three-by-three grid of shapes — diamonds, circles and triangles — with a white ball marking one cell. Clear the grid and the green tailgate swings up; inside the bed is a small metal crank key. The panel is the lock, the truck bed is the container.",
  },
  {
    q: "What is the heart-shaped box for?",
    a: "The heart box on the shelf is a clue container. Its lid holds a small grid picture that is too grubby to read until you wipe it: combine the <b>Towel</b> with the <b>Cleaning spray</b> to make a <b>Wet towel</b>, then use it on the inside of the lid and a grid of coloured squares comes up. That grid is what the four-by-four colour panel on the wall is asking you to reproduce.",
  },
  {
    q: "What does '2-5' mean on the card next to the train?",
    a: "It is the reference card for the block train. The card shows a finished train built from coloured blocks with the numbers <b>2</b> to <b>5</b> marking positions, and the loose blocks on the floor are the pieces. Build the train to match the card. If you leave a piece out, the game tells you plainly: <i>The train doesn't seem complete. It won't run yet.</i>",
  },
  {
    q: "How long does the Toy Store take, and what is the reward?",
    a: "The results panel on our main recording pays <b>+50 coins</b> and shows <b>21:31</b> on the in-game clock, with nine of ten efficiency segments lit. A second recording reaches the exit with <b>12:56</b> on the clock, so a clean second run is much faster — the level is long because of the number of separate locks, not because any one of them is slow.",
  },
  {
    q: "Do I need the hair dryer, the pliers and the cable?",
    a: "We could not prove that any of them is required. All three are picked up in the first twenty seconds of our main recording and all three can be combined or examined, but the footage never shows them used on a lock, and the level completes without a visible payoff for them. If you are stuck and short of inventory space, they are the first things to ignore.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
