---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 21 Walkthrough: Hobby Room";
const description = "Rooms & Exits Chapter 3 Level 21 walkthrough for the Hobby Room: the Blue tempera tube, the key hanging under the daffodil painting, the hexagonal box on the green dresser and its six-tile rotation puzzle, the four carved diamond recesses that take the Wooden decoration tiles, the drawer that needs a Handle, the three tulip planters reading 7, 2 and 5, the three-segment colour dial and the blue papercraft model house. The run finishes at 9:11 with +50 coins.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 21 Hobby Room?",
    a: "The only numbered clue in the room is the row of three yellow wall planters on the right: the <b>red tulip</b> planter is numbered <b>7</b>, the <b>magenta tulip</b> planter <b>2</b> and the <b>yellow tulip</b> planter <b>5</b>. Those three colours match the three segments of the circular dial that appears later — red, magenta, yellow — so the intended reading is 7 / 2 / 5. We could not confirm the dial's accepted digits from a clean frame; see \"What this page could not verify\".",
  },
  {
    q: "How do I open the hexagonal box?",
    a: "The hexagonal wooden box sits on the green dresser on the right wall, with a light grey lid. On top of it sit <b>four square coasters in a 2x2 grid</b>, each divided into four quadrants by a cross, on yellow, teal, peach and green backgrounds. Tapping the box opens a full-screen <b>rotation puzzle</b> on a hexagonal tray: <b>four square tiles in a 2x2</b> — light green, orange, light blue and yellow — each carrying four curved shapes around a coloured centre dot. Tap a tile to rotate it until the shapes meet their neighbours. The puzzle is the box's lock, and it runs for roughly a minute in this recording.",
  },
  {
    q: "Where is the key in the Hobby Room?",
    a: "On a wall-mounted key holder below the framed <b>daffodil painting</b>, on the pink wall beside the ladder shelf with the thread basket. The holder has three hooks — a black car remote on the left, a small key in the middle and a larger key on the right — and the run takes the key. It opens the tall green cabinet on the right wall, which holds the upper shelves of craft stock.",
  },
  {
    q: "What is Blue tempera for?",
    a: "It is one of the paint tubes on the wall shelf above the workbench, picked up at <b>0:36</b> with the caption <b>Blue tempera</b>. It is the only paint the run collects, and the only blue object that needs painting is the <b>papercraft model house</b> that appears on the workbench near the end. If you are stuck holding it, you are not there yet.",
  },
  {
    q: "What are the four carved diamond recesses for?",
    a: "A wooden panel on the dresser has four diamond-shaped depressions, each carved with a different motif — a five-petal flower, a textured leaf, a multi-lobed leaf and a rose-like swirl. These take the four <b>Wooden decoration</b> tiles from the inventory, one motif per recess. The panel is a shape-matching lock, not a colour puzzle.",
  },
  {
    q: "Where do I get a Handle?",
    a: "The <b>Handle</b> is a separate inventory item, shown selected at <b>6:11</b> in-game with the standard <b>Use</b> / <b>Combine</b> / <b>Dismantle</b> / <b>Examine</b> row underneath. It goes on the dresser drawer that has no knob: with the handle fitted the drawer pulls open and the cardboard box inside is reachable at about <b>7:02</b>.",
  },
  {
    q: "What is the three-segment dial?",
    a: "A circular metal dial with three pie-slice segments — <b>red</b> at the top, <b>magenta</b> bottom-left, <b>yellow</b> bottom-right — each showing a green digital digit that you can cycle. Its colours are the same three as the tulip planters, which is the whole clue. It appears at about <b>8:10</b> in-game, and the room brightens when it is accepted.",
  },
  {
    q: "How do I finish the Hobby Room?",
    a: "The last prop is the <b>blue papercraft model house</b> on the workbench: a chapel-like building with a steeple, arched window cut-outs and a tan paper base with a fence and path. Once the model is complete and the dial is set, the level ends. There is no door keypad in the Hobby Room — the exit is triggered by finishing the props.",
  },
  {
    q: "How long is the Hobby Room?",
    a: "This run takes <b>9:11</b> in-game across a <b>9:07</b> video file (547 seconds, one frame per second for this page). It is the longest of the three bedroom-side rooms in Chapter 3 and roughly twice the length of Kids Bedroom 2, because it has three separate locks — the hex box, the carved panel and the dial — plus a build.",
  },
  {
    q: "Does the run show the results card?",
    a: "Yes. The final frame reads <b>LEVEL COMPLETED!</b> with <b>+50</b> coins, <b>Time: 8:51</b>, and a piggy-bank panel showing <b>300</b> and a <b>42h 35m</b> refill timer. No stars are shown.",
  },
  {
    q: "Where does the Hobby Room sit in Chapter 3?",
    a: "It is room <b>21 of 24</b> in Chapter 3, <i>Murder Dressed in White</i>: straight after Kids Bedroom 2 (Level 20) and before the Master Bedroom (Level 22).",
  },
  {
    q: "Is the Hobby Room the same as the Art Studio?",
    a: "It is the chapter's craft room — easel, sewing machine, thread spools, paint tubes, workbench — and it is labelled <b>Level 21 / Hobby Room</b> on the title card. Some walkthroughs call it the Art Room or the Craft Room; the level number is what matters.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
