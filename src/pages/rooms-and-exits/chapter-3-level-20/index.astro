---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 20 Walkthrough: Kids Bedroom 2";
const description = "Rooms & Exits Chapter 3 Level 20 walkthrough for Kids Bedroom 2: the pink ottoman, the Zipper and Battery on the cloud shelf, combining the battery with the flashlight to light the space under the bed, the stained-glass tile board on the wooden chest that opens a drawer, the Screwdriver in the panda teepee, the five-socket jewel box on the desk and the cloud softpillow colour tag. The run finishes at 4:18 with +50 coins and a 4:10 level time.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 20 Kids Bedroom 2?",
    a: "There is no typed keypad code in Kids Bedroom 2. This is an object-puzzle room: a <b>Battery</b> and a <b>Flashlight</b> to combine, a stained-glass tile board on a wooden chest, a <b>Screwdriver</b> hidden in the panda teepee, and a jewel box whose lid carries <b>five ornate sockets</b>. The only code-like clue is the <b>cloud softpillow</b> tag, whose five-segment cloud reads <b>green, red, blue, purple, yellow</b>. Treat it as the socket order, but see the unverified note about the middle colour.",
  },
  {
    q: "How do I see under the bed?",
    a: "The space under the bed reads as a black rectangle the first time you look at it, at <b>0:26</b>. Open the inventory, select the <b>Battery</b>, then the <b>Flashlight</b>, and press <b>Combine</b>. The combined torch appears with a green outline and the caption changes to <b>Turned on flashlight</b> at <b>0:44</b>. Go back under the bed at <b>0:46</b> and the area is lit, with a dark wooden chest sitting on the floor.",
  },
  {
    q: "Where is the battery and where is the flashlight?",
    a: "The <b>Battery</b> comes off the white cloud shelf that holds the pink handheld console and the oval mirror — the camera pushes in at <b>0:11</b> and the battery is shown with the caption <b>Battery</b> at <b>0:16</b>. The <b>Flashlight</b> is already in the inventory when you first open it at <b>0:32</b>; the recording never shows where it was picked up, so we do not invent a location for it.",
  },
  {
    q: "What is the rule of the stained-glass tile board?",
    a: "Square tiles, each split into four triangular facets by an X-shaped metal frame, every facet a different glossy colour. Tiles sit in stacks to the left and right of a wooden board and you drop them into the grid. The completed frames show <b>edge matching</b>: the colour on one side of a tile repeats on the touching side of its neighbour. When the board is nearly full, the bottom facet of the upper row and the top facet of the row below are the same red across the seam.",
  },
  {
    q: "How long does the tile board take?",
    a: "In this run it starts at <b>0:50</b>, when the chest is opened under the bed, and the last loose tile goes in at about <b>1:49</b>. That is close to a minute of real time with no detours, which makes it the longest single interaction in the level. Plan for it rather than treating it as a quick lock.",
  },
  {
    q: "How many cells does the tile board have?",
    a: "We are not printing a count. Three passes over the board read it as three rows of three, as three rows of four, and as four rows of four with fourteen cells filled and two empty. The mechanic is clear and the completion is visible; the exact cell count is not, so it is listed under \"What this page could not verify\".",
  },
  {
    q: "What is inside the pink ottoman?",
    a: "The pink ottoman by the dollhouse opens at <b>0:05</b>. The lid lifts and the inside shows small pale objects with a sparkle effect. The frame carries no white item caption, so this page does not name the pickup — the battery shown later comes off the cloud shelf, not from here.",
  },
  {
    q: "What does the Zipper do?",
    a: "At <b>0:13</b> the close-up on the pink handheld console produces the caption <b>Zipper</b>. In the rest of this run it is never used — no zip, bag or seam takes it. Treat it as a collected part and do not spend time hunting for a place to use it before the jewel box.",
  },
  {
    q: "What is in the panda teepee?",
    a: "The white teepee with the black-and-white panda print is opened at <b>2:04</b>: a quilted pink mat, a large pink cushion, a doll, a white plush, stacked wooden blocks and a striped ball. At <b>2:16</b> a red-handled <b>Screwdriver</b> is picked up from the mat and the caption reads <b>Screwdriver</b>.",
  },
  {
    q: "What is the jewel box on the desk?",
    a: "An ornate wooden box with gold scrollwork at the corners, sitting on the desk under the window. Its lid carries <b>five round sockets with gold rims</b>, and the run fills them from the inventory as it goes — orange-red, green and magenta gems are visible in separate frames. The inventory at <b>3:37</b> holds <b>six</b> jewel colours: green, gold, purple, red, white and light blue.",
  },
  {
    q: "What is the cloud softpillow tag?",
    a: "A white label with a five-segment rainbow cloud and the words <b>cloud softpillow</b>. Each segment of the cloud is a solid colour and each letter of \"cloud\" is coloured to match one: <b>c</b> green, <b>l</b> red, <b>o</b> blue, <b>u</b> purple, <b>d</b> yellow. That gives a five-colour order — <b>green, red, blue, purple, yellow</b> — which is the only colour-order clue in the room and the natural key for the five jewel sockets. It appears on the bedding and again as a held close-up at <b>3:43</b>.",
  },
  {
    q: "Is there a keypad in Kids Bedroom 2?",
    a: "No. Nothing in the 4:20 run shows a number pad, a dial lock or a letter lock. The locks are physical: the tile board on the chest, the chest's own drawer, the jewel box, and the items that feed them.",
  },
  {
    q: "Where does Kids Bedroom 2 sit in Chapter 3?",
    a: "It is room <b>20 of 24</b> in Chapter 3, <i>Murder Dressed in White</i>. It comes straight after the Garden Shed (Level 19) and before the Hobby Room (Level 21).",
  },
  {
    q: "Does the recording show the level being completed?",
    a: "Yes. This copy runs the full <b>4:20</b> and the results card appears at <b>4:18</b>: <b>LEVEL COMPLETED!</b>, <b>+50</b> coins, <b>Time: 4:10</b>, and a piggy-bank reward of <b>300</b> with a <b>42h 46m</b> refill timer. No stars are shown on the card.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
