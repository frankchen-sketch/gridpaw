import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 7 Walkthrough: Food Court";
const description = "Rooms & Exits Chapter 2 Level 7 walkthrough for the Food Court: blend the smoothie to 350 ml to get the till code, pay with the card named MARIA, type 53402 at the back-office terminal, and finish the three-letter lock on ZCO.";
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is the till code in Rooms & Exits Chapter 2 Level 7?", "acceptedAnswer": {"@type": "Answer", "text": "350. You do not find it written anywhere: it is the level of the smoothie you blend at the juice bar. Fill the blender until the red drink sits on the 350 ml line, then type 350 on the register keypad at the counter and press the green arrow."}}, {"@type": "Question", "name": "What is the computer code in the Food Court?", "acceptedAnswer": {"@type": "Answer", "text": "53402. The monitor on the back counter, behind the coffee bar, opens a QWERTY keyboard and a single input field. Type 53402, confirm, and a Name tag drops into your inventory."}}, {"@type": "Question", "name": "What is the three-letter code at the end of Chapter 2 Level 7?", "acceptedAnswer": {"@type": "Answer", "text": "ZCO. The last lock is a keyboard with three slots. The table service you assemble carries the three letters in reading order: a Z piped in mustard on the plate, a C in the foam of the coffee, and the round cupcake. Type Z, C, O and the level ends."}}, {"@type": "Question", "name": "Where do I get the payment card?", "acceptedAnswer": {"@type": "Answer", "text": "The card is in your inventory, labelled Payment card, and it is in the name of MARIA. The till asks for payment right after you enter 350, and using the card on the register clears the sale. You never have to hunt for it on the floor."}}, {"@type": "Question", "name": "What is the piece of paper numbered 1042 P-23?", "acceptedAnswer": {"@type": "Answer", "text": "It is a printed slip that goes into your bag as Piece of paper. The header reads 1042 P-23 and underneath there are six coloured dots in two rows of three. Our recording never shows it being used on anything, so this page does not claim it opens a lock."}}, {"@type": "Question", "name": "How long does the Food Court take?", "acceptedAnswer": {"@type": "Answer", "text": "The recording runs 11 minutes 10 seconds of video and the in-game clock reads 17:31 on the results screen. Nothing in the level is timed and there is no fail state; the time goes on criss-crossing the court between four kiosks."}}]};
