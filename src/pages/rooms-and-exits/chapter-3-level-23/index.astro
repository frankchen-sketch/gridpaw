import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 23 Walkthrough: Entertainment Room";
const description = "Rooms & Exits Chapter 3 Level 23 walkthrough for the Entertainment Room: the pool table and dartboard, the four sums pinned to the board, the case padlock that takes 7561, the arcade cabinet that runs a Breakout game, the HIGH SCORE table reading YOU 56941, the metal box it opens, the arrow grid, the three-dial letter lock and the Key that ends the level. Every printed number was read twice from separate frames.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 23 Entertainment Room?",
    a: "There are two typed codes, on two different locks. The case sitting by the foosball table has a 12-key padlock and takes <b>7561</b>. The battered metal box on the stack of books has the same kind of padlock and takes <b>56941</b>, which is the top line of the arcade machine's HIGH SCORE table: <b>1. YOU 56941</b>. Both numbers were read twice off the green displays, at two separate seconds, and both reads agreed.",
  },
  {
    q: "Where does 56941 come from?",
    a: "From the arcade cabinet. The Breakout-style mini-game runs from about 3:08 to 5:06, and when it ends the cabinet shows a black HIGH SCORE screen with three entries: <b>1. YOU 56941</b>, <b>2. TOM 46987</b>, <b>3. OLY 24567</b>. The first line is the one the level uses. Type it into the metal box's padlock and the lid opens on a small tile carrying an arrow-like symbol.",
  },
  {
    q: "Where does 7561 come from?",
    a: "The level never shows the working. What it does show is a dartboard with a piece of paper pinned to it, and the paper carries four short expressions written one under another: <b>1+6</b>, <b>4/6</b>, <b>2-5</b>, <b>3-1</b>. Those four lines were each read twice from two different crops. How they turn into <b>7561</b> is not captured in any frame we could decode, so this page prints the code as a read rather than as a derivation.",
  },
  {
    q: "How do I beat the Breakout mini-game on the arcade cabinet?",
    a: "You play it like Breakout: clear the brick wall with the paddle, one ball. The recording spends almost two minutes on it — 3:08 to 5:06 — which tells you it is not a two-second interaction. The part that matters is what comes after: the cabinet ends on the HIGH SCORE table, and that table is the clue for the metal box. The run we used ends the game with <b>56941</b> on the top line.",
  },
  {
    q: "What is the dartboard for?",
    a: "It is a clue station, not a lock. Three darts are stuck in the board — one high and slightly right, one at the left, one at the right — and a rectangle of aged paper is pinned to the middle with four hand-written lines on it. We read those lines twice and they came out as <b>1+6</b>, <b>4/6</b>, <b>2-5</b> and <b>3-1</b>. Read it, then go to the case by the foosball table.",
  },
  {
    q: "What are the six black-and-white tiles on the bar?",
    a: "A single row of six small square tiles sits on the bar counter, each holding one big disc. Five of them are white tiles with a black disc; exactly one, second from the left, is a black tile with a white disc. That inverted tile is the read: this is a matching board, not a keypad. There is no instruction text and no counter, and the footage never holds a solved frame of it, so this page does not claim a rule for it.",
  },
  {
    q: "Where do I find the Token and what does it do?",
    a: "The <b>Token</b> is a pickup at about <b>2:47</b>: a flat, silver disc with two rings etched into it and a small centre dot, captioned simply <b>Token</b>. It appears right after the close-up of the arcade cabinet's control panel, which has two red button squares on top and two empty slots underneath them, and right before the cabinet's Breakout game starts at 3:08. The recording shows the panel, then the Token, then the game running — it does not show the Token being dropped into a slot, so treat that step as the obvious reading rather than a filmed one.",
  },
  {
    q: "How do I open the exit door?",
    a: "With the <b>Key</b>. The last lock in the room is a three-column letter machine: three square letter drums with the numbers <b>2</b>, <b>1</b> and <b>3</b> printed above them. The drums scroll, and at 7:25 the three boxes read <b>T</b>, <b>Y</b>, <b>N</b>; a second later the key is already in the open compartment. Pick up the <b>Key</b>, open the inventory, use it on the door on the left wall, and the door swings open on the exit at 7:37.",
  },
  {
    q: "What is the four-record wall display?",
    a: "A close-up on the right wall of the room: four black vinyl records set in a cross, two with red centre labels and two with pale ones, around a small framed picture of a gramophone. It opens as an interactive close-up and sparkles when it is done at 7:31. The recording never holds a solved frame long enough to read a pattern off it, so this page describes it rather than solving it.",
  },
  {
    q: "What is the pinned arrow board?",
    a: "A yellow panel pinned to a surface with a single white pin, holding a four-by-four grid of beveled cells, each carrying one white arrow: single up, down, left and right arrows mixed with double and triple ones. It is a directional-board puzzle, not a keypad. The footage covers about fifty seconds of it around 6:10 to 6:43 without ever spelling out the rule, so no move list is printed here.",
  },
  {
    q: "Is Entertainment Room room 23 of Chapter 3?",
    a: "Yes. Chapter 3 is <i>Murder Dressed in White</i> and it runs twenty-four rooms; Entertainment Room is <b>23 of 24</b>, straight after the Master Bedroom and immediately before the Hallway, which is the chapter's last room. That makes this the last room of the chapter with a full set of puzzles before the Hallway closes the chapter out.",
  },
  {
    q: "Does the recording show the level being completed?",
    a: "Yes, all the way to the results card. The door opens at 7:37 with a white silhouette in the doorway, and the <b>LEVEL COMPLETED!</b> card follows at 7:39. It shows a level reward of <b>+50</b> coins and a recorded <b>Time: 7:29</b>, plus the usual piggy-bank panel underneath.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
