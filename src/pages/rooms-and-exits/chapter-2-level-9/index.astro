import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 9 Walkthrough: Indoor Playground";
const description = "Rooms & Exits Chapter 2 Level 9 walkthrough for the Indoor Playground: the four coloured balls, the ball pit and slide, the six-by-six pipe puzzle that pays out the blue key, the shoelace-and-magnet rod, and the code 3764 on the chest that hands you the exit key.";

const faqs = [
  {
    q: "What is the code in Rooms & Exits Chapter 2 Level 9 Indoor Playground?",
    a: "3764. It is written on the piece of paper hidden in the base of the tall lime-green clock in the dollshouse part of the level, the section you reach through the tunnel behind the pulley plank. Set the four wheels of the chest lock to 3764 and the chest opens onto the exit key. We read the paper twice, from two separate recordings, and both agree on 3764."
  },
  {
    q: "Where do I find the four coloured balls?",
    a: "You need four, in red, green, blue and yellow, and the inventory tracks them as Ball with a counter such as 3/4. Our recording takes one out of the play area around the ball pit and one out of the gumball machine. The other two are in the same playground frame on tappable props: the blue hopper balls on the floor, the painted red flowers on the wall and the teddy bear sitting on the cubbies. Tap everything loose until the counter reads 4/4."
  },
  {
    q: "How does the pipe puzzle work?",
    a: "The board has four glass cups along the top, one per colour, a grid of yellow pipe segments and four matching colour slots along the bottom. Drop each ball into the cup of its colour, then tap the pipe segments to rotate them until every colour has an unbroken run to the slot of the same colour. When all four are home, the glass dome on the right opens and the blue key is yours."
  },
  {
    q: "What do I do with the shoelace, the magnet and the fishing rod?",
    a: "Dismantle the sneakers to get the shoelace, then combine the shoelace with the magnet to make a tied magnet, and combine that with the fishing rod to make the fishing rod with magnet. Use the rod on the ball pit: it fishes out a second key, and that key opens the cubby that holds the backpack."
  },
  {
    q: "Where is the blue key used?",
    a: "On the stack of coloured cubbies beside the EXIT door. One of the purple doors is the one the blue key from the pipe puzzle opens: inside is the pair of sneakers. The sneakers are not an exit item, they are a source of laces, which is why players who try to leave with them get nowhere."
  },
  {
    q: "How do I finish the Indoor Playground level?",
    a: "Take the key out of the open chest in the dollshouse, walk back through the tunnel to the playground, open the inventory, select the key, press Use and tap the door marked EXIT on the left wall. The level ends on the results panel with +50 coins; our recording clocked 9:42 of level time."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
