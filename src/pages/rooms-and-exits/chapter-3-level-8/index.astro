const title = "Rooms & Exits Chapter 3 Level 8 Walkthrough: Kids Playroom";
const description = "Rooms & Exits Chapter 3 Level 8 walkthrough for Kids Playroom: the two-digit keypad that takes 30 from the sign reading XXX over 10 + 10 + 10, the six-slot toy-car display that takes 05 · 66 · 50 · 06 · 08 and one slot we could not read, and the letter-cube order V Z O P X H that sets the whole chain up.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 8 Kids Playroom?",
    a: "There are two locks and two answers. The <b>two-digit keypad</b> takes <b>30</b>, the sum printed on the white sign in the room that reads <b>XXX</b> over <b>10 + 10 + 10</b>. The <b>toy-car display</b> takes six two-digit values in the order the letter cubes were arranged, and we could read five of them with confidence: <b>05</b>, <b>66</b>, <b>50</b>, <b>06</b>, <b>08</b>. The sixth slot is listed under what this page could not verify rather than guessed.",
  },
  {
    q: "Where does 30 come from?",
    a: "From a white sign in the playroom. It shows three placeholder marks — <b>XXX</b> — on the top line and <b>10 + 10 + 10</b> underneath. 10 + 10 + 10 = <b>30</b>, and the keypad next to it has a two-digit display. We read the sign whole-frame and again from a zoomed crop, and we read the keypad display showing <b>30</b> twice from two separate frames.",
  },
  {
    q: "How do I open the keypad?",
    a: "The keypad is a dark panel with a green border and a yellow two-digit display above the buttons. The keys are not in telephone order: in the recording the rows read <b>1 4 7</b>, <b>5 8 0</b>, <b>2 6 9</b>, with a clear key and an enter arrow on the bottom row. Type <b>3</b> then <b>0</b> and press the arrow. In the footage the display shows 30 and the toy chest below the pad opens on the next beat, handing over a <b>Shovel</b>.",
  },
  {
    q: "What is the letter-cube puzzle for?",
    a: "It defines the order of the six cars. The clue is a wardrobe whose label reads <b>THE ORDER OF LETTER CUBE BASED ON COLOR</b>: the cubes are sorted by the colour order of the folded clothes. In the recording the finished order is <b>V, Z, O, P, X, H</b> top to bottom. That order is what the toy-car display asks you to respect, and it is why the numbers are entered V first and H last rather than in the order the cars sit on the shelf.",
  },
  {
    q: "Where do the car numbers come from?",
    a: "From four pieces of paper and one whiteboard. <b>Z = 396 / 6</b> on the whiteboard gives <b>66</b>; <b>O = Z − 16</b> gives <b>50</b>; <b>P = 30 / V</b> with <b>V = 5</b> gives <b>06</b>; a paper reading <b>X = 8</b> gives <b>08</b>; and <b>V = 5</b> itself is written on its own paper, giving <b>05</b>. Each value is two digits, padded with a leading zero, which is what the six boxes expect.",
  },
  {
    q: "What is the car-track puzzle at the start?",
    a: "It is a touch puzzle, not a code. The panel is titled <b>MOVE THE CAR ACCORDING TO THE COLOR OF THE TRACK</b> and shows two interlocking oval tracks, one pink and one yellow, with small car tokens sitting on the nodes. You drag each car onto the track that matches its colour. It pays out nothing you can write down — there is no number on it — which is why this page does not print a sequence for it.",
  },
  {
    q: "What do the Shovel and the Baseball bat do?",
    a: "The <b>Shovel</b> comes out of the toy chest the keypad unlocks at about 2:15. The <b>Baseball bat</b> is picked up later, around 2:33. Both are tools rather than codes: the footage shows them entering the bag and the camera moving on, and we never catch the exact swing or dig that uses them, so treat them as items you will need rather than as steps with a fixed order.",
  },
  {
    q: "What is the reward for finishing Kids Playroom?",
    a: "A <b>Key</b>. When the last car value is accepted, the display column clears and a large key is revealed in the panel where the number boxes were — it is on screen at 4:49 and it goes into the bag. The recording ends on a THANKS FOR WATCHING card at 4:56, before any results panel, so this page does not print a coin figure for the room.",
  },
  {
    q: "Where does Kids Playroom sit in Chapter 3?",
    a: "Chapter 3 is <i>Murder Dressed in White</i> and Kids Playroom is room <b>8 of 15</b>. It comes after Master Bathroom and before Backyard. The chapter title card in this recording reads <b>Level 8 — Kids Playroom</b>, which is the game's own label, not ours.",
  },
  {
    q: "Do I have to solve the puzzles in order?",
    a: "Mostly, yes — this room is a chain. The letter-cube order has to exist before the car display makes sense, and three of the car values depend on papers you find while working the room. The keypad is the exception: its clue is printed on the wall next to it, so you can open the toy chest and get the Shovel as soon as you see the sign.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
