const title = "Rooms & Exits Chapter 3 Level 15 Walkthrough: Garage";
const description = "Rooms & Exits Chapter 3 Level 15 walkthrough for the Garage: the wall screen showing three sports cars, the four-letter lock that reads L S Z A, the red-and-green shape board that changes state in front of you, the 2/2 battery pickup and the red saloon over the service pit. Every printed letter was read twice from separate frames.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 15 Garage?",
    a: "The only code the recording lets us read cleanly is a four-letter lock, shown at <b>5:19</b> as four dark tiles in gold frames on a yellow panel. The letters are <b>L</b>, <b>S</b>, <b>Z</b>, <b>A</b>, left to right. That reading was taken twice — once from the whole frame and once from a crop of the panel — and both passes agreed with no ambiguous glyphs. There is no digit keypad in this room.",
  },
  {
    q: "Are the four letters the answer or the current state?",
    a: "That is the honest open question. The tiles are the lock's display, and in the frames sampled they hold <b>L S Z A</b> and do not change. Because the recording is cut, we cannot tell whether the player had already solved the lock, or whether <b>L S Z A</b> is a mid-attempt that never resolves on camera. If your lock starts blank, treat the sequence as the value to try, not as a demonstrated solution.",
  },
  {
    q: "What is on the wall screen with the three cars?",
    a: "At <b>1:59</b> the camera holds on a framed screen or poster over a desk lamp and a shelf of books. It shows three sports cars: a <b>yellow</b> car with its doors raised, a <b>red</b> car in the middle, and a <b>blue</b> car on the right. The garage itself contains a white saloon, a red saloon and a blue saloon, so the poster's colours map onto the three real cars — which is the kind of mirroring this game uses instead of writing instructions down.",
  },
  {
    q: "What is the red-and-green shape board?",
    a: "It is a close-up puzzle made of framed panels rather than digits: in the first state a <b>purple</b> square holding a dark circle, two solid <b>green</b> squares, a <b>red</b> horizontal bar and a <b>green</b> horizontal bar. At <b>3:19</b> the first square has changed to <b>blue</b> with a dark circle, and by the next sampled second it is <b>red</b> with a white circle. The other four elements stay put throughout, so the leftmost panel is the one being cycled.",
  },
  {
    q: "Where do the batteries come from?",
    a: "The inventory at <b>3:59</b> holds a stack labelled <b>2/2</b> — a pair of red batteries, counted as a set of two. They are the only item in that inventory view at that moment, which usually means the level has just handed them over for a device that needs both. This page does not name the device, because no frame in the recording shows the batteries being inserted.",
  },
  {
    q: "What is under the blue car?",
    a: "A service pit. The garage floor is marked with yellow lines, and the blue saloon sits over an opening in the concrete with stacked tyres down inside it and two piles of dirt or sand at the pit's edges. A red saloon is up on the lift beside it, and the camera visits the red car's nose at <b>4:19</b> as a close-up framed by white corner brackets.",
  },
  {
    q: "What is the cart with the green books?",
    a: "At <b>0:29</b> the camera settles on a blue-handled metal utility cart holding several green hardback books with <b>TECHNOLOGY</b> on the covers, plus a stack of flat blue rings. Behind it sit a metal crate of cardboard boxes, a piece of blue fabric and a pair of work boots on the floor, with a yellow line painted across the concrete. Books with titles are rare in this game, so the word is worth remembering.",
  },
  {
    q: "Does the recording show the Garage being completed?",
    a: "It shows the completion banner but not the numbers. At <b>5:31</b> the screen goes to <b>LEVEL COMPLETED!</b> with a shower of coins and a reward card icon in the lower right. The clip ends one second later at 5:32, before the reward panel resolves, so this page prints no coin figure and no time for the Garage. Any number you see elsewhere is not from this recording.",
  },
  {
    q: "How long is the Garage run and is it edited?",
    a: "The source file runs 5:32. It is cut: the in-game clock does not advance monotonically between sampled frames, and some puzzle states change across a single second. That is why the timestamps here are video time and why a state can look like it solved itself between two cards.",
  },
  {
    q: "Where does the Garage sit in Chapter 3?",
    a: "Chapter 3, <i>Murder Dressed in White</i>, lists twenty-four rooms. Garage is room <b>15 of 24</b>, straight after the Storage Room and immediately before the Attic.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
