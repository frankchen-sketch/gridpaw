import InContentAd from '../../../components/InContentAd.astro';

const title = "Rooms & Exits Chapter 2 Level 2 Walkthrough: Cinemas";
const description = "Rooms & Exits Chapter 2 Level 2 walkthrough for Cinemas: the three price boards (8, 11, 13), the terminal that wants them added, the seat map, the extinguisher cabinet, and the code 3581 that opens the exit door.";
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {"@type": "Question", "name": "What is the exit door code in Rooms & Exits Chapter 2 Level 2 (Cinemas)?", "acceptedAnswer": {"@type": "Answer", "text": "3581. The four digits appear on the BURNING CITY poster in the lobby, but only after you have put the fire on the poster out with the fire extinguisher from the red wall cabinet in the hallway. They are printed in a horizontal row on the charred poster. Type 3581 into the keypad on the red exit door and press the tick."}},
  {"@type": "Question", "name": "What do the three menu boards in the cinema lobby mean?", "acceptedAnswer": {"@type": "Answer", "text": "They are the numbers for the terminal puzzle. The boards above the counters read MENU 1 with a price of 8, MENU 2 with 11 and MENU 3 with 13. Our recording opens the terminal under the MENU 1 board, types 8+11+13 on the calculator keypad and presses the equals key, and the screen clears back to its blue idle state."}},
  {"@type": "Question", "name": "Where is the fire extinguisher in Cinemas?", "acceptedAnswer": {"@type": "Answer", "text": "In the hallway, in a red wall cabinet with a glass front. The cabinet door swings open to the left. Take the extinguisher from the cabinet, go back to the BURNING CITY poster in the lobby, select the extinguisher and use it on the poster. The flames go out and the code 3581 is left on the burnt poster."}},
  {"@type": "Question", "name": "How do you get the key off the wooden rack?", "acceptedAnswer": {"@type": "Answer", "text": "With the selfie stick. The rack is a wooden bar with three pegs mounted high on the lobby wall and the key hangs on the middle peg, out of reach. Select the selfie stick from the inventory, extend it at the rack, and the key comes off into your inventory."}},
  {"@type": "Question", "name": "Where is the cable in Chapter 2 Level 2?", "acceptedAnswer": {"@type": "Answer", "text": "In the crisp bags on the snack shelf behind counter 1, next to the EXPRESS CAFE sign. Zoom in on the bags, tap the white coiled cable lying across them, and the pickup screen labels it Cable."}},
  {"@type": "Question", "name": "Does the seat map need a specific set of seats?", "acceptedAnswer": {"@type": "Answer", "text": "The ticket the printer produces names THEATER 01 / SEAT E11, so mark row E, seat 11. The chart is six rows, A to F from the bottom up, with seats 1 to 12 across, and tapping a seat fills it red. We do not publish the full set of marked seats because the red cells are only a few pixels wide at playback resolution and our reads of the completed chart disagreed, but E11 is unambiguous on the ticket and was read from three separate frames."}},
  {"@type": "Question", "name": "What is the reward for finishing Cinemas?", "acceptedAnswer": {"@type": "Answer", "text": "50 coins. The level closes on the LEVEL COMPLETED screen with +50 in the top reward panel and a level time of 8:09, plus the piggy bank panel underneath."}}
]};
