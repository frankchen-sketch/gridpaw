import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 6 Walkthrough: Guest Bedroom";
const description = "Rooms & Exits Chapter 3 Level 6 walkthrough for Guest Bedroom: the two-dial padlock that takes 94 off the lamp shade's IX and IV, and the phone password DAVID that comes from the ID card in the chest.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 6 Guest Bedroom?",
    a: "The room's numeric lock is the <b>two-dial padlock on the grey quilted hamper</b> in the foreground, and it takes <b>94</b>. The other lock that needs a phrase rather than a number is the <b>phone</b>, which wants the name on the ID card found in the chest: <b>DAVID</b>. The 94 was read twice from the dial's centre row; the DAVID comes from the card itself, legible on screen at 1:50.",
  },
  {
    q: "Where does 94 come from?",
    a: "From the table lamp beside the bed. Its shade carries two Roman numerals, <b>IX</b> and <b>IV</b>, printed on the fabric at 0:06. IX is 9 and IV is 4, and the padlock has exactly two dials — left and right — so the pair reads straight across as <b>9</b> then <b>4</b>. In the recording the left dial sits on 9 and the right dial is turned down to 4, and the hamper opens.",
  },
  {
    q: "How many dials does the hamper padlock have?",
    a: "Two, not three. Each dial shows three digits at a time in a vertical strip — the digit above, the setting in the middle and the digit below — which is why a single frame can look like it has four or six numbers on it. Only the <b>middle row</b> counts. At the moment the hamper opens the middle row reads <b>9</b> on the left and <b>4</b> on the right.",
  },
  {
    q: "Where do I type DAVID?",
    a: "On the smartphone that lies on the room's console. Tap it and the screen shows a <b>red padlock</b> with a keyhole, a row of placeholder dashes underneath, and the game's white text bar at the bottom with <b>Done</b> and <b>Cancel</b>. Type the name and confirm: in the recording the lock turns <b>green</b> and the screen fills with masked characters at 2:15.",
  },
  {
    q: "Where is the ID card with the name on it?",
    a: "In the dark wooden chest that sits on the floor under the nine framed pictures. The chest is fastened by a lock with <b>five gold-framed slots</b>, each holding a rotatable arrow, and it opens at <b>1:50</b> to reveal a white card with a teal wave design. The card carries the name <b>DAVID</b> in large black capitals, an ID number, a join date of <b>07/21</b> and a valid-thru date of <b>09/22</b>, plus a QR code.",
  },
  {
    q: "What is the clock that appears in the middle of the room?",
    a: "At <b>0:36</b> the lights in the room drop and a large white analogue clock floats over the bed, its hands and numerals picked out in black. It is a set-the-hands puzzle, not a code you type: the room goes dark, the clock becomes the only lit object, and the player moves the hands. We could not read a reliable target time off the footage — different frames of the same dial give different readings — so this page does not print a time for it.",
  },
  {
    q: "What is the lock with five arrows on the chest?",
    a: "A row of five square slots under gold frames, each holding an arrow you rotate. It is the chest's only lock and it guards the ID card. The clue for the arrow directions is the <b>3x3 gallery of nine framed pictures</b> on the wall directly above the chest — each frame holds a small grid-and-arrow pattern. We could see the frames and the slots clearly but not the exact arrow order the game accepts, so no order is printed here.",
  },
  {
    q: "What is the safe with fruit on the keypad?",
    a: "A black safe on the right-hand side of the room, at <b>3:24</b>, with a circular dial on the door and a <b>3x3 keypad of fruit and vegetable symbols</b> below it. Above the keypad is a display of <b>six slots</b>, so the code is a sequence of six of those symbols, not a number. The recording works through it around the five-minute mark. We could not read the accepted six-symbol order, so this page leaves it unverified rather than inventing one.",
  },
  {
    q: "What do the two key parts do?",
    a: "They combine. Near the end of the run the inventory holds two separate <b>Key part</b> items, and using one on the other produces a single <b>Key</b>. That key is what opens the door on the left wall — the level does not finish on a keypad. At <b>6:24</b> the door stands open with the white exit icon in the doorway, which is the last gameplay frame of the video.",
  },
  {
    q: "Is Guest Bedroom the sixth room of Chapter 3?",
    a: "Yes. Chapter 3 is <i>Murder Dressed in White</i>, and Guest Bedroom is room <b>6 of 15</b>: after Workshop (5) and before Master Bathroom (7). It is a single-room level with no corridor: a bed against the back wall, a long console of vinyl records and a turntable on the left, a globe and speaker on top, a chest under a gallery of nine frames, and a white two-door cabinet holding a cushion with a gold anchor on it.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
