const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How do you open the dartboard cabinet in Level 3?", "acceptedAnswer": {"@type": "Answer", "text": "Three dials, each a digit above a card suit. The posters on the maroon wall give 7 of hearts, 2 of diamonds, 7 of clubs left to right. Set 7-2-7 with heart, diamond, club underneath."}}, {"@type": "Question", "name": "What is the phone code?", "acceptedAnswer": {"@type": "Answer", "text": "35721. The coloured block stack on the wall reads 3, 5, 7, 2, 1 top to bottom; enter it on the smartphone on the dining table."}}, {"@type": "Question", "name": "What is the keypad code on the wooden cabinet?", "acceptedAnswer": {"@type": "Answer", "text": "2519. The four slots above the display take 2, 5, 1 and 9. Typing 2510 is the usual wrong turn. The door stays shut until the last digit is 9."}}, {"@type": "Question", "name": "Where do the two bottles come from?", "acceptedAnswer": {"@type": "Answer", "text": "The white one from the sliding-block box on the terrace after the steel ball drops, the yellow citrus one from the keypad cabinet in the flat. Both go into the metal shaker behind the bar."}}, {"@type": "Question", "name": "Does this match the current build?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The order and the codes were rebuilt from recorded footage of the current build rather than copied from another guide, and the one digit we could not read cleanly is marked as unconfirmed on this page instead of filled in."}}]};
