const title = "Rooms & Exits Chapter 1 Level 1 Walkthrough: Warm Up";
const description = "Rooms & Exits Chapter 1 Level 1 walkthrough: where the Key and the two bolt-cutter parts are, how to cut the door chain, and the sliding puzzle that ends the room.";
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Where is the Key in Rooms & Exits Chapter 1 Level 1?", "acceptedAnswer": {"@type": "Answer", "text": "In the glass jar lying on the floor of the first room. Pick the jar up, open it, and the Key is inside. It is the item your progress bar tracks for the whole level."}}, {"@type": "Question", "name": "Where are the two bolt-cutter parts in Level 1?", "acceptedAnswer": {"@type": "Answer", "text": "The first is on the wooden shelf unit against the back wall. The second sits on the small ledge under the wall mirror, next to two white candles. Combine the two parts in the inventory to make the Bolt cutters."}}, {"@type": "Question", "name": "How do you get through the chained door in Level 1?", "acceptedAnswer": {"@type": "Answer", "text": "Use the Bolt cutters on the chain. The chain drops, the door opens, and the level moves into a second room with a sofa. The Key is not what opens this door."}}, {"@type": "Question", "name": "What ends Chapter 1 Level 1?", "acceptedAnswer": {"@type": "Answer", "text": "A 3x3 sliding puzzle mounted on the door of the second room. The pieces form an old-fashioned key. Solve it and the level completes; there is nothing else to collect first."}}]};
---
