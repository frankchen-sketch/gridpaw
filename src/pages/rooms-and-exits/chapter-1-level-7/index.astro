import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 1 Level 7 Walkthrough: The Game Night Agency";
const description = "Rooms & Exits Chapter 1 Level 7 walkthrough: the checkerboard packing puzzle, the sixteen-card board, the fox tangram, the briefcase blocks, the Game Night neon sign and the safe code 55793 that ends The Game Night Agency.";
const notes = [['H','C'],['T','B'],['M','T'],['G','Q'],['N','M'],['I','S']];
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is the safe code in The Game Night Agency?", "acceptedAnswer": {"@type": "Answer", "text": "55793. The keypad takes five digits and that is the number written on the crumpled note from the bottom shelf of the game shelf."}}, {"@type": "Question", "name": "Where do you find the code in Level 7?", "acceptedAnswer": {"@type": "Answer", "text": "On the bottom shelf of the board-game shelf, next to the Scrabble box: a small white crumpled scrap you can pick up at 7:13. Smooth it out in your inventory and it reads 5-5-7-9-3. It is not in the drawer and it is not on the letter notes."}}, {"@type": "Question", "name": "Is the checkerboard a chess puzzle?", "acceptedAnswer": {"@type": "Answer", "text": "No. It is a packing puzzle: loose pieces with a checkerboard pattern are dragged into the recessed board until the pattern closes. There is no legal-move rule and no chess opening to spot."}}, {"@type": "Question", "name": "Do the letter notes open the safe?", "acceptedAnswer": {"@type": "Answer", "text": "No. The six notes carry letter pairs. H=C, T=B, M=T, G=Q, N=M, I=S. And the keypad only takes digits. The safe code comes from the crumpled paper. The notes belong to the Game Night neon sign, where only some letters glow."}}, {"@type": "Question", "name": "How long does Level 7 take?", "acceptedAnswer": {"@type": "Answer", "text": "Our recording finishes with an in-game time of 7:37 and a reward of +50 coins. A first run takes longer, because both floors have to be searched before the odd little scrap on the game shelf means anything."}}]};
---
