import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 19 Walkthrough: Bookstore";
const description = "Rooms & Exits Chapter 2 Level 19 walkthrough for the Bookstore: the poster counts Pink 1, Red 6, Purple 4, Yellow 3 that open the back-room door, the four plates E=5 X=8 I=3 T=1 that spell 5831 on the EXIT keypad, and the +50 coin finish.";

const faq = [
  {
    q: "What is the exit code in Rooms & Exits Chapter 2 Level 19?",
    a: "<b>5831</b>. The Bookstore does not hide a number anywhere: it hands you four plates that each carry a letter and its value — <b>E=5</b>, <b>X=8</b>, <b>I=3</b>, <b>T=1</b> — and the four letters spell <b>EXIT</b>. Read them in that order and type 5-8-3-1 on the keypad beside the blue EXIT sign. Both of our recordings end on the same four digits.",
  },
  {
    q: "What is the colour keypad code in the Bookstore?",
    a: "The door to the back room takes a colour and a number for each of its four slots, and the four pairs settle on <b>pink 01, yellow 03, red 06, purple 04</b> — the display reads <b>01 · 03 · 06 · 04</b> on the frame before the door gives way, in both of our runs. The numbers are the four counts printed on the note beside the motivational poster: <b>Pink 1, Red 6, Purple 4, Yellow 3</b>.",
  },
  {
    q: "How does the colour keypad actually work?",
    a: "It is a two-part entry, not a four-digit code. The panel has a normal 1-9 keypad on the left and four round colour buttons on the right — pink, yellow, red and purple, top to bottom — and the game prints the instruction <b>\"Click into color Button firstly\"</b> across the screen when you open it. Press a colour, then type the two-digit number that belongs to that colour. The display at the top has four segments, each with its own colour dot, which is how you check your work before you commit.",
  },
  {
    q: "Where do the four colour counts come from?",
    a: "From the framed poster above the desk: a mint-green print reading <b>EVERY great DREAM BEGINS with a DREAMER</b>, with two strings of triangular bunting flags across the top in pink, red, purple and yellow. The note beside it lists the four counts — Pink: 1, Red: 6, Purple: 4, Yellow: 3 — and those counts are what the back-room lock wants. Our independent recount of the tiny flags disagreed with the note by one on the purple string, so the figures printed here are the ones the lock accepted, not our own count.",
  },
  {
    q: "Where is the E=5 note?",
    a: "It starts life as a <b>Folded paper</b> in your inventory. Open the bag, select it and use <b>Examine</b>: the fold opens into a torn sheet with <b>E=5</b> written on it in a serif hand, and the item renames itself <b>Piece of paper</b>. That is the first of the four letter plates and the one players most often walk past, because a folded scrap in the bag reads like junk until you examine it.",
  },
  {
    q: "Where do X=8, I=3 and T=1 come from?",
    a: "<b>X=8</b> is on a parchment in the desk drawer on the shop floor — the drawer also holds a green book, and the parchment is marked with a large X and an arrow. <b>I=3</b> is a <b>Metal plate</b> found in the back room. <b>T=1</b> is a second <b>Piece of paper</b>, and it comes out of the padlocked chest that stands on the red rug, opened with the <b>Key</b>. Together with E=5 they spell EXIT in numbers.",
  },
  {
    q: "What does the key open?",
    a: "The small riveted wooden chest with the heart-shaped padlock, standing on the red rug in the back room in front of the sofa, with a round green stool just to its right. The key does not open the exit door — the exit is a keypad, not a lock — and it does not open the wooden door to the back room either, which is the colour keypad. If you are standing at the EXIT door holding a key, you are holding the wrong solution.",
  },
  {
    q: "How do I get the key in the Bookstore?",
    a: "Cut open the <b>Teddy bear</b>. With the <b>Knife</b> in the bag, use the knife on the bear: the item's label changes to <b>Key part</b>, the knife is consumed, and the part turns into the <b>Key</b>. It is the nastiest step in the level because a plush toy does not read as a container, and the game gives you no prompt that the knife is meant for it.",
  },
  {
    q: "What do I get for finishing Chapter 2 Level 19?",
    a: "The results panel reads <b>LEVEL COMPLETED!</b> with <b>+50 coins</b>, an Efficiency bar of segmented blocks, and <b>+1</b> playing card — the Ace of Hearts in the run we captured. No time field appears on this panel in the build we recorded, so the only clock is the in-game timer in the top corner, which reads <b>7:16</b> as the last keypad is being typed in our first recording.",
  },
  {
    q: "How long does the Bookstore take?",
    a: "Our first recording finishes in <b>4:58</b> of footage with the in-game clock at about <b>7:16</b> when the exit keypad is filled; the second run, played by someone who already knew the level, finishes in <b>3:33</b>. Nothing here is timed and there is no fail state. The two things that cost the most time are not knowing that the colour buttons come before the digits, and not realising that the four plates spell a word.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
