import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 18 Walkthrough: Basement";
const description = "Rooms & Exits Chapter 3 Level 18 walkthrough for the Basement: the pipe room whose valve list reads 3L, 1S, 2V, 5W, the eight-letter valve dial, the wall keypad that takes 1200, the barbell bench that asks for 18 kilo on each side, the laundry and ring-tower chain, and the horoscope that leads to the suitcase. Every printed number was read twice from separate frames.";

const faq = [
  {
    q: "What are the codes in Rooms & Exits Chapter 3 Level 18 Basement?",
    a: "Two are solid. The wall keypad takes <b>1200</b> — four digits on a green display, read twice from separate frames. The pipe manifold is set from a printed list beside the valves that reads <b>3L</b>, <b>1S</b>, <b>2V</b>, <b>5W</b>: the number is how many turns, the letter names the valve. The barbell bench prints <b>18kilo-18kilo</b> as its target. A final keypad appears at 8:06 with a five-digit string on it, but that one did not survive a second read and is not printed here.",
  },
  {
    q: "How do the valves in the Basement work?",
    a: "The pipework is lettered, not numbered. At <b>4:54</b> the camera holds a grey handwheel on a green pipe with an <b>S</b> stamped in the middle, and the list <b>3L / 1S / 2V / 5W</b> sits to its left. At 5:00 five more handwheels on red pipes all carry a <b>W</b>. So each entry in the list is a valve letter plus a turn count: L three turns, S one turn, V two turns, W five turns. The letters on the L and V valves are further along the same run of pipes.",
  },
  {
    q: "What is the eight-letter dial under the valves?",
    a: "At <b>5:06</b> the game opens a circular brass dial with eight lettered positions around its rim — the ones we could read are <b>V, K, O, W, T, S, M, L</b> — plus a vertical slider on the right. Four of those letters are the four valve letters, which is why the dial belongs to the same puzzle family as the 3L/1S/2V/5W list: you are selecting letters in the order the list gives you, then pulling the slider.",
  },
  {
    q: "What does the 1200 keypad open?",
    a: "The keypad is a light grey plate screwed to a wall, with a green four-digit display, a 3x4 number pad, a clear key and a green tick. At <b>5:30</b> the display reads <b>1200</b>. Where the code comes from is not spelled out on screen. Nothing else in the decodable footage opens with it — the recording walks away from the keypad without showing a door, a safe or a hatch swinging open.",
  },
  {
    q: "What is the weight-bench puzzle?",
    a: "At <b>6:30</b> the game opens the blue bench with its barbell, a rack of coloured plates and a printed label that reads <b>Balance both side / 18kilo-18kilo</b>. The labels above the rack run in single kilos, 1 kg, 2 kg, 3 kg and upward. You are loading each end of the bar to the same total, 18 kilos, and every plate is a whole number of kilos, so the arithmetic is clean. The recording grinds on this for about half a minute before the bench's under-seat compartment pops at 7:06.",
  },
  {
    q: "What is behind the blue cabinet?",
    a: "The distressed blue cabinet on the left wall is the level's main storage. It opens at <b>0:42</b> with white shoes and bottles on its shelves, and at 0:54 its cubby section shows books and boxes, including one spine printed <b>Vocabulary</b>. At 1:06 the top drawers are pulled open with a green toolbox and a white first-aid kit sitting on top of the unit. This is where the early pickups live, so open all of it before you start on the pipe room.",
  },
  {
    q: "What is the coat rack hint?",
    a: "At <b>1:24</b> the camera holds a blue wall rack: three white storage bins along the top and three blue hangers below. A hint line appears over it about the white hanger positions and the blue drawer — that is the level telling you the rack's arrangement is a combination, not decoration. A round-button keypad comes up six seconds later at 1:30, which is the lock that arrangement feeds.",
  },
  {
    q: "What do I do with the laundry and the rings?",
    a: "Two separate chains, both in the middle of the level. The <b>Laundry</b> is a bundle of coloured clothes picked up around 2:24 and put into the washing machine at 2:36; the drum spins and the item is consumed. The <b>Rings</b> are picked up one at a time — a teal one at 2:06, a purple one at 2:12 — and land in the inventory as a stack of coloured rings. At <b>3:06</b> those rings go onto a stacking tower, one peg with rings already on it and a second bare peg, and the recording has it rearranged by 3:12.",
  },
  {
    q: "Where does the horoscope come from and what is it for?",
    a: "Solving the weight bench opens a compartment under the seat at <b>7:06</b>, and the paper inside it goes into the inventory as a folded newspaper. Examined, it is a <b>WEEKLY HOROSCOPE</b> page with all twelve zodiac glyphs laid out in a grid and a date range at the top. At <b>7:36</b> the camera finds a vintage suitcase with a row of zodiac glyphs painted on the wall above it — the same glyphs, in the same order the page is showing you.",
  },
  {
    q: "Does the Basement level finish in this recording?",
    a: "No. The file runs <b>8:16</b>. The last thing on screen is a five-digit keypad at 8:06, then the camera pulls back to the room at 8:12 and holds there until the file ends. There is no results card, no <i>level completed</i> banner and no coin figure anywhere, so this page prints no reward for the Basement.",
  },
  {
    q: "Is the Basement room 18 of Chapter 3?",
    a: "Yes. Chapter 3 is <i>Murder Dressed in White</i>, and the Basement is room <b>18</b> — after the Terrace (17) and before the Garden Shed (19). It is the first fully enclosed utility room in the chapter, and almost every puzzle in it is a piece of household plant: a washer, a fuse panel, a pipe manifold and a weight bench.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
