const cipher = [
  ['A','4'],['B','11'],['C','21'],['D','5'],['E','25'],['F','15'],['G','23'],['H','18'],['I','1'],
  ['J','26'],['K','10'],['L','9'],['M','12'],['N','6'],['O','17'],['P','22'],['Q','2'],['R','14'],
  ['S','7'],['T','19'],['U','3'],['V','20'],['W','8'],['X','13'],['Y','24'],['Z','16'],
];
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is the code from the arcade maze?", "acceptedAnswer": {"@type": "Answer", "text": "1590. Finish the dot maze on the classroom screen and it shows the number, which is what the classroom keypad takes."}}, {"@type": "Question", "name": "What does the blackboard cipher decode?", "acceptedAnswer": {"@type": "Answer", "text": "It maps each letter to a scrambled number: A=4, B=11, C=21, D=5, E=25, F=15, G=23, H=18, I=1, J=26, K=10, L=9, M=12, N=6, O=17, P=22, Q=2, R=14, S=7, T=19, U=3, V=20, W=8, X=13, Y=24, Z=16."}}, {"@type": "Question", "name": "What are the numbers on the globe?", "acceptedAnswer": {"@type": "Answer", "text": "20, 17 and 39, one on each coloured continent. They go into the three coloured buttons on the small keypad, matched by colour."}}, {"@type": "Question", "name": "Does High School have a timed puzzle?", "acceptedAnswer": {"@type": "Answer", "text": "Only the arcade maze, and it is generous. Around three minutes of clock for a board that takes well under two. Everything else in the level waits for you."}}]};
