const title = "Rooms & Exits Chapter 2 Level 17 Walkthrough: Shoe Store";
const description = "Rooms & Exits Chapter 2 Level 17 walkthrough for the Shoe Store: the arithmetic box answer 96, the three-total number panel (31, 23, 18), the till code 2120, the five-symbol locker and the sneaker that opens the exit.";
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the arithmetic box answer in Rooms & Exits Chapter 2 Level 17?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "96. The grid is 1 4 5 / 2 5 12 / 3 6 21 / 8 11 with the last cell empty, and the rule is multiply the first two numbers and add the first one again: 1×4+1=5, 2×5+2=12, 3×6+3=21, so 8×11+8=96. The game prints the rule on a note beside the box. Type 96 and press the green arrow."
      }
    },
    {
      "@type": "Question",
      "name": "How do you solve the 31 / 23 / 18 number panel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Drag a line from each number in the left column to the total it belongs to. 20 + 11 = 31 and 14 + 9 = 23 are written on the note pinned beside the panel; the last total, 18, takes the three numbers that are left over — 6, 7 and 5. Seven numbers for three totals means the third answer is forced once the first two pairs are taken."
      }
    },
    {
      "@type": "Question",
      "name": "What is the till code in the Shoe Store?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "2120. The till shows four symbols across the top — a star, a circle, a flower and a bow — with a four-box digit field under them, and those are the same four symbols as the framed plates beside the shoe display. Enter 2, 1, 2, 0 and the cash drawer springs open. Our two reads of the plate wall disagree on the order the plates hang in, so this page gives you the four digits rather than a symbol-to-digit mapping we could not confirm twice."
      }
    },
    {
      "@type": "Question",
      "name": "What order do the shoe boxes go in?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lowest size to highest. The game prints ARRANGE LOWER TO HIGHER across the wall, and the ten boxes are labelled US 4, 4.5, 5, 5.5, 6, 6.5, 7, 7.5, 8 and 8.5, with four price stickers between them: $120, $139, $150 and $165. Sort by the US size, not by the price."
      }
    },
    {
      "@type": "Question",
      "name": "What are the symbols on the shoe-store note?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Five, left to right: a star, a club, a triangle, a crescent moon and a diamond. You only see them after you combine the pencil with the piece of paper in the inventory. That row is the code for the five-symbol lock on the red locker in the stockroom."
      }
    },
    {
      "@type": "Question",
      "name": "Where do I get the key card to leave the Shoe Store?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "From the display stand after you place the sneaker on it. Take the sneaker off the pedestal, combine it with the shoelaces from the shoe-to-sole board, then use the finished sneaker on the stand. It releases a key card; use that on the glass exit door."
      }
    },
    {
      "@type": "Question",
      "name": "How long does Chapter 2 Level 17 take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The recording finishes the Shoe Store in 6:59 of level time for a +5 coin reward. Nothing is timed and there is no fail state, so the only thing that really costs you time is entering the till code before you have read the four symbols off the display wall."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to finish everything in the shop to leave?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Once the key card is in your hand the glass door opens, and the sandals, the shoes, the broom, the brush, the dustpan, the hammer and the piggy bank are all optional. They feed other puzzles inside the level, not the exit."
      }
    }
  ]
};
