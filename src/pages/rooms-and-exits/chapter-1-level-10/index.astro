import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 1 Level 10 Walkthrough: Train Station";
const description = "Rooms & Exits Chapter 1 Level 10 walkthrough for Train Station: the three departures times that are wrong (Jubilee 10:15, Northern 08:57, Piccadilly 13:36), the vending machine code 51, the chest code 77059 and the five-cup order.";
const note = [
  ['07:02', 'District'],
  ['08:57', 'Nothern'],
  ['09:21', 'Waterloo'],
  ['10:15', 'Jubilee'],
  ['11:47', 'DLR'],
  ['12:00', 'Circle'],
  ['13:36', 'Piccadilly'],
];
const board = [
  ['08:51', 'BAKERLOO', 'leave it'],
  ['09:07', 'CENTRAL', 'leave it'],
  ['10:15', 'JUBILEE', 'set it from the note'],
  ['08:57', 'NORTHERN', 'set it from the note'],
  ['13:36', 'PICCADILLY', 'set it from the note'],
  ['16:17', 'VICTORIA', 'leave it'],
];
const cups = [
  ['1', 'White cup, hand-drawn coffee cup with beans and the words FRISCH GEMAHLE(N)'],
  ['2', 'Black chalkboard cup, white outline of a cup, 100% ARABICA'],
  ['3', 'Black jazz cup, cartoon player in a red suit with a saxophone'],
  ['4', 'Yellow and blue abstract cup with a small white bird'],
  ['5', 'Dark blue cup, snowy night skyline'],
];
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {"@type": "Question", "name": "What are the three wrong times on the departures board in Level 10?", "acceptedAnswer": {"@type": "Answer", "text": "Jubilee must read 10:15, Northern 08:57 and Piccadilly 13:36. The other three rows on the board, Bakerloo 08:51, Central 09:07 and Victoria 16:17, are already correct and must not be touched."}},
  {"@type": "Question", "name": "What does the note in the Train Station level say?", "acceptedAnswer": {"@type": "Answer", "text": "The note lists seven times: 07:02 District, 08:57 Nothern, 09:21 Waterloo, 10:15 Jubilee, 11:47 DLR, 12:00 Circle and 13:36 Piccadilly. Only three of those line names appear on the departures board, so only three rows need changing."}},
  {"@type": "Question", "name": "What is the vending machine code in Level 10?", "acceptedAnswer": {"@type": "Answer", "text": "Insert the dollar bill you take off the departures board and type 51. Slot 51 holds the newspaper, which you need for the newspaper-sorting puzzle on the stand."}},
  {"@type": "Question", "name": "What is the code for the chest in Train Station?", "acceptedAnswer": {"@type": "Answer", "text": "77059. The game shows it on a blue card and repeats it in the objective line, so there is nothing to decode. The chest holds a paper cup and a crumpled piece of paper with five cup designs on it."}},
  {"@type": "Question", "name": "How do you order the five cups on the shelf?", "acceptedAnswer": {"@type": "Answer", "text": "Match the paper from the chest: white coffee cup, then the black chalkboard cup, then the black jazz cup with the saxophone player, then the yellow and blue abstract cup, then the dark blue snowy city cup. A key drops into the drawer under the shelf."}},
  {"@type": "Question", "name": "How long is Chapter 1 Level 10 and does it have a timer?", "acceptedAnswer": {"@type": "Answer", "text": "The recorded run finishes in about four and a half minutes with no timed puzzle anywhere in the level. Nothing in Train Station punishes you for standing still and reading the board."}}
]};
