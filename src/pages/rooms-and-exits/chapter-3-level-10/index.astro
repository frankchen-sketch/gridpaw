---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 10 Walkthrough: Garden";
const description = "Rooms & Exits Chapter 3 Level 10 walkthrough for Garden: the four-dial letter lock that takes B-N-U-G, the pattern-tool shape order that produces those letters, the round lawn cover maze, the four-valve manifold set from four coffee-cup handles, the bench digits 8 5 2 7 and the shed padlock they open, plus the herb planter, the 1911 notice, the trowel, the shears and the brick-wall puzzle.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 10 Garden?",
    a: "The room's letter lock is a vertical four-dial device and the answer is <b>B · N · U · G</b>, read top to bottom. The dials settle one at a time, and the fourth was still turning in our frames — it passes through W and K before landing on G. We read the finished state twice: once on the full frame and once on a 3x crop of the lock.",
  },
  {
    q: "Why B-N-U-G and not a word?",
    a: "Because the clue is not a word puzzle. The instruction reads <b>ARRANGE THE LETTERS THAT APPEAR IN THE PATTERN TOOL BASED ON THE SHAPE ORDER</b>, so the answer is letters sorted by the <i>shape</i> of the letterforms in the pattern the tool produces, not letters that spell something. If you are hunting for an English word, you will not find one — the lock accepts the shape order.",
  },
  {
    q: "What is the pattern tool?",
    a: "A dark hexagonal honeycomb pattern that fills the screen when you open the puzzle, with the instruction laid across the bottom. The letters that come out of it are the ones you lay into the four dials. It is the room's equivalent of a stencil: the pattern is not a clue you read, it is the thing that defines which order the letters belong in.",
  },
  {
    q: "What are the herbs in the planter for?",
    a: "They label the room's gardening chain. The three-tier pallet planter next to the shed carries chalkboard tags reading <b>Chives</b> and <b>Thyme</b> on the top tier and <b>Basil</b> and <b>Carrots</b> on the middle one. The tags are the only place those plant names exist in the room, so read them once — this run never asks you to name a plant, and the plants themselves are not a code.",
  },
  {
    q: "What does the trowel do?",
    a: "It is the digging tool. It comes into the bag at 0:32, on the same panel as the <b>Key</b>. Neither is a code, and this run never shows either of them being used — no soil is turned, no keyhole is turned. Take them when they appear; treat them as pickups rather than as keys to a specific lock.",
  },
  {
    q: "What is the 1911 notice?",
    a: "An open journal, dated <b>1911</b> in its header, that fills the screen for about five seconds at 0:46. One bold line on the same screen is legible — <b>THE SHAPE ORDER</b> — which is the phrase the pattern tool later expands into a full instruction. The body paragraph around it is set too small to read reliably at 720p and is not transcribed on this page.",
  },
  {
    q: "What is the brick wall puzzle?",
    a: "The instruction is explicit: <b>MAKE THE LARGE BRICK ON TOP STICK OUT, THEN TOUCH IT. THE REQUIRED BRICK WILL APPEAR, TOUCH IT TO DISMANTLE IT.</b> A dry-stone wall under a flowering vine is the play area. You push one brick proud of the face, touch it, and the wall presents the brick it actually wants; touching that one dismantles it. There are no digits involved — it is a dexterity and observation puzzle, not a code.",
  },
  {
    q: "Where do the shears and the rope come in?",
    a: "Late, and the rope is the one that pays off. <b>Shears</b> appear around 1:52. The <b>Rope</b> is picked up at 2:23 on the patio side of the room, and by 2:27 the bag holds two separate items — <b>Rope</b> and <b>Handle</b>; <b>Combine</b> at 2:29 turns the pair into a single item labelled <b>Rope with handle</b>. That is the last thing the inventory does in this run: it is never reopened, so nothing in the recording shows the rope, the shears or the key being used.",
  },
  {
    q: "What is the shed padlock code in Rooms & Exits Chapter 3 Level 10?",
    a: "<b>8 5 2 7</b>. The digits are painted across the slats of the wooden bench on the lawn, read at 3:24, and the four-wheel padlock hanging on the shed door takes them at 3:37. The lock starts at 0 0 0 0 when the camera first reaches it at 3:28. We read the finished state twice — the full frame and a 2x crop of the same frame — and both gave 8 5 2 7.",
  },
  {
    q: "What is the round cover in the lawn?",
    a: "A circular plate set flush into the grass, ringed by a raised lip and cut with a maze in concentric bands; a small white orb runs in the channels. Tracing the orb through the maze is what clears the plate — at 3:04 it is gone and the pit below is open. Underneath is an H-shaped pipe manifold with four red-capped handwheels, and the clue for those is the tray of <b>four coffee cups</b> shown with the line <b>PAY ATTENTION TO THE POSITION OF THE GLASS HANDLE</b>.",
  },
  {
    q: "How long is Garden and how much of it does this page cover?",
    a: "The upload runs <b>3:46</b> and decodes end to end — all 226 seconds, sampled at one frame per second. Everything from the opening wide shot to the shed's exit icon at 3:41 is read from that file, and the run ends on a <i>Thanks for watching</i> card from 3:43 rather than on a score screen.",
  },
  {
    q: "Where does Garden sit in Chapter 3?",
    a: "Chapter 3 is <i>Murder Dressed in White</i> and Garden is room <b>10 of 15</b>. It follows Backyard and precedes the next interior. This recording opens on a loading screen and a keyhole vignette rather than a title card, so the room name comes from the chapter list, not from the video. It is the chapter's daytime outdoor room, in contrast to Backyard, which is played at dusk.",
  },
  {
    q: "Do the puzzles in Garden depend on each other?",
    a: "They chain, but loosely. The first half is reading: the herb tags, the 1911 journal, the pattern tool and the letter lock. The second half is the lawn: the round cover and its maze, the four-valve manifold under it set from the tray of four cups, and the number painted on the bench that opens the shed padlock. Skip the bench and the shed will not open, no matter how much of the rest you have finished.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
