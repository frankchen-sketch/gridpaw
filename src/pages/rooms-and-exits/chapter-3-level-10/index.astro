---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 3 Level 10 Walkthrough: Garden";
const description = "Rooms & Exits Chapter 3 Level 10 walkthrough for Garden: the four-dial letter lock that takes B-N-U-G, the pattern-tool shape order that produces those letters, the three-tier herb planter (Chives, Thyme, Basil, Carrots), the 1911 notice, the trowel, the shears and the brick-wall dismantle puzzle.";

const faq = [
  {
    q: "What is the code in Rooms & Exits Chapter 3 Level 10 Garden?",
    a: "The room's letter lock is a vertical four-dial device and the answer is <b>B · N · U · G</b>, read top to bottom. The dials settle one at a time, and the fourth was still turning in our frames — it passes through W and K before landing on G. We read the finished state twice: once on the full frame and once on a 3x crop of the lock.",
  },
  {
    q: "Why B-N-U-G and not a word?",
    a: "Because the clue is not a word puzzle. The instruction reads <b>ARRANGE THE LETTERS THAT APPEAR IN THE PATTERN TOOL BASED ON THE SHAPE ORDER</b>, so the answer is letters sorted by the <i>shape</i> of the letterforms in the pattern the tool produces, not letters that spell something. If you are hunting for an English word, you will not find one — the lock accepts the shape order.",
  },
  {
    q: "What is the pattern tool?",
    a: "A dark hexagonal honeycomb pattern that fills the screen when you open the puzzle, with the instruction laid across the bottom. The letters that come out of it are the ones you lay into the four dials. It is the room's equivalent of a stencil: the pattern is not a clue you read, it is the thing that defines which order the letters belong in.",
  },
  {
    q: "What are the herbs in the planter for?",
    a: "They label the room's gardening chain. The three-tier pallet planter next to the shed carries chalkboard tags reading <b>Chives</b> and <b>Thyme</b> on the top tier and <b>Basil</b> and <b>Carrots</b> on the middle one. The tags matter because they identify which plant is which when the puzzle asks you to pick or cut; the plants themselves are not a code.",
  },
  {
    q: "What does the trowel do?",
    a: "It is the digging tool. It comes into the bag around 0:32 and is used on soil — the planter tiers, the beds by the shed. The recording never shows it being consumed by one specific puzzle, so treat it as a tool you will need in the garden rather than as a key to one lock.",
  },
  {
    q: "What is the 1911 notice?",
    a: "A printed sheet, dated 1911 in its header, that opens full-screen and carries a paragraph of small print. It is the room's document clue, in the same family as Kids Playroom's whiteboard: you read it for a line that turns into an instruction later. The header is legible in our frames; the body text is set too small to read reliably at this resolution and is not transcribed on this page.",
  },
  {
    q: "What is the brick wall puzzle?",
    a: "The instruction is explicit: <b>MAKE THE LARGE BRICK ON TOP STICK OUT, THEN TOUCH IT. THE REQUIRED BRICK WILL APPEAR, TOUCH IT TO DISMANTLE IT.</b> A dry-stone wall under a flowering vine is the play area. You push one brick proud of the face, touch it, and the wall presents the brick it actually wants; touching that one dismantles it. There are no digits involved — it is a dexterity and observation puzzle, not a code.",
  },
  {
    q: "Where do the shears and the rope come in?",
    a: "Late. <b>Shears</b> appear around 1:52 and a <b>Rope</b> at the very end of the section we could decode. Both are garden tools in the same chain as the trowel: the shears cut, the rope ties or lowers. The footage cuts away before either is used, so this page lists them as collected rather than as solved.",
  },
  {
    q: "How long is Garden and how much of it does this page cover?",
    a: "The video runs <b>3:47</b>. The copy we could decode frame by frame stops at <b>2:23</b>, which is the point where the download truncated, so roughly the last eighty seconds — the resolution of the brick wall and the garden's exit — are outside what we can honestly describe. Everything before that point was sampled at one frame per second.",
  },
  {
    q: "Where does Garden sit in Chapter 3?",
    a: "Chapter 3 is <i>Murder Dressed in White</i> and Garden is room <b>10 of 15</b>. It follows Backyard and precedes the next interior. The level card in this recording reads <b>Level 10 — Garden</b>. It is the chapter's daytime outdoor room, in contrast to Backyard, which is played at dusk.",
  },
  {
    q: "Do the puzzles in Garden depend on each other?",
    a: "Less than the two rooms before it. The herb tags, the trowel and the notice are all readable in the first two minutes, and the pattern-tool lock can be opened as soon as you have the instruction. The gardening chain (trowel, shears, rope) is the part that runs in sequence, because each tool unlocks the next patch of ground.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
