---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 12 Walkthrough: Jewelry Store";
const description = "Rooms & Exits Chapter 2 Level 12 walkthrough for the Jewelry Store: the necklace rack, the five-pendant colour puzzle, the seven-piece watch jigsaw that prints the four door digits and the four green dial panes that take them.";

const faq = [
  {
    q: "What is the door code in Rooms & Exits Chapter 2 Level 12?",
    a: "There is no single code to copy: the four green panes of the exit door are dials, and the digits you need are printed into the picture you assemble from the seven watch pieces. Our two recordings of this level settled the panes on <b>8 · 4 · 9 · 1</b> in one run and <b>8 · 6 · 9 · 1</b> in the other — the same four panes, one digit apart — and both runs opened the door once the <b>Key</b> was used. Read the four digits off your own finished jigsaw and dial the panes to those.",
  },
  {
    q: "Where does the door code come from?",
    a: "From the watch jigsaw. Assemble the seven hexagonal pieces on the table between the red armchairs and the finished picture carries four digits printed into the artwork; those four digits are the door code. Nothing in the room writes the code out for you — you manufacture it, which is why the exit looks impossible until the jigsaw is done. And because our two runs ended on two different sets, a code copied from any guide is a coin flip: read your own artwork.",
  },
  {
    q: "How do I open the door — with the code or with the key?",
    a: "Both. The four green panes take the digits from your jigsaw, and the key from the scale drawer then releases the door itself. In our recordings the panes are set first, the inventory is opened, <b>Key</b> is selected and used, and the door swings open on the results screen. One wrong pane holds the door even with the key in hand.",
  },
  {
    q: "How many watch puzzle pieces are there?",
    a: "Seven. The watch panel in the middle of the room counts them for you: it reads <b>5/7</b> when you first open it, <b>6/7</b> for most of the assembly and <b>7/7</b> on the frame where the last piece goes in. The jigsaw itself is seven hexagons showing the inside of a mechanical watch — gears, jewels, and the words SWISS MADE, 17 JEWELS and ADJUSTED.",
  },
  {
    q: "What is the digital scale for?",
    a: "The scale on the counter under the till is a container, not a clue. Put items on the pan and a counter above it steps up; at <b>3/3</b> the drawer under the scale slides open and hands you a silver <b>Key</b>. Our footage shows the pan holding a brown paper bag with a diamond logo and the display reading around <b>0.06 kg</b> when the counter is full.",
  },
  {
    q: "How do I solve the necklace rack?",
    a: "The wall rack holds nine necklaces on nine busts in three rows of three, in three colour families: gold-yellow, red and white. You swap necklaces pairwise, and the rack is checking colour positions rather than necklace designs — the rule our recordings show is that a colour on one side has to be answered by the same colour directly opposite it. Sort by colour first instead of swapping at random and the rack clears quickly.",
  },
  {
    q: "What are the five coloured studs under the watch?",
    a: "They are the lock on the watch box: five pentagon-shaped buttons in red, blue, yellow, red and green under the watch. The order is a colour sequence rather than a number, a wrong stud resets the row, and the first stud in the recorded solve is <b>red</b>. Clearing the row gives you the <b>Cross</b>, not the watch itself.",
  },
  {
    q: "How long does the Jewelry Store take?",
    a: "Our full run shows <b>18:11</b> on the game's own timer at the results screen, which is the longest room in the first half of Chapter 2. Nothing in the level is timed and there is no fail state, so the only thing that really slows you down is hunting for the exit code before the jigsaw and the paper are in your hands.",
  },
  {
    q: "What do I get for finishing the Jewelry Store?",
    a: "The results panel pays <b>+50 coins</b> and shows the level clock at <b>18:11</b>. Nothing you collected carries over — the necklaces, gems and tools all stay in the shop.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
  })),
};
---
