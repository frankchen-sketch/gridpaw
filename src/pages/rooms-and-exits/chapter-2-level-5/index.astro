import AdSlot from '../../../components/AdSlot.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import LevelSelector from '../../../components/LevelSelector.astro';

const title = "Rooms & Exits Chapter 2 Level 5 Walkthrough: Gym";
const description = "Rooms & Exits Chapter 2 Level 5 walkthrough for the Gym: the shape panel 1-6-5, the floor-mat keypad 6098, the bike console 3516, the arrow sequence, the red yoga poses, the chalked climbing wall and the +50 coin finish.";

const faqs = [
  {
    q: "What are the codes in Rooms & Exits Chapter 2 Level 5?",
    a: "Four of them. The three-screen shape panel on the metal plate takes 1 (square), 6 (triangle), 5 (circle). The keypad on locker 1 takes 6098, the four digits printed on the yellow floor mats. The exercise bike console takes 3516, which is the colour count from the weight rack read in the console's own dot order (green, red, blue, yellow). The treadmill wants the seven-step arrow sequence Up, Up, Down, Left, Left, Down, Up."
  },
  {
    q: "How do I open locker 1 in the Gym?",
    a: "Locker 1 has a four-digit keypad with a green strip across the top. The code is 6098, taken from the four yellow mats on the floor. Read the mats starting at the one nearest the treadmill and work back toward the climbing wall: 6, 0, 9, 8. The isometric camera mirrors the digits, so the same row scans as 8-6-0-9 if you read the screen left to right, which is the order that gets rejected. Inside locker 1 is a rolled Mat."
  },
  {
    q: "What is the shape panel answer in the Gym?",
    a: "1, 6 and 5. The panel has three small screens framed by a square, a triangle and a circle, and each screen counts how often that shape appears in the framed picture of the flexing strongman on the back wall. Square 1, triangle 6, circle 5. Solving it hands you the Pedal part, which is what the exercise bike is missing."
  },
  {
    q: "What is the colour code on the exercise bike?",
    a: "3516. The weight rack on the back wall carries a hint board that reads Blue: 1, Red: 5, Green: 3, Yellow: 6. The bike console has four buttons in the order green, red, blue, yellow, so you type the value for each button in that order: 3, 5, 1, 6. The console's status light turns green when the code lands."
  },
  {
    q: "What is the arrow sequence on the treadmill?",
    a: "Up, Up, Down, Left, Left, Down, Up. The treadmill console shows four direction buttons and a list of seven words beside them; enter the words with the matching buttons in the order written. The same seven-step list is also shown on the panel by the arrow pad, so you can check your reading against both displays."
  },
  {
    q: "How do I finish the Gym and how long does it take?",
    a: "After you chalk the climbing wall you get the phrase \"From up Into Down\", and the exit door beside the shower sign is the last thing you touch. The recording opens it at 8:03 of level time and the results screen pays +50 coins. Nothing in the level is timed and there is no fail state."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
