<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <SEOHead title={title} description={description} canonical="/kenken/solver" type="article" image="/og-kenken.png" breadcrumbTitle="KenKen Solver" />
