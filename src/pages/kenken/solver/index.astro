---
import SEOHead from '../../../components/SEOHead.astro';
import GameSwitcher from '../../../components/GameSwitcher.astro';
import SolverTiles from '../../../components/SolverTiles.astro';
import SideAd from '../../../components/SideAd.astro';

const title = "KenKen Solver — Solve Any Calcudoku Online";
const description = "Free KenKen solver: enter each cage and its target plus any givens, and get the full grid in one click. Also solves Calcudoku, Mathdoku and NYT KenKen puzzles.";

const faqs = [
  { q: "Is this KenKen solver free?", a: "Yes — free, no account, no download, no limit on how many puzzles you solve. Everything runs in your browser: the cages you type never leave your device." },
  { q: "How do I enter a KenKen puzzle?", a: "Two passes. First the cages: click the cells that make up one cage, pick its operator, type the target number, then press Add cage — repeat until every cell is covered. Then the givens: switch to Givens mode, click each cell that shows a printed digit and set it. A digit alone in its cell can go in as a one-cell cage with = instead. Press Solve when the grid is covered." },
  { q: "What does the ÷ operator mean in KenKen?", a: "Division cages have exactly two cells: the larger digit divided by the smaller one equals the target. So 6÷ on two cells means 6 and 1, or 3 and 2. Order does not matter — 1 and 6 is the same cage as 6 and 1." },
  { q: "What does the − operator mean?", a: "Subtraction cages also have exactly two cells: the difference between the two digits equals the target. A 2− cage is 3 and 1, or 4 and 2 — never 1 and 1." },
  { q: "Can it solve a 6×6 or a 9×9 KenKen?", a: "Yes. The tool handles 3×3 up to 9×9, which covers the NYT daily KenKen sizes (4×4 to 7×7) and the 9×9 monsters in puzzle apps. Boards up to 6×6 solve instantly; the very largest sizes take a moment on a phone." },
  { q: "The solver says my puzzle has more than one solution. Is the solver wrong?", a: "No. That message means your cage set genuinely allows two or more different grids, and the solver shows the first one it finds. It usually happens when a cage was typed with the wrong target, when two cages that should be one were entered separately, or when the puzzle itself is ambiguous. A correctly entered KenKen from a newspaper or the NYT app has exactly one solution." },
  { q: "Why does it say no solution exists?", a: "Something in the entry contradicts the KenKen rules. The four usual suspects: a cell left out of every cage, a target typed one off, a digit typed into a cage that already contains a given, or a two-cell ÷ / − cage entered as three cells. The solver prints which cage cannot be satisfied, then check that cage against the original puzzle." },
  { q: "Is KenKen the same as Calcudoku or Mathdoku?", a: "Yes. KenKen is the trademarked name (invented by Tetsuya Miyamoto, popularised by the New York Times), and Calcudoku, Mathdoku, Kendoku, Newdoku and MathDoku are the same puzzle under different names. Cage entry and rules are identical, so this page solves all of them." },
  { q: "Does it show the solving steps?", a: "No — and it does not pretend to. Unlike a nonogram, where human line logic maps cleanly onto steps, KenKen solving is a constraint search: the solver narrows each cage to the digit combinations that fit, then fills the grid by Latin-square rules. What it gives you instead is the full answer plus a uniqueness verdict, which is the part you actually need when you are stuck." },
  { q: "Can I share a puzzle with someone?", a: "Yes. After you solve or build a puzzle the cages are written into the page address. Press Copy link and anyone who opens it sees the same puzzle, ready to solve — the fastest way to ask a friend or a forum why a puzzle feels impossible." },
];

const exampleNote = "The example is a 4×4 KenKen with a division cage, a multiplication cage and five givens — four of them printed inside a bigger cage, the way most puzzle apps print them.";
---
