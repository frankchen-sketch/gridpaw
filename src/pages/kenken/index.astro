---
import SEOHead from '../../components/SEOHead.astro';
import GameHub from '../../components/GameHub.astro';

// ── KenKen (Calcudoku) — GridPaw game page ────────────────────────────────
// Engine: public/calcudoku-engine.js (global CalcudokuEngine, generated by
// scripts/bundle-engine.mjs from src/lib/puzzle-core/calcudoku-engine.ts).
// API: generate(size, difficulty, seed) → { id, size, cages, givens, solution, difficulty }
//      validate(p, valsInt8Array) → { ok, errors }   (only used for win confirmation)
//      hintLookup(p, idx) → number                   (the answer digit)
// Cage: { op: '+'|'-'|'×'|'÷'|'=', target, cells: number[] } (board indices r*size+c)
const title = "KenKen Puzzle - Play Free Calcudoku Online";
const description = "Play KenKen (Calcudoku) free online: cat-themed math logic puzzles in your browser, no download. Also known as Mathdoku, from easy 4x4 to hard 9x9 grids.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <SEOHead title={title} description={description} canonical="/kenken/" type="website" image="/og-kenken.png" />
  <link rel="alternate" hreflang="en" href="https://gridpaw.com/kenken/">
  <link rel="alternate" hreflang="x-default" href="https://gridpaw.com/kenken/">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://gridpaw.com/#website",
        "url": "https://gridpaw.com/",
        "name": "GridPaw",
        "publisher": { "@id": "https://gridpaw.com/#organization" }
      },
      {
        "@type": "Organization",
        "@id": "https://gridpaw.com/#organization",
        "name": "GridPaw",
        "url": "https://gridpaw.com/"
      },
      {
        "@type": "WebApplication",
        "name": "GridPaw KenKen Puzzle",
        "applicationCategory": "GameApplication",
        "operatingSystem": "Web Browser",
        "url": "https://gridpaw.com/kenken/",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question", "name": "What is a KenKen puzzle?",
            "acceptedAnswer": { "@type": "Answer", "text": "KenKen is a number logic puzzle where every row and every column contains each number from 1 to N exactly once, while numbers inside each thick-outlined cage must combine to the cage's target using the given operator (addition, subtraction, multiplication or division). It was invented by Japanese math teacher Tetsuya Miyamoto." }
          },
          {
            "@type": "Question", "name": "Is KenKen the same as Calcudoku?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes — Calcudoku and Mathdoku are the same puzzle family. KenKen is a registered trademark of Nextoy LLC, so most unlicensed publishers use the generic names Calcudoku or Mathdoku for identical rules." }
          },
          {
            "@type": "Question", "name": "Is KenKen harder than Sudoku?",
            "acceptedAnswer": { "@type": "Answer", "text": "Not necessarily. KenKen adds cage arithmetic on top of the same row-and-column rules as Sudoku, so it exercises mental math as well as logic. Small grids like 4x4 KenKen are very beginner-friendly, while 9x9 puzzles can get as demanding as hard Sudoku." }
          },
          {
            "@type": "Question", "name": "Is this KenKen puzzle free?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes, the GridPaw KenKen puzzle is completely free to play in your browser. There is no download, no account, and no payment required — just open the page and start solving." }
          },
          {
            "@type": "Question", "name": "Can I play KenKen on mobile?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes — the grid works on any device with a browser. On phones and tablets use the on-screen number pad to enter digits, or a physical keyboard on desktop." }
          },
          {
            "@type": "Question", "name": "Are all KenKen puzzles solvable without guessing?",
            "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every GridPaw KenKen puzzle has exactly one solution that can be reached through pure logic — the arithmetic of the cages plus the row and column rules. If you are stuck, the Hint button reveals the correct digit for the selected cell." }
          }
        ]
      }
    ]
  })} />

  <style is:global>
    /* ── GridPaw 视觉合同 token（STYLE.md）── */
    :root {
      --gp-primary: #E8A888;
      --gp-primary-strong: #D47A50;
      --gp-primary-dark: #C06A40;
      --gp-primary-soft: #F0B898;
      --gp-brown-900: #342421;
      --gp-brown-600: #6F5651;
      --gp-brown-400: #9B726C;
      --gp-stone: #9E9590;
      --gp-cream: #FFF8F0;
      --gp-cream-warm: #FFF4F0;
      --gp-sand: #F8F6EF;
      --gp-blush: #F4DFDC;
      --gp-linen: #E7DACF;
      --gp-parchment: #E8DDD0;
      --gp-white: #FFFFFF;
      --gp-error: #E74C3C;
      --gp-success: #559C68;
      --gp-info: #5C6BC0;
      --gp-mint: #88C8A8;
      --gp-lilac-soft: #E8E0EB;
      --gp-lilac-bright: #CFC2E8;
      --gp-badge-easy-bg: #B8E8C0;
      --gp-badge-easy-text: #2D6A3F;
      --gp-badge-med-bg: #FDD09F;
      --gp-badge-med-text: #8B6914;
      --gp-badge-hard-bg: #FFB3C6;
      --gp-badge-hard-text: #8B2252;
    }
    /* ═══════════ meowdoku 风格配色 ════════════ */
    :root {
      --bg:            var(--gp-sand);
      --card:          #ffffff;
      --ink:           var(--gp-brown-900);
      --text:          var(--gp-brown-600);
      --text-muted:    var(--gp-brown-400);
      --border:        var(--gp-linen);
      --border-soft:   var(--gp-blush);
      --hover-bg:      var(--gp-cream-warm);
      --btn-dark:      var(--gp-brown-900);
      --green:         var(--gp-success);
      --focus:         var(--gp-mint);
      --accent:        var(--gp-primary);
      --shadow:        0 12px 28px rgba(78,64,55,0.10);
      --shadow-sm:     0 4px 10px rgba(78,64,55,0.12);
      --radius-lg:     1.7rem;
      --radius-md:     1.15rem;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: "SF Pro Rounded", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; display: block; }

    /* ── 主布局 ── */
    .shell {
      max-width: 1500px; margin: 0 auto; flex: 1;
      display: grid; grid-template-columns: 1fr; gap: 0;
      padding: 1.5rem 1rem 3rem;
    }
    .main { max-width: 72rem; width: 100%; margin: 0 auto; }

    /* ── Sticky Header ── */
    .site-header {
      position: sticky; top: 0; z-index: 30;
      border-bottom: 1px solid var(--border-soft);
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    }
    .header-inner {
      max-width: 80rem; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      height: 4rem; padding: 0 1rem;
    }
    .brand { display: flex; align-items: center; gap: 0.75rem; }
    .brand-logo {
      width: 2.25rem; height: 2.25rem; border-radius: 0.5rem;
      box-shadow: var(--shadow-sm); display: grid; place-items: center;
      font-size: 1.4rem; overflow: hidden;
    }
    .brand-logo img { width: 100%; height: 100%; object-fit: cover; }
    .brand-name { line-height: 1.1; }
    .brand-name .big { font-weight: 900; color: var(--ink); font-size: 1.05rem; display: block; }
    .brand-name .small { font-weight: 600; color: var(--text-muted); font-size: 0.75rem; }
    .nav { display: flex; align-items: center; gap: 0.25rem; }
    .nav a {
      border-radius: 0.375rem; padding: 0.5rem 0.75rem;
      font-size: 0.875rem; font-weight: 700; color: var(--text);
    }
    .nav a:hover { background: var(--hover-bg); color: var(--ink); }
    .game-switcher { position: relative; }
    .game-switcher-btn { font-size: 0.875rem; font-weight: 700; color: var(--text); background: none; border: none; cursor: pointer; padding: 0.5rem 0.75rem; border-radius: 0.375rem; display: flex; align-items: center; gap: 4px; }
    .game-switcher-btn::after { content: '▾'; font-size: 10px; }
    .game-switcher-btn:hover { background: var(--hover-bg); color: var(--ink); }
    .game-switcher-menu { display: none; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); background: white; border: 1.5px solid var(--gp-parchment); border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.12); min-width: 200px; padding: 6px 0; z-index: 300; }
    .game-switcher:hover .game-switcher-menu { display: block; }
    .game-switcher-menu a { display: flex; flex-direction: column; padding: 10px 16px !important; font-size: 13px !important; gap: 2px; border-radius: 0 !important; }
    .game-switcher-menu a .game-desc { font-size: 11px; font-weight: 500; color: var(--gp-stone); }
    .game-switcher-menu a:hover { background: var(--gp-cream) !important; color: var(--ink) !important; }
    .game-switcher-menu a.active { color: var(--ink) !important; background: var(--gp-cream-warm) !important; font-weight: 800 !important; }
    @media (max-width: 480px) { .game-switcher:hover .game-switcher-menu { display: none; } .game-switcher-menu.open { display: block; } }
    .nav .hamburger { display: none; font-size: 1.4rem; padding: 0.5rem; cursor: pointer; background: none; border: none; color: var(--text); }
    @media (max-width: 768px) {
      .nav a:not(.hamburger) { display: none; }
      .nav .hamburger { display: block; }
    }

    /* ── 卡片通用 ── */
    .card {
      background: var(--card);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow), inset 0 0 0 1px var(--border);
      padding: 1.5rem;
    }
    .section { margin-top: 2.5rem; }
    .section-title { font-size: 1.5rem; font-weight: 800; color: var(--ink); margin-bottom: 1rem; }
    .section-title .accent { color: var(--green); }

    /* ── 游戏卡片 ── */
    .game-card { padding: 0; overflow: hidden; }
    .game-topbar {
      display: grid; grid-template-columns: 1fr auto 1fr;
      align-items: center; gap: 0.75rem;
      padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-soft);
      width: 100%;
    }
    @media (max-width: 640px) {
      .game-topbar { grid-template-columns: 1fr; gap: 0.5rem; text-align: center; }
      .game-topbar > :first-child { justify-self: center; }
      .game-topbar > :last-child { justify-self: center; }
    }
    .level-badge {
      display: inline-flex; align-items: center; gap: 0.4rem;
      background: var(--card); border: 1px solid var(--border);
      border-radius: 999px; padding: 0.3rem 0.8rem;
      font-weight: 700; color: var(--ink); font-size: 0.85rem;
      box-shadow: var(--shadow-sm);
    }
    .difficulty-badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; vertical-align: middle; }
    .badge-easy { background: var(--gp-badge-easy-bg); color: var(--gp-badge-easy-text); }
    .badge-medium { background: var(--gp-badge-med-bg); color: var(--gp-badge-med-text); }
    .badge-hard { background: var(--gp-badge-hard-bg); color: var(--gp-badge-hard-text); }
    .game-center-info {
      display: flex; flex-direction: column; align-items: center; gap: 0.35rem;
    }
    .level-title { font-size: 1.25rem; font-weight: 900; color: var(--ink); text-align: center; }
    @media (min-width: 640px) { .level-title { font-size: 1.875rem; } }
    .game-meta-row { display: flex; align-items: center; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }
    .timer { font-size: 0.85rem; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
    .hint-left-label { font-size: 0.75rem; color: var(--text-muted); }
    .game-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end; }
    @media (max-width: 480px) { .game-actions { justify-content: center; } }
    .icon-btn {
      position: relative; width: 2.4rem; height: 2.4rem; border-radius: 999px;
      background: var(--card); border: 1px solid var(--border);
      box-shadow: var(--shadow-sm); cursor: pointer;
      display: grid; place-items: center; font-size: 1rem;
      transition: transform 0.15s ease; color: var(--text);
    }
    .icon-btn:hover { transform: translateY(-2px); color: var(--ink); }
    .icon-btn .tip {
      position: absolute; top: 100%; margin-top: 0.5rem; left: 50%;
      transform: translateX(-50%); white-space: nowrap;
      background: var(--btn-dark); color: #fff; font-size: 0.72rem;
      padding: 0.2rem 0.6rem; border-radius: 999px; opacity: 0; pointer-events: none;
      transition: opacity 0.15s;
    }
    .icon-btn:hover .tip { opacity: 1; }
    /* hint 文字胶囊按钮（与 Shikaku 同款）：Clarity 实锤 icon-only 没人看得见 */
    .game-actions .hint-btn {
      display: inline-flex; align-items: center; gap: 5px; height: 34px; padding: 0 12px;
      border-radius: 999px; background: white; border: 1.5px solid var(--gp-primary-strong);
      font-size: 13px; font-weight: 800; color: var(--ink); cursor: pointer;
      transition: all 0.15s; font-family: inherit;
    }
    .game-actions .hint-btn:hover { background: var(--gp-primary-strong); color: white; }
    .game-actions .hint-btn .hint-word { line-height: 1; }
    .game-actions .hint-btn.disabled { opacity: 0.45; cursor: not-allowed; border-color: var(--border); }
    .game-actions .hint-btn.disabled:hover { background: white; color: var(--ink); }
    .howto-chip {
      display: inline-flex; align-items: center; gap: 0.3rem;
      background: #fff; border: 1.5px dashed var(--accent); color: var(--gp-primary-strong);
      border-radius: 999px; font-size: 0.72rem; font-weight: 800;
      padding: 0.35rem 0.7rem; cursor: pointer; font-family: inherit;
    }
    .howto-chip:hover { background: #fde8c8; }

    /* ── 难度选择 ── */
    .diff-row {
      display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap;
      padding: 0.8rem 1.25rem 0.4rem;
    }
    .diff-btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      border: 1.5px solid var(--border); background: var(--card);
      border-radius: 999px; padding: 0.45rem 1rem;
      font-size: 0.85rem; font-weight: 800; color: var(--text);
      cursor: pointer; font-family: inherit; transition: all 0.15s;
    }
    .diff-btn span { font-size: 0.72rem; color: var(--text-muted); }
    .diff-btn:hover { border-color: var(--gp-primary-strong); color: var(--ink); transform: translateY(-1px); }
    .diff-btn.active { background: var(--btn-dark); border-color: var(--btn-dark); color: #fff; }
    .diff-btn.active span { color: rgba(255,255,255,0.75); }

    /* ── 棋盘区 ── */
    .game-stage {
      display: flex; flex-direction: column; align-items: center;
      padding: 0.9rem 1rem 1.2rem; gap: 0.9rem;
    }
    .kk-grid-wrap {
      --cell: 56px;
      position: relative;
      border: 3px solid var(--gp-brown-900);
      border-radius: 10px;
      overflow: hidden;
      background: var(--gp-cream);
      box-shadow: 0 8px 28px rgba(52,36,33,0.18), 0 2px 8px rgba(52,36,33,0.1);
      max-width: 100%;
    }
    .kk-cells {
      display: grid;
      grid-template-columns: repeat(4, var(--cell));
      user-select: none;
    }
    .kk-cell {
      position: relative;
      width: var(--cell); height: var(--cell);
      background: var(--gp-white);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      transition: background 0.12s ease;
      font-family: "SF Pro Rounded", ui-sans-serif, system-ui, sans-serif;
    }
    .kk-cell:hover { background: var(--gp-cream-warm); }
    .kk-cell.sel { background: #fdeedb; box-shadow: inset 0 0 0 3px var(--gp-primary); z-index: 1; }
    .kk-cell.given { background: var(--gp-cream); }
    .kk-cell.given .kk-num { color: var(--gp-brown-900); }
    .kk-cell.err { background: #fdecea; }
    .kk-cell.err .kk-num { color: #c0392b; }
    .kk-cell .kk-num {
      font-weight: 800; color: var(--gp-primary-dark);
      font-size: calc(var(--cell) * 0.5);
      line-height: 1; position: relative; z-index: 2;
      pointer-events: none;
    }
    .kk-cell .kk-clue {
      position: absolute; top: 1px; left: 3px; z-index: 2;
      font-size: clamp(7px, calc(var(--cell) * 0.28), 12px);
      font-weight: 900; color: var(--gp-brown-900); line-height: 1.15;
      pointer-events: none;
      letter-spacing: -0.02em;
      white-space: nowrap;
    }
    .kk-cage-lines {
      position: absolute; inset: 0; width: 100%; height: 100%;
      pointer-events: none; z-index: 3;
    }
    .kk-cage-lines line {
      stroke: var(--gp-brown-900);
      stroke-width: 5;
      vector-effect: non-scaling-stroke;
    }

    /* ── 数字键盘 ── */
    .num-pad {
      display: flex; gap: 0.45rem; flex-wrap: wrap; justify-content: center;
      max-width: 100%;
    }
    .pad-btn {
      width: 3rem; height: 3rem; border-radius: 12px;
      background: var(--card); border: 1.5px solid var(--border);
      box-shadow: var(--shadow-sm); cursor: pointer;
      font-size: 1.15rem; font-weight: 800; color: var(--ink);
      transition: transform 0.12s ease, background 0.12s ease;
      font-family: inherit;
    }
    .pad-btn:hover { transform: translateY(-2px); background: var(--hover-bg); }
    .pad-btn:active { transform: scale(0.94); }
    @media (max-width: 480px) {
      .pad-btn { width: 2.6rem; height: 2.6rem; font-size: 1rem; border-radius: 10px; }
    }

    /* ── Toast ── */
    .toast {
      position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
      background: var(--gp-error); color: #fff;
      padding: 0.6rem 1.2rem; border-radius: 12px;
      font-size: 0.9rem; font-weight: 600; z-index: 1000;
      opacity: 0; transition: opacity 0.3s; pointer-events: none;
      max-width: 92vw; text-align: center;
    }
    .toast.show { opacity: 1; }
    .toast.success { background: var(--green); }

    /* ── Win Overlay ── */
    .win-overlay {
      position: fixed; inset: 0; background: rgba(248,246,239,0.95);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      z-index: 999; opacity: 0; transition: opacity 0.4s;
      pointer-events: none; overflow: hidden;
    }
    .win-overlay.show { opacity: 1; pointer-events: auto; }
    .win-cat { animation: cat-pop 0.8s cubic-bezier(0.34,1.56,0.64,1) forwards; }
    @keyframes cat-pop { 0% { transform: scale(0) rotate(-10deg); } 50% { transform: scale(1.3) rotate(5deg); } 100% { transform: scale(1) rotate(0); } }
    .win-glow {
      position: absolute; width: 300px; height: 300px; border-radius: 50%;
      background: radial-gradient(circle, rgba(232,168,136,0.35) 0%, transparent 70%);
      animation: glow-pulse 2s ease-in-out infinite; pointer-events: none;
    }
    @keyframes glow-pulse { 0%,100% { transform: scale(1); opacity: 0.5; } 50% { transform: scale(1.3); opacity: 1; } }
    .win-text { font-size: 2rem; font-weight: 800; color: var(--ink); margin-top: 1.5rem; animation: text-pop 0.6s 0.3s cubic-bezier(0.34,1.56,0.64,1) both; }
    @keyframes text-pop { 0% { transform: scale(0); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
    .win-sub { font-size: 1.1rem; color: var(--text); margin-top: 0.5rem; animation: fade-up 0.5s 0.5s ease both; }
    @keyframes fade-up { 0% { transform: translateY(20px); opacity: 0; } 100% { transform: translateY(0); opacity: 1; } }
    .win-btn {
      margin-top: 1.5rem; padding: 0.7rem 2rem;
      background: var(--accent); color: #fff; border: none; border-radius: 12px;
      font-size: 1rem; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .win-btn:hover { background: var(--gp-primary-strong); }
    .win-share-row { display: flex; gap: 0.5rem; margin-top: 0.8rem; flex-wrap: wrap; justify-content: center; }
    .share-btn { padding: 0.5rem 1rem; border: none; border-radius: 10px; cursor: pointer; font-size: 0.85rem; font-weight: 600; font-family: inherit; transition: transform 0.1s; }
    .share-btn:active { transform: scale(0.95); }
    .share-copy { background: var(--gp-cream-warm); color: var(--gp-brown-600); }
    .share-copy:hover { background: var(--gp-lilac-soft); }
    .share-twitter { background: var(--gp-info); color: #fff; }
    .share-twitter:hover { background: var(--gp-info); }
    .share-reddit { background: #FF4500; color: #fff; }
    .share-reddit:hover { background: var(--gp-primary-dark); }
    .confetti-container { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
    .confetti { position: absolute; width: 10px; height: 10px; border-radius: 3px; animation: confetti-fall linear forwards; }
    @keyframes confetti-fall { 0% { transform: translateY(-20vh) rotate(0); opacity: 1; } 100% { transform: translateY(110vh) rotate(720deg); opacity: 0; } }

    /* ── Rules overlay ── */
    .rules-card {
      background: #fff8ef; border: 1.5px solid #e7d4b8; border-radius: 16px;
      max-width: 340px; width: 88%; padding: 1.2rem 1.3rem;
      box-shadow: 0 12px 30px rgba(74,59,50,0.25); text-align: left;
      animation: text-pop 0.4s 0.05s cubic-bezier(0.34,1.56,0.64,1) both;
    }
    .rules-card h3 { margin: 0 0 0.7rem; font-size: 1.05rem; font-weight: 900; color: var(--ink); text-align: center; }
    .rules-rule { display: flex; gap: 0.6rem; margin: 0.6rem 0; align-items: flex-start; font-size: 0.85rem; line-height: 1.5; color: var(--text); }
