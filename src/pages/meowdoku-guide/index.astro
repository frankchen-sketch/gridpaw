    .compare-table .sim-high { color: #1E7A3C; font-weight: 800; }
    .compare-table .sim-mid { color: #B26A00; font-weight: 700; }

    /* ===== callouts ===== */
    .callout { font-size: 0.88rem; padding: 0.55rem 0.75rem; border-radius: 8px; margin: 0.7rem 0; display: flex; gap: 6px; align-items: flex-start; line-height: 1.6; }
    .callout.warn { background: #FFF4E0; color: #92610A; border: 1px dashed #E8B15C; }
    .callout.grn { background: rgba(34,197,94,.1); color: #15803d; }

    /* ===== rules demo ===== */
    .rulewrap { display: flex; gap: 14px; align-items: flex-start; flex-wrap: wrap; background: #fff; border: 1.5px solid var(--md-cell-border); border-radius: 10px; padding: 12px 14px; margin: 6px 0; }
    .rulewrap ol { margin: 0; padding-left: 0; list-style: none; counter-reset: rl; flex: 1; min-width: 260px; }
    .rulewrap ol li { counter-increment: rl; position: relative; padding: 0 0 10px 30px; font-size: 0.78rem; color: #555; line-height: 1.55; }
    .rulewrap ol li:last-child { padding-bottom: 0; }
    .rulewrap ol li::before { content: counter(rl); position: absolute; left: 0; top: 1px; width: 19px; height: 19px; border-radius: 50%; background: #42352E; color: #FFFAF5; font-size: 10.5px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
    .rulewrap ol li b { display: block; color: #42352E; font-size: 0.84rem; margin-bottom: 1px; }
    .xdemo { display: grid; grid-template-columns: repeat(4, 21px); grid-auto-rows: 21px; gap: 2px; background: #fff; padding: 3px; border: 2px solid #E8D8CA; border-radius: 8px; flex: 0 0 auto; }
    .xdemo .c { border-radius: 3px; position: relative; }
    .xdemo .x::after { content: "✕"; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 11px; color: rgba(66,53,46,.45); font-weight: 700; }
    .xdemo .off { opacity: .35; }

    /* ===== strategy list ===== */
    .strat { margin: 6px 0; columns: 2; column-gap: 30px; }
    .strat .st { break-inside: avoid; display: flex; gap: 10px; padding: 7px 2px; border-bottom: 1px dashed var(--md-cell-border); font-size: 0.88rem; color: #555; line-height: 1.55; }
    .strat .st i { font-style: normal; color: var(--md-primary); font-weight: 800; font-size: 1.05rem; line-height: 1.15; flex: 0 0 16px; font-family: Georgia, 'Times New Roman', serif; }
    .strat .st b { color: var(--md-text); }

    /* ===== boards ===== */
    .boardrow { display: flex; gap: 14px; align-items: flex-start; flex-wrap: wrap; background: #fff; border: 1.5px solid var(--md-cell-border); border-radius: 10px; padding: 10px 12px; margin: 8px 0; box-shadow: 0 1px 5px rgba(232,122,79,.08); }
    .bd { display: grid; gap: 2px; background: #fff; padding: 3px; border: 2px solid #E8D8CA; border-radius: 8px; }
    .c { border-radius: 3px; display: flex; align-items: center; justify-content: center; font-size: 11px; }
    .cP { background: #FD9FEB; } .cL { background: #E6A8C1; } .cD { background: #C1658A; } .cU { background: #9179D1; } .cO { background: #FEA96B; }
    .cat { width: 82%; height: 82%; background: url('/meowdoku-guide/cat-icon.png') center/contain no-repeat; filter: drop-shadow(0 1px 1px rgba(0,0,0,.25)); }
    .b4 { grid-template-columns: repeat(4, 24px); grid-auto-rows: 24px; }
    .b5 { grid-template-columns: repeat(5, 20px); grid-auto-rows: 20px; }
    .s4 { grid-template-columns: repeat(4, 13px); grid-auto-rows: 13px; gap: 1.5px; border-width: 1.5px; }
    .s4 .c { border-radius: 2px; }
    .s4 .cat { width: 88%; height: 88%; }
    .stepstrip { display: flex; gap: 8px; align-items: flex-end; flex-wrap: wrap; }
    .step { display: flex; flex-direction: column; align-items: center; gap: 2px; }
    .step i { font-style: normal; font-size: 9px; color: var(--md-text-light); font-weight: 700; }
    .lvmeta { flex: 1; min-width: 230px; }
    .lvmeta h4 { margin: 0 0 4px; font-size: 13.5px; color: var(--md-text); }
    .lvmeta ol { margin: 4px 0 0; padding-left: 18px; font-size: 0.78rem; color: #555; }
    .lvmeta ol li { margin-bottom: 3px; line-height: 1.55; }
    .lvmeta .ans { font-size: 0.78rem; background: #FFF4E0; border-radius: 6px; padding: 4px 8px; margin-top: 5px; display: inline-block; color: #92610A; font-weight: 700; }
    .lvtag { font-size: 9px; font-weight: 800; padding: 1px 7px; border-radius: 99px; vertical-align: 2px; margin-left: 5px; }
    .lvtag.e { background: #DFF3E4; color: #1E7A3C; } .lvtag.m { background: #FFF4E0; color: #B26A00; }

    /* ===== snapshot gallery ===== */
