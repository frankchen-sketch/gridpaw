  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --md-primary: #E87A4F;
      --md-secondary: #6B8FE8;
      --md-bg: #FFFAF5;
      --md-cell-border: #F0DFD2;
      --md-text: #42352E;
      --md-text-light: #A08D80;
      --md-shadow-sm: 0 2px 8px rgba(232,122,79,0.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Nunito', -apple-system, sans-serif; background: var(--md-bg); color: var(--md-text); min-height: 100vh; }
    .breadcrumb { font-size: 12px; color: var(--md-text-light); padding: 14px 16px 0; text-align: center; }
    .breadcrumb a { color: var(--md-text-light); text-decoration: none; }
    .breadcrumb a:hover { color: var(--md-primary); }
    .seo-section { max-width: 720px; margin: 0 auto; padding: 1.5rem 1rem 1rem; }
    .seo-section h1 { font-size: 1.7rem; color: var(--md-text); margin: 1rem 0 0.5rem; line-height: 1.3; }
    .seo-section h2 { font-size: 1.35rem; color: var(--md-text); margin: 2rem 0 0.6rem; line-height: 1.3; }
    .seo-section h2 .accent { color: var(--md-primary); }
    .seo-section h3 { font-size: 1.1rem; color: var(--md-text); margin: 1.2rem 0 0.4rem; }
    .seo-section p { margin: 0.5rem 0; line-height: 1.75; color: #555; }
    .seo-section ul, .seo-section ol { padding-left: 1.5rem; margin: 0.5rem 0; color: #555; }
    .seo-section li { margin-bottom: 0.4rem; line-height: 1.6; }
    .seo-section a { color: var(--md-primary); }
    .seo-section details { margin: 0.6rem 0; padding: 0.6rem 0.9rem; background: white; border: 1.5px solid var(--md-cell-border); border-radius: 10px; box-shadow: var(--md-shadow-sm); }
    .seo-section details[open] { border-color: var(--md-primary); }
    .seo-section summary { cursor: pointer; font-weight: 800; color: var(--md-text); line-height: 1.5; }
    .seo-section summary:hover { color: var(--md-primary); }
    .seo-section details p { margin-top: 0.5rem; }
    .lede { font-size: 1rem; color: #4a3d35; line-height: 1.75; margin: 0.5rem 0 0.25rem; }
    .disclaimer { font-size: 0.82rem; color: var(--md-text-light); font-style: italic; background: #fff; border: 1px solid var(--md-cell-border); border-radius: 8px; padding: 0.5rem 0.8rem; margin: 0.6rem 0 1rem; }
    .seo-footer { text-align: center; margin: 2rem 0 1rem; font-size: 0.8rem; color: var(--md-text-light); }
    .seo-footer a { color: var(--md-text-light); }
    .seo-footer a:hover { color: var(--md-primary); }
    .cta-box { margin: 1.2rem 0; padding: 0.9rem 1.1rem; background: white; border: 2px dashed var(--md-primary); border-radius: 12px; text-align: center; }
    .cta-box p { margin: 0.2rem 0; font-weight: 700; color: var(--md-text); }
    .cta-box a { color: var(--md-primary); font-weight: 800; text-decoration: none; }
    .cta-box a:hover { text-decoration: underline; }
    .compare-table { width: 100%; border-collapse: collapse; margin: 0.8rem 0; background: white; border-radius: 12px; overflow: hidden; box-shadow: var(--md-shadow-sm); }
    .compare-table th, .compare-table td { padding: 0.6rem 0.8rem; text-align: left; border-bottom: 1px solid var(--md-cell-border); font-size: 0.9rem; }
    .compare-table th { background: #FFF1E8; color: var(--md-text); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .compare-table td:first-child { font-weight: 800; color: var(--md-text); }
    .compare-table a { color: var(--md-primary); text-decoration: none; font-weight: 700; }
