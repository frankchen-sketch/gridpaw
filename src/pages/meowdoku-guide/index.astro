  <script is:inline>
    // Board renderer. Region letters: P pink / L light-rose / D deep-rose / U purple / O orange / M magenta (renders pink)
    function mk(id, n, regions, cats) {
      const el = document.getElementById(id);
      const letters = { P: 'cP', L: 'cL', D: 'cD', U: 'cU', O: 'cO', M: 'cP' };
      for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) {
        const d = document.createElement('div');
        d.className = 'c ' + letters[regions[r][c]];
        if (cats.some(p => p[0] === r && p[1] === c)) d.innerHTML = '<span class="cat"></span>';
        el.appendChild(d);
      }
    }
    // L1 regions: P pink / L light-rose / D deep-rose / U purple
    const L1R = ["PPLP", "DPPP", "PPUU", "PPPU"];
    const L1C = [[0, 2], [1, 0], [2, 3], [3, 1]];
    // progressive strips: 0..4 cats placed
    [0, 1, 2, 3, 4].forEach(k => {
      const id = 'l1s' + k, el = document.getElementById(id);
      const letters = { P: 'cP', L: 'cL', D: 'cD', U: 'cU' };
      for (let r = 0; r < 4; r++) for (let c = 0; c < 4; c++) {
        const d = document.createElement('div'); d.className = 'c ' + letters[L1R[r][c]];
        if (L1C.slice(0, k).some(p => p[0] === r && p[1] === c)) d.innerHTML = '<span class="cat"></span>';
        el.appendChild(d);
      }
    });
    // Rules demo: one cat at R2C2, row/column + 8-neighbor exclusion marked ✕
    (function () {
      const el = document.getElementById('xdemo');
      const R = ["ULMM", "UMMD", "UUMD", "UMMM"]; // reuse L2 region map
      const cat = [1, 1]; // R2C2
      const letters = { P: 'cP', L: 'cL', D: 'cD', U: 'cU', O: 'cO', M: 'cP' };
      for (let r = 0; r < 4; r++) for (let c = 0; c < 4; c++) {
        const d = document.createElement('div');
        d.className = 'c ' + letters[R[r][c]];
        const isCat = (r === cat[0] && c === cat[1]);
        const blocked = !isCat && (r === cat[0] || c === cat[1] || (Math.abs(r - cat[0]) <= 1 && Math.abs(c - cat[1]) <= 1));
        if (isCat) { d.innerHTML = '<span class="cat"></span>'; }
        else if (blocked) { d.classList.add('x'); }
        else { d.classList.add('off'); }
        el.appendChild(d);
      }
    })();
    // L2: U purple / L light / D deep / M magenta (pink)
    const L2R = ["ULMM", "UMMD", "UUMD", "UMMM"];
    const L2C = [[0, 1], [1, 3], [2, 0], [3, 2]];
    mk('l2', 4, L2R, L2C);
    // L3: U purple / D deep / P pink / O orange / L light-rose
    const L3R = ["UULUU", "DUUUU", "UUUOU", "UPUOO", "OOOOO"];
    const L3C = [[0, 2], [1, 0], [2, 4], [3, 1], [4, 3]];
    mk('l3', 5, L3R, L3C);
  </script>

