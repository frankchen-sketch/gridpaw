---
import SEOHead from '../components/SEOHead.astro';

const title = 'Reset Your Password — GridPaw';
const description = 'Choose a new password for your GridPaw account.';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead title={title} description={description} canonical="/reset-password" type="website" noindex={true} />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand" aria-label="GridPaw home">
        <span class="brand-logo"><img src="/assets/logo.png" alt="GridPaw cat mascot" width="40" height="40" /></span>
        <span class="brand-name">
          <span class="big">GridPaw</span>
          <span class="small">Puzzle games for cat lovers</span>
        </span>
      </a>
      <nav class="nav" aria-label="Main navigation">
        <a href="/">Play</a>
        <a href="/akari/">Akari</a>
        <a href="/pictomino/">Pictomino</a>
      </nav>
    </div>
  </header>

  <main class="page">
    <div class="card" id="card" role="status" aria-live="polite">
      <!-- 初始占位：JS 根据 URL token 决定展示表单 / 错误态 -->
      <div class="loading">🐾 Loading…</div>
    </div>
  </main>

  <style is:global>
    body { margin: 0; background: #FFF9F0; font-family: Arial, Helvetica, sans-serif; }
    .site-header { background: rgba(255,255,255,0.95); backdrop-filter: blur(8px); border-bottom: 1px solid #f4dfdc; position: sticky; top: 0; z-index: 100; }
    .header-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1.5rem; }
    .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
    .brand-logo img { border-radius: 0.5rem; }
    .brand-name .big { display: block; font-weight: 900; font-size: 1.15rem; color: #342421; line-height: 1.1; }
    .brand-name .small { display: block; font-size: 0.7rem; color: #9b726c; font-weight: 600; }
    .nav { display: flex; gap: 1.25rem; }
    .nav a { font-size: 0.85rem; font-weight: 700; color: #6f5651; text-decoration: none; transition: color 0.15s; }
    .nav a:hover { color: #342421; }
    .page { max-width: 480px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
    .card { background: #fff; border: 1px solid #f4dfdc; border-radius: 18px; box-shadow: 0 8px 24px rgba(52,36,33,0.08); padding: 2rem 1.75rem; text-align: center; }
    .loading { color: #9b726c; font-size: 1rem; padding: 1rem 0; }
    .card .emoji { font-size: 2.6rem; display: block; margin-bottom: 0.5rem; }
    .card h1 { font-size: 1.45rem; font-weight: 900; color: #342421; margin: 0 0 0.5rem; }
    .card p.sub { color: #6f5651; font-size: 0.95rem; line-height: 1.6; margin: 0 0 1.25rem; }
    .card .err-text { color: #b0524a; font-size: 0.9rem; line-height: 1.6; margin: 0 0 1.25rem; }
    .card .ok-text { color: #4d7c57; font-size: 0.95rem; font-weight: 700; line-height: 1.6; margin: 0 0 1.25rem; }
    .card label { display: block; text-align: left; font-size: 0.8rem; font-weight: 800; color: #342421; margin: 0 0 0.3rem; }
    .card input { width: 100%; box-sizing: border-box; border: 1.5px solid #eadfd3; border-radius: 10px; padding: 0.65rem 0.75rem; font-size: 0.95rem; color: #342421; margin-bottom: 0.9rem; outline: none; }
    .card input:focus { border-color: #E8A888; }
    .card input.invalid { border-color: #d47a50; }
    .card .hint { font-size: 0.75rem; color: #9b726c; margin: -0.5rem 0 0.9rem; text-align: left; }
    .btn { display: inline-block; width: 100%; box-sizing: border-box; border: none; border-radius: 12px; background: linear-gradient(135deg, #E8A888, #D47A50); color: #fff; font-size: 1rem; font-weight: 800; padding: 0.8rem 1.5rem; cursor: pointer; font-family: inherit; transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease; box-shadow: 0 4px 16px rgba(232,168,136,0.3); }
    .btn:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(232,168,136,0.4); }
    .btn:disabled { opacity: 0.6; cursor: default; transform: none; }
    .btn.ghost { background: #fff; color: #6f5651; border: 1.5px solid #eadfd3; box-shadow: none; margin-top: 0.6rem; }
    .btn.ghost:hover { background: #fff8f0; }
    .card a.back { display: inline-block; margin-top: 1.1rem; color: #9b726c; font-size: 0.8rem; text-decoration: underline; }
    @media (max-width: 640px) {
      .header-inner { flex-direction: column; gap: 0.5rem; }
      .page { padding: 2rem 1rem 4rem; }
      .card { padding: 1.5rem 1.25rem; }
    }
  </style>

  <script>
    (function () {
      var card = document.getElementById('card');
      // 红色警示块
      function showError(title, msg) {
        card.innerHTML = '';
        var emoji = document.createElement('span'); emoji.className = 'emoji'; emoji.textContent = '😿';
        var h = document.createElement('h1'); h.textContent = title;
        var p = document.createElement('p'); p.className = 'err-text'; p.textContent = msg;
        var back = document.createElement('a'); back.className = 'back'; back.href = '/'; back.textContent = '← Back to GridPaw';
        card.appendChild(emoji); card.appendChild(h); card.appendChild(p); card.appendChild(back);
      }
      // 绿色成功块
      function showSuccess() {
        card.innerHTML = '';
        var emoji = document.createElement('span'); emoji.className = 'emoji'; emoji.textContent = '🎉';
        var h = document.createElement('h1'); h.textContent = 'Password updated!';
        var p = document.createElement('p'); p.className = 'ok-text'; p.textContent = 'You\u2019re signed in. Taking you back to the game\u2026';
        card.appendChild(emoji); card.appendChild(h); card.appendChild(p);
        setTimeout(function () { window.location.href = '/'; }, 1200);
      }
      function buildForm(token) {
        card.innerHTML = '';
        var emoji = document.createElement('span'); emoji.className = 'emoji'; emoji.textContent = '🔑';
        var h = document.createElement('h1'); h.textContent = 'Choose a new password';
        var p = document.createElement('p'); p.className = 'sub'; p.textContent = 'Make it at least 8 characters — something you won\u2019t forget!';
        card.appendChild(emoji); card.appendChild(h); card.appendChild(p);

        var lbl1 = document.createElement('label'); lbl1.textContent = 'New password'; lbl1.htmlFor = 'pw1';
        var pw1 = document.createElement('input'); pw1.id = 'pw1'; pw1.type = 'password'; pw1.autocomplete = 'new-password'; pw1.required = true; pw1.minLength = 8;
        var lbl2 = document.createElement('label'); lbl2.textContent = 'Type it again'; lbl2.htmlFor = 'pw2';
        var pw2 = document.createElement('input'); pw2.id = 'pw2'; pw2.type = 'password'; pw2.autocomplete = 'new-password'; pw2.required = true; pw2.minLength = 8;
        var hint = document.createElement('div'); hint.className = 'hint'; hint.textContent = 'Min 8 characters · max 128';
        var btn = document.createElement('button'); btn.className = 'btn'; btn.type = 'submit'; btn.textContent = 'Save new password';

        var form = document.createElement('form'); form.style.margin = '0';
        form.appendChild(lbl1); form.appendChild(pw1);
        form.appendChild(lbl2); form.appendChild(pw2);
        form.appendChild(hint); form.appendChild(btn);
        form.addEventListener('submit', function (ev) {
          ev.preventDefault();
          var a = pw1.value, b = pw2.value;
          if (a.length < 8 || a.length > 128) { pw1.focus(); pw1.classList.add('invalid'); return; }
          if (a !== b) { pw2.value = ''; pw2.focus(); pw2.classList.add('invalid'); hint.textContent = 'Passwords don\u2019t match — try again.'; hint.style.color = '#b0524a'; return; }
          btn.disabled = true; btn.textContent = 'Saving\u2026';
          var ctrl = new AbortController();
          var t = setTimeout(function () { ctrl.abort(); }, 8000);
          fetch('/api/auth/reset-password', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ token: token, password: a }),
            signal: ctrl.signal
          }).then(function (r) { return r.json(); }).then(function (j) {
            if (j && j.ok) { showSuccess(); }
            else if (j && j.error === 'invalid_token') { showError('This link no longer works', 'It may have already been used or expired. You can ask for a fresh link on the sign-in page.'); }
            else if (j && j.error === 'weak_password') { pw1.classList.add('invalid'); btn.disabled = false; btn.textContent = 'Save new password'; hint.textContent = 'Password must be 8–128 characters.'; hint.style.color = '#b0524a'; }
            else { btn.disabled = false; btn.textContent = 'Save new password'; }
          }).catch(function () {
            btn.disabled = false; btn.textContent = 'Save new password';
            showError('Something went wrong', 'We couldn\u2019t reach the server. Please try again in a moment.');
          }).finally(function () { clearTimeout(t); });
        });
        card.appendChild(form);
      }

      var params = new URLSearchParams(window.location.search);
      var token = params.get('token') || '';
      if (token.length < 32) {
        showError('This link is incomplete', 'The reset link is missing its token. Please use the exact link from your email, or ask for a new one on the sign-in page.');
      } else {
        buildForm(token);
      }
    })();
  </script>
</body>
</html>
