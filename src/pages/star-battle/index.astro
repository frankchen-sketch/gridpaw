          var u = me && me.user ? me.user : null;
          isAdmin = !!(u && u.googleSub && ADMIN_GOOGLE_SUBS.indexOf(u.googleSub) !== -1);
          updateHintBtn();
        }).catch(function () {});
      } catch (e) {}

      // ── Dev 检测：is:inline 脚本不经 Vite，import.meta 会抛 SyntaxError，
      //    用 localhost 主机名等价判定 import.meta.env.DEV（生产域永远 false）──
      var IS_DEV = /^(localhost|127\.0\.0\.1|\[::1\])/.test(location.hostname);

      // ── GA4 track()（与 kenken 同款；gpTrack 转发行是硬性要求）──
      function track(event, params) {
        if (window.gpTrack) window.gpTrack(event, params || {});
        if (typeof window.gtag === 'function') {
          var gtagParams = {};
          Object.keys(params || {}).forEach(function (k) {
            if (k === 'source') gtagParams['trigger'] = params[k];
            else if (k === 'medium') gtagParams['evt_medium'] = params[k];
            else if (k === 'campaign') gtagParams['evt_campaign'] = params[k];
            else gtagParams[k] = params[k];
          });
          window.gtag('event', event, gtagParams);
        }
        if (window.posthog && typeof window.posthog.capture === 'function') {
          window.posthog.capture(event, Object.assign({ site: 'gridpaw' }, params || {}));
        }
        if (typeof window.clarity === 'function') {
          window.clarity('event', event);
          if (params) Object.keys(params).forEach(function (k) { window.clarity('set', k, String(params[k])); });
        }
      }

      // ── Traffic source ──
      function detectSource() {
        var p = new URLSearchParams(location.search);
        if (p.get('embed')) return 'embed';
        if (p.get('daily')) return 'daily';
        var ref = document.referrer || '';
        if (!ref) return 'direct';
        if (ref.indexOf(location.hostname) !== -1) return 'internal';
        if (ref.indexOf('google') !== -1) return 'google';
        return 'referral';
      }

      // ── Puzzle state ──
      var DIFFS = { easy: { size: 8, stars: 2, label: 'Easy', badge: 'badge-easy', full: 'Easy 8×8' },
                    medium: { size: 10, stars: 2, label: 'Medium', badge: 'badge-medium', full: 'Medium 10×10' },
                    hard: { size: 12, stars: 2, label: 'Hard', badge: 'badge-hard', full: 'Hard 12×12' } };
      var state = {
        difficulty: 'easy',
        puzzle: null,
        board: null,      // Int8Array, -1 = unknown, 0 = empty (hinted), 1 = star
        locked: null,     // Uint8Array, 1 = revealed by hint (star or empty), not editable
        sel: -1,
        hintsLeft: 3,
        winShown: false,
        timerSec: 0,
        timerId: 0,
        genToken: 0       // stale-generation guard
      };

      // 星星 = paw SVG（非 emoji 猫）
      var STAR_SVG = '<svg class="sb-star" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="currentColor"><ellipse cx="7.3" cy="8.4" rx="2.3" ry="2.7"/><ellipse cx="12" cy="6.2" rx="2.45" ry="2.75"/><ellipse cx="16.7" cy="8.4" rx="2.3" ry="2.7"/><ellipse cx="5.2" cy="12.6" rx="1.85" ry="2.15"/><path d="M6.6 14.4c.6-1.2 3.2-2 5.4-2s4.8.8 5.4 2c.7 1.4.5 3.3-1.3 4.1-1.2.6-8.4.6-9.6 0-1.8-.8-2-2.7-1.3-4.1Z"/></g></svg>';

      function toast(msg, type) {
        toastEl.textContent = msg;
        toastEl.className = 'toast' + (type ? ' ' + type : '');
        setTimeout(function () { toastEl.classList.remove('show'); }, 2600);
        requestAnimationFrame(function () { toastEl.classList.add('show'); });
      }

      function fmtTime(s) {
        var m = Math.floor(s / 60), ss = s % 60;
        return m + ':' + (ss < 10 ? '0' : '') + ss;
      }

      function startTimer() {
        if (state.timerId) clearInterval(state.timerId);
        state.timerSec = 0;
        timerEl.textContent = '0:00';
        state.timerId = setInterval(function () {
          state.timerSec++;
          timerEl.textContent = fmtTime(state.timerSec);
        }, 1000);
      }

      function stopTimer() {
        if (state.timerId) { clearInterval(state.timerId); state.timerId = 0; }
      }

      // ── Generation（hard 可能耗时数秒：先显示 loading，再 setTimeout 让 spinner 渲染）──
      function newPuzzle(difficulty) {
        var d = DIFFS[difficulty];
        state.difficulty = difficulty;
        state.sel = -1;
        state.winShown = false;
        closeWin();
        updateDiffUI(d);
        var showLoad = difficulty === 'hard';
        if (showLoad) setLoading(true);
        var token = ++state.genToken;
        setTimeout(function () {
          var p = null;
          // up to 3 tries with an 8s budget each — seed# misses happen (~1/3 hit
          // rate on hard), but a fresh seed converges fast; user sees loading.
          for (var tryN = 0; tryN < 3 && !p; tryN++) {
            var seed = (Date.now() ^ ((Math.random() * 0x7fffffff) | 0)) | 0;
            try {
              p = StarBattleEngine.generate(d.size, d.stars, difficulty, seed, 8000);
            } catch (e) { /* next seed */ }
          }
          if (!p) {
            if (state.genToken !== token) return;
            setLoading(false);
            toast('Could not breed this puzzle — try again.', 'error');
            return;
          }
          if (state.genToken !== token) return;
          state.puzzle = p;
          state.board = new Int8Array(d.size * d.size).fill(-1);
          state.locked = new Uint8Array(d.size * d.size);
          state.hintsLeft = 3;
          state.winShown = false;
          updateHintBtn();
          renderBoard();
          startTimer();
          fireGameStart();
          updateCellSize();
          setLoading(false);
        }, showLoad ? 30 : 0);
      }

      function setLoading(on) {
        if (on) {
          loadingEl.hidden = false;
          var btns = document.querySelectorAll('.diff-btn');
          for (var i = 0; i < btns.length; i++) btns[i].setAttribute('disabled', 'disabled');
        } else {
          loadingEl.hidden = true;
          var btns2 = document.querySelectorAll('.diff-btn');
          for (var j = 0; j < btns2.length; j++) {
            // preserve statically-disabled buttons (hard = coming soon)
            if (btns2[j].getAttribute('data-diff') === 'hard') continue;
            btns2[j].removeAttribute('disabled');
          }
        }
      }

      function updateDiffUI(d) {
        diffBadge.className = 'difficulty-badge ' + d.badge;
        diffBadge.textContent = d.full;
        difficultyNameEl.textContent = d.label;
        var diffBtns = document.querySelectorAll('.diff-btn');
        for (var b = 0; b < diffBtns.length; b++) {
          var on = diffBtns[b].getAttribute('data-diff') === state.difficulty;
          diffBtns[b].classList.toggle('active', on);
          diffBtns[b].setAttribute('aria-pressed', on ? 'true' : 'false');
        }
      }

      var gaFiredOnce = false;
      function fireGameStart() {
        if (gaFiredOnce) return;
        gaFiredOnce = true;
        track('game_start', { difficulty: DIFFS[state.difficulty].label, source: detectSource() });
      }

      // ── Cell sizing ──
      function updateCellSize() {
        var N = state.puzzle.size;
        var avail = Math.min(window.innerWidth - 24, 640);
        var cell = Math.max(26, Math.min(64, Math.floor((avail - 4) / N), Math.floor((window.innerHeight - 360) / N)));
        wrapEl.style.setProperty('--cell', cell + 'px');
        cellsEl.style.gridTemplateColumns = 'repeat(' + N + ', var(--cell))';
      }

      // ── Board render ──
      function renderBoard() {
        var N = state.puzzle.size, N2 = N * N;
        var K = state.puzzle.starsPerUnit;
        var regionOf = state.puzzle.regionOf;
        // 计数：行 / 列 / 区域（用于超量标红）
        var rowCnt = new Int32Array(N), colCnt = new Int32Array(N), regCnt = new Int32Array(state.puzzle.regionCount);
        for (var i = 0; i < N2; i++) {
          if (state.board[i] !== 1) continue;
          rowCnt[Math.floor(i / N)]++; colCnt[i % N]++; regCnt[regionOf[i]]++;
        }
        var html = '';
        for (var r = 0; r < N; r++) {
          for (var c = 0; c < N; c++) {
            var idx = r * N + c;
            var v = state.board[idx];
            var cls = 'sb-cell t' + (regionOf[idx] % 8);
            var style = '';
            if (c < N - 1) style += 'border-right:1px solid var(--gp-linen);';
            if (r < N - 1) style += 'border-bottom:1px solid var(--gp-linen);';
            if (state.locked[idx]) {
              cls += v === 1 ? ' given' : ' empty-hint';
            }
            if (idx === state.sel) cls += ' sel';
            if (v === 1) {
              // 违规检查：no-touch（8 邻域）或行/列/区域超出 K
              var err = false;
              for (var dr = -1; dr <= 1 && !err; dr++) {
                for (var dc = -1; dc <= 1; dc++) {
                  if (!dr && !dc) continue;
                  var rr = r + dr, cc2 = c + dc;
                  if (rr >= 0 && rr < N && cc2 >= 0 && cc2 < N && state.board[rr * N + cc2] === 1) { err = true; break; }
                }
              }
              if (!err && (rowCnt[r] > K || colCnt[c] > K || regCnt[regionOf[idx]] > K)) err = true;
              if (err) cls += ' err';
            }
            var inner = '';
            if (v === 1) inner = STAR_SVG;
            else if (v === 0 && state.locked[idx]) inner = '<span class="sb-empty-mark"></span>';
            html += '<div class="' + cls + '" data-i="' + idx + '" role="gridcell" style="' + style + '">' + inner + '</div>';
          }
        }
        cellsEl.innerHTML = html;

        // 区域粗线：不同 region 的相邻格之间画 5px 边（grid 对齐，同 kenken cage 观感）
        var lines = '';
        for (var rr = 0; rr < N; rr++) {
          for (var cc = 0; cc < N; cc++) {
            var ii = rr * N + cc;
            if (cc < N - 1 && regionOf[ii] !== regionOf[ii + 1]) {
              lines += '<line x1="' + ((cc + 1) / N) + '" y1="' + (rr / N) + '" x2="' + ((cc + 1) / N) + '" y2="' + ((rr + 1) / N) + '"/>';
            }
            if (rr < N - 1 && regionOf[ii] !== regionOf[ii + N]) {
              lines += '<line x1="' + (cc / N) + '" y1="' + ((rr + 1) / N) + '" x2="' + ((cc + 1) / N) + '" y2="' + ((rr + 1) / N) + '"/>';
            }
          }
        }
        svgEl.innerHTML = lines;
        updateStarCount();
      }

      function updateStarCount() {
        if (!state.puzzle) return;
        var N = state.puzzle.size, K = state.puzzle.starsPerUnit, cnt = 0;
        for (var i = 0; i < N * N; i++) if (state.board[i] === 1) cnt++;
        starCountEl.textContent = '⭐ ' + cnt + ' / ' + (K * N);
      }

      // ── Hint（3 次/盘；dev/admin 无限）──
      function unlimitedHints() { return IS_DEV || isAdmin; }

      function updateHintBtn() {
        var unlimited = unlimitedHints();
        hintCountEl.textContent = unlimited ? '(∞)' : '(' + state.hintsLeft + ')';
        var empty = !unlimited && state.hintsLeft <= 0;
        hintBtn.classList.toggle('disabled', empty);
        hintBtn.setAttribute('aria-disabled', empty ? 'true' : 'false');
      }

      function useHint() {
        if (state.sel === -1) { toast('Select a cell first!'); return; }
        if (state.locked[state.sel]) { toast('That cell is already revealed.'); return; }
        if (!unlimitedHints()) {
          if (state.hintsLeft <= 0) {
            toast('No hints left — a new puzzle gives you 3 fresh hints', 'error');
            return;
          }
          state.hintsLeft--;
        }
        var val = StarBattleEngine.hintLookup(state.puzzle, state.sel);
        state.board[state.sel] = val;      // 1 = star, 0 = empty（锁定）
        state.locked[state.sel] = 1;
        track('hint_click', { level: state.puzzle.size, difficulty: DIFFS[state.difficulty].label });
        updateHintBtn();
        renderBoard();
        maybeWin();
      }

      // ── Toggle ──
      function toggleCell(i) {
        if (state.locked[i]) return;
        state.board[i] = state.board[i] === 1 ? -1 : 1;
        renderBoard();
        maybeWin();
      }

      // ── Win detection ──
      function maybeWin() {
        if (state.winShown || !state.puzzle) return;
        var N = state.puzzle.size, K = state.puzzle.starsPerUnit;
        var cnt = 0;
        for (var i = 0; i < N * N; i++) if (state.board[i] === 1) cnt++;
        if (cnt !== K * N) return;  // 星星数没放满不放赢
        var res = StarBattleEngine.validate(state.puzzle, state.board); // -1 视为空，语义正确
        if (!res.ok) {
          toast('Not quite — ' + res.errors.length + ' rule' + (res.errors.length === 1 ? '' : 's') + ' still broken', 'error');
          return;
        }
        showWin();
      }

      function showWin() {
        state.winShown = true;
        stopTimer();
        winDetailEl.textContent = state.puzzle.size + '×' + state.puzzle.size + ' ' + DIFFS[state.difficulty].label + ' solved in ' + fmtTime(state.timerSec) + '!';
        winOverlay.classList.add('show');
        launchConfetti();
        // leaderboard：上报成绩 + 胜利面板当日榜
        if (window.GPLeaderboard) {
          GPLeaderboard.submit('star-battle', state.timerSec * 1000).then(function () {
            return GPLeaderboard.mount('star-battle', document.getElementById('gp-lb-win'));
          });
        }
        track('level_up', { level: state.puzzle.size, difficulty: DIFFS[state.difficulty].label, size: state.puzzle.size });
      }

      function launchConfetti() {
        if (!confettiEl) return;
        confettiEl.innerHTML = '';
        var colors = ['#E8A888', '#88C8A8', '#FDD09F', '#CFC2E8', '#D47A50', '#559C68', '#FFB3C6'];
        for (var i = 0; i < 60; i++) {
          var d = document.createElement('div');
          d.className = 'confetti';
          d.style.left = (Math.random() * 100) + '%';
          d.style.top = '-10px';
          d.style.background = colors[i % colors.length];
          d.style.animationDuration = (2.2 + Math.random() * 2) + 's';
          d.style.animationDelay = (Math.random() * 0.9) + 's';
          d.style.width = d.style.height = (6 + Math.random() * 8) + 'px';
          confettiEl.appendChild(d);
        }
      }

      function closeWin() { winOverlay.classList.remove('show'); }

      // ── 分享 ──
      function shareText() {
        return 'I solved a ' + state.puzzle.size + '×' + state.puzzle.size + ' ' + DIFFS[state.difficulty].label + ' Star Battle (Two Not Touch) puzzle on GridPaw in ' + fmtTime(state.timerSec) + '! No two stars may touch. Play free → https://gridpaw.com/star-battle/';
      }

      // ── Events：点击 / 拖拽 ──
      // pointerdown 承担 toggle（鼠标拖拽起点），click 兜底触屏 tap；
      // lastTog 去重，防止 pointerdown + click 双触发。
      var lastTog = { i: -1, t: 0 };
      var dragging = false;

      cellsEl.addEventListener('pointerdown', function (e) {
        var cell = e.target.closest('.sb-cell');
        if (!cell) return;
        var i = parseInt(cell.getAttribute('data-i'), 10);
        if (e.pointerType === 'mouse') {
          dragging = true;
          try { cell.setPointerCapture(e.pointerId); } catch (err) {}
        }
        state.sel = i;
        lastTog = { i: i, t: Date.now() };
        toggleCell(i);
      });

      cellsEl.addEventListener('pointermove', function (e) {
        if (!dragging || !state.puzzle) return;
        var tgt = document.elementFromPoint(e.clientX, e.clientY);
        var cell = tgt && tgt.closest ? tgt.closest('.sb-cell') : null;
        if (!cell) return;
        var i = parseInt(cell.getAttribute('data-i'), 10);
        if (i !== state.sel) {
          state.sel = i;
          lastTog = { i: i, t: Date.now() };
          toggleCell(i);
        }
      });

      cellsEl.addEventListener('click', function (e) {
        var cell = e.target.closest('.sb-cell');
        if (!cell) return;
        var i = parseInt(cell.getAttribute('data-i'), 10);
        if (i === lastTog.i && Date.now() - lastTog.t < 600) return;
        state.sel = i;
        toggleCell(i);
      });

      document.addEventListener('pointerup', function () { dragging = false; });
      document.addEventListener('pointercancel', function () { dragging = false; });

      // ── Events：键盘（箭头移动 + Enter/Space 切换 + Backspace 清除）──
      document.addEventListener('keydown', function (e) {
        if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
        if (e.key === 'Escape') {
          if (winOverlay.classList.contains('show')) closeWin();
          else if (rulesOverlay.classList.contains('show')) rulesOverlay.classList.remove('show');
          return;
        }
        if (winOverlay.classList.contains('show') || rulesOverlay.classList.contains('show')) return;
        if (!state.puzzle) return;
        var N = state.puzzle.size;
        if (e.key === 'Enter' || e.key === ' ') {
          if (state.sel !== -1) { e.preventDefault(); toggleCell(state.sel); }
          return;
        }
        if (e.key === 'Backspace' || e.key === 'Delete') {
          if (state.sel !== -1) { e.preventDefault(); toggleCell(state.sel); }
          return;
        }
        var dir = { ArrowUp: -N, ArrowDown: N, ArrowLeft: -1, ArrowRight: 1 }[e.key];
        if (dir !== undefined) {
          e.preventDefault();
          if (state.sel !== -1) {
            var r = Math.floor(state.sel / N), c = state.sel % N;
            if (e.key === 'ArrowLeft' && c > 0) state.sel += dir;
            else if (e.key === 'ArrowRight' && c < N - 1) state.sel += dir;
            else if (e.key === 'ArrowUp' && r > 0) state.sel += dir;
            else if (e.key === 'ArrowDown' && r < N - 1) state.sel += dir;
            renderBoard();
          }
          return;
        }
      });

      hintBtn.addEventListener('click', useHint);

      document.getElementById('new-btn').addEventListener('click', function () {
        newPuzzle(state.difficulty);
      });

      document.getElementById('reset-btn').addEventListener('click', function () {
        closeWin();
        if (!state.puzzle) return;
        for (var i = 0; i < state.board.length; i++) {
          if (!state.locked[i]) state.board[i] = -1;
        }
        state.sel = -1;
        track('puzzle_reset', { level: state.puzzle.size, difficulty: DIFFS[state.difficulty].label });
        renderBoard();
        startTimer();
      });

      document.getElementById('win-next').addEventListener('click', function () {
        closeWin();
        newPuzzle(state.difficulty);
      });

      document.getElementById('howto-chip').addEventListener('click', function () { rulesOverlay.classList.add('show'); });
      document.getElementById('rules-close').addEventListener('click', function () { rulesOverlay.classList.remove('show'); });
      rulesOverlay.addEventListener('click', function (e) { if (e.target === rulesOverlay) rulesOverlay.classList.remove('show'); });

      document.getElementById('share-copy').addEventListener('click', function () {
        track('share_copy', { level: state.puzzle.size, difficulty: DIFFS[state.difficulty].label });
        navigator.clipboard.writeText(shareText()).then(function () {
          toast('📋 Copied to clipboard!', 'success');
        }).catch(function () {
          var ta = document.createElement('textarea');
          ta.value = shareText();
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); toast('📋 Copied to clipboard!', 'success'); } catch (e2) {}
          document.body.removeChild(ta);
        });
      });

      document.getElementById('share-twitter').addEventListener('click', function () {
        track('share_twitter', { level: state.puzzle.size, difficulty: DIFFS[state.difficulty].label });
        // 带图分享：系统分享面板优先（附棋盘截图）；不可用回退 web intent
        GPShare.shareWithImage({
          boardEl: document.getElementById('sb-grid-wrap'),
          filename: 'gridpaw-star-battle.png',
          text: shareText(),
          url: 'https://gridpaw.com/star-battle/',
          fallback: function () {
            var url = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareText()) + '&url=' + encodeURIComponent('https://gridpaw.com/star-battle/');
            window.open(url, '_blank', 'noopener,width=620,height=480');
          }
        }).then(function (shared) { if (shared) track('share_image', { game: 'star-battle', via: 'system' }); });
      });

      document.getElementById('share-reddit').addEventListener('click', function () {
        track('share_reddit', { level: state.puzzle.size, difficulty: DIFFS[state.difficulty].label });
        var title = 'I solved a ' + state.puzzle.size + '×' + state.puzzle.size + ' ' + DIFFS[state.difficulty].label + ' Star Battle puzzle on GridPaw!';
        GPShare.shareWithImage({
          boardEl: document.getElementById('sb-grid-wrap'),
          filename: 'gridpaw-star-battle.png',
          text: title,
          url: 'https://gridpaw.com/star-battle/',
          fallback: function () {
            var url = 'https://www.reddit.com/submit?url=' + encodeURIComponent('https://gridpaw.com/star-battle/') + '&title=' + encodeURIComponent(title);
            window.open(url, '_blank', 'noopener,width=680,height=520');
          }
        }).then(function (shared) { if (shared) track('share_image', { game: 'star-battle', via: 'system' }); });
      });

      // ── 难度切换 ──
      var diffBtns = document.querySelectorAll('.diff-btn');
      for (var b = 0; b < diffBtns.length; b++) {
        diffBtns[b].addEventListener('click', function () {
          if (this.getAttribute('data-diff') === state.difficulty) return;
          closeWin();
          newPuzzle(this.getAttribute('data-diff'));
        });
      }

      // ── Mobile nav ──
      document.getElementById('mobile-menu-btn').addEventListener('click', function () {
        document.getElementById('mobile-nav').style.display = 'block';
      });
      document.getElementById('mobile-nav-close').addEventListener('click', function () {
        document.getElementById('mobile-nav').style.display = 'none';
      });
      document.getElementById('mobile-nav').addEventListener('click', function (e) {
        if (e.target === this) this.style.display = 'none';
      });

      // ── 窗口尺寸变化时重算格子大小（--cell 是 wrapper 上的变量，自动生效）──
      window.addEventListener('resize', function () { updateCellSize(); });

      // ── Start ──
      newPuzzle('easy');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

</body>
</html>