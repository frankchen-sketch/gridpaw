---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import SideAd from '../../components/SideAd.astro';
import { allDives, fmt, shortDate, totalListed, diveTag } from '../../lib/krillion';

const byYear = new Map<number, typeof allDives>();
for (const d of allDives) {
  const y = Number(d.date.slice(0, 4));
  const arr = byYear.get(y) ?? [];
  arr.push(d);
  byYear.set(y, arr);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const newest = allDives[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead
      title="Krillion Answers Archive — Every Dive We've Catalogued"
      description={`Browse ${allDives.length} archived Krillion Dives with ${allDives.reduce(
        (n, d) => n + totalListed(d),
        0,
      )} catalogued answers. Every day's seven prompts, with rarity tiers and real player counts.`}
      canonical="/krillion-answers/archive/"
      breadcrumbTitle="Archive"
      segmentNames={{ 'krillion-answers': 'Krillion Answers' }}
    />
    <link rel="alternate" hreflang="en" href="https://gridpaw.com/krillion-answers/archive/" />
    <link rel="alternate" hreflang="x-default" href="https://gridpaw.com/krillion-answers/archive/" />
    <style is:global>
      :root {
        --amber: #d97706;
        --amber-ink: #a35700;
        --cream: #fffbf5;
        --ink: #2a1e12;
        --paper: #ffffff;
        --line: #eadbc8;
        --sand: #f5ebdd;
        --muted: #7a6a58;
      }
      body {
        margin: 0;
        background: var(--cream);
        color: var(--ink);
        font-family: Nunito, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        font-size: 17px;
        line-height: 1.62;
      }
      .wrap {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 20px 64px;
      }
      .kr-crumb {
        font-size: 13px;
        color: var(--muted);
        padding: 18px 0 6px;
      }
      .kr-crumb a {
        color: var(--amber-ink);
        text-decoration: none;
      }
      .kr-h1 {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: clamp(28px, 4.6vw, 38px);
        line-height: 1.18;
        margin: 6px 0 8px;
      }
      .kr-lede {
        font-size: 15px;
        color: var(--muted);
        margin: 0 0 20px;
      }
      .kr-lede b {
        color: var(--ink);
      }
      .yearblock {
        margin-top: 26px;
      }
      .yearblock h2 {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 22px;
        margin: 0 0 10px;
        color: var(--amber-ink);
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 8px;
      }
      .grid a {
        display: block;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: var(--paper);
        text-decoration: none;
        color: var(--ink);
        font-size: 14.5px;
      }
      .grid a:hover {
        border-color: var(--amber);
        background: var(--sand);
      }
      .grid a small {
        display: block;
        color: var(--muted);
        font-size: 11.5px;
        margin-top: 1px;
      }
      .cta {
        margin-top: 28px;
      }
      .cta a {
        display: inline-block;
        padding: 12px 18px;
        border-radius: 10px;
        background: var(--amber);
        color: var(--ink);
        text-decoration: none;
        font-weight: 700;
        font-size: 15px;
      }
      .cta a:hover {
        background: #c96a05;
      }
    </style>
  </head>
  <body>
    <GameNav />
    <main class="wrap">
      <nav class="kr-crumb" aria-label="Breadcrumb">
        <a href="/">GridPaw</a> › <a href="/krillion-answers/">Krillion Answers</a> ›
        <span>Archive</span>
      </nav>

      <h1 class="kr-h1">Krillion Answers Archive</h1>
      <p class="kr-lede">
        <b>{allDives.length}</b> Dives catalogued · <b>{allDives.reduce((n, d) => n + totalListed(d), 0)}</b>
        answers recorded · newest first
      </p>

      {years.map((y) => (
        <section class="yearblock">
          <h2>{y}</h2>
          <div class="grid">
            {byYear.get(y)!.map((d) => (
              <a href={`/krillion-answers/${d.date}/`}>
                {shortDate(d.date)}
                <small>
                  {diveTag(d) || 'Dive'} · {totalListed(d)} answers
                </small>
              </a>
            ))}
          </div>
        </section>
      ))}

      <div class="cta">
        <a href="/krillion-answers/">Today's {diveTag(newest) || 'Dive'} answers →</a>
      </div>
    </main>
    <SideAd />
  </body>
</html>
