---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import SideAd from '../../components/SideAd.astro';
import InContentAd from '../../components/InContentAd.astro';
import {
  latestDive,
  allDives,
  fmt,
  longDate,
  shortDate,
  diveNo,
  diveTag,
  totalListed,
  totalSubmitted,
  type Prompt,
} from '../../lib/krillion';

const dive = latestDive!;
const dtag = diveTag(dive);

// H1 恒为 "Today"（b 版设计），数据期号与日期在 kicker 里明示，避免正文撒谎
const h1Accent = 'Today';

const submitted = totalSubmitted(dive);
const minAcc = Math.min(...dive.prompts.map((p) => p.accepted));
const maxAcc = Math.max(...dive.prompts.map((p) => p.accepted));

const compact = (n: number) => {
  if (n >= 1e9) return (n / 1e9).toFixed(1).replace(/\.0$/, '') + 'B';
  if (n >= 1e6) return (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
  if (n >= 1e3) return Math.round(n / 1e3) + 'K';
  return String(n);
};

const resetsIn = (() => {
  if (!dive.resetsAt) return 'daily';
  const ms = new Date(dive.resetsAt).getTime() - Date.now();
  if (ms <= 0) return 'soon';
  const h = Math.floor(ms / 3_600_000);
  const m = Math.floor((ms % 3_600_000) / 60_000);
  return h > 0 ? `${h}h ${m}m` : `${m}m`;
})();

const TIERS = [
  { key: 'plank', label: 'Plankton', pts: 10 },
  { key: 'school', label: 'Schooler', pts: 30 },
  { key: 'rare', label: 'Rare', pts: 60 },
  { key: 'deep', label: 'Deep Cut', pts: 85 },
  { key: 'one', label: 'One in a Krillion', pts: 100 },
] as const;

function tiersOf(p: Prompt) {
  return TIERS.map((t) => {
    if (t.key === 'one')
      return {
        ...t,
        items: p.one.map((a) => ({ name: a.a, note: a.players ? fmt(a.players) : '' })),
        more: 0,
      };
    if (t.key === 'deep')
      return {
        ...t,
        items: p.deep.map((a) => ({ name: a.a, note: a.players ? fmt(a.players) : '' })),
        more: Math.max(0, (p.deepCuts || 0) - p.deep.length),
      };
    const want = t.key === 'plank' ? 'Plankton' : t.key === 'school' ? 'Schooler' : 'Rare';
    return {
      ...t,
      items: p.crowd.filter((a) => a.tier === want).map((a) => ({ name: a.a, note: a.pct ? `${a.pct}%` : '' })),
      more: 0,
    };
  }).filter((t) => t.items.length > 0);
}

const rarest = dive.prompts
  .filter((p) => p.one.length)
  .map((p) => ({ a: p.one[0].a, q: p.prompt }));

const faqs = [
  {
    q: 'What is Krillion?',
    a: 'Krillion is a free daily browser game. Everyone gets the same 7 prompts, each with a 25-second timer. Obvious answers score low; rare-but-valid answers score high. A perfect dive is 700 points.',
  },
  {
    q: 'How are the rarity tiers scored?',
    a: 'Plankton 10 · Schooler 30 · Rare 60 · Deep Cut 85 · One in a Krillion 100. The game scores answers against a familiarity database plus editorial review, so the same answer always gets the same tier.',
  },
  {
    q: 'When does Krillion reset?',
    a: `The Daily Dive rolls over at 05:00 UTC (13:00 Beijing). This page is rebuilt after each reset — the newest Dive fully catalogued here is ${dtag || 'this one'} on ${longDate(dive.date)}.`,
  },
  {
    q: 'Why are only some accepted answers listed?',
    a: `A prompt can accept anywhere from ${fmt(minAcc)} to ${fmt(maxAcc)} answers. The full list is revealed inside the game and the official archive of past answers requires a one-off unlock, so we document the answers that change your score: the top tier, Deep Cuts, and the crowd favourites.`,
  },
  {
    q: 'Is this the official Krillion site?',
    a: 'No. GridPaw is independent and not affiliated with krillion.io. This is an answer archive for players who want to check a score or see what they missed. The game itself lives at krillion.io.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const archDays = allDives.slice(1, 9);
const bankData = (() => {
  const out: Array<{ n: string; t: string; pts: number; tier: string; q: string; i: number; url: string }> = [];
  const NAME: Record<string, string> = {
    one: 'One in a Krillion',
    deep: 'Deep Cut',
    rare: 'Rare',
    school: 'Schooler',
    plank: 'Plankton',
  };
  const PT: Record<string, number> = { one: 100, deep: 85, rare: 60, school: 30, plank: 10 };
  for (const p of dive.prompts) {
    const push = (name: string, t: string) =>
      out.push({
        n: name.toLowerCase(),
        t,
        pts: PT[t],
        tier: NAME[t],
        q: p.prompt,
        i: p.n,
        url: `/krillion-answers/q/${p.slug}/`,
      });
    for (const a of p.one) push(a.a, 'one');
    for (const a of p.deep) push(a.a, 'deep');
    for (const a of p.crowd) {
      const t = a.tier === 'Plankton' ? 'plank' : a.tier === 'Schooler' ? 'school' : a.tier === 'Rare' ? 'rare' : null;
      if (t) push(a.a, t);
    }
  }
  return out;
})();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead
      title={`Krillion Answers Today: ${dtag || 'Latest Dive'} (${shortDate(dive.date)})`}
      description={`All ${dive.promptCount} prompts from Krillion ${dtag || 'Dive'} with ${totalListed(dive)} catalogued answers sorted by rarity tier — check what your answer would have scored.`}
      canonical="/krillion-answers/"
      type="article"
      breadcrumbTitle="Krillion Answers"
      segmentNames={{ 'krillion-answers': 'Krillion Answers' }}
    />
    <link rel="alternate" hreflang="en" href="https://gridpaw.com/krillion-answers/" />
    <link rel="alternate" hreflang="x-default" href="https://gridpaw.com/krillion-answers/" />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <style is:global>
      /* ===== b 版设计稿原样：调色板与字体栈（勿改）===== */
      :root {
        --amber: #d97706;
        --amber-ink: #a35700;
        --cream: #fffbf5;
        --ink: #2a1e12;
        --paper: #ffffff;
        --line: #eadbc8;
        --sand: #f5e6cc;
        --ember: #4a2e14;
        --muted: rgba(42, 30, 18, 0.68);

        --serif: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Palatino, 'URW Palladio L', Georgia,
          serif;
        --sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;

        --f11: 11px;
        --f13: 13px;
        --f15: 15px;
        --f17: 17px;
        --f20: 20px;
        --f28: 28px;
        --f48: 48px;
      }
      * {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background: var(--cream);
        color: var(--ink);
        font-family: var(--sans);
        font-size: var(--f17);
        line-height: 1.55;
        font-variant-numeric: tabular-nums;
      }
      a {
        color: var(--amber-ink);
      }
      :focus-visible {
        outline: 2px solid var(--amber);
        outline-offset: 2px;
      }

      /* ================= HERO ================= */
      .hero {
        background: linear-gradient(180deg, var(--ink) 0%, var(--ink) 52%, var(--ember) 100%);
        color: var(--cream);
        padding: 28px 20px 0;
        border-bottom: 3px solid var(--amber);
      }
      .hero-in {
        max-width: 960px;
        margin: 0 auto;
      }
      .crumb {
        font-size: var(--f13);
        color: var(--line);
        margin-bottom: 28px;
      }
      .crumb a {
        color: var(--line);
        text-decoration: none;
        border-bottom: 1px solid var(--ember);
      }
      .crumb a:hover {
        color: var(--amber);
        border-color: var(--amber);
      }
      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 48px;
        align-items: end;
      }
      .kicker {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: var(--f11);
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--amber);
        margin-bottom: 14px;
      }
      .kicker::before {
        content: '';
        width: 28px;
        height: 2px;
        background: var(--amber);
      }
      .hero h1 {
        margin: 0 0 14px;
        font-family: var(--serif);
        font-size: var(--f48);
        line-height: 1.04;
        font-weight: 700;
        letter-spacing: -0.015em;
        color: var(--cream);
      }
      .hero h1 .num {
        color: var(--amber);
        font-style: italic;
      }
      .sub {
        margin: 0 0 26px;
        font-size: var(--f17);
        color: var(--line);
        max-width: 540px;
        line-height: 1.5;
      }

      /* finder — the primary action */
      .finder {
        background: var(--paper);
        color: var(--ink);
        border-radius: 14px 14px 0 0;
        padding: 22px 22px 20px;
        border-top: 4px solid var(--amber);
      }
      .finder h2 {
        margin: 0 0 4px;
        font-family: var(--serif);
        font-size: var(--f20);
        font-weight: 700;
      }
      .finder p {
        margin: 0 0 14px;
        font-size: var(--f15);
        color: var(--muted);
      }
      .frow {
        display: flex;
        gap: 0;
        flex-wrap: wrap;
        border: 2px solid var(--ink);
        border-radius: 10px;
        overflow: hidden;
        background: var(--paper);
      }
      .frow input {
        flex: 1;
        min-width: 180px;
        font: inherit;
        font-size: var(--f17);
        padding: 13px 14px;
        border: none;
        background: var(--paper);
        color: var(--ink);
      }
      .frow input::placeholder {
        color: var(--muted);
      }
      .frow input:focus {
        outline: none;
        background: var(--cream);
      }
      .frow:focus-within {
        border-color: var(--amber);
      }
      .frow button {
        font: inherit;
        font-weight: 800;
        font-size: var(--f15);
        padding: 13px 22px;
        border: none;
        background: var(--amber);
        color: var(--ink);
        cursor: pointer;
        letter-spacing: 0.01em;
        transition: background-color 0.15s;
      }
      .frow button:hover {
        background: var(--ink);
        color: var(--cream);
      }
      #fout {
        margin-top: 14px;
        font-size: var(--f15);
        display: none;
        padding: 12px 14px;
        border-radius: 10px;
        background: var(--cream);
        border: 1px solid var(--line);
        border-left: 4px solid var(--amber);
      }
      #fout .hit {
        padding: 6px 0;
        border-top: 1px solid var(--line);
      }
      #fout .hit:first-child {
        border-top: none;
        padding-top: 0;
      }
      #fout .hit:last-child {
        padding-bottom: 0;
      }
      #fout .hit b {
        color: var(--amber-ink);
      }
      #fout .hit.t-one b {
        color: var(--ink);
        background: var(--amber);
        padding: 0 5px;
      }
      #fout .hit-q {
        font-size: var(--f15);
        color: var(--muted);
      }

      /* depth gauge (tier ladder) */
      .gauge {
        list-style: none;
        margin: 0 0 22px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .gauge li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding: 7px 12px;
        border-radius: 10px;
        font-size: var(--f13);
      }
      .gauge li b {
        font-family: var(--serif);
        font-weight: 700;
      }
      .gauge .g-plank {
        width: 56%;
        background: transparent;
        border: 1px solid var(--ember);
        color: var(--line);
        font-weight: 400;
      }
      .gauge .g-school {
        width: 66%;
        background: var(--ember);
        color: var(--line);
        font-weight: 500;
      }
      .gauge .g-rare {
        width: 77%;
        background: var(--ember);
        color: var(--amber);
        font-weight: 700;
        border-left: 3px solid var(--amber);
      }
      .gauge .g-deep {
        width: 88%;
        background: var(--amber-ink);
        color: var(--cream);
        font-weight: 700;
      }
      .gauge .g-one {
        width: 100%;
        background: var(--amber);
        color: var(--ink);
        font-weight: 800;
        padding: 10px 12px;
        font-size: var(--f15);
      }

      /* stats strip */
      .stats-wrap {
        background: var(--ink);
      }
      .stats-wrap .hero-in {
        padding: 0 20px;
      }
      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin-top: 0;
        border-top: 1px solid var(--ember);
      }
      .stat {
        padding: 16px 18px 18px;
        border-left: 1px solid var(--ember);
      }
      .stat:first-child {
        border-left: none;
        padding-left: 0;
      }
      .stat b {
        display: block;
        font-family: var(--serif);
        font-size: var(--f28);
        font-weight: 700;
        color: var(--amber);
        line-height: 1.1;
        white-space: nowrap;
      }
      .stat span {
        font-size: var(--f11);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--line);
        font-weight: 600;
      }

      /* ================= CONTENT ================= */
      .wrap {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 20px 64px;
      }
      h2.sec {
        font-family: var(--serif);
        font-size: var(--f28);
        font-weight: 700;
        margin: 52px 0 6px;
        letter-spacing: -0.01em;
        line-height: 1.15;
        padding-top: 14px;
        position: relative;
      }
      h2.sec::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        width: 40px;
        height: 3px;
        background: var(--amber);
      }
      .sec-sub {
        margin: 0 0 18px;
        font-size: var(--f15);
        color: var(--muted);
        max-width: 620px;
      }

      /* prompts ledger */
      #prompts {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
      }
      .pcard {
        border-top: 1px solid var(--line);
        transition: background-color 0.15s;
      }
      .pcard:first-child {
        border-top: none;
      }
      .pcard summary {
        list-style: none;
        cursor: pointer;
        padding: 18px 22px;
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr) auto;
        gap: 16px;
        align-items: start;
        border-left: 4px solid transparent;
        transition: border-color 0.15s, background-color 0.15s;
      }
      .pcard summary::-webkit-details-marker {
        display: none;
      }
      .pcard summary:hover {
        background: var(--cream);
      }
      .pcard[open] summary {
        border-left-color: var(--amber);
        background: var(--cream);
      }
      .pnum {
        font-family: var(--serif);
        font-size: var(--f28);
        font-weight: 700;
        line-height: 1;
        color: var(--line);
        padding-top: 2px;
        transition: color 0.15s;
      }
      .pcard summary:hover .pnum,
      .pcard[open] .pnum {
        color: var(--amber-ink);
      }
      .pbody {
        min-width: 0;
      }
      .pq {
        font-size: var(--f17);
        font-weight: 700;
        line-height: 1.35;
        margin: 0 0 6px;
      }
      .pcard[open] .pq {
        font-family: var(--serif);
        font-size: var(--f20);
      }
      .pmeta {
        font-size: var(--f13);
        color: var(--muted);
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: baseline;
      }
      .tag {
        font-size: var(--f11);
        font-weight: 800;
        color: var(--amber-ink);
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .caret {
        color: var(--muted);
        font-size: var(--f11);
        padding-top: 6px;
        transition: transform 0.15s;
      }
      .pcard[open] .caret {
        transform: rotate(90deg);
        color: var(--amber-ink);
      }
      .pinner {
        border-top: 1px solid var(--line);
      }

      /* tier ladder: surface (common) → trench (legendary) */
      .tier {
        display: grid;
        grid-template-columns: 170px minmax(0, 1fr);
        gap: 16px;
        padding: 12px 22px 12px 26px;
        border-top: 1px solid var(--line);
      }
      .tier:first-child {
        border-top: none;
      }
      .tbadge {
        font-size: var(--f11);
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        line-height: 1.25;
        padding-top: 5px;
      }
      .tbadge::before {
        content: '';
        display: block;
        height: 4px;
        margin-bottom: 7px;
        border-radius: 2px;
      }
      .tbadge i {
        display: block;
        font-style: normal;
        font-weight: 600;
        font-size: var(--f11);
        letter-spacing: 0.04em;
        margin-top: 3px;
        opacity: 0.8;
      }
      .tans {
        min-width: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
      }
      .chip {
        font-size: var(--f15);
        line-height: 1.35;
        padding: 4px 9px;
        border-radius: 5px;
        border: 1px solid transparent;
      }
      .chip em {
        font-style: normal;
        font-size: var(--f13);
        margin-left: 6px;
        color: var(--muted);
      }
      .chip a {
        color: inherit;
        text-decoration: none;
      }
      .more {
        font-size: var(--f13);
        color: var(--amber-ink);
        font-weight: 700;
        padding-left: 4px;
      }

      /* Plankton — lightest */
      .t-plank {
        background: var(--paper);
      }
      .t-plank .tbadge {
        color: var(--muted);
        font-weight: 500;
      }
      .t-plank .tbadge::before {
        width: 14px;
        background: var(--line);
      }
      .t-plank .chip {
        border: 1px dashed var(--line);
        color: var(--muted);
      }
      /* Schooler */
      .t-school {
        background: var(--paper);
      }
      .t-school .tbadge {
        color: var(--ink);
        font-size: var(--f13);
        font-weight: 600;
      }
      .t-school .tbadge::before {
        width: 30px;
        background: var(--line);
      }
      .t-school .chip {
        border-color: var(--line);
        background: var(--paper);
        font-weight: 500;
      }
      /* Rare */
      .t-rare {
        background: var(--cream);
      }
      .t-rare .tbadge {
        color: var(--amber-ink);
        font-size: var(--f13);
        font-weight: 800;
      }
      .t-rare .tbadge::before {
        width: 48px;
        background: var(--amber);
      }
      .t-rare .chip {
        background: var(--paper);
        border-color: var(--line);
        border-left: 3px solid var(--amber);
        font-weight: 600;
      }
      /* Deep Cut */
      .t-deep {
        background: var(--sand);
      }
      .t-deep .tbadge {
        color: var(--amber-ink);
        font-size: var(--f15);
        font-weight: 800;
        letter-spacing: 0.05em;
      }
      .t-deep .tbadge::before {
        width: 72px;
        background: var(--amber-ink);
      }
      .t-deep .chip {
        background: var(--paper);
        border-color: var(--amber);
        color: var(--amber-ink);
        font-weight: 700;
      }
      /* One in a Krillion — the trench */
      .t-one {
        background: var(--ink);
        padding-top: 18px;
        padding-bottom: 20px;
        border-top-color: var(--ink);
      }
      .t-one .tbadge {
        color: var(--amber);
        font-size: var(--f17);
        font-weight: 800;
        letter-spacing: 0.03em;
        text-transform: none;
        font-family: var(--serif);
      }
      .t-one .tbadge::before {
        width: 100%;
        max-width: 120px;
        background: var(--amber);
        height: 6px;
      }
      .t-one .tbadge i {
        color: var(--line);
        font-family: var(--sans);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        opacity: 1;
      }
      .t-one .chip {
        background: var(--amber);
        color: var(--ink);
        font-family: var(--serif);
        font-size: var(--f20);
        font-weight: 700;
        padding: 6px 14px;
        border-color: var(--amber);
      }
      .t-one .chip em {
        color: var(--ember);
      }

      /* rarest — the trench panel */
      .rare-grid {
        display: block;
        background: var(--ink);
        color: var(--cream);
        border-radius: 14px;
        padding: 6px 26px;
        counter-reset: rr;
        border-bottom: 4px solid var(--amber);
      }
      .rare-row {
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr);
        gap: 14px;
        align-items: baseline;
        padding: 16px 0;
        border-top: 1px solid var(--ember);
        counter-increment: rr;
      }
      .rare-row:first-child {
        border-top: none;
      }
      .rare-row::before {
        content: counter(rr, decimal-leading-zero);
        font-size: var(--f13);
        font-weight: 700;
        color: var(--amber);
        letter-spacing: 0.06em;
      }
      .rare-row > div {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        gap: 20px;
        align-items: baseline;
      }
      .rare-row b {
        font-family: var(--serif);
        font-size: var(--f20);
        font-weight: 700;
        color: var(--cream);
        line-height: 1.25;
      }
      .rare-row span {
        font-size: var(--f15);
        color: var(--line);
        display: block;
      }

      /* archive */
      .arch {
        display: grid;
        grid-template-columns: repeat(9, minmax(0, 1fr));
        gap: 0;
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
        background: var(--paper);
      }
      .arch a {
        display: block;
        padding: 14px 12px 13px;
        text-decoration: none;
        color: var(--ink);
        font-weight: 700;
        font-size: var(--f15);
        border-left: 1px solid var(--line);
        line-height: 1.3;
        transition: background-color 0.15s, color 0.15s;
      }
      .arch a:first-child {
        border-left: none;
        border-top: 3px solid var(--amber);
        padding-top: 11px;
      }
      .arch a:hover {
        background: var(--cream);
        color: var(--amber-ink);
      }
      .arch a small {
        display: block;
        font-weight: 500;
        font-size: var(--f13);
        color: var(--muted);
        margin-top: 3px;
      }
      .arch a:last-child {
        background: var(--ink);
        color: var(--cream);
        border-left-color: var(--ink);
      }
      .arch a:last-child small {
        color: var(--amber);
      }
      .arch a:last-child:hover {
        background: var(--amber-ink);
      }

      /* faq */
      .faq-list {
        border-top: 2px solid var(--ink);
      }
      details.faq {
        border-bottom: 1px solid var(--line);
      }
      details.faq summary {
        cursor: pointer;
        font-weight: 700;
        font-size: var(--f17);
        padding: 16px 36px 16px 0;
        list-style: none;
        position: relative;
        transition: color 0.15s;
      }
      details.faq summary::-webkit-details-marker {
        display: none;
      }
      details.faq summary::after {
        content: '';
        position: absolute;
        right: 6px;
        top: 50%;
        width: 8px;
        height: 8px;
        border-right: 2px solid var(--amber-ink);
        border-bottom: 2px solid var(--amber-ink);
        transform: translateY(-70%) rotate(45deg);
        transition: transform 0.15s;
      }
      details.faq[open] summary::after {
        transform: translateY(-30%) rotate(-135deg);
      }
      details.faq summary:hover,
      details.faq[open] summary {
        color: var(--amber-ink);
      }
      details.faq p {
        margin: 0 0 18px;
        font-size: var(--f15);
        color: var(--muted);
        max-width: 680px;
        padding-left: 14px;
        border-left: 3px solid var(--sand);
      }

      /* cta */
      .cta {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 44px;
        padding-top: 24px;
        border-top: 1px solid var(--line);
      }
      .cta a {
        font-weight: 800;
        font-size: var(--f15);
        padding: 14px 22px;
        border-radius: 10px;
        border: 2px solid var(--amber-ink);
        background: var(--amber-ink);
        color: var(--paper);
        text-decoration: none;
        flex: 2;
        min-width: 200px;
        text-align: center;
        transition: background-color 0.15s, border-color 0.15s, color 0.15s;
      }
      .cta a:hover {
        background: var(--ink);
        border-color: var(--ink);
      }
      .cta a.ghost {
        flex: 1;
        background: var(--paper);
        color: var(--amber-ink);
      }
      .cta a.ghost:hover {
        background: var(--cream);
        color: var(--ink);
        border-color: var(--ink);
      }
      .note {
        font-size: var(--f15);
        color: var(--muted);
        margin-top: 12px;
        max-width: 680px;
      }

      @media (max-width: 820px) {
        .hero-grid {
          grid-template-columns: 1fr;
          gap: 0;
        }
        .gauge {
          flex-direction: row;
          gap: 4px;
          margin: 0 0 18px;
        }
        .gauge li {
          width: auto !important;
          flex: 1;
          flex-direction: column;
          align-items: flex-start;
          gap: 2px;
          padding: 7px 8px;
          font-size: var(--f11);
        }
        .gauge .g-one {
          font-size: var(--f11);
          padding: 7px 8px;
        }
        .hero-side {
          order: -1;
          margin-top: 6px;
        }
        .arch {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
        .arch a {
          border-top: 1px solid var(--line);
        }
        .arch a:nth-child(3n + 1) {
          border-left: none;
        }
        .arch a:nth-child(-n + 3) {
          border-top: none;
        }
        .arch a:first-child {
          border-top: 3px solid var(--amber);
        }
        .rare-row > div {
          grid-template-columns: 1fr;
          gap: 4px;
        }
      }
      @media (max-width: 560px) {
        .hero h1 {
          font-size: var(--f28);
        }
        .hero {
          padding: 22px 16px 0;
        }
        .crumb {
          margin-bottom: 18px;
        }
        .finder {
          padding: 18px 16px 16px;
        }
        .frow button {
          width: 100%;
        }
        .gauge {
          display: none;
        }
        .stats {
          grid-template-columns: 1fr 1fr;
        }
        .stat {
          padding: 12px 12px 14px;
        }
        .stat:nth-child(odd) {
          border-left: none;
          padding-left: 0;
        }
        .stat:nth-child(n + 3) {
          border-top: 1px solid var(--ember);
        }
        .stat b {
          font-size: var(--f20);
        }
        .stats-wrap .hero-in {
          padding: 0 16px;
        }
        .wrap {
          padding: 0 14px 50px;
        }
        .pcard summary {
          grid-template-columns: 30px minmax(0, 1fr) auto;
          gap: 10px;
          padding: 16px 14px;
        }
        .pnum {
          font-size: var(--f20);
        }
        .tier {
          grid-template-columns: 1fr;
          gap: 8px;
          padding: 12px 14px 14px;
        }
        .tbadge::before {
          margin-bottom: 5px;
        }
        .rare-grid {
          padding: 4px 16px;
        }
        .rare-row {
          grid-template-columns: 28px minmax(0, 1fr);
          gap: 10px;
        }
        .cta a {
          min-width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <GameNav />

    <header class="hero">
      <div class="hero-in">
        <div class="crumb">
          <a href="/">GridPaw</a> › <a href="/krillion-answers/archive/">Daily Answers</a> › Krillion
        </div>
        <div class="hero-grid">
          <div class="hero-main">
            <div class="kicker">{dtag || 'Dive'} · {longDate(dive.date)}</div>
            <h1>Krillion Answers <span class="num">{h1Accent}</span></h1>
            <p class="sub">
              All {dive.promptCount} prompts from the newest Daily Dive, with every accepted answer sorted by
              rarity tier — so you can see exactly what your answer would have scored.
            </p>
            <div class="finder">
              <h2>What did you answer?</h2>
              <p>
                Type your answer to see which rarity tier it lands in. Nothing to install — this checks the
                same answer bank the game uses.
              </p>
              <div class="frow">
                <input
                  id="fin"
                  type="text"
                  placeholder="e.g. platypus, Eton wall game, Burger King…"
                  autocomplete="off"
                  aria-label="Answer to look up"
                />
                <button id="fgo" type="button">Check score</button>
              </div>
              <div id="fout" aria-live="polite"></div>
            </div>
          </div>
          <div class="hero-side">
            <ol class="gauge" aria-hidden="true">
              {TIERS.map((t) => (
                <li class={`g-${t.key}`}>
                  <span>{t.label}</span>
                  <b>{t.pts}</b>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </header>

    <div class="stats-wrap">
      <div class="hero-in">
        <div class="stats">
          <div class="stat"><b>{compact(submitted)}</b><span>answers submitted</span></div>
          <div class="stat"><b>{dive.promptCount}</b><span>prompts</span></div>
          <div class="stat"><b>{fmt(minAcc)}–{fmt(maxAcc)}</b><span>answers / prompt</span></div>
          <div class="stat"><b>{resetsIn}</b><span>until reset</span></div>
        </div>
      </div>
    </div>

    <div class="wrap">
      <h2 class="sec">The {dive.promptCount} prompts</h2>
      <p class="sec-sub">
        Tap a prompt to open its full answer bank. Answers are grouped by the tier they score.
      </p>
      <div id="prompts">
        {dive.prompts.map((p: Prompt, i: number) => {
          const groups = tiersOf(p);
          return (
            <details class="pcard" open={i === 0}>
              <summary>
                <div class="pnum">{i + 1}</div>
                <div class="pbody">
                  <p class="pq">{p.prompt}</p>
                  <div class="pmeta">
                    <span class="tag">Prompt {p.n}</span>
                    <span>{fmt(p.accepted)} accepted answers</span>
                    <span>·</span>
                    <span>{fmt(p.deepCuts)} Deep Cuts</span>
                  </div>
                </div>
                <div class="caret">▶</div>
              </summary>
              <div class="pinner">
                {groups.map((g) => (
                  <div class={`tier t-${g.key}`}>
                    <div class="tbadge">
                      {g.label}
                      <i>{g.pts} pts</i>
                    </div>
                    <div class="tans">
                      {g.items.map((it) => (
                        <span class="chip">
                          <a href={`/krillion-answers/q/${p.slug}/`}>{it.name}</a>
                          {it.note ? <em>{it.note}</em> : null}
                        </span>
                      ))}
                      {g.more > 0 && <span class="more">+{fmt(g.more)} more</span>}
                    </div>
                  </div>
                ))}
              </div>
            </details>
          );
        })}
      </div>

      <h2 class="sec">Rarest answers</h2>
      <p class="sec-sub">
        The single hardest answer on each prompt — only the sharpest divers reached these.
      </p>
      <div class="rare-grid">
        {rarest.map((r) => (
          <div class="rare-row">
            <div>
              <b>{r.a}</b>
              <span>{r.q}</span>
            </div>
          </div>
        ))}
      </div>

      <InContentAd />

      <h2 class="sec">Previous dives</h2>
      <p class="sec-sub">
        Every past Daily Dive, archived by date. Same {dive.promptCount}-prompt format, full answer banks.
      </p>
      <div class="arch">
        {archDays.map((d) => (
          <a href={`/krillion-answers/${d.date}/`}>
            {diveNo(d) ? `Dive #${diveNo(d)}` : shortDate(d.date)}
            <small>{shortDate(d.date)}</small>
          </a>
        ))}
        <a href="/krillion-answers/archive/">
          All {allDives.length}
          <small>full archive</small>
        </a>
      </div>

      <h2 class="sec">Common questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <div class="cta">
        <a href="/krillion-answers/archive/">Browse every archived Dive</a>
        <a class="ghost" href="/">Play a puzzle on GridPaw</a>
      </div>

      <p class="note">
        Sources: prompt text, Dive numbers and reset times come from Krillion's public daily endpoint; answer
        tiers and player counts come from the game's public reveal data. The official archive of past answers
        sits behind a one-off unlock, so it isn't available to us directly. GridPaw is independent and not
        affiliated with krillion.io. Last built {dive.fetchedAt.slice(0, 10)}.
      </p>
    </div>

    <SideAd />

    <script is:inline define:vars={{ bank: bankData }}>
      (function () {
        var INDEX = new Map();
        bank.forEach(function (b) {
          if (!INDEX.has(b.n)) INDEX.set(b.n, []);
          INDEX.get(b.n).push(b);
        });
        var fin = document.getElementById('fin');
        var fgo = document.getElementById('fgo');
        var fout = document.getElementById('fout');
        var BANK = bank.length;

        function esc(s) {
          return String(s).replace(/[&<>"]/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
          });
        }

        function run() {
          var q = (fin.value || '').trim().toLowerCase();
          fout.style.display = 'block';
          if (!q) {
            fout.innerHTML = 'Type an answer first.';
            return;
          }
          if (!INDEX.has(q)) {
            fout.innerHTML =
              '⌕ <b>No match in this answer bank.</b> It may still be accepted by the game — a prompt here accepts anywhere from a few dozen to hundreds of thousands of answers, and we only carry the top of each tier (' +
              BANK +
              ' catalogued).';
            return;
          }
          fout.innerHTML = INDEX.get(q)
            .map(function (h) {
              return (
                '<div class="hit t-' +
                h.t +
                '">Prompt ' +
                h.i +
                ': <b>' +
                h.tier +
                '</b> · ' +
                h.pts +
                ' pts<br><span class="hit-q">' +
                esc(h.q) +
                '</span> · <a href="' +
                h.url +
                '">open breakdown →</a></div>'
              );
            })
            .join('');
        }
        fgo.addEventListener('click', run);
        fin.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') run();
        });
      })();
    </script>
  </body>
</html>
