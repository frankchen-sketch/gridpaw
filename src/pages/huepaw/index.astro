      var targetLabelEl = document.querySelector('.hw-target-label');
      var winEl = $('hw-win'), winDetail = $('hw-win-detail'), ticketEl = $('hw-ticket');
      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ?d=YYYY-MM-DD → 归档盘：只认过去 60 天内的真实日期（今天等同普通 daily，未来/久远一律忽略） */
      var archiveId = (function () {
        var v = null;
        try { v = new URLSearchParams(location.search).get('d'); } catch (e) {}
        if (!v || !/^\d{4}-\d{2}-\d{2}$/.test(v)) return null;
        var p = v.split('-').map(Number);
        var d = new Date(p[0], p[1] - 1, p[2]);
        if (isNaN(d.getTime()) || localYmd(d) !== v) return null;
        var now = new Date();
        var diff = Math.round((new Date(now.getFullYear(), now.getMonth(), now.getDate()) - d) / 86400000);
        return (diff > 0 && diff <= 60) ? v : null;
      })();

      var S = {
        engine: null, size: 5, mode: 'daily', id: '', p: null,
        board: [], initial: [], sel: -1, moves: 0, hints: 3,
        t0: 0, tickId: null, over: false, firstMove: false, lockedClicks: 0, userScrolled: false
      };
      var hintTimer = null;
      /* 用户是否自己滚过：认「滚动落点」。我们自己 scrollTo 前记下目标，落点对上就是程序滚的，
         其余任何滚动（滚轮/触摸/拖滚动条/键盘）都算用户主动 → 本局不再自动定位。
         这样不用按事件次数或时间窗猜，也不会被 Escape 之类不滚动页面的按键误触发。
         取舍：浏览器因布局变化自行调整滚动位置时也会算"用户滚过"，本局就跳过自动定位 ——
         宁可少定位一次（用户自己滚一下就有），也不要把正在读页面的人拽回棋盘 */
      var autoScrollTarget = -1;
      window.addEventListener('scroll', function () {
        if (autoScrollTarget >= 0 && Math.abs(window.scrollY - autoScrollTarget) < 2) {
          autoScrollTarget = -1;
          return;
        }
