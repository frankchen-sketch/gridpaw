  <!-- Engine is loaded lazily on Play (封面 → 加载 → 游戏，首屏不预加载). -->
  <script is:inline>
    (function () {
      'use strict';

      function track(event, params) {
        try {
          var p = params || {};
          if (typeof window.gtag === 'function') window.gtag('event', event, p);
          if (typeof window.gpTrack === 'function') window.gpTrack(event, p);
        } catch (e) {}
      }
      function $(id) { return document.getElementById(id); }
      function pad(n) { return n < 10 ? '0' + n : '' + n; }
      /** 本地 YYYY-MM-DD（引擎缺 dailyId 时的兜底；toISOString 是 UTC，会破本地午夜承诺） */
      function localYmd(d) {
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
      }
      /** 某天对应的每日盘尺寸（与引擎 DAILY_SIZES 同表；date 字符串按本地日历解析） */
      function sizeForYmd(v) {
        var p = v.split('-').map(Number);
        return [3, 5, 4, 5, 4, 5, 4][new Date(p[0], p[1] - 1, p[2]).getDay()];
      }
      /** 游客键：与服务端 ANON_ID_RE ^anon-[0-9a-fA-F-]{6,70}$ 同口径；优先复用 funnel-track 写的同一个键 */
      function getAnonId() {
        try {
          var a = localStorage.getItem('gp_anon_id');
          if (a && /^anon-[0-9a-fA-F-]{6,70}$/.test(a)) return a;
        } catch (e) {}
        var fresh = 'anon-' + (typeof crypto !== 'undefined' && crypto.randomUUID
          ? crypto.randomUUID()
          : Date.now().toString(16) + '-' + Math.random().toString(16).slice(2, 10));
        try { localStorage.setItem('gp_anon_id', fresh); } catch (e) {}
        return fresh;
      }
      /** 本地连胜：按 huepaw:daily:<YYYY-MM-DD> 记录回扫连续天（今天没玩但昨天解过 → 连胜仍存活） */
      function streak() {
        var days = {};
        try {
          for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && k.indexOf('huepaw:daily:') === 0) days[k.slice(13)] = 1; // 'huepaw:daily:' 正好 13 字符
          }
        } catch (e) {}
        var dates = Object.keys(days).sort();
        var cur = 0, d = new Date();
        if (!days[localYmd(d)]) d.setDate(d.getDate() - 1);
        while (days[localYmd(d)]) { cur++; d.setDate(d.getDate() - 1); }
        var best = 0, run = 0, prev = '';
        for (var j = 0; j < dates.length; j++) {
          run = prev && Math.round((new Date(dates[j] + 'T12:00:00') - new Date(prev + 'T12:00:00')) / 86400000) === 1 ? run + 1 : 1;
          if (run > best) best = run;
          prev = dates[j];
        }
        return { cur: cur, best: best, total: dates.length };
      }
      function updateStreakChip() {
