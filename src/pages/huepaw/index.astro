    @keyframes hwPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); } 50% { box-shadow: 0 0 0 4px rgba(255,255,255,.95), 0 0 0 7px rgba(0,0,0,.18); } }
    /* 锁定标记不靠颜色：内圈虚线圈 + 右上 ✓，色盲/低对比下同样可辨识 */
    .hw-tile.locked { cursor: default; }
