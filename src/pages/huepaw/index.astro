  <!-- Engine is loaded lazily on Play (封面 → 加载 → 游戏，首屏不预加载). -->
  <script is:inline>
    (function () {
      'use strict';

      function track(event, params) {
        try {
          var p = params || {};
          if (typeof window.gtag === 'function') window.gtag('event', event, p);
          if (typeof window.gpTrack === 'function') window.gpTrack(event, p);
        } catch (e) {}
      }
      function $(id) { return document.getElementById(id); }
      function pad(n) { return n < 10 ? '0' + n : '' + n; }

      var boardEl = $('hw-board'), coverEl = $('hw-cover'), loadEl = $('hw-loading');
      var movesEl = $('hw-moves'), timerEl = $('hw-timer'), hintCountEl = $('hw-hint-count');
      var badgeEl = $('hw-badge'), modeNameEl = $('hw-mode-name'), targetEl = $('hw-target'), stripEl = $('hw-target-strip');
      var winEl = $('hw-win'), winDetail = $('hw-win-detail');

      var S = {
        engine: null, size: 5, mode: 'daily', id: '', p: null,
        board: [], initial: [], sel: -1, moves: 0, hints: 3,
        t0: 0, tickId: null, over: false, firstMove: false, started: false
      };

      function todayId() {
        var d = new Date();
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
      }
      function dailySize() {
        // 周日 3×3、周三/周六 4×4，其余 5×5 —— 每天难度有起伏（文案里已写「轮换」）
        var dow = new Date().getDay();
        return [3, 5, 4, 5, 4, 5, 4][dow];
      }
      function fmtTime(ms) {
        var s = Math.max(0, Math.floor(ms / 1000));
        var m = Math.floor(s / 60);
        return m + ':' + pad(s % 60);
      }
      function store(key, val) {
        try { if (val === undefined) return localStorage.getItem(key); localStorage.setItem(key, val); } catch (e) { return null; }
      }

      /* ── 引擎懒加载 ─────────────────────────────────────────────── */
      function loadEngine(cb) {
        if (window.GradientEngine) { S.engine = window.GradientEngine; return cb(null); }
        var s = document.createElement('script');
        s.src = '/gradient-engine.js';
        s.onload = function () {
          if (window.GradientEngine) { S.engine = window.GradientEngine; cb(null); }
          else cb(new Error('engine missing'));
        };
        s.onerror = function () { cb(new Error('engine load failed')); };
        document.head.appendChild(s);
      }

      /* ── 渲染 ──────────────────────────────────────────────────── */
      function buildTiles(n) {
        boardEl.innerHTML = '';
        boardEl.style.gridTemplateColumns = 'repeat(' + n + ', 1fr)';
        for (var i = 0; i < n * n; i++) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'hw-tile';
          b.setAttribute('data-i', String(i));
          b.setAttribute('role', 'gridcell');
          b.innerHTML = '<span class="hw-idx"></span>';
          boardEl.appendChild(b);
        }
      }
      function paint() {
        var kids = boardEl.children;
        for (var i = 0; i < kids.length; i++) {
          var tile = kids[i];
          var c = S.p.target[S.board[i]];
          tile.style.background = c;
          tile.classList.toggle('sel', S.sel === i);
          tile.querySelector('.hw-idx').textContent = String(S.board[i] + 1);
          tile.setAttribute('aria-label', 'Tile ' + (i + 1) + ' of ' + S.board.length + ', colour ' + (S.board[i] + 1) + (S.board[i] === i ? ', correct' : ''));
        }
        movesEl.textContent = S.moves + (S.moves === 1 ? ' swap' : ' swaps');
        hintCountEl.textContent = '(' + S.hints + ')';
        $('hw-hint').classList.toggle('disabled', S.hints <= 0);
        $('hw-peek').classList.toggle('disabled', S.hints <= 0);
      }
      function paintTarget() {
        stripEl.innerHTML = '';
        for (var i = 0; i < S.p.target.length; i++) {
          var bar = document.createElement('i');
          bar.style.background = S.p.target[i];
          stripEl.appendChild(bar);
        }
      }

      /* ── 计时 ──────────────────────────────────────────────────── */
      function startTimer() {
        if (S.tickId) return;
        S.t0 = Date.now();
        S.tickId = setInterval(function () {
          timerEl.textContent = fmtTime(Date.now() - S.t0);
        }, 500);
      }
      function stopTimer() { if (S.tickId) { clearInterval(S.tickId); S.tickId = null; } }

      /* ── 开局 ──────────────────────────────────────────────────── */
      function newPuzzle(mode, size) {
        S.mode = mode || 'daily';
        S.size = size || (S.mode === 'daily' ? dailySize() : 5);
        S.id = S.mode === 'daily' ? todayId() : 'practice-' + Math.random().toString(36).slice(2, 9);
        S.p = S.engine.generate(S.size, S.id);
        S.board = S.p.board.slice();
        S.initial = S.p.board.slice();
        S.sel = -1; S.moves = 0; S.hints = 3; S.over = false; S.firstMove = false;
        S.started = true;
        stopTimer(); timerEl.textContent = '0:00';
        buildTiles(S.size);
        paint(); paintTarget();
        targetEl.hidden = true;
        badgeEl.textContent = (S.mode === 'daily' ? 'Daily' : 'Practice') + ' · ' + S.size + '×' + S.size;
        modeNameEl.textContent = S.mode === 'daily' ? 'Daily' : 'Practice';
        document.querySelectorAll('.diff-btn').forEach(function (b) {
          var on = Number(b.getAttribute('data-size')) === S.size;
          b.classList.toggle('active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        var done = S.mode === 'daily' ? store('huepaw:daily:' + S.id) : null;
        if (done) {
          try {
            var rec = JSON.parse(done);
            toast('✓ You already solved today\'s board in ' + rec.moves + ' swaps (' + fmtTime(rec.ms) + ')');
          } catch (e) {}
        }
      }

      function begin(mode, size) {
        coverEl.hidden = true;
        if (!S.engine) {
          loadEl.hidden = false;
          loadEngine(function (err) {
            loadEl.hidden = true;
            if (err) { toast('Could not load the board — check your connection and try again.'); coverEl.hidden = false; return; }
            newPuzzle(mode, size);
            track('game_start', { game: 'huepaw', mode: mode, size: size || dailySize() });
          });
          return;
        }
        newPuzzle(mode, size);
        track('game_start', { game: 'huepaw', mode: mode, size: size || dailySize() });
      }

      /* ── 交互 ──────────────────────────────────────────────────── */
      boardEl.addEventListener('click', function (ev) {
        var tile = ev.target.closest('.hw-tile');
        if (!tile || S.over) return;
        var i = Number(tile.getAttribute('data-i'));
        if (!S.firstMove) { S.firstMove = true; startTimer(); track('first_move', { game: 'huepaw', size: S.size }); }
        if (S.sel < 0) { S.sel = i; paint(); return; }
        if (S.sel === i) { S.sel = -1; paint(); return; }
        var a = S.sel, b = i;
        S.board = S.engine.swap(S.board, a, b);
        S.moves++; S.sel = -1;
        clearHint();
        paint();
        if (S.engine.isSolved(S.p, S.board)) win();
      });

      function clearHint() {
        var els = boardEl.querySelectorAll('.hint-a, .hint-b');
        for (var i = 0; i < els.length; i++) els[i].classList.remove('hint-a', 'hint-b');
      }

      function doHint() {
        if (S.over) return;
        if (S.hints <= 0) { toast('No hints left — peek costs a hint too.'); return; }
        var h = S.engine.hint(S.p, S.board);
        if (!h) return;
        S.hints--;
        clearHint();
        boardEl.children[h.from].classList.add('hint-a');
        boardEl.children[h.to].classList.add('hint-b');
        paint();
        track('hint_click', { game: 'huepaw', size: S.size, hints_left: S.hints });
        setTimeout(function () {
          var els = boardEl.querySelectorAll('.hint-a, .hint-b');
          for (var i = 0; i < els.length; i++) els[i].classList.remove('hint-a', 'hint-b');
        }, 2600);
      }

      function peek() {
        if (S.over) return;
        if (S.hints <= 0) { toast('No hints left for a peek — solve more boards to reset.'); return; }
        S.hints--; paint();
        targetEl.hidden = false;
        track('hint_click', { game: 'huepaw', size: S.size, kind: 'peek' });
        clearTimeout(peek._t);
        peek._t = setTimeout(function () { targetEl.hidden = true; }, 3200);
      }

      /* ── 胜利 ──────────────────────────────────────────────────── */
      function win() {
        S.over = true; stopTimer();
        var ms = S.t0 ? Date.now() - S.t0 : 0;
        winDetail.textContent = S.size * S.size + ' tiles in ' + S.moves + ' swaps · ' + fmtTime(ms);
        winEl.classList.add('show');
        track('game_won', { game: 'huepaw', size: S.size, moves: S.moves, seconds: Math.round(ms / 1000), mode: S.mode, hints_used: 3 - S.hints });
        if (S.mode === 'daily') {
          try { store('huepaw:daily:' + S.id, JSON.stringify({ moves: S.moves, ms: ms })); } catch (e) {}
        }
        win._ms = ms;
      }

      function shareText() {
        var d = S.mode === 'daily' ? S.id : 'practice';
        return 'Huepaw ' + d + ' — ' + S.size + '×' + S.size + ' gradient solved in ' + S.moves + ' swaps, ' + fmtTime(win._ms || 0) + ' 🎨';
      }

      /* ── Toast ─────────────────────────────────────────────────── */
      var toastT = null;
      function toast(msg) {
        var el = $('toast');
        el.textContent = msg;
        el.classList.add('show');
        clearTimeout(toastT);
        toastT = setTimeout(function () { el.classList.remove('show'); }, 3200);
      }

      /* ── 绑定 ──────────────────────────────────────────────────── */
      $('hw-play').addEventListener('click', function () { begin('daily'); });
      $('hw-hint').addEventListener('click', doHint);
      $('hw-peek').addEventListener('click', peek);
      $('hw-restart').addEventListener('click', function () {
        if (!S.p) { begin('daily'); return; }
        S.board = S.initial.slice(); S.moves = 0; S.sel = -1; S.hints = 3; S.over = false;
        stopTimer(); timerEl.textContent = '0:00'; S.firstMove = false;
        targetEl.hidden = true; clearHint(); paint();
        winEl.classList.remove('show');
        toast('Board reset — same tiles, clean slate.');
      });
      $('hw-new').addEventListener('click', function () {
        winEl.classList.remove('show');
        if (!S.engine) { begin('practice', S.size); return; }
        newPuzzle('practice', S.size);
      });
      $('hw-labels').addEventListener('click', function () {
        var on = this.getAttribute('aria-pressed') !== 'true';
        this.setAttribute('aria-pressed', on ? 'true' : 'false');
        this.textContent = on ? '# Labels on' : '# Labels off';
        boardEl.classList.toggle('show-labels', on);
      });
      document.querySelectorAll('.diff-btn').forEach(function (b) {
        b.addEventListener('click', function () {
          winEl.classList.remove('show');
          begin('practice', Number(b.getAttribute('data-size')));
        });
      });
      $('hw-win-next').addEventListener('click', function () {
        winEl.classList.remove('show');
        newPuzzle('practice', S.size);
      });
      $('hw-share-copy').addEventListener('click', function () {
        var t = shareText();
        if (navigator.clipboard) navigator.clipboard.writeText(t).then(function () { toast('Copied — paste it anywhere!'); });
        else toast(t);
        track('share_copy', { game: 'huepaw', size: S.size });
      });
      $('hw-share-twitter').addEventListener('click', function () {
        var url = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareText()) + '&url=' + encodeURIComponent('https://gridpaw.com/huepaw/');
        window.open(url, '_blank', 'noopener');
        track('share_twitter', { game: 'huepaw', size: S.size });
      });
      $('hw-share-reddit').addEventListener('click', function () {
        var url = 'https://www.reddit.com/submit?url=' + encodeURIComponent('https://gridpaw.com/huepaw/') + '&title=' + encodeURIComponent(shareText());
        window.open(url, '_blank', 'noopener');
        track('share_reddit', { game: 'huepaw', size: S.size });
      });

      // 埋点：进入视口但未开局的曝光（与 akari 同款 lazy start 观测）
      var startedOnce = false;
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting && !startedOnce) { startedOnce = true; track('game_view', { game: 'huepaw' }); }
          });
        }, { threshold: 0.4 });
        io.observe($('play'));
      }
    })();
  </script>

</body>
</html>
