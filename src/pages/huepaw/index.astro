        playBtn.textContent = S.mode === 'archive'
          ? '▶ Play the ' + S.id + ' board'
          : '▶ Play Today\'s ' + S.size + '×' + S.size + ' Board';
        document.querySelectorAll('.diff-btn').forEach(function (b) {
          var on = Number(b.getAttribute('data-size')) === S.size && S.mode === 'practice';
          b.classList.toggle('active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        setTimeout(ensureBoardVisible, 450); // 等教学卡/工具行布局落定后再定位一次
        updateStreakChip();
        if (S.mode !== 'practice' && store('huepaw:daily:' + S.id)) {
          try {
            var rec = JSON.parse(store('huepaw:daily:' + S.id));
            toast('✓ You already solved ' + (S.mode === 'daily' ? "today's board" : 'this board') +
              ' in ' + rec.moves + ' swaps (' + fmtTime(rec.ms) + ')');
          } catch (e) {}
        }
      }

      /* 换盘守卫：当前盘有未完成的步数/已用提示时，先确认再覆盖（daily 跨日、practice 切换都走这里） */
      function confirmDiscard(targetLabel) {
        if (!S.p || S.over) return true;
        if (S.moves === 0 && S.hints === 3) return true;
        var used = 3 - S.hints;
        return window.confirm('Switch to ' + targetLabel + '? Your board in progress (' +
          S.moves + (S.moves === 1 ? ' swap' : ' swaps') + (used ? ', ' + used + (used === 1 ? ' hint' : ' hints') + ' used' : '') +
          ') will be discarded.');
      }

      /* 开局后棋盘若被教学卡/标题挤出视口，就把它滚到视口中央（游戏页常态） */
      function ensureBoardVisible() {
        if (S.userScrolled) return; // 用户已经自己滚过，就别把人拽回来
        try {
          var r = boardEl.getBoundingClientRect();
          var vh = window.innerHeight;
          // 棋盘比视口还高（横屏/小窗）：不强求"完整可见"，只保证顶部露出来
          if (r.height > vh - 24) {
            if (r.top < 0 || r.top > vh - 140) autoScrollTo(window.scrollY + r.top - 12);
            return;
          }
          if (r.top >= 0 && r.bottom <= vh) return;
          // 一次性即时滚动：smooth 在省电/无头环境会被吞，和用户滚动抢也没意义
          autoScrollTo(window.scrollY + r.top - (vh - r.height) / 2);
        } catch (e) {}
      }

      function begin(mode, size, idOverride) {
        S.userScrolled = false; // 从点击这一刻起，用户任何滚动都优先于我们的自动定位
        autoScrollTarget = -1;  // 上一局的待匹配目标不带进新局
        coverEl.hidden = true;
        stageEl.classList.remove('hw-pre');
        if (!S.engine) {
          loadEl.hidden = false;
          loadEngine(function (err) {
            loadEl.hidden = true;
            if (err) {
              toast('Could not load the board — check your connection and try again.');
              coverEl.hidden = false;
              stageEl.classList.add('hw-pre');
              return;
            }
            newPuzzle(mode, size, idOverride);
            firstLook();
            track('game_start', { game: 'huepaw', mode: mode, size: S.size });
            // daily_start 是 /api/leaderboard 成绩下限的佐证事件（<下限必须 24h 内有它）
            if (mode !== 'practice') track('daily_start', { game: 'huepaw', mode: mode, size: S.size, date: S.id });
          });
          return;
        }
        newPuzzle(mode, size, idOverride);
        firstLook();
        track('game_start', { game: 'huepaw', mode: mode, size: S.size });
        if (mode !== 'practice') track('daily_start', { game: 'huepaw', mode: mode, size: S.size, date: S.id });
      }

      /* ── 交互 ──────────────────────────────────────────────────── */
      boardEl.addEventListener('click', function (ev) {
        var tile = ev.target.closest('.hw-tile');
        if (!tile || S.over) return;
        var i = Number(tile.getAttribute('data-i'));
        if (S.board[i] === i) {
          S.lockedClicks++;
          toast('Locked — that tile is already in its home spot.');
          track('locked_block_click', { game: 'huepaw', size: S.size, count: S.lockedClicks });
          return;
        }
        if (!S.firstMove) { S.firstMove = true; startTimer(); track('first_move', { game: 'huepaw', size: S.size }); }
        if (S.sel < 0) { S.sel = i; paint(); return; }
        if (S.sel === i) { S.sel = -1; paint(); return; }
        var a = S.sel, b = i;
        if (S.board[b] === b) { S.sel = -1; paint(); return; }
        var before = S.board.slice();
        S.board = S.engine.swap(S.board, a, b);
        S.moves++; S.sel = -1;
        clearHint(); paint();
        var pulsing = [];
        for (var k = 0; k < S.board.length; k++) if (S.board[k] === k && before[k] !== k) pulsing.push(k);
        pulsing.forEach(function (idx) {
          var el = boardEl.children[idx];
          if (!el) return;
          el.classList.add('just-locked');
          setTimeout(function () { el.classList.remove('just-locked'); }, 480);
        });
        if (pulsing.length) track('tile_locked', { game: 'huepaw', size: S.size, gained: pulsing.length });
        if (S.engine.isSolved(S.p, S.board)) win();
      });

      function clearHint() {
        clearTimeout(hintTimer);
        hintTimer = null;
        var els = boardEl.querySelectorAll('.hint-a, .hint-b');
        for (var i = 0; i < els.length; i++) els[i].classList.remove('hint-a', 'hint-b');
      }

      function doHint() {
        if (S.over || !S.p) return;
        if (S.hints <= 0) { toast('No hints left on this board — restart or start a new one.'); return; }
        var h = S.engine.hint(S.p, S.board);
        if (!h) return;
        S.hints--;
        S.sel = -1; // 有选中块时给提示：先取消选中，免得下一次点击把提示的砖换走
        clearHint();
        boardEl.children[h.from].classList.add('hint-a');
        boardEl.children[h.to].classList.add('hint-b');
        paint();
        toast('Swap the two marked tiles — at least one lands home.');
        track('hint_click', { game: 'huepaw', size: S.size, hints_left: S.hints });
        clearTimeout(hintTimer);
        hintTimer = setTimeout(function () {
          var els = boardEl.querySelectorAll('.hint-a, .hint-b');
          for (var i = 0; i < els.length; i++) els[i].classList.remove('hint-a', 'hint-b');
        }, 3000);
      }

      function peek() {
        if (S.over || !S.p) return;
        if (S.hints <= 0) { toast('No hints left for a peek.'); return; }
        S.hints--; paint();
        if (targetLabelEl) targetLabelEl.textContent = 'Target board — top row is the top of the board';
        targetEl.hidden = false;
        track('hint_click', { game: 'huepaw', size: S.size, kind: 'peek' });
        clearTimeout(peek._t);
        peek._t = setTimeout(function () { targetEl.hidden = true; }, 3200);
      }

      /* 首次进每日盘：目标盘免费展示 3 秒（不扣 hint，只给一次） */
      function firstLook() {
        if (!S.p || S.mode !== 'daily') return;
        if (store('huepaw:firstLook')) return;
        store('huepaw:firstLook', '1');
        if (targetLabelEl) targetLabelEl.textContent = 'Your goal — 3 s, free: hues warm → cool, brightness light → deep';
        targetEl.hidden = false;
        clearTimeout(peek._t);
        peek._t = setTimeout(function () { targetEl.hidden = true; }, 3200);
        track('hint_click', { game: 'huepaw', size: S.size, kind: 'first_look' });
      }

      /* ── 胜利：色流 + 色票卡 ────────────────────────────────────── */
      function win() {
        S.over = true; stopTimer();
        var ms = S.t0 ? Date.now() - S.t0 : 0;
        var size = S.size;
        winDetail.textContent = size * size + ' tiles · ' + S.moves + ' swaps · ' + fmtTime(ms);
        $('hw-ticket-date').textContent = S.mode === 'daily' ? S.id : 'Practice board';
        $('hw-ticket-size').textContent = size + '×' + size + ' · ' + S.moves + ' swaps';
        var ts = $('hw-ticket-strip');
        ts.innerHTML = '';
        for (var i = 0; i < S.p.target.length; i++) {
          var bar = document.createElement('i');
          bar.style.background = S.p.target[i];
          ts.appendChild(bar);
        }
        winEl.classList.add('show');
        ticketEl.classList.remove('reveal');
        setTimeout(function () { ticketEl.classList.add('reveal'); }, reduceMotion ? 0 : 620);
        track('game_won', { game: 'huepaw', size: size, moves: S.moves, seconds: Math.round(ms / 1000), mode: S.mode, hints_used: 3 - S.hints, locked_clicks: S.lockedClicks });
        if (S.mode !== 'practice') {
          // 同一盘重玩只留更快的一次（记录同时驱动"今日已解"/连胜）
          try {
            var prev = store('huepaw:daily:' + S.id);
            var prevMs = prev ? (JSON.parse(prev).ms || Infinity) : Infinity;
            if (ms < prevMs) store('huepaw:daily:' + S.id, JSON.stringify({ moves: S.moves, ms: ms }));
          } catch (e) {}
          // daily_solved 是连胜/徽章派生事件（_badges-derive 按日聚合）；归档盘不计连胜
          if (S.mode === 'daily') track('daily_solved', { game: 'huepaw', size: size, seconds: Math.round(ms / 1000), date: S.id });
          postResult(ms, size, false);
        } else {
          $('hw-rank').hidden = true;
          postResult(ms, size, true); // 练习盘也上尺寸阶梯榜（刷阶梯就在练习盘）
        }
        saveSizeBest(size, ms);
        loadLadderMini(size, ms);
        if (LAD_TAB === size) loadLadder(size);
        updateStreakChip();
        win._ms = ms;
      }

      /* ── 尺寸阶梯榜：best-ever per size（新表 game_results_size，永不过期） ── */
      var LAD_TAB = 5;
      function sizeBest(size) {
        try { var v = store('huepaw:best:' + size); return v ? (JSON.parse(v).ms || null) : null; } catch (e) { return null; }
      }
      function saveSizeBest(size, ms) {
        try { var b = sizeBest(size); if (!b || ms < b) store('huepaw:best:' + size, JSON.stringify({ ms: Math.round(ms) })); } catch (e) {}
      }
      function ladderEntries(size, cb) {
        fetch('/api/leaderboard?game=huepaw&type=size&size=' + size + '&_=' + Date.now())
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) { cb(d && Array.isArray(d.entries) ? d.entries : null); })
          .catch(function () { cb(null); });
      }
      function ladderRow(rank, name, t, me) {
        var safe = String(name || 'Anonymous Cat').replace(/[<>&]/g, '');
        return '<li' + (me ? ' class="me"' : '') + '><b>' + rank + '</b>' + safe + '<span>' + fmtTime(t) + '</span></li>';
      }
      function rankLine(mine, entries) {
        var faster = 0;
        for (var i = 0; i < entries.length; i++) if (entries[i].timeMs < mine) faster++;
        if (entries.length >= 20 && faster >= 20) return 'outside top 20';
        return '#' + (faster + 1);
      }
      function loadLadder(size) {
        LAD_TAB = size;
        document.querySelectorAll('#hw-ladder-tabs [data-lad]').forEach(function (b) {
          var on = Number(b.getAttribute('data-lad')) === size;
          b.classList.toggle('is-on', on);
          b.setAttribute('aria-selected', String(on));
        });
        var list = $('hw-ladder-list'), you = $('hw-ladder-you');
        if (!list) return;
        list.innerHTML = '<li class="hw-ladder-empty">Loading…</li>';
        if (you) you.textContent = '';
        ladderEntries(size, function (entries) {
          if (!entries) { list.innerHTML = '<li class="hw-ladder-empty">Ladder unavailable right now.</li>'; return; }
          var mine = sizeBest(size), html = '', rows = entries.slice(0, 5);
          for (var i = 0; i < rows.length; i++) html += ladderRow(i + 1, rows[i].name, rows[i].timeMs, mine && rows[i].timeMs === mine);
          list.innerHTML = html || '<li class="hw-ladder-empty">No times yet on ' + size + '×' + size + ' — be the first.</li>';
          if (you) you.textContent = mine
            ? 'Your best ' + size + '×' + size + ' — ' + fmtTime(mine) + ' · ' + rankLine(mine, entries)
            : 'No time from this device on ' + size + '×' + size + ' yet.';
        });
      }
      function loadLadderMini(size, ms) {
        var box = $('hw-ladder-mini'), head = $('hw-ladder-mini-head'), list = $('hw-ladder-mini-list'), you = $('hw-ladder-mini-you');
        if (!box) return;
        if (head) head.textContent = 'Ladder · ' + size + '×' + size + ' all-time';
        ladderEntries(size, function (entries) {
          if (!entries) { box.hidden = true; return; }
          var mine = sizeBest(size);
          if (list) {
            list.innerHTML = entries.slice(0, 3).map(function (e, i) { return ladderRow(i + 1, e.name, e.timeMs, mine && e.timeMs === mine); }).join('');
          }
          if (you) you.textContent = mine ? 'Your best this size — ' + fmtTime(mine) + ' · ' + rankLine(mine, entries) : '';
          box.hidden = !(list && list.innerHTML);
        });
      }

      /* ── 榜单：复用 /api/leaderboard（game=huepaw，日期=盘面日期；游客 anonId 也能上榜） ── */
      function postResult(ms, size, ladderOnly) {
        if (!ladderOnly && !/^\d{4}-\d{2}-\d{2}$/.test(S.id)) return;
        var payload = { game: 'huepaw', date: S.id, timeMs: Math.round(ms), anonId: getAnonId(), size: size };
        if (ladderOnly) payload.ladderOnly = true; // 练习盘：只写尺寸阶梯榜，不碰当日榜
        fetch('/api/leaderboard', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload)
        }).then(function () { if (!ladderOnly) loadRank(ms); }).catch(function () { if (!ladderOnly) loadRank(ms); });
      }

      function loadRank(ms) {
        var box = $('hw-rank');
        if (!box) return;
        var s = streak();
        var head = s.cur > 0 ? '🔥 ' + s.cur + '-day streak' : 'First board today';
        fetch('/api/leaderboard?game=huepaw&date=' + encodeURIComponent(S.id) + '&_=' + Date.now())
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (data) {
            var entries = data && Array.isArray(data.entries) ? data.entries : null;
            var html = '<div class="hw-rank-head">' + head + '</div>';
            if (!entries) { box.innerHTML = html; box.hidden = false; return; } // 接口不可达/异常：不冒称名次
            if (entries.length) {
              var faster = 0;
              for (var i = 0; i < entries.length; i++) if (entries[i].timeMs < Math.round(ms)) faster++;
              var mine = 'Your time ' + fmtTime(ms) + ' · #' + (faster + 1);
              if (entries.length >= 20 && faster >= 20) mine = 'Your time ' + fmtTime(ms) + ' · outside top 20';
              html += '<div class="hw-rank-you">' + mine + '</div><ol class="hw-rank-list">';
              for (var j = 0; j < Math.min(3, entries.length); j++) {
                var e = entries[j];
                var nm = String(e.name || 'Anonymous Cat').replace(/[<>&]/g, '');
                html += '<li>' + nm + (e.guest ? ' · guest' : '') + ' <b>' + fmtTime(e.timeMs) + '</b></li>';
              }
              html += '</ol>';
            } else {
              html += '<div class="hw-rank-you">Your time ' + fmtTime(ms) + " — first result on this board.</div>";
            }
            box.innerHTML = html;
            box.hidden = false;
          })
          .catch(function () {
            box.innerHTML = '<div class="hw-rank-head">' + head + '</div>';
            box.hidden = false;
          });
      }

      function shareText() {
        var when = S.mode === 'daily' ? S.id : 'practice';
        return 'Huepaw ' + when + ' — ' + S.size + '×' + S.size + ' gradient solved in ' + S.moves + ' swaps (' + fmtTime(win._ms || 0) + '). New board every midnight, local time.';
      }

      /* ── Toast ─────────────────────────────────────────────────── */
      var toastT = null;
      function toast(msg) {
        var el = $('toast');
        el.textContent = msg;
        el.classList.add('show');
        clearTimeout(toastT);
        toastT = setTimeout(function () { el.classList.remove('show'); }, 3200);
      }

      /* ── 绑定 ──────────────────────────────────────────────────── */
      playBtn.addEventListener('click', function () { begin(archiveId ? 'archive' : 'daily', null, archiveId); });
      if (archiveId) {
        var coverSub = document.querySelector('.hw-cover-sub');
        var archSize = sizeForYmd(archiveId);
        if (coverSub) coverSub.textContent = 'Replaying the ' + archiveId + ' daily board — same tiles as that day.';
        playBtn.textContent = '▶ Play the ' + archiveId + ' board';
        badgeEl.textContent = 'Archive · ' + archiveId + ' · ' + archSize + '×' + archSize;
      }
      document.querySelectorAll('#hw-ladder-tabs [data-lad]').forEach(function (b) {
        b.addEventListener('click', function () { loadLadder(Number(b.getAttribute('data-lad'))); });
      });
      loadLadder(LAD_TAB);
      $('hw-hint').addEventListener('click', doHint);
      $('hw-peek').addEventListener('click', peek);
      $('hw-restart').addEventListener('click', function () {
        if (!S.p) { begin('daily'); return; }
        var usedHints = 3 - S.hints;
        // 只用过 hint/peek 也算进度（提示额度是稀缺资源，不该被一次误点清掉）
        if ((S.moves > 0 || usedHints > 0) && !window.confirm('Restart this board? Your progress (' +
            S.moves + (S.moves === 1 ? ' swap' : ' swaps') +
            (usedHints ? ', ' + usedHints + (usedHints === 1 ? ' hint' : ' hints') + ' used' : '') +
            ') will be reset.')) return;
        S.board = S.initial.slice(); S.moves = 0; S.sel = -1; S.hints = 3; S.over = false; S.lockedClicks = 0;
        stopTimer(); timerEl.textContent = '0:00'; S.firstMove = false;
        targetEl.hidden = true; clearHint(); paint();
        winEl.classList.remove('show'); ticketEl.classList.remove('reveal');
        toast('Board reset — same tiles, clean slate.');
      });
      $('hw-today').addEventListener('click', function () {
        var todayId = localYmd(new Date());
        // 当天盘还在进行中：保留进度（清空只能走 Restart），只把棋盘带回视野
        if (S.p && S.mode === 'daily' && S.id === todayId && !S.over) {
          ensureBoardVisible();
          toast("You're already on today's board — Restart clears it.");
          return;
        }
        // 其余情况（练习盘、或昨天的盘还没解完）统一走换盘守卫，旧盘不会被静默覆盖
        var label = (S.p && S.mode === 'daily' && S.id !== todayId) ? "today's board (a new day)" : "today's board";
        if (!confirmDiscard(label)) return;
        winEl.classList.remove('show'); ticketEl.classList.remove('reveal');
        clearHint();
        begin('daily');
      });
      $('hw-new').addEventListener('click', function () {
        if (!confirmDiscard('a new practice board')) return;
        winEl.classList.remove('show'); ticketEl.classList.remove('reveal');
        if (!S.engine) { begin('practice', S.size); return; }
        newPuzzle('practice', S.size);
      });
      $('hw-labels').addEventListener('click', function () {
        var on = this.getAttribute('aria-pressed') !== 'true';
        this.setAttribute('aria-pressed', on ? 'true' : 'false');
        this.textContent = on ? '# Labels on' : '# Labels off';
        boardEl.classList.toggle('show-labels', on);
      });
      document.querySelectorAll('.diff-btn').forEach(function (b) {
        b.addEventListener('click', function () {
          var size = Number(b.getAttribute('data-size'));
          if (!confirmDiscard('a ' + size + '×' + size + ' practice board')) return;
          winEl.classList.remove('show'); ticketEl.classList.remove('reveal');
          begin('practice', size);
        });
      });
      $('hw-win-next').addEventListener('click', function () {
        winEl.classList.remove('show'); ticketEl.classList.remove('reveal');
        newPuzzle('practice', S.size);
      });
      $('hw-share-copy').addEventListener('click', function () {
        var t = shareText();
        if (navigator.clipboard) navigator.clipboard.writeText(t).then(function () { toast('Copied — paste it anywhere!'); });
        else toast(t);
        track('share_copy', { game: 'huepaw', size: S.size });
      });
      $('hw-share-twitter').addEventListener('click', function () {
        window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareText()) + '&url=' + encodeURIComponent('https://gridpaw.com/huepaw/'), '_blank', 'noopener');
        track('share_twitter', { game: 'huepaw', size: S.size });
      });
      $('hw-share-reddit').addEventListener('click', function () {
        window.open('https://www.reddit.com/submit?url=' + encodeURIComponent('https://gridpaw.com/huepaw/') + '&title=' + encodeURIComponent(shareText()), '_blank', 'noopener');
        track('share_reddit', { game: 'huepaw', size: S.size });
      });

      // JS 就绪后把封面的静态文案换成今天的真实尺寸（JS 前不得出现错误尺寸）。
      // 这里刻意不加载引擎（三态要求：点了才加载），尺寸表与 engine 的
      // DAILY_SIZES 是同一份 [3,5,4,5,4,5,4]，引擎侧由 scripts/selftest-gradient.mjs 守着。
      var DAILY_SIZES = [3, 5, 4, 5, 4, 5, 4];
      function refreshCoverLabels() {
        var now = new Date();
        var size = (window.GradientEngine && window.GradientEngine.dailySize)
          ? window.GradientEngine.dailySize(now) : DAILY_SIZES[now.getDay()];
        if (S.p) {
          // 正在玩昨天的每日盘：提示新盘已就绪（不强制替换，用顶部 Today 自己决定）
          var todayId = localYmd(now);
          if (S.mode === 'daily' && S.id !== todayId && S.noticedId !== todayId) {
            S.noticedId = todayId; // 按日期去重，跨多个午夜也能再提示
            toast("A new daily board is ready — tap Today's board.");
          }
          return;
        }
        if (archiveId) return; // 归档盘封面文案属于那一天，不随今日尺寸刷新
        badgeEl.textContent = 'Daily · ' + size + '×' + size;
        playBtn.textContent = '▶ Play Today\'s ' + size + '×' + size + ' Board';
      }
      refreshCoverLabels();
      document.addEventListener('visibilitychange', function () { if (!document.hidden) refreshCoverLabels(); });
      setInterval(refreshCoverLabels, 60000); // 前台跨本地午夜也能换封面尺寸/发新盘提示

      var viewed = false;
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting && !viewed) { viewed = true; track('game_view', { game: 'huepaw' }); }
          });
        }, { threshold: 0.4 });
        io.observe($('play'));
      }
    })();
  </script>

</body>
</html>
