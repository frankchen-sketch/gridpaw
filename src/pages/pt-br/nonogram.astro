---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import AdSlot from '../../components/AdSlot.astro';
// TODO: PT 词表待人工审校

const title = "Nonogram Online Grátis — Jogo de Lógica de Imagem (Paint-by-Number) | GridPaw";
const description = "Jogue Nonogram online grátis: um puzzle de lógica onde você pinta células para revelar um desenho oculto, seguindo as pistas numéricas das linhas e colunas. Com tutorial, campanha e desafios diários — sem cadastro.";

const faqJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "O que é Nonogram?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nonogram — em português também chamado de nonograma —, também conhecido como Picross, Griddler ou paint-by-number, é um jogo de lógica japonês jogado em uma grade. Os números em cada linha e coluna indicam os tamanhos dos blocos preenchidos consecutivos naquela direção. Ao preencher as células certas, uma imagem oculta aparece — como um desenho que se revela com a lógica."
        }
      },
      {
        "@type": "Question",
        name: "Como jogar Nonogram online grátis?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Toque em uma célula uma vez para preenchê-la, de novo para marcá-la como vazia com um X, e de novo para limpá-la. Comece pelas linhas cujas pistas fixam células imediatamente: uma pista 5 em uma linha de 5 células preenche a linha inteira, e uma pista 4 em uma linha de 5 preenche pelo menos três células. Cruze as informações entre linhas e colunas e a imagem se resolve sozinha."
        }
      },
      {
        "@type": "Question",
        name: "Nonogram e Picross são a mesma coisa?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Sim — Nonogram, Picross, Griddler, Paint by Numbers e Palavras Cruzadas Japonesas são todos nomes para o mesmo tipo de puzzle. O nome Picross é uma marca registrada da Jupiter Corporation, então sites independentes como o GridPaw usam o nome genérico Nonogram. As regras são idênticas."
        }
      },
      {
        "@type": "Question",
        name: "O que ganho ao resolver um Nonogram?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Uma imagem. Cada Nonogram esconde um desenho nas células preenchidas, e os níveis do GridPaw são temáticos: os tutoriais e os primeiros níveis da campanha revelam gatos. Resolver a lógica lhe dá a revelação — é esse momento que faz os jogadores de Nonogram voltarem."
        }
      },
      {
        "@type": "Question",
        name: "Preciso chutar no Nonogram?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Não. Grades bem construídas são solucionáveis apenas com lógica pura — cada célula é forçada pelas regras. Todo tabuleiro do GridPaw é verificado para ter exatamente uma solução, e quando você trava, o botão de dica revela uma célula verdadeira."
        }
      }
    ]
  }
];
---
<!DOCTYPE html>
<html lang="pt-BR">
