---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import AdSlot from '../../components/AdSlot.astro';
// TODO: PT 词表待人工审校

const title = "Kakuro Online Grátis — Jogo de Lógica de Somas Cruzadas | GridPaw";
const description = "Jogue Kakuro online grátis: o palavras-cruzadas com números. Somas que se cruzam, sem repetir dígitos. Com tutorial, 11 níveis e modo névoa exclusivo — sem download.";

const faqJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "O que é Kakuro?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Kakuro, também chamado de Somas Cruzadas (Cross Sums), é um jogo de lógica japonês frequentemente descrito como um palavras-cruzadas matemático. Cada sequência de células brancas deve somar o valor da dica no início, e nenhum dígito pode se repetir dentro da mesma sequência. Kakuro parece Sudoku, mas joga com combinações de soma em vez de regras de posicionamento."
        }
      },
      {
        "@type": "Question",
        name: "Como jogar Kakuro?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Toque em qualquer célula branca e depois toque em um dígito no teclado numérico. Cada célula pertence a duas sequências: uma horizontal e uma vertical. Ambas devem atingir a soma da dica sem dígitos repetidos. O teclado marca dígitos que seriam repetição (riscados) ou que estourariam a soma restante (em vermelho), então você aprende as regras jogando."
        }
      },
      {
        "@type": "Question",
        name: "Kakuro é mais difícil que Sudoku?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "É diferente, não necessariamente mais difícil. Sudoku testa eliminação em linhas, colunas e blocos; Kakuro testa combinações de soma. Resolver começa com aritmética de dicas — saber que 17 em duas células só pode ser 8+9. Iniciantes geralmente acham nosso tutorial de 4 passos suficiente para começar a resolver com confiança."
        }
      },
      {
        "@type": "Question",
        name: "Este jogo de Kakuro é gratuito?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Sim. Todos os níveis, o modo névoa e os puzzles diários são gratuitos no navegador, sem download e sem cadastro. As espiadas na névoa e as dicas vêm com tolerâncias gratuitas por nível."
        }
      },
      {
        "@type": "Question",
        name: "O que é o modo névoa?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "O modo névoa é uma inovação do GridPaw para Kakuro que nenhum outro site oferece. A partir do Nível 4, parte do tabuleiro fica oculta sob uma névoa com patinhas de gato. Resolva o bloco visível corretamente e a névoa se levanta. Cada tabuleiro com névoa tem exatamente uma solução garantida."
        }
      }
    ]
  }
];
---
<!DOCTYPE html>
<html lang="pt-BR">
