---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import AdSlot from '../../components/AdSlot.astro';
// TODO: PT 词表待人工审校

const title = "Nurikabe Online Grátis — Jogo de Lógica de Ilhas e Mar | GridPaw";
const description = "Jogue Nurikabe online grátis: construa ilhas numeradas em um mar conectado, sem permitir um quadrado 2×2 de oceano. Com tutorial, campanha e desafios diários — sem cadastro.";

const faqJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "O que é Nurikabe?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Nurikabe é um jogo de lógica japonês jogado em uma grade. Algumas células contêm números; cada número é o tamanho de uma ilha — um grupo conectado de células brancas — e cada ilha contém exatamente um número. Todas as células restantes são mar (pretas). O mar deve formar uma única área conectada e nunca pode conter um quadrado 2×2. O nome vem de um espírito do folclore japonês que se manifesta como um muro."
        }
      },
      {
        "@type": "Question",
        name: "Como jogar Nurikabe online grátis?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Toque em uma célula para alternar entre ilha, mar e desconhecido. Comece pelos números: uma pista 1 diz que seus quatro vizinhos são mar, e uma pista 2 em um canto fixa uma ilha inteira imediatamente. Observe também o mar — duas células de mar que formariam um quadrado 2×2 devem ser ilhas, e uma célula que nenhuma ilha pode alcançar deve ser mar."
        }
      },
      {
        "@type": "Question",
        name: "Quais estratégias resolvem Nurikabe mais rápido?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Três hábitos cobrem a maior parte do tabuleiro. Primeiro, esgote cada ilha: quando uma ilha atinge seu número, toda célula vizinha desconhecida vira mar. Segundo, proteja o mar: qualquer ilha que cortaria o mar em dois ou completaria um quadrado 2×2 preto é impossível. Terceiro, conte o alcance: uma célula que nenhuma ilha inacabada pode alcançar dentro de sua capacidade restante deve ser mar."
        }
      },
      {
        "@type": "Question",
        name: "Preciso chutar no Nurikabe?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Não. Tabuleiros bem construídos de Nurikabe são solucionáveis apenas com lógica pura — cada célula é determinada pelas três regras. Todo tabuleiro do GridPaw é verificado para ter exatamente uma solução, e o botão de dica revela uma célula verdadeira quando você trava."
        }
      },
      {
        "@type": "Question",
        name: "Nurikabe é mais difícil que Sudoku?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "São desafios diferentes. Nurikabe tem uma curva de aprendizado mais íngreme por causa da regra do mar conectado — é fácil criar uma parede de ilhas que divide o oceano em duas partes sem perceber. Mas as grades pequenas se resolvem em minutos, e a sensação de ver o tabuleiro se encaixar é única. Nurikabe é um excelente próximo passo para quem já domina Sudoku ou Shikaku."
        }
      }
    ]
  }
];
---
<!DOCTYPE html>
<html lang="pt-BR">
