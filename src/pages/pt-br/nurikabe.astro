  <link rel="alternate" hreflang="en" href="https://gridpaw.com/nurikabe/" />
  <link rel="alternate" hreflang="x-default" href="https://gridpaw.com/nurikabe/" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style is:global>
    body { font-family: 'Nunito', sans-serif; background: #FFF8F0; color: #3D3229; margin: 0; }
    main { max-width: 52.5rem; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
    .breadcrumb { max-width: 52.5rem; margin: 0.75rem auto 0; padding: 0 1rem; font-size: 0.85rem; color: #8A7A6A; }
