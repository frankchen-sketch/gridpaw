---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import AdSlot from '../../components/AdSlot.astro';
// TODO: PT 词表待人工审校

const title = "Pictomino Online Grátis — Jogo de Lógica de Dominós | GridPaw";
const description = "Jogue Pictomino online grátis: coloque dominós na grade para formar uma imagem completa. Um puzzle de lógica visual que combina dominó com paint-by-number — sem cadastro.";

const faqJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "O que é Pictomino?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Pictomino é um jogo de lógica que combina elementos de dominó com paint-by-number. Em uma grade com números nas bordas, você coloca dominós (peças de duas células) que se encaixam perfeitamente. Quando todos os dominós estão no lugar certo, uma imagem se revela. É um puzzle visual e lógico ao mesmo tempo — criado pela Nikoli, a editora japonesa do Sudoku."
        }
      },
      {
        "@type": "Question",
        name: "Como jogar Pictomino online grátis?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Arraste e solte os dominós na grade seguindo as pistas numéricas. Cada dominó cobre exatamente duas células adjacentes, e todos os dominós juntos preenchem a grade sem sobreposição. As pistas nas bordas indicam quantas células de cada linha ou coluna devem ser preenchidas. No GridPaw você joga direto no navegador, grátis, sem cadastro."
        }
      },
      {
        "@type": "Question",
        name: "Pictomino é igual a Nonogram?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Não, embora ambos revelem imagens. No Nonogram você preenche células individuais seguindo pistas de blocos. No Pictomino você coloca dominós — peças de duas células — e as pistas nas bordas dizem quantas células de cada linha ou coluna participam. A lógica é diferente: enquanto Nonogram é sobre sequências, Pictomino é sobre encaixe de peças."
        }
      },
      {
        "@type": "Question",
        name: "Preciso saber jogar dominó para jogar Pictomino?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Não. O nome Pictomino vem de 'picture' (imagem) + 'domino', mas você não precisa conhecer as regras do dominó tradicional. As peças são apenas retângulos de duas células que você encaixa na grade seguindo a lógica do puzzle. As regras são explicadas no tutorial do jogo."
        }
      },
      {
        "@type": "Question",
        name: "Pictomino é grátis?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Sim. No GridPaw você joga Pictomino direto no navegador, grátis, sem download e sem cadastro. O puzzle incorporado nesta página já está pronto para jogar, e a versão completa com todos os níveis está disponível no site em inglês."
        }
      }
    ]
  }
];
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <SEOHead
    title={title}
    description={description}
    canonical="/pt-br/pictomino"
    type="article"
    breadcrumbTitle="Pictomino em Português"
  />
  <link rel="alternate" hreflang="pt-BR" href="https://gridpaw.com/pt-br/pictomino/" />
  <link rel="alternate" hreflang="en" href="https://gridpaw.com/pictomino/" />
  <link rel="alternate" hreflang="x-default" href="https://gridpaw.com/pictomino/" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style is:global>
    body { font-family: 'Nunito', sans-serif; background: #FFF8F0; color: #3D3229; margin: 0; }
    main { max-width: 52.5rem; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
