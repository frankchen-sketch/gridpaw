const title = "Akari Online Grátis — Light Up, Jogo de Lógica Japonês | GridPaw";
const description = "Jogue Akari (Light Up) online grátis: coloque lâmpadas na grade até iluminar cada célula branca. Regras, dicas e puzzle interativo — sem download, sem cadastro.";

const faqJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "O que é Akari (Light Up)?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Akari, também conhecido como Light Up, é um jogo de lógica japonês da Nikoli. Você coloca lâmpadas em células brancas de modo que todas as células brancas fiquem iluminadas, nenhuma lâmpada enxergue outra e os números nas células pretas indiquem quantas lâmpadas devem estar ao lado. Puro raciocínio, sem chutes."
        }
      },
      {
        "@type": "Question",
        name: "Posso jogar Akari grátis online?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Sim. No GridPaw você joga Akari direto no navegador, grátis, sem download e sem cadastro. O puzzle completo está disponível na página do jogo com vários tamanhos e níveis de dificuldade."
        }
      },
      {
        "@type": "Question",
        name: "Qual a estratégia básica do Akari?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Comece pelos números altos: um 4 nos quatro lados de uma célula preta significa uma lâmpada em cada direção. Um 0 já resolve aquela vizinhança inteira. Depois, identifique células que só podem ser iluminadas por uma única posição — essas são obrigatórias."
        }
      },
      {
        "@type": "Question",
        name: "Akari é mais fácil que Shikaku?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "São desafios diferentes. Shikaku é mais visual e direto; Akari exige pensar em alcance de luz e evitar que lâmpadas se enxerguem. Iniciantes costumam achar Shikaku um pouco mais simples, mas Akari recompensa quem gosta de planejar vários movimentos à frente."
        }
      }
    ]
  }
];
---
