---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import AdSlot from '../../components/AdSlot.astro';
// TODO: PT 词表待人工审校

const title = "Shikaku Online Grátis — Jogo de Lógica Japonês | GridPaw";
const description = "Jogue Shikaku online grátis: divida a grade em retângulos até cada número se encaixar. Com regras, dicas e um puzzle para jogar direto — sem cadastro.";

const faqJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "O que é Shikaku?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Shikaku é um jogo de lógica japonês da Nikoli. Em uma grade com números, você divide o tabuleiro em retângulos de modo que cada retângulo contenha exatamente um número e tenha exatamente a quantidade de células que o número indica. Todas as regras se resolvem com raciocínio puro — nunca é preciso chutar."
        }
      },
      {
        "@type": "Question",
        name: "Posso jogar Shikaku grátis online?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Sim. No GridPaw você joga Shikaku direto no navegador, grátis, sem download e sem cadastro. O puzzle abaixo nesta página já está pronto para jogar, e a versão completa com todos os níveis está na página inicial."
        }
      },
      {
        "@type": "Question",
        name: "Qual estratégia funciona no Shikaku?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Comece pelos números maiores, pois eles têm poucas formas possíveis de retângulo. Preste atenção especial aos números nos cantos e nas bordas, porque cabem menos formatos ali. Números ímpares também ajudam: um retângulo com área ímpar precisa ter lados ímpares, como 3×3 ou 3×5."
        }
      },
      {
        "@type": "Question",
        name: "Shikaku é mais difícil que Sudoku?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Não, a regra é mais simples que a do Sudoku. Grades pequenas se resolvem em minutos; as grandes exigem planejamento de verdade. Shikaku é um ótimo ponto de partida para jogos de lógica japoneses porque as regras se explicam em trinta segundos."
        }
      }
    ]
  }
];
---
