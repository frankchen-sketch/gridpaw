---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import GameCoach from '../../components/GameCoach.astro';
import pool from '../../data/tracks-puzzles.json';

// ── Train Tracks — GridPaw game page ───────────────────────────────────────
// Boards come from src/data/tracks-puzzles.json (scripts/gen-tracks-pool.mjs).
// Nothing is generated in the browser: 8×8 takes 6.2s and 10×10 freezes the
// main thread. Hints are cheap (deduce ≈ 1ms on 12×12), so those stay runtime.
//
// Engine: public/tracks-engine.js (global TracksEngine, bundled by
// scripts/bundle-engine.mjs from src/lib/puzzle-core/tracks-engine.ts).
// Sizes: 6×6 easy / 8×8 medium / 10×10 hard (label = board size; `grade` in the
// data is the solver's own rating and is shown nowhere on this page).
const boards = Object.fromEntries(
  (['6', '8', '10'] as const).map((n) => [
    n,
    (pool.boards as Record<string, any[]>)[n].map((b) => ({
      rows: b.rows, cols: b.cols,
      rowClues: b.rowClues, colClues: b.colClues,
      start: b.start, end: b.end, pathLen: b.pathLen,
      difficulty: b.difficulty, solution: b.solution,
    })),
  ]),
);
const totalBoards = Object.values(boards).reduce((a, l) => a + l.length, 0);

const title = 'Train Tracks Puzzle — Play Free Online, 6×6 to 10×10';
const description = `Play Train Tracks free online: one unbroken railway from A to B, every row and column count satisfied, no crossings. ${totalBoards} hand-checked boards from 6x6 to 10x10, with hints that show the rule behind every move. No download.`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <SEOHead title={title} description={description} canonical="/train-tracks-puzzle/" type="website" image="/og-train-tracks-puzzle.png" />
  <link rel="alternate" hreflang="en" href="https://gridpaw.com/train-tracks-puzzle/">
  <link rel="alternate" hreflang="x-default" href="https://gridpaw.com/train-tracks-puzzle/">
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': 'WebSite', '@id': 'https://gridpaw.com/#website', url: 'https://gridpaw.com/', name: 'GridPaw' },
      {
        '@type': 'WebApplication',
        name: 'GridPaw Train Tracks Puzzle',
        applicationCategory: 'GameApplication',
        operatingSystem: 'Web Browser',
        url: 'https://gridpaw.com/train-tracks-puzzle/',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        description,
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'GridPaw', item: 'https://gridpaw.com/' },
          { '@type': 'ListItem', position: 2, name: 'Train Tracks', item: 'https://gridpaw.com/train-tracks-puzzle/' },
        ],
      },
    ],
  })} />
</head>
<body>
  <GameNav />

  <main class="tt-page">
    <header class="tt-head">
      <h1>Train Tracks Puzzle</h1>
      <p class="tt-sub">
        Draw one unbroken railway from <strong>A</strong> to <strong>B</strong>. Every square of track has
        exactly two joints, the numbers on each row and column say how many squares hold rail, and the
        line never crosses itself or splits.
      </p>
    </header>

    <div class="tt-controls">
      <div class="tt-seg" id="tt-sizes" role="group" aria-label="Board size">
        <button data-n="6" aria-pressed="false">6×6</button>
        <button data-n="8" aria-pressed="true">8×8</button>
        <button data-n="10" aria-pressed="false">10×10</button>
      </div>
      <button class="tt-btn" id="tt-new">New puzzle</button>
      <button class="tt-btn" id="tt-hint">Hint</button>
      <button class="tt-btn tt-btn-primary" id="tt-check">Check</button>
      <span class="tt-meta" id="tt-meta"></span>
    </div>

    <GameCoach
      game="train-tracks"
      steps={[
        'Drag on the grid to lay track.',
        'Every track square needs two joints.',
        'Row numbers count railed squares.',
      ]}
      rules={[
        { ic: '1', text: 'Drag along the grid to lay track. Drag again over a piece to erase it, or tap a single edge.' },
        { ic: '2', text: 'Every square holding track has exactly two joints — a straight piece or a corner.' },
        { ic: '3', text: '<b>A</b> and <b>B</b> are the ends: one joint each, and the line leaves the board through them.' },
        { ic: '4', text: 'The number beside a row or column counts the squares in it that hold rail.' },
        { ic: '5', text: 'The result is a single connected line — neighbouring rails run side by side without connecting.' },
      ]}
      rulesTitle="How to play Train Tracks"
    />

    <div class="tt-boardwrap">
      <svg id="tt-board" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Train Tracks board"></svg>
    </div>

    <p class="tt-msg" id="tt-msg" role="status" aria-live="polite"></p>

    <section class="tt-copy">
      <h2>How to play</h2>
      <ul>
        <li>Drag along the grid to lay track. Drag again over a piece to erase it, or tap a single edge.</li>
        <li>Every square holding track has exactly two joints — a straight piece or a corner.</li>
        <li><strong>A</strong> and <strong>B</strong> are the ends: one joint each, and the line leaves the board through them.</li>
        <li>The number beside a row or column counts the squares in it that hold rail.</li>
        <li>The result is a single connected line. Two rails running side by side in neighbouring squares is allowed — they simply do not connect.</li>
      </ul>

      <h2>Not sure where to start?</h2>
      <p>
        Press <strong>Hint</strong>. It does not reveal a random piece: it names the rule that forces the
        move — a row that already holds its count, a square that has run out of options, a piece that would
        cut the line off from A or B. That is how the puzzle is meant to be solved, and
        <a href="/train-tracks-puzzle/solver/">the solver page</a> walks a full 12×12 board through every
        deduction for you to watch.
      </p>

      <h2>Why these boards are fair</h2>
      <p>
        A Train Tracks board can be built from row and column counts alone, and still have several
        different answers — a solver that only checks the counts will happily accept one of them. Every
        board here was generated and then verified twice before shipping: exactly one solution, and a
        complete proof that needs no guessing. If you get stuck, there is always a deduction available.
      </p>
    </section>
  </main>

  <script type="application/json" id="tt-pool" set:html={JSON.stringify(boards)}></script>
  <script is:inline src="/tracks-engine.js"></script>
  <style is:global>
    .tt-page { max-width: 760px; margin: 0 auto; padding: 24px 16px 64px; }
    .tt-head h1 { font-size: 30px; line-height: 1.2; margin: 8px 0 8px; }
    .tt-sub { font-size: 16px; line-height: 1.6; margin: 0 0 16px; }
    .tt-controls { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 8px 0 12px; }
    .tt-seg { display: inline-flex; border: 1px solid currentColor; border-radius: 999px; overflow: hidden; }
    .tt-seg button { border: 0; background: transparent; color: inherit; padding: 6px 14px; font: inherit; font-size: 14px; cursor: pointer; }
    .tt-seg button[aria-pressed="true"] { background: #D97706; color: #fff; }
    .tt-btn { border: 1px solid currentColor; background: transparent; color: inherit; border-radius: 8px; padding: 6px 14px; font: inherit; font-size: 14px; cursor: pointer; }
    .tt-btn-primary { background: #D97706; border-color: #D97706; color: #fff; }
    .tt-meta { font-size: 13px; opacity: .7; }
    .tt-boardwrap { max-width: 520px; }
    .tt-boardwrap svg { width: 100%; height: auto; touch-action: none; user-select: none; display: block; }
    .tt-gl { stroke: #e4e4e7; stroke-width: 1; }
    .tt-clue { font-size: 15px; font-weight: 600; fill: currentColor; }
    .tt-clue.done { fill: #D97706; }
    .tt-rail { stroke: #1f2937; stroke-width: 7; stroke-linecap: round; }
    .tt-hit { stroke: transparent; stroke-width: 18; cursor: pointer; }
    .tt-badge { fill: #D97706; }
    .tt-badge-t { fill: #fff; font-size: 12px; font-weight: 700; }
    .tt-cellbad { fill: #dc2626; opacity: .12; }
    .tt-msg { font-size: 14px; line-height: 1.55; min-height: 46px; padding: 10px 12px; border-left: 3px solid #D97706; background: rgba(217,119,6,.06); border-radius: 0 8px 8px 0; }
    .tt-msg.ok { border-left-color: #15803d; background: rgba(21,128,61,.08); }
    .tt-msg.bad { border-left-color: #b91c1c; background: rgba(185,28,28,.07); }
    .tt-copy h2 { font-size: 20px; margin: 28px 0 8px; }
    .tt-copy li { margin: 6px 0; line-height: 1.55; }
    .tt-copy p { line-height: 1.65; }
    @media (prefers-color-scheme: dark) {
      .tt-gl { stroke: #333; }
      .tt-rail { stroke: #f4f4f5; }
    }
  </style>

  <script is:inline>
    (() => {
      const E = window.TracksEngine;
      const pool = JSON.parse(document.getElementById('tt-pool').textContent);
      const svg = document.getElementById('tt-board');
      const msgEl = document.getElementById('tt-msg');
      const metaEl = document.getElementById('tt-meta');
      const NS = 'http://www.w3.org/2000/svg';

      let N = 8;
      let puzzle = null;
      let state = null;
      let paintVal = null;
      let hintSteps = null;
      let S = 42, padL = 44, padT = 44;
      let hitsG = null, piecesG = null, topG = null;

      const say = (text, cls = '') => { msgEl.textContent = text; msgEl.className = 'tt-msg ' + cls; };

      const hydrate = (raw) => ({
        ...raw,
        rowClues: Int8Array.from(raw.rowClues),
        colClues: Int8Array.from(raw.colClues),
        solution: Uint8Array.from(raw.solution),
      });

      const midOf = (r, c, side) => {
        const x = padL + c * S, y = padT + r * S;
        if (side === 0) return [x + S / 2, y];
        if (side === 1) return [x + S / 2, y + S];
        if (side === 2) return [x, y + S / 2];
        return [x + S, y + S / 2];
      };

      function edgeHit(idx, x1, y1, x2, y2) {
        const hit = document.createElementNS(NS, 'line');
        hit.setAttribute('x1', x1); hit.setAttribute('y1', y1);
        hit.setAttribute('x2', x2); hit.setAttribute('y2', y2);
        hit.setAttribute('class', 'tt-hit');
        hitsG.appendChild(hit);
        const paint = (ev) => {
          ev.preventDefault();
          const v = paintVal !== null ? paintVal : (state[idx] === 1 ? 0 : 1);
          if (paintVal === null) paintVal = v;
          state[idx] = v;
          renderPieces();
        };
        hit.addEventListener('pointerdown', (ev) => { paintVal = null; paint(ev); });
        hit.addEventListener('pointerenter', (ev) => { if (ev.buttons) paint(ev); });
      }

      // Track is drawn inside cells — from the midpoint of a side through the
      // cell centre. Drawing it on the grid lines reads as a Slitherlink loop.
      function renderPieces() {
        const { rows, cols } = puzzle;
        piecesG.innerHTML = '';
        const line = (x1, y1, x2, y2) => {
          const l = document.createElementNS(NS, 'line');
          l.setAttribute('x1', x1); l.setAttribute('y1', y1);
          l.setAttribute('x2', x2); l.setAttribute('y2', y2);
          l.setAttribute('class', 'tt-rail');
          piecesG.appendChild(l);
        };
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const edges = E.cellEdges(rows, cols, r, c);
            const cx = padL + c * S + S / 2, cy = padT + r * S + S / 2;
            for (let b = 0; b < 4; b++) {
              if (state[edges[b]] !== 1) continue;
              const [mx, my] = midOf(r, c, b);
              line(mx, my, cx, cy);
            }
          }
        }
        const [ax, ay] = midOf(0, puzzle.start % cols, 0);
        line(ax, padT - 12, ax, ay);
        const [bx, by] = midOf(rows - 1, puzzle.end % cols, 1);
        line(bx, by, bx, padT + rows * S + 12);
        refreshLive();
      }

      function refreshLive() {
        const { rows, cols } = puzzle;
        const on = new Int16Array(rows * cols);
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            let n = 0;
            for (const e of E.cellEdges(rows, cols, r, c)) if (state[e] === 1) n++;
            on[E.ci(cols, r, c)] = n;
          }
        }
        for (const n of svg.querySelectorAll('.tt-cellbad')) n.remove();
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const idx = E.ci(cols, r, c);
            const isEnd = idx === puzzle.start || idx === puzzle.end;
            const n = on[idx];
            if (!(isEnd ? n > 1 : (n === 1 || n > 2))) continue;
            const rect = document.createElementNS(NS, 'rect');
            rect.setAttribute('x', padL + c * S + 2); rect.setAttribute('y', padT + r * S + 2);
            rect.setAttribute('width', S - 4); rect.setAttribute('height', S - 4);
            rect.setAttribute('rx', 4);
            rect.setAttribute('class', 'tt-cellbad');
            svg.insertBefore(rect, piecesG);
          }
        }
        for (let r = 0; r < rows; r++) {
          let n = 0;
          for (let c = 0; c < cols; c++) if (on[E.ci(cols, r, c)] > 0) n++;
          const t = svg.querySelector('[data-row-clue="' + r + '"]');
          if (t) t.classList.toggle('done', n === puzzle.rowClues[r]);
        }
        for (let c = 0; c < cols; c++) {
          let n = 0;
          for (let r = 0; r < rows; r++) if (on[E.ci(cols, r, c)] > 0) n++;
          const t = svg.querySelector('[data-col-clue="' + c + '"]');
          if (t) t.classList.toggle('done', n === puzzle.colClues[c]);
        }
      }

      function build() {
        const { rows, cols } = puzzle;
        S = N >= 10 ? 36 : N >= 8 ? 42 : 48;
        padL = 44; padT = 44;
        const W = padL + cols * S + 12, H = padT + rows * S + 12;
        svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
        svg.innerHTML = '';

        const g = document.createElementNS(NS, 'g');
        hitsG = document.createElementNS(NS, 'g');
        piecesG = document.createElementNS(NS, 'g');
        topG = document.createElementNS(NS, 'g');
        svg.appendChild(g); svg.appendChild(hitsG); svg.appendChild(piecesG); svg.appendChild(topG);

        for (let r = 0; r <= rows; r++) {
          const l = document.createElementNS(NS, 'line');
          l.setAttribute('x1', padL); l.setAttribute('x2', padL + cols * S);
          l.setAttribute('y1', padT + r * S); l.setAttribute('y2', padT + r * S);
          l.setAttribute('class', 'tt-gl'); g.appendChild(l);
        }
        for (let c = 0; c <= cols; c++) {
          const l = document.createElementNS(NS, 'line');
          l.setAttribute('x1', padL + c * S); l.setAttribute('x2', padL + c * S);
          l.setAttribute('y1', padT); l.setAttribute('y2', padT + rows * S);
          l.setAttribute('class', 'tt-gl'); g.appendChild(l);
        }
        for (let r = 0; r < rows; r++) {
          const t = document.createElementNS(NS, 'text');
          t.setAttribute('x', padL - 22); t.setAttribute('y', padT + r * S + S / 2 + 5);
          t.setAttribute('text-anchor', 'middle'); t.setAttribute('class', 'tt-clue');
          t.dataset.rowClue = String(r); t.textContent = String(puzzle.rowClues[r]);
          g.appendChild(t);
        }
        for (let c = 0; c < cols; c++) {
          const t = document.createElementNS(NS, 'text');
          t.setAttribute('x', padL + c * S + S / 2); t.setAttribute('y', padT - 18);
          t.setAttribute('text-anchor', 'middle'); t.setAttribute('class', 'tt-clue');
          t.dataset.colClue = String(c); t.textContent = String(puzzle.colClues[c]);
          g.appendChild(t);
        }
        const badge = (cx, cy, ch) => {
          const c2 = document.createElementNS(NS, 'circle');
          c2.setAttribute('cx', cx); c2.setAttribute('cy', cy); c2.setAttribute('r', 13);
          c2.setAttribute('class', 'tt-badge'); topG.appendChild(c2);
          const t = document.createElementNS(NS, 'text');
          t.setAttribute('x', cx); t.setAttribute('y', cy + 5); t.setAttribute('text-anchor', 'middle');
          t.setAttribute('class', 'tt-badge-t'); t.textContent = ch; topG.appendChild(t);
        };
        const ax = padL + (puzzle.start % cols) * S + S / 2;
        badge(ax, padT + S / 2 - 4, 'A');
        const bx = padL + (puzzle.end % cols) * S + S / 2;
        badge(bx, padT + (rows - 1) * S + S / 2 + 4, 'B');

        for (let r = 0; r <= rows; r++) {
          for (let c = 0; c < cols; c++) {
            edgeHit(E.hIdx(rows, cols, r, c), padL + c * S, padT + r * S, padL + (c + 1) * S, padT + r * S);
          }
        }
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c <= cols; c++) {
            edgeHit(E.vIdx(rows, cols, r, c), padL + c * S, padT + r * S, padL + c * S, padT + (r + 1) * S);
          }
        }
        renderPieces();
      }

      function newPuzzle(n) {
        if (n) N = n;
        const bag = pool[String(N)];
        puzzle = hydrate(bag[Math.floor(Math.random() * bag.length)]);
        state = new Int8Array(E.edgeCount(puzzle.rows, puzzle.cols)).fill(-1);
        hintSteps = null;
        build();
        metaEl.textContent = puzzle.rows + '×' + puzzle.cols + ' · ' + puzzle.pathLen + ' rail squares';
        say('Drag along the grid to lay track. Drag over a piece again to erase it.');
      }

      document.getElementById('tt-sizes').addEventListener('click', (ev) => {
        const b = ev.target.closest('button');
        if (!b) return;
        for (const x of document.querySelectorAll('#tt-sizes button')) {
          x.setAttribute('aria-pressed', String(x === b));
        }
        newPuzzle(Number(b.dataset.n));
      });
      document.getElementById('tt-new').addEventListener('click', () => newPuzzle());

      document.getElementById('tt-hint').addEventListener('click', () => {
        if (!hintSteps) hintSteps = E.deduce(puzzle).steps;
        const step = hintSteps.find((s) => state[s.edge] === -1);
        if (!step) { say('Nothing more follows from the rules — the rest is yours to judge.', ''); return; }
        state[step.edge] = step.value;
        renderPieces();
        const rows = puzzle.rows, cols = puzzle.cols;
        let where;
        if (step.edge < (rows + 1) * cols) {
          where = 'row ' + (Math.floor(step.edge / cols) + 1) + ', column ' + ((step.edge % cols) + 1) + ' (horizontal side)';
        } else {
          const t = step.edge - (rows + 1) * cols;
          where = 'row ' + (Math.floor(t / (cols + 1)) + 1) + ', column ' + ((t % (cols + 1)) + 1) + ' (vertical side)';
        }
        say('Hint — ' + where + ': ' + step.reason + ' → ' + (step.value ? 'lay rail.' : 'leave it empty.'));
      });

      document.getElementById('tt-check').addEventListener('click', () => {
        const edges = Uint8Array.from(state, (v) => (v === 1 ? 1 : 0));
        const undecided = Array.from(state).filter((v) => v === -1).length;
        const res = E.validate(puzzle, edges);
        if (res.ok) {
          say('Correct — one unbroken line from A to B, every row and column count satisfied.', 'ok');
          return;
        }
        if (undecided > 0) { say(undecided + ' sides still undecided — keep going.'); return; }
        say('Every side is decided, but the board does not work: ' + res.errors.slice(0, 2).join('; '), 'bad');
      });

      window.addEventListener('pointerup', () => { paintVal = null; });
      newPuzzle(8);
    })();
  </script>
</body>
</html>
