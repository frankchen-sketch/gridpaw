const title = "Arrows Puzzle: How to Play, Full Rules, and Beginner Tips";
const description = "Everything about the arrows puzzle: the complete rules broken down step by step, how the sliding-arrow placement mechanic works, five beginner tips, where to play, and answers to the most common questions.";

const faqJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What is an arrows puzzle?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "An arrows puzzle is a logic game where directional arrows must be placed on a grid so that each arrow points at its own target. In the popular mobile version Arrows – Puzzle Escape you slide arrow tiles through empty cells: arrows move like sliding blocks, cannot be lifted off the board, and locked tiles never move. Every level has exactly one arrangement where every arrow points at a target."
        }
      },
      {
        "@type": "Question",
        name: "How do you play the arrows puzzle?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "You start with a grid of empty cells, a set of arrow tiles, and a set of targets. Drag any arrow tile into an adjacent empty cell (or slide it along a clear path) until it sits in the cell that gives it a clear line of sight to its target. The level is solved when every arrow points at one target. Locked tiles stay in place, and in color levels each colored arrow must point at a target of the same color."
        }
      },
      {
        "@type": "Question",
        name: "What do the colored arrows mean in the arrows puzzle?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Colored arrows are color-locked: a blue arrow must point at a blue target, and a red arrow must point at a red target. Colors turn the puzzle into several smaller sub-puzzles solved in parallel. When both colors share the grid, solve each color's structure separately before re-combining them on the shared board."
        }
      },
      {
        "@type": "Question",
        name: "Is the arrows puzzle good for your brain?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. Arrows puzzles train spatial planning, sequential reasoning, and working memory — the same cognitive skills exercised by classic Japanese grid puzzles. Each move asks you to hold a mental map of slide paths and targets, which is exactly the kind of planning practice that keeps reasoning sharp. It also has a built-in reward loop: every solved level is a small, earned win."
        }
      },
      {
        "@type": "Question",
        name: "What is the difference between the arrows puzzle and Shikaku?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Shikaku (rectangle partition) asks you to divide a grid into rectangles, each containing one number equal to its area, so it is about partitioning space. The arrows puzzle is about placement and direction: every arrow must find a cell from which it can point at its target. Both train spatial logic, but Shikaku is purely about shapes while arrows puzzles are about orientation and movement."
        }
      },
      {
        "@type": "Question",
        name: "Where can I play the arrows puzzle for free?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "The official Arrows – Puzzle Escape app by Ecffri is free to download on Android and iOS and has over 100 million installs. The web does not have an official browser version of the exact same levels. For a free browser puzzle with the same spatial-reasoning feel, GridPaw's Shikaku game runs entirely online with no download, no signup, and unlimited procedurally generated levels."
        }
      }
    ]
  }
];
