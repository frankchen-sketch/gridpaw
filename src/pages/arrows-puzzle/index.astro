  <script is:inline>
    // Rules demo: 4x4 mini arrows board. 'ok' = clear path to the edge (green outline),
    // 'blk' = another arrow sits in the slide path (red ✕), 'off' = empty cell.
    (function () {
      const el = document.getElementById('xdemo');
      const R = [
        ['U', 'R', 'R', 'D'],
        ['L', 'L', 'R', 'U'],
        ['U', 'R', 'L', 'L'],
        ['D', 'D', 'L', null]
      ];
      const mark = { '0,0': 'ok', '2,2': 'blk' }; // (0,0) ↑ clears the top edge; (2,2) → is blocked by (2,3) ←
      const arrow = { U: '↑', D: '↓', L: '←', R: '→' };
      for (let r = 0; r < 4; r++) for (let c = 0; c < 4; c++) {
        const d = document.createElement('div');
        d.className = 'c' + (mark[r + ',' + c] ? ' ' + mark[r + ',' + c] : (R[r][c] ? '' : ' off'));
        if (R[r][c]) d.textContent = arrow[R[r][c]];
        el.appendChild(d);
      }
    })();
  </script>
