---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import ExtensionPromo from '../../components/ExtensionPromo.astro';
import AdSlot from '../../components/AdSlot.astro';
import SideAd from '../../components/SideAd.astro';

const title = "Arrows Puzzle: How to Play, Full Rules, and Beginner Tips";
const description = "Everything about the arrows puzzle: the complete rules broken down step by step, how the sliding-arrow placement mechanic works, five beginner tips, where to play, and answers to the most common questions.";

const faqJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How many levels are in Arrows Puzzle Escape?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Arrows – Puzzle Escape has thousands of handcrafted levels per the official listing, plus a daily challenge that keeps adding fresh boards. The developer has not published an exact total. The official difficulty ladder runs Normal, Hard, Super Hard, and Nightmare."
        }
      },
      {
        "@type": "Question",
        name: "Who makes Arrows Puzzle Escape?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Arrows – Puzzle Escape is made by Lessmore GmbH. It is free to play on Android and iOS, with over 100 million downloads and a 4.7-star rating on Google Play."
        }
      },
      {
        "@type": "Question",
        name: "How do hearts work in Arrows Puzzle Escape?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "You start each level with 3 hearts. Tapping an arrow whose slide path is blocked by another arrow causes a collision and costs one heart. The goal is to clear the grid without losing a single heart, and because there is no timer there is never a reason to risk a careless tap."
        }
      },
      {
        "@type": "Question",
        name: "Does Arrows Puzzle Escape have hints?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. Arrows – Puzzle Escape has a built-in hint system for when a board deadlocks. Since collisions cost hearts, using a hint is usually cheaper than guessing into a blocked path."
        }
      },
      {
        "@type": "Question",
        name: "Is there a timer in Arrows Puzzle Escape?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "No. Arrows – Puzzle Escape has no timer — the only pressure is your three hearts. You can study any board for as long as you like before tapping an arrow."
        }
      },
      {
        "@type": "Question",
        name: "Is Arrows Puzzle Escape free?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. Arrows – Puzzle Escape is a free-to-play mobile game with ads on Google Play and the App Store, with over 100 million downloads. It is not available as an official browser game — the exact levels are mobile-only."
        }
      }
    ]
  }
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead
    title={title}
    description={description}
    canonical="/arrows-puzzle"
    type="article"
    breadcrumbTitle="Arrows Puzzle"
  />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --ap-primary: #E87A4F;
      --ap-secondary: #6B8FE8;
      --ap-bg: #FFFAF5;
      --ap-cell-border: #F0DFD2;
      --ap-text: #42352E;
      --ap-text-light: #A08D80;
      --ap-shadow-sm: 0 2px 8px rgba(232,122,79,0.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Nunito', -apple-system, sans-serif; background: var(--ap-bg); color: var(--ap-text); min-height: 100vh; }
    .breadcrumb { font-size: 12px; color: var(--ap-text-light); padding: 14px 16px 0; text-align: center; }
    .breadcrumb a { color: var(--ap-text-light); text-decoration: none; }
    .breadcrumb a:hover { color: var(--ap-primary); }
    .seo-section { max-width: 720px; margin: 0 auto; padding: 1.5rem 1rem 1rem; }
    .seo-section h1 { font-size: 1.7rem; color: var(--ap-text); margin: 1rem 0 0.5rem; line-height: 1.3; }
    .seo-section h2 { font-size: 1.35rem; color: var(--ap-text); margin: 2rem 0 0.6rem; line-height: 1.3; }
    .seo-section h2 .accent { color: var(--ap-primary); }
    .seo-section h3 { font-size: 1.1rem; color: var(--ap-text); margin: 1.2rem 0 0.4rem; }
    .seo-section p { margin: 0.5rem 0; line-height: 1.75; color: #555; }
    .seo-section ul, .seo-section ol { padding-left: 1.5rem; margin: 0.5rem 0; color: #555; }
    .seo-section li { margin-bottom: 0.4rem; line-height: 1.6; }
    .seo-section a { color: var(--ap-primary); }
    .seo-section details { margin: 0.6rem 0; padding: 0.6rem 0.9rem; background: white; border: 1.5px solid var(--ap-cell-border); border-radius: 10px; box-shadow: var(--ap-shadow-sm); }
    .seo-section details[open] { border-color: var(--ap-primary); }
    .seo-section summary { cursor: pointer; font-weight: 800; color: var(--ap-text); line-height: 1.5; }
    .seo-section summary:hover { color: var(--ap-primary); }
    .seo-section details p { margin-top: 0.5rem; }
    .seo-footer { text-align: center; margin: 2rem 0 1rem; font-size: 0.8rem; color: var(--ap-text-light); }
    .seo-footer a { color: var(--ap-text-light); }
    .seo-footer a:hover { color: var(--ap-primary); }
    .cta-box { margin: 1.2rem 0; padding: 0.9rem 1.1rem; background: white; border: 2px dashed var(--ap-primary); border-radius: 12px; text-align: center; }
    .cta-box p { margin: 0.2rem 0; font-weight: 700; color: var(--ap-text); }
    .cta-box a { color: var(--ap-primary); font-weight: 800; text-decoration: none; }
    .cta-box a:hover { text-decoration: underline; }
    .disclaimer { font-size: 0.82rem; color: var(--ap-text-light); font-style: italic; background: #fff; border: 1px solid var(--ap-cell-border); border-radius: 8px; padding: 0.5rem 0.8rem; margin: 0.6rem 0 1rem; }
    .lede { font-size: 1rem; color: #3a4054; line-height: 1.75; margin: 0.5rem 0 0.25rem; }

    /* ===== callouts ===== */
    .callout { font-size: 0.88rem; padding: 0.55rem 0.75rem; border-radius: 8px; margin: 0.7rem 0; display: flex; gap: 6px; align-items: flex-start; line-height: 1.6; }
    .callout.warn { background: #FFF4E0; color: #92610A; border: 1px dashed #E8B15C; }
    .callout.grn { background: rgba(34,197,94,.1); color: #15803d; }

    /* ===== rules demo ===== */
    .rulewrap { display: flex; gap: 14px; align-items: flex-start; flex-wrap: wrap; background: #fff; border: 1.5px solid var(--ap-cell-border); border-radius: 10px; padding: 12px 14px; margin: 6px 0; box-shadow: var(--ap-shadow-sm); }
    .rulewrap ol { margin: 0; padding-left: 0; list-style: none; counter-reset: rl; flex: 1; min-width: 260px; }
    .rulewrap ol li { counter-increment: rl; position: relative; padding: 0 0 10px 30px; font-size: 0.78rem; color: #555; line-height: 1.55; }
    .rulewrap ol li:last-child { padding-bottom: 0; }
    .rulewrap ol li::before { content: counter(rl); position: absolute; left: 0; top: 1px; width: 19px; height: 19px; border-radius: 50%; background: #42352E; color: #FFFAF5; font-size: 10.5px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
    .rulewrap ol li b { display: block; color: #333A4E; font-size: 0.84rem; margin-bottom: 1px; }
    .xdemo { display: grid; grid-template-columns: repeat(4, 21px); grid-auto-rows: 21px; gap: 2px; background: #fff; padding: 3px; border: 2px solid #D8DFF2; border-radius: 8px; flex: 0 0 auto; }
    .xdemo .c { border-radius: 3px; background: #EDF1FF; display: flex; align-items: center; justify-content: center; font-size: 12px; color: #333A4E; font-weight: 800; position: relative; }
    .xdemo .ok { outline: 2px solid #1E7A3C; outline-offset: -2px; }
    .xdemo .blk::after { content: "✕"; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 13px; color: #B3261E; font-weight: 900; background: rgba(255,255,255,.6); border-radius: 3px; }
    .xdemo .off { opacity: .22; }

    /* ===== strategy list ===== */
    .strat { margin: 6px 0; columns: 2; column-gap: 30px; }
