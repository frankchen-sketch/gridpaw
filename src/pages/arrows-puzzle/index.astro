    .strat .st i { font-style: normal; color: var(--ap-primary); font-weight: 800; font-size: 1.05rem; line-height: 1.15; flex: 0 0 16px; font-family: Georgia, 'Times New Roman', serif; }
    .strat .st b { color: var(--ap-text); }

    /* ===== snapshot gallery ===== */
    .snaprow { display: flex; gap: 12px; margin: 6px 0; flex-wrap: wrap; }
    .snaprow figure { flex: 1 1 150px; margin: 0; text-align: center; }
    .snaprow img { width: 100%; max-width: 200px; border-radius: 8px; border: 1.5px solid #D8DFF2; }
    .snaprow figcaption { font-size: 10px; color: var(--ap-text-light); margin-top: 3px; }

    @media (max-width: 600px) {
      .strat { columns: 1; }
    }
    @media (max-width: 480px) {
      .seo-section h1 { font-size: 1.4rem; }
      .seo-section h2 { font-size: 1.2rem; }
      .seo-section { padding: 1.2rem 0.8rem 1rem; }
    }

    .cmp { width:100%; border-collapse:collapse; margin:1.2rem 0 0.6rem; font-size:0.95rem; }
    .cmp th, .cmp td { border:1px solid #F0DFD2; padding:0.6rem 0.75rem; text-align:left; vertical-align:top; color:#42352E; }
    .cmp thead th { background:#42352E; color:#FFFAF5; font-size:0.85rem; }
    .cmp tbody th { background:#FBF3EA; font-weight:700; white-space:nowrap; }
    .cmp-note { font-size:0.9rem; color:#A08D80; font-style:italic; }
    @media (max-width:620px){ .cmp thead{display:none;} .cmp tbody tr{display:block; margin:0 0 0.7rem;} .cmp tbody th, .cmp tbody td{display:block; border:none; padding:0.2rem 0.5rem; white-space:normal;} .cmp tbody th{padding-bottom:0.1rem;} }
  </style>
