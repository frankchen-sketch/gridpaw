const description = 'How to play GridPaw Kakuro (Cross Sums): fill runs that add to the clue with no repeats, read the keypad colors, and use fog mode.';

const faqs = [
  {
    q: 'Do I need an account to play Kakuro?',
    a: 'No. Everything is playable without signing in; progress is saved in your browser.',
  },
  {
    q: 'What do the two small numbers in a black cell mean?',
    a: 'The number in the top-left (next to the wall\'s corner) is the clue for the run going down; the number bottom-right is the clue for the run going right. Tap any clue cell and the run it controls lights up, so you always know which cells a number governs.',
  },
  {
    q: 'Why won\'t my digit stay?',
    a: 'It was wrong for one of two reasons: the digit is already used in that run (flashes red, "no repeats!") or it would overflow the run\'s clue sum (flashes orange). The game never keeps an invalid digit — and if your board becomes impossible to finish, it tells you ("one of your earlier digits must be wrong").',
  },
  {
    q: 'What does the keypad coloring mean?',
    a: 'Struck-through = duplicate in this cell\'s runs; pink background = larger than the remaining sum; amber ring = legal. It\'s a live hint system that teaches the rules as you play.',
  },
  {
    q: 'How many hints do I get?',
    a: '3 per level, shown on the hint button badge. They refill on the next level. Peek allowances (2 per fog level) are separate from hints.',
  },
  {
    q: 'Is there a timer or lives?',
    a: 'No. Kakuro on GridPaw has no lives and no countdown — you can take as long as you like, and even step away; your level is saved.',
  },
  {
    q: 'Is fog mode fair?',
    a: 'Yes — fog blocks never share a run, and every fog board is generated with exactly one solution, so lifting the fog never breaks your progress.',
  },
];
