const title = 'Pictomino Help: How to Play the Cat Puzzle Game';
const description = 'How to play GridPaw Pictomino for kids: memorize the picture, place the pieces on the + spots, earn stars and points, and beat the Daily Challenge.';

const faqs = [
  {
    q: 'Do I need an account to play Pictomino?',
    a: 'No. Everything is playable signed out; the account (optional Google Sign in) only unlocks cloud streak sync and the daily leaderboard.',
  },
  {
    q: 'How do I place a piece?',
    a: 'Tap the + spot on the board — you do not need to select the tray piece first (tapping it just plays a selection animation). Correct spots snap the piece in; wrong spots cost a life.',
  },
  {
    q: 'I\'m stuck on a level. What do I do?',
    a: 'Tap 👁 Peek at the picture (2s) after losing to re-see the full image, or Skip this puzzle → to move on. Wrong guesses reveal information too — the piece stays in the tray, so try another +.',
  },
  {
    q: 'What do the blurred pieces mean?',
    a: 'On Medium and above the candidate piece is deliberately blurred/dimmed to force comparison, not recognition. The higher the level, the weaker the piece (weak → super-weak).',
  },
  {
    q: 'Why did my round restart with fewer lives?',
    a: 'The timer ran out on a timed level — it costs 1 life and resets the current round\'s fills on the same puzzle.',
  },
  {
    q: 'Can my child play alone?',
    a: 'Yes — pre-readers can play with no text; there\'s no reading required to place pieces. Cat facts after each win add a reading moment to share.',
  },
  {
    q: 'Is progress saved?',
    a: 'Per-level best stars survive reloads (pictomino_stars); streak and best time are stored locally and cloud-synced when signed in (best-of-both merged). The cat lineup re-shuffles on every page load.',
  },
  {
    q: 'Is this game like a jigsaw?',
    a: 'It\'s the same idea with a logic twist: only a few candidate + spots are active at once and the piece may be blurred — you deduce from edges and colors instead of trying every spot.',
  },
  {
    q: 'Are the cats real breeds?',
    a: 'Yes — 15 real breeds (pictures under assets/cats/), each with 3 verified fun facts shown after you complete its puzzle.',
  },
];
