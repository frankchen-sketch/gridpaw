---
import SEOHead from '../../components/SEOHead.astro';
import GameNav from '../../components/GameNav.astro';
import AdSlot from '../../components/AdSlot.astro';
import SideAd from '../../components/SideAd.astro';
import InContentAd from '../../components/InContentAd.astro';

const title = 'Amochiroom Room Sort — Play All 133 Rooms Online';
const description =
  'Play the Room Sort item-sorting puzzle from Amochiroom Puzzle in your browser: tap an item, send it to the open box that wants it, and keep your buffer clear. All 133 rooms, no sign-up.';
const canonical = '/amochiroom/play';

const faq = [
  {
    q: 'What is this version of Room Sort?',
    a: 'It is the item-sorting Room Sort that ships inside Amochiroom Puzzle: Room Sort (com.gamefactory.roomsort, version 1.0.20). You empty a messy room into labelled boxes while a small buffer absorbs anything no open box wants yet.',
  },
  {
    q: 'How do you play it?',
    a: 'Tap any item lying in the room. If one of the open boxes is waiting for that category, the item flies into it and counts. If no open box wants it, the item goes into your buffer. Clear every box and the room is done.',
  },
  {
    q: 'Why does the buffer matter so much?',
    a: 'You start with five buffer slots out of seven, and only two boxes are open at a time. Anything you tap that no open box wants takes a slot. When all five are full and nothing left on the floor can go into an open box, the run dead-ends.',
  },
  {
    q: 'How many rooms can I play?',
    a: 'All 133 rooms from version 1.0.20, in the order the game ships them, from My Study through Lost and Found.',
  },
  {
    q: 'Is this the same as Room Sort - Floor Plan Game?',
    a: 'No. That one is a different puzzle: you fit room-shaped tiles into a floor plan and match doors. We host a free build of that too — see Room Sort — Floor Plan Puzzle.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const gameJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Amochiroom Room Sort',
  url: 'https://gridpaw.com/amochiroom/play/',
  applicationCategory: 'Game',
  gamePlatform: 'Web browser',
  genre: 'Puzzle',
  isAccessibleForFree: true,
  description:
    'A browser version of the Room Sort item-sorting puzzle: tap items into the boxes that want them while keeping the buffer clear.',
};
---

<!doctype html>
<html lang="en">
<head>
  <SEOHead
    title={title}
    description={description}
    canonical={canonical}
    type="article"
    breadcrumbTitle="Play Amochiroom Room Sort"
  />
  <link rel="alternate" hreflang="en" href="https://gridpaw.com/amochiroom/play/" />
  <link rel="alternate" hreflang="x-default" href="https://gridpaw.com/amochiroom/play/" />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(gameJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
  <GameNav />
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/amochiroom/">Amochiroom Room Sort Answers</a> › Play</nav>

  <main class="rs-main">
    <h1>Amochiroom Room Sort — Play Online</h1>
    <p class="rs-lede">
      Tap an item, send it to the open box that wants it, and keep the buffer clear. All 133 rooms of
      Amochiroom Puzzle: Room Sort, playable right here — no download, no sign-up. Stuck on a room?
      <a href="/amochiroom/">The box lists for every level</a> are published too.
    </p>

    <div class="rs-wrap">
      <div class="rs-bar">
        <label class="rs-picker-label" for="rsPicker">Level</label>
        <select id="rsPicker" class="rs-picker" aria-label="Choose a level"></select>
        <span id="rsLevelTitle" class="rs-level-title">Loading…</span>
        <span id="rsTimer" class="rs-timer">⏱ 0:00</span>
        <button id="rsHint" class="rs-hint-btn" type="button">Hint (3)</button>
        <button id="rsRestart" class="rs-restart" type="button">Restart</button>
      </div>

      <div id="rsRoom" class="rs-room" role="application" aria-label="Room with items to sort"></div>

      <p class="rs-hint">Items are drawn at the positions the game ships them. Items in front can be tapped; ones behind can't.</p>

      <div class="rs-panels">
        <section class="rs-panel" aria-labelledby="rsBoxesHead">
          <h2 id="rsBoxesHead" class="rs-panel-head">Open boxes</h2>
          <div id="rsBoxes" class="rs-boxes"></div>
        </section>
        <section class="rs-panel" aria-labelledby="rsBufferHead">
          <h2 id="rsBufferHead" class="rs-panel-head">Buffer <span id="rsBufferCount" class="rs-buffer-count">0/5</span></h2>
          <div id="rsBuffer" class="rs-buffer"></div>
        </section>
      </div>

      <p id="rsStatus" class="rs-status" hidden></p>
    </div>

    <section class="rs-sec">
      <h2>How to play</h2>
      <ol class="rs-steps">
        <li><b>Two boxes are open at a time.</b> Each one lists a category and how many items it wants.</li>
        <li><b>Tap what they want.</b> Matching items fly in and count toward the box.</li>
        <li><b>Everything else goes to the buffer.</b> You have five open slots out of seven.</li>
        <li><b>Do not fill the buffer.</b> If all five slots are taken and nothing left on the floor fits an open box, the run is dead.</li>
      </ol>
      <p class="rs-tip">
        The one habit that fixes most failed runs: only park an item if the box that wants it is about to open.
        Parking three random items early is what kills a run twenty taps later.
      </p>
    </section>

    <InContentAd />

    <section class="rs-sec">
      <h2>Stuck on a level?</h2>
      <p>
        Every room’s box list — how many boxes, which categories, how many items each one wants — is published from the
        game’s own data. Start with <a href="/amochiroom/">all 133 Room Sort answers</a>, or use the
        <a href="/amochiroom/find/">box finder</a> if you only remember one item that was on the floor.
      </p>
    </section>

    <section class="rs-sec">
      <h2>Frequently asked questions</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <section class="rs-sec">
      <h2>Prefer the floor plan version?</h2>
      <p>
        Room Sort also names a different puzzle: fit room-shaped tiles into a floor plan where every door
        has to meet another door or an entry gap. <a href="/room-sort-game-online/">Play Room Sort — Floor Plan Puzzle</a>
        — 60 layouts, solved and verified before they ship.
      </p>
    </section>

    <p class="rs-evidence">
      Unofficial fan-made build. Level data and art come from Amochiroom Puzzle: Room Sort 1.0.20
      (com.gamefactory.roomsort), unpacked from the shipped APK. Not affiliated with ABF ALPENHOF.
    </p>
  </main>

  <AdSlot />
  <SideAd />

  <script is:inline src="/room-sort/engine.js"></script>
  <script is:inline>
    (function () {
      function boot() {
        if (!window.RoomSort) return;
        window.RoomSort.init();
        var btn = document.getElementById('rsRestart');
        if (btn) btn.addEventListener('click', function () { window.RoomSort.restart(); });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    })();
  </script>

  <style is:global>
    .rs-main { max-width: 840px; margin: 0 auto; padding: 1.2rem 1rem 3rem; }
    .rs-main h1 { font-size: clamp(1.5rem, 4vw, 2.1rem); margin: .4rem 0 .5rem; }
    .rs-lede { color: #555; line-height: 1.6; margin: 0 0 1rem; }

    .rs-wrap {
      background: #fff; border: 2px solid var(--border, #E7E0D4); border-radius: 16px;
      padding: .8rem; box-shadow: 0 2px 10px rgba(217,119,6,.08); margin-bottom: 1.2rem;
    }
    .rs-bar { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-bottom: .7rem; }
    .rs-picker-label { font-size: .78rem; font-weight: 900; letter-spacing: .05em; text-transform: uppercase; color: var(--amber-ink, #B45309); }
    .rs-picker {
      font: inherit; font-size: .85rem; padding: .3rem .5rem; border-radius: 8px;
      border: 1.5px solid var(--border, #E7E0D4); background: #fff; max-width: 46vw;
    }
    .rs-level-title { font-size: .85rem; font-weight: 800; color: #444; }
    .rs-restart {
      font: inherit; font-size: .8rem; font-weight: 800; cursor: pointer;
      background: var(--amber-ink, #B45309); color: #fff; border: 0; border-radius: 8px; padding: .35rem .8rem;
    }
    .rs-restart:hover { filter: brightness(1.08); }
    .rs-timer {
      margin-left: auto; font-size: .8rem; font-weight: 800; color: #8a7355;
      font-variant-numeric: tabular-nums;
    }
    .rs-hint-btn {
      font: inherit; font-size: .8rem; font-weight: 800; cursor: pointer;
      background: #FFF3DF; color: var(--amber-ink, #B45309); border: 1.5px solid #F0DFAE;
      border-radius: 8px; padding: .3rem .75rem;
    }
    .rs-hint-btn:hover:not(:disabled) { background: #FFE9C9; }
    .rs-hint-btn:disabled { opacity: .45; cursor: not-allowed; }

    /* 房间按宽高比缩放，高度封顶 64vh —— 玩家反馈物品本来就小、房间再小就看不清，从 52vh 抬高。
       仍留封顶：完全不封顶时 1440×900 桌面上房间会顶到 865px，箱子栏被推出首屏。 */
    .rs-room {
      position: relative; width: auto; max-width: 100%; max-height: 64vh;
      aspect-ratio: var(--rs-ar, 0.78); margin: 0 auto; border-radius: 12px; overflow: hidden;
      background-size: cover; background-position: center; background-color: #F3EEE4;
      touch-action: manipulation;
    }
    /* 手机上把房间压到 56vh 以内，否则箱子栏和缓冲栏要滚动才看得见 ——
       玩家点物品时看不到还有哪些箱子，等于盲玩。宽度由宽高比反推，居中。 */
    @media (max-width: 620px) {
      /* 首屏预算 812px：房间 317 + 箱子 81 + 缓冲 60 + 间距之后，头部只剩 ~330px。
         h1 / lede / breadcrumb 属于「进页时看一次」的信息，压掉它们把游戏顶上来。 */
      .breadcrumb { display: none; }
      .rs-main { padding-top: .5rem; }
      .rs-main h1 { font-size: 1.22rem; margin: 0 0 .35rem; }
      .rs-lede {
        font-size: .84rem; line-height: 1.5; margin-bottom: .6rem;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      }
      .rs-hint { display: none; }
      .rs-wrap { padding: .55rem; }
      .rs-picker { max-width: 100%; flex: 1 1 100%; order: 3; }
      .rs-level-title { order: 4; flex: 1 1 100%; font-size: .8rem; }
      .rs-bar { gap: .4rem; margin-bottom: .5rem; }
      .rs-room { max-height: 68vh; }
      .rs-panels { gap: .5rem; margin-top: .5rem; }
    }
    /* 矮屏分档：52vh 只够 900px 以上的视口，1280×800 会差十几像素，
       640px 的小屏更会差一屏 —— 按高度降档，并把「进页看一次」的文案让位给游戏。 */
    @media (max-height: 820px) {
      .rs-room { max-height: 56vh; }
    }
    @media (max-height: 700px) {
      .rs-lede, .rs-hint, .breadcrumb { display: none; }
      .rs-main { padding-top: .4rem; }
      .rs-main h1 { font-size: 1.05rem; margin: 0 0 .3rem; }
      .rs-room { max-height: 50vh; }
      .rs-panels { margin-top: .4rem; }
      .rs-bar { margin-bottom: .4rem; }
    }
    .rs-item {
      position: absolute; cursor: pointer; user-select: none; -webkit-user-drag: none;
      transform-origin: center; transition: filter .12s;
    }
    .rs-item:hover { filter: drop-shadow(0 0 3px rgba(217,119,6,.9)); }
    @keyframes rsHintPulse {
      0%, 100% { filter: drop-shadow(0 0 0 rgba(217,119,6,0)); }
      50% { filter: drop-shadow(0 0 7px rgba(217,119,6,1)); }
    }
    .rs-item--hint { animation: rsHintPulse .55s ease-in-out 4; z-index: 30; }
    .rs-item--gone {
      pointer-events: none; opacity: 0; scale: .4;
      transition: opacity .24s linear, scale .24s ease-in;
    }

    .rs-hint { font-size: .76rem; color: #777; margin: .5rem 0 0; line-height: 1.5; }

    .rs-panels { display: grid; grid-template-columns: 1.6fr 1fr; gap: .8rem; margin-top: .8rem; }
    @media (max-width: 620px) { .rs-panels { grid-template-columns: 1fr; } }
    .rs-panel { border: 1.5px solid var(--border, #E7E0D4); border-radius: 12px; padding: .55rem .6rem; background: #FFFDF9; }
    .rs-panel-head {
      font-size: .72rem; font-weight: 900; letter-spacing: .06em; text-transform: uppercase;
      color: var(--amber-ink, #B45309); margin: 0 0 .45rem; display: flex; align-items: center; gap: .4rem;
    }
    .rs-buffer-count { font-weight: 800; color: #666; letter-spacing: 0; text-transform: none; }

    .rs-boxes { display: grid; grid-template-columns: repeat(3, 1fr); gap: .4rem; }
    .rs-box {
      border: 1.5px solid var(--border, #E7E0D4); border-radius: 10px; padding: .35rem .4rem;
      background: #fff; display: flex; flex-direction: column; gap: .18rem; min-width: 0;
    }
    .rs-box--empty { opacity: .35; align-items: center; justify-content: center; }
    .rs-box-name { font-size: .72rem; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rs-box-count { font-size: .74rem; color: #666; }
    .rs-box-count b { color: var(--amber-ink, #B45309); }
    .rs-box-bar { display: block; height: 4px; background: #EFE7D9; border-radius: 3px; overflow: hidden; }
    .rs-box-bar i { display: block; height: 100%; background: #D97706; transition: width .28s; }
    .rs-box-thumbs { display: flex; gap: .15rem; margin-top: .1rem; }
    .rs-box-thumbs img { width: 20px; height: 20px; object-fit: contain; }

    .rs-buffer { display: grid; grid-template-columns: repeat(7, 1fr); gap: .3rem; }
    .rs-slot {
      aspect-ratio: 1; border-radius: 8px; border: 1.5px dashed #D8CFBF; background: #fff;
      display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .rs-slot--locked { background: #F0EAE0; border-style: solid; border-color: #E1D8C8; opacity: .55; }
    .rs-slot--used { border-style: solid; border-color: var(--amber, #D97706); background: #FFF7EC; }
    .rs-slot img { width: 88%; height: 88%; object-fit: contain; }

    .rs-status { margin: .8rem 0 0; padding: .55rem .8rem; border-radius: 10px; font-weight: 800; font-size: .88rem; line-height: 1.5; }
    .rs-status--win { background: #ECFDF5; color: #065F46; border: 1.5px solid #6EE7B7; }
    .rs-status--fail { background: #FEF2F2; color: #991B1B; border: 1.5px solid #FCA5A5; }
    .rs-status--warn { background: #FFFBEB; color: #92400E; border: 1.5px solid #FCD34D; }

    .rs-sec { margin: 1.8rem 0; }
    .rs-sec h2 { font-size: 1.22rem; margin: 0 0 .6rem; }
    .rs-sec p { line-height: 1.65; }
    .rs-steps { padding-left: 1.2rem; line-height: 1.75; }
    .rs-steps li { margin-bottom: .35rem; }
    .rs-tip {
      margin-top: .8rem; padding: .7rem .9rem; background: #FFF7EC;
      border: 1.5px solid #F0DFAE; border-radius: 10px; font-size: .92rem;
    }
    .rs-sec details {
      margin: .5rem 0; padding: .55rem .85rem; background: #fff;
      border: 1.5px solid var(--border, #E7E0D4); border-radius: 10px;
    }
    .rs-sec details[open] { border-color: var(--amber, #D97706); }
    .rs-sec summary { cursor: pointer; font-weight: 800; line-height: 1.5; }
    .rs-sec details p { margin-top: .45rem; }
    .rs-evidence {
      font-size: .78rem; color: #888; border-top: 1px solid var(--border, #E7E0D4);
      margin-top: 2rem; padding-top: .7rem; line-height: 1.6;
    }
  </style>
</body>
</html>
