        timerSec: 0,
        timerId: 0,
        gaStarted: false
      };

      function toast(msg, type) {
        toastEl.textContent = msg;
        toastEl.className = 'toast' + (type ? ' ' + type : '');
        setTimeout(function () { toastEl.classList.remove('show'); }, 2600);
        requestAnimationFrame(function () { toastEl.classList.add('show'); });
      }

      function fmtTime(s) {
        var m = Math.floor(s / 60), ss = s % 60;
        return m + ':' + (ss < 10 ? '0' : '') + ss;
      }

      function startTimer() {
        if (state.timerId) clearInterval(state.timerId);
        state.timerSec = 0;
        timerEl.textContent = '0:00';
        state.timerId = setInterval(function () {
          state.timerSec++;
          timerEl.textContent = fmtTime(state.timerSec);
        }, 1000);
      }

      function stopTimer() {
        if (state.timerId) { clearInterval(state.timerId); state.timerId = 0; }
      }

      // ── Generation（takuzu 规则固定开启：行列不重复）──
      function newPuzzle(difficulty) {
        var d = DIFFS[difficulty];
        state.difficulty = difficulty;
        state.size = d.size;
        var seed = (Date.now() ^ ((Math.random() * 0x7fffffff) | 0)) | 0;
        var p;
        try {
          p = BinaryEngine.generate(state.size, difficulty, seed, true);
        } catch (e) {
          toast('Failed to generate puzzle.', 'error');
          return;
        }
        state.puzzle = p;
        var N2 = state.size * state.size;
        state.board = new Int8Array(N2).fill(-1);
        state.locked = new Uint8Array(N2);
        for (var gi = 0; gi < p.givens.length; gi++) {
          var idx = p.givens[gi][0], val = p.givens[gi][1];
          state.board[idx] = val;
          state.locked[idx] = 1;
        }
        state.sel = -1;
        state.winShown = false;
        window.__firstMoveTracked = false; goTracked = false;
        state.hintsLeft = 3;
        // 徽标 / 难度按钮
        diffBadge.className = 'difficulty-badge ' + d.badge;
        diffBadge.textContent = d.full;
        difficultyNameEl.textContent = d.label;
        var diffBtns = document.querySelectorAll('.diff-btn');
        for (var b = 0; b < diffBtns.length; b++) {
          var on = diffBtns[b].getAttribute('data-diff') === difficulty;
          diffBtns[b].classList.toggle('active', on);
          diffBtns[b].setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        updateHintBtn();
        renderBoard();
        startTimer();
        fireGameStart();
        updateCellSize();
      }

      var gaFiredOnce = false;
      var goTracked = false;
      function fireGameStart() {
        if (gaFiredOnce) return;
        gaFiredOnce = true;
        track('game_start', { difficulty: DIFFS[state.difficulty].label, source: detectSource() });
      }

      // ── game_over（盘满但 validate 不过 = 首次提交校验失败，每关一次）──
      function fireGameOver() {
        if (goTracked) return;
        goTracked = true;
        track('game_over', { level: state.size, difficulty: DIFFS[state.difficulty].label, size: state.size });
      }

      // ── Cell sizing ──
      function updateCellSize() {
        var N = state.size;
        var avail = Math.min(window.innerWidth - 24, 620);
        var cell = Math.max(30, Math.min(72, Math.floor((avail - 4) / N), Math.floor((window.innerHeight - 360) / N)));
        wrapEl.style.setProperty('--cell', cell + 'px');
        cellsEl.style.gridTemplateColumns = 'repeat(' + N + ', var(--cell))';
      }

      // ── Live error scan（轻触方案）──
      // 三连相同 → 强红 .err；行/列某值超半数（含整行失衡）→ 浅红 .err-soft；
      // 重复的已完成行/列（takuzu）→ 淡紫 .dup，成对高亮。given 永不标错。
      function scanErrors() {
        var N = state.size, N2 = N * N, half = N / 2;
        var err = new Uint8Array(N2);   // three-in-a-row
        var soft = new Uint8Array(N2);  // unbalanced row/col
        var dup = new Uint8Array(N2);   // duplicated completed rows/cols
        var r0 = new Uint8Array(N), r1 = new Uint8Array(N),
            c0 = new Uint8Array(N), c1 = new Uint8Array(N);
        for (var i = 0; i < N2; i++) {
          var v = state.board[i];
          if (v < 0) continue;
          var r = (i / N) | 0, c = i % N;
          if (v === 0) { r0[r]++; c0[c]++; } else { r1[r]++; c1[c]++; }
        }
        for (var r = 0; r < N; r++) {
          for (var c = 0; c < N; c++) {
            var x = r * N + c, v2 = state.board[x];
            if (v2 < 0) continue;
            var run = 1;
            for (var cc = c - 1; cc >= 0 && state.board[r * N + cc] === v2; cc--) run++;
            for (var cc = c + 1; cc < N && state.board[r * N + cc] === v2; cc++) run++;
            if (run >= 3) { err[x] = 1; continue; }
            run = 1;
            for (var rr = r - 1; rr >= 0 && state.board[rr * N + c] === v2; rr--) run++;
            for (var rr = r + 1; rr < N && state.board[rr * N + c] === v2; rr++) run++;
            if (run >= 3) err[x] = 1;
          }
        }
        for (var r = 0; r < N; r++) {
          if (r0[r] > half || r1[r] > half) {
            for (var c = 0; c < N; c++) soft[r * N + c] = 1;
          }
        }
        for (var c = 0; c < N; c++) {
          if (c0[c] > half || c1[c] > half) {
            for (var r = 0; r < N; r++) soft[r * N + c] = 1;
          }
        }
        // duplicated completed rows
        var seen = {}, dupRows = {}, dupCols = {};
        for (var r = 0; r < N; r++) {
          var full = true, key = '';
          for (var c = 0; c < N; c++) {
            var v3 = state.board[r * N + c];
            if (v3 < 0) { full = false; break; }
            key += v3;
          }
          if (full) {
            if (seen[key] !== undefined) { dupRows[r] = 1; dupRows[seen[key]] = 1; }
            else seen[key] = r;
          }
        }
        seen = {};
        for (var c = 0; c < N; c++) {
          var full2 = true, key2 = '';
          for (var r = 0; r < N; r++) {
            var v4 = state.board[r * N + c];
            if (v4 < 0) { full2 = false; break; }
            key2 += v4;
          }
          if (full2) {
            if (seen[key2] !== undefined) { dupCols[c] = 1; dupCols[seen[key2]] = 1; }
            else seen[key2] = c;
          }
        }
        for (var k in dupRows) { var r5 = +k; for (var c = 0; c < N; c++) dup[r5 * N + c] = 1; }
        for (var k in dupCols) { var c5 = +k; for (var r = 0; r < N; r++) dup[r5 * N + c5] = 1; }
        return { err: err, soft: soft, dup: dup };
      }

      // ── Board render ──
      function renderBoard() {
        var N = state.size, N2 = N * N;
        var errs = scanErrors();
        var html = '';
        for (var r = 0; r < N; r++) {
          for (var c = 0; c < N; c++) {
            var i = r * N + c;
            var v = state.board[i];
            var cls = 'bp-cell';
            var style = '';
            if (c < N - 1) style += 'border-right:1px solid var(--gp-linen);';
            if (r < N - 1) style += 'border-bottom:1px solid var(--gp-linen);';
            if (state.locked[i]) {
              cls += ' given';
            } else if (v !== -1) {
              cls += ' user';
            }
            if (i === state.sel) cls += ' sel';
            // given 永不标错（given 之间不可能自相矛盾）
            if (!state.locked[i]) {
              if (errs.err[i]) cls += ' err';
              else if (errs.soft[i]) cls += ' err-soft';
              if (errs.dup[i]) cls += ' dup';
            }
            var digit = v === -1 ? '' : '<span class="bp-num">' + v + '</span>';
            html += '<div class="' + cls + '" data-i="' + i + '" role="gridcell" style="' + style + '">' + digit + '</div>';
          }
        }
        cellsEl.innerHTML = html;
      }

      // ── Hint（3 次/盘；dev/admin 无限）──
      function unlimitedHints() { return IS_DEV || isAdmin; }

      function updateHintBtn() {
        var unlimited = unlimitedHints();
        hintCountEl.textContent = unlimited ? '(∞)' : '(' + state.hintsLeft + ')';
        var empty = !unlimited && state.hintsLeft <= 0;
        hintBtn.classList.toggle('disabled', empty);
        hintBtn.setAttribute('aria-disabled', empty ? 'true' : 'false');
      }

      function useHint() {
        if (state.sel === -1) { toast('Select a cell first!'); return; }
        if (state.locked[state.sel]) { toast('That cell is already given.'); return; }
        if (!unlimitedHints()) {
          if (state.hintsLeft <= 0) {
            toast('No hints left — a new puzzle gives you 3 fresh hints', 'error');
            return;
          }
          state.hintsLeft--;
        }
        var val = BinaryEngine.hintLookup(state.puzzle, state.sel);
        state.board[state.sel] = val;
        track('hint_click', { level: state.size, difficulty: DIFFS[state.difficulty].label });
        updateHintBtn();
        renderBoard();
        maybeWin();
      }

      function clearSelected() {
        if (state.sel === -1 || state.locked[state.sel]) return;
        state.board[state.sel] = -1;
        renderBoard();
        maybeWin();
      }

      function setValue(i, v) {
        if (state.locked[i]) return;
        if (state.board[i] === v) return; // 重复输入保持
        if (!window.__firstMoveTracked) { window.__firstMoveTracked = true; track('first_move', { level: state.size, difficulty: DIFFS[state.difficulty].label }); }
        state.board[i] = v;
        renderBoard();
        maybeWin();
      }

      // 点按切换约定：empty → 0 → 1 → empty
      function toggleValue(i) {
        if (state.locked[i]) return;
        if (!window.__firstMoveTracked) { window.__firstMoveTracked = true; track('first_move', { level: state.size, difficulty: DIFFS[state.difficulty].label }); }
        var v = state.board[i];
        state.board[i] = (v === -1) ? 0 : (v === 0) ? 1 : -1;
        renderBoard();
        maybeWin();
      }

      // ── Win detection（盘满 + 引擎 validate.ok = 唯一解吻合）──
      function maybeWin() {
        if (state.winShown) return;
        var N2 = state.size * state.size;
        for (var i = 0; i < N2; i++) if (state.board[i] === -1) return;
        var res = BinaryEngine.validate(state.puzzle, state.board);
        if (!res.ok) { track('game_over', { level: state.size, difficulty: DIFFS[state.difficulty].label }); return; }
        showWin();
      }

      function showWin() {
        state.winShown = true;
        stopTimer();
        winDetailEl.textContent = state.size + '×' + state.size + ' ' + DIFFS[state.difficulty].label + ' solved in ' + fmtTime(state.timerSec) + '!';
        winOverlay.classList.add('show');
        launchConfetti();
        // leaderboard：上报成绩 + 胜利面板当日榜
        if (window.GPLeaderboard) {
          GPLeaderboard.submit('binary', state.timerSec * 1000).then(function () {
            return GPLeaderboard.mount('binary', document.getElementById('gp-lb-win'));
          });
        }
        track('level_up', { level: state.size, difficulty: DIFFS[state.difficulty].label, size: state.size });
      }

      function launchConfetti() {
        if (!confettiEl) return;
        confettiEl.innerHTML = '';
        var colors = ['#E8A888', '#88C8A8', '#FDD09F', '#CFC2E8', '#D47A50', '#559C68', '#FFB3C6'];
        for (var i = 0; i < 60; i++) {
          var d = document.createElement('div');
          d.className = 'confetti';
          d.style.left = (Math.random() * 100) + '%';
          d.style.top = '-10px';
          d.style.background = colors[i % colors.length];
          d.style.animationDuration = (2.2 + Math.random() * 2) + 's';
          d.style.animationDelay = (Math.random() * 0.9) + 's';
          d.style.width = d.style.height = (6 + Math.random() * 8) + 'px';
          confettiEl.appendChild(d);
        }
      }

      function closeWin() { winOverlay.classList.remove('show'); }

      // ── 分享 ──
      function shareText() {
        return 'I solved a ' + state.size + '×' + state.size + ' ' + DIFFS[state.difficulty].label + ' Binary Puzzle (Takuzu) on GridPaw in ' + fmtTime(state.timerSec) + '! Play free, no download → https://gridpaw.com/binary/';
      }

      // ── Events ──
      cellsEl.addEventListener('click', function (e) {
        var cell = e.target.closest('.bp-cell');
        if (!cell) return;
        var i = parseInt(cell.getAttribute('data-i'), 10);
        if (state.locked[i]) { state.sel = i; renderBoard(); return; }
        state.sel = i;
        toggleValue(i);
      });

      document.addEventListener('keydown', function (e) {
        if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
        if (e.key === 'Escape') {
          if (winOverlay.classList.contains('show')) closeWin();
          else if (rulesOverlay.classList.contains('show')) rulesOverlay.classList.remove('show');
          return;
        }
        // overlay 打开时不响应棋盘输入
        if (winOverlay.classList.contains('show') || rulesOverlay.classList.contains('show')) return;
        var N = state.size;
        if (e.key === '0' || e.key === '1') {
          if (state.sel !== -1) { e.preventDefault(); setValue(state.sel, parseInt(e.key, 10)); }
          return;
        }
        if (e.key === 'Backspace' || e.key === 'Delete') {
          if (state.sel !== -1) { e.preventDefault(); clearSelected(); }
          return;
        }
        var dir = { ArrowUp: -N, ArrowDown: N, ArrowLeft: -1, ArrowRight: 1 }[e.key];
        if (dir !== undefined) {
          e.preventDefault();
          if (state.sel !== -1) {
            var r = Math.floor(state.sel / N), c = state.sel % N;
            if (e.key === 'ArrowLeft' && c > 0) state.sel += dir;
            else if (e.key === 'ArrowRight' && c < N - 1) state.sel += dir;
            else if (e.key === 'ArrowUp' && r > 0) state.sel += dir;
            else if (e.key === 'ArrowDown' && r < N - 1) state.sel += dir;
            renderBoard();
          }
          return;
        }
      });

      hintBtn.addEventListener('click', useHint);

      document.getElementById('new-btn').addEventListener('click', function () {
        closeWin();
        newPuzzle(state.difficulty);
      });

      document.getElementById('reset-btn').addEventListener('click', function () {
        closeWin();
        // 同一盘：清空用户输入（锁定格保留），提示数保留（防止刷 hint）
        for (var i = 0; i < state.board.length; i++) {
          if (!state.locked[i]) state.board[i] = -1;
        }
        state.sel = -1;
        track('puzzle_reset', { level: state.size, difficulty: DIFFS[state.difficulty].label });
        renderBoard();
        startTimer();
      });

      document.getElementById('win-next').addEventListener('click', function () {
        closeWin();
        newPuzzle(state.difficulty);
      });

      document.getElementById('howto-chip').addEventListener('click', function () { rulesOverlay.classList.add('show'); });
      document.getElementById('rules-close').addEventListener('click', function () { rulesOverlay.classList.remove('show'); });
      rulesOverlay.addEventListener('click', function (e) { if (e.target === rulesOverlay) rulesOverlay.classList.remove('show'); });

      document.getElementById('share-copy').addEventListener('click', function () {
        track('share_copy', { level: state.size, difficulty: DIFFS[state.difficulty].label });
        navigator.clipboard.writeText(shareText()).then(function () {
          toast('📋 Copied to clipboard!', 'success');
        }).catch(function () {
          var ta = document.createElement('textarea');
          ta.value = shareText();
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); toast('📋 Copied to clipboard!', 'success'); } catch (e2) {}
          document.body.removeChild(ta);
        });
      });

      document.getElementById('share-twitter').addEventListener('click', function () {
        track('share_twitter', { level: state.size, difficulty: DIFFS[state.difficulty].label });
        var url = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareText()) + '&url=' + encodeURIComponent('https://gridpaw.com/binary/');
        window.open(url, '_blank', 'noopener,width=620,height=480');
      });

      document.getElementById('share-reddit').addEventListener('click', function () {
        track('share_reddit', { level: state.size, difficulty: DIFFS[state.difficulty].label });
        var title = 'I solved a ' + state.size + '×' + state.size + ' ' + DIFFS[state.difficulty].label + ' Binary Puzzle (Takuzu) on GridPaw!';
        var url = 'https://www.reddit.com/submit?url=' + encodeURIComponent('https://gridpaw.com/binary/') + '&title=' + encodeURIComponent(title);
        window.open(url, '_blank', 'noopener,width=680,height=520');
      });

      // 难度切换
      var diffBtns = document.querySelectorAll('.diff-btn');
      for (var b = 0; b < diffBtns.length; b++) {
        diffBtns[b].addEventListener('click', function () {
          if (this.getAttribute('data-diff') === state.difficulty) return;
          closeWin();
          newPuzzle(this.getAttribute('data-diff'));
        });
      }

      // ── Mobile nav ──
      document.getElementById('mobile-menu-btn').addEventListener('click', function () {
        document.getElementById('mobile-nav').style.display = 'block';
      });
      document.getElementById('mobile-nav-close').addEventListener('click', function () {
        document.getElementById('mobile-nav').style.display = 'none';
      });
      document.getElementById('mobile-nav').addEventListener('click', function (e) {
        if (e.target === this) this.style.display = 'none';
      });

      // ── 窗口尺寸变化时重算格子大小 ──
      window.addEventListener('resize', function () { updateCellSize(); });

      // ── Start ──
      newPuzzle('easy');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

</body>
</html>
