    <footer>
      <p>GridPaw - Takuzu Puzzle Online, Free in Your Browser · <a href="/binary/">Play Binary Puzzle</a></p>
      <p style="margin-top:0.3rem"><a href="https://www.pinterest.com/gridpaw/" rel="noopener">GridPaw on Pinterest</a></p>
    </footer>
  </div>
</body>
</html>
