---
import SEOHead from '../components/SEOHead.astro';
const title = "Shikaku Rules — Complete Guide with Examples | GridPaw";
const description = "The complete Shikaku rules explained with worked 5×5 examples. Learn the four core rules, common misconceptions, and how every puzzle is solved by logic alone.";

const faqs = [
  { q: "What are the rules of Shikaku?", a: "Divide the whole grid into rectangles so that each rectangle contains exactly one number, the number of cells in each rectangle equals that number, no two rectangles overlap, and no cell is left uncovered. Squares count as rectangles." },
  { q: "Can a rectangle contain two numbers?", a: "No. Every rectangle must contain exactly one numbered cell. If two numbers end up inside the same rectangle, the placement is illegal even if the area happens to match one of them." },
  { q: "Does the number have to be in a specific position inside the rectangle?", a: "No. The numbered cell can sit anywhere inside its rectangle — a corner, an edge, or the middle. Only the rectangle's total area and its single-number requirement matter." },
  { q: "Are the numbers in Shikaku always a perfect fit for the grid?", a: "Yes. In a valid puzzle the sum of all numbers equals the total number of cells. If a 5×5 board shows numbers adding up to 25, you know the rectangles will tile the grid exactly with no leftovers." },
  { q: "Is guessing ever required in Shikaku?", a: "No. A well-constructed Shikaku puzzle has exactly one solution and every step can be proven by elimination. If you cannot see a move, look for a number with only one legal shape or an empty cell that only one number can reach." },
  { q: "What happens if I draw a wrong rectangle on GridPaw?", a: "GridPaw checks the area against the number as you release the drag. A rectangle that does not match, contains no number, or contains two numbers is rejected. If a correctly sized rectangle turns out to be in the wrong place, tap it to remove it or press Undo." },
];
