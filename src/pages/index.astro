  function applyCloudProgress(cloud) {
    if (!cloud) return;
    var local = loadDailyState();
    var st = {
      date: getToday(),
      streak: cloud.streak || 0,
      bestStreak: cloud.bestStreak || 0,
      bestTime: cloud.bestTime != null ? Math.round(cloud.bestTime / 1000) : (local && local.bestTime) || null,
      solved: !!(local && local.solved),
      lastPlayedDate: cloud.lastSolvedDate || (local && local.lastPlayedDate) || null
    };
    localStorage.setItem(DAILY_KEY, JSON.stringify(st));
    var statusEl2 = document.getElementById('dailyStatus');
    if (statusEl2 && st.solved) statusEl2.innerHTML = '✅ Daily solved! 🔥 ' + st.streak + ' day streak';
  }
  function syncCloudOnLoad() {
    fetchWithTimeout('/api/auth/me').then(function(r) { return r.json(); }).then(function(me) {
      currentUser = me && me.user ? me.user : null;
      isAdmin = !!(currentUser && currentUser.googleSub && ADMIN_GOOGLE_SUBS.indexOf(currentUser.googleSub) !== -1);
      updateHintBadge();
      renderAccountArea();
      if (!currentUser) return;
      syncLevelOnLoad();
      fetchWithTimeout('/api/progress').then(function(r) {
        if (!r.ok) return null;
        return r.json();
      }).then(function(cloudData) {
        if (!cloudData) return;
        var cloud = cloudData.progress;
        var local = loadDailyState();
        var localBestSec = local && local.bestTime != null ? local.bestTime : null;
        var cloudBestMs = cloud && cloud.bestTime != null ? cloud.bestTime : null;
        var localHasMore = local && (!cloud ||
          (local.streak || 0) > (cloud.streak || 0) ||
          (local.bestStreak || 0) > (cloud.bestStreak || 0) ||
          (localBestSec != null && localBestSec * 1000 < (cloudBestMs == null ? Infinity : cloudBestMs)));
        if (localHasMore) {
          fetchWithTimeout('/api/progress', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              date: (local && (local.lastPlayedDate || local.date)) || null,
              streak: local.streak || 0,
              bestStreak: local.bestStreak || 0,
              bestTime: localBestSec != null ? localBestSec * 1000 : null
            })
          }).then(function(r) {
            if (!r.ok) return null;
            return r.json();
          }).then(function(merged) {
            if (merged && merged.progress) applyCloudProgress(merged.progress);
          }).catch(function() {});
        } else if (cloud) {
          applyCloudProgress(cloud);
        }
      }).catch(function() {});
    }).catch(function() { /* 静默降级 */ });
  }
  // ─── Level progress cloud sync (max merge) ────────────────────────
  function syncLevelOnLoad() {
    fetchWithTimeout('/api/level').then(function(r) {
      if (!r.ok) return null;
      return r.json();
    }).then(function(data) {
      if (!data || data.level == null) {
        // 云端无记录 → 上传本地关卡作为基线
        if (levelNum > 1) postLevel(levelNum);
        return;
      }
      if (data.level > levelNum) {
        // 云端领先（换设备恢复）→ 跳到云端关卡
        levelNum = data.level;
        localStorage.setItem('gridpaw-level', String(levelNum));
        newPuzzle();
      } else if (levelNum > data.level) {
        postLevel(levelNum);
      }
    }).catch(function() {});
  }
  function postLevel(level) {
    fetchWithTimeout('/api/level', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ level: level })
    }).catch(function() {});
  }

  function syncWinToCloud(state, elapsedSeconds) {
    if (!currentUser) return;
    fetchWithTimeout('/api/progress', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        date: getToday(),
        streak: state.streak || 0,
        bestStreak: state.bestStreak || 0,
        bestTime: state.bestTime != null ? state.bestTime * 1000 : null
      })
    }).catch(function() {});
    fetchWithTimeout('/api/leaderboard', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ date: getToday(), timeMs: Math.round(elapsedSeconds * 1000) })
    }).then(function() { renderLeaderboard(); }).catch(function() {});
  }
  function renderLeaderboard() {
    var list = document.getElementById('leaderboard-list');
    if (!list) return;
    fetchWithTimeout('/api/leaderboard?date=' + getToday()).then(function(r) {
      if (!r.ok) return null;
      return r.json();
    }).then(function(data) {
      if (!data) return;
      var entries = data.entries || [];
      var hintEl = document.getElementById('leaderboard-hint');
      if (hintEl) hintEl.style.display = entries.length ? 'none' : 'block';
      if (!entries.length) {
        list.innerHTML = '<p style="text-align:center;font-size:.85rem;color:#9E9590">🐾 Be the first cat on the leaderboard today!</p>';
        return;
      }
      var html = '';
      for (var i = 0; i < entries.length; i++) {
        var e = entries[i];
        var medal = e.rank === 1 ? '🥇' : e.rank === 2 ? '🥈' : e.rank === 3 ? '🥉' : '#' + e.rank;
        var safeName = String(e.name || 'Anonymous Cat').replace(/[<>&]/g, '');
        html += '<div style="display:flex;justify-content:space-between;padding:.4rem .6rem;border-bottom:1px solid #E8E0EB;font-size:.85rem">'
          + '<span style="font-weight:700;color:#3D3D3D">' + medal + ' ' + safeName + '</span>'
          + '<span style="color:#FF42A5;font-weight:700">' + msToClock(e.timeMs) + '</span></div>';
      }
      list.innerHTML = html;
    }).catch(function() {});
  }
  setInterval(renderLeaderboard, 60000);
  syncCloudOnLoad();
  renderLeaderboard();

  // 登录回跳错误提示
  try {
    const authErr = new URLSearchParams(window.location.search).get('auth_error');
    if (authErr) {
      const msg = authErr === 'access_denied' ? 'Sign-in was cancelled.' : 'Sign-in failed (' + authErr + '). Please try again.';
      const statusEl3 = document.getElementById('dailyStatus');
      if (statusEl3) { statusEl3.innerHTML = '⚠️ ' + msg; statusEl3.style.color = '#FF42A5'; }
      history.replaceState(null, '', window.location.pathname);
    }
  } catch (e) {}

  newPuzzle();
  track('game_start', { level: levelNum, difficulty: getDifficulty(levelNum).label });
  window.addEventListener('resize', function() { if (puzzle) render(); });

  // Testimonial carousel
  (function() {
    var track = document.getElementById('testimonialTrack');
    var dotsEl = document.getElementById('testimonialDots');
    if (!track || !dotsEl) return;
    var cards = track.querySelectorAll('.testimonial-card');
    var total = cards.length;
    for (var i = 0; i < total; i++) {
      var dot = document.createElement('button');
      dot.className = 'testimonial-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', 'Review ' + (i + 1));
      dot.dataset.idx = i;
      dot.addEventListener('click', function() {
        var idx = parseInt(this.dataset.idx);
        cards[idx].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      });
      dotsEl.appendChild(dot);
    }
    var dots = dotsEl.querySelectorAll('.testimonial-dot');
    var scrollTimer = null;
    track.addEventListener('scroll', function() {
      if (scrollTimer) clearTimeout(scrollTimer);
      scrollTimer = setTimeout(function() {
        var cardWidth = cards[0].offsetWidth + 12;
        var activeIdx = Math.round(track.scrollLeft / cardWidth);
        activeIdx = Math.max(0, Math.min(activeIdx, total - 1));
        dots.forEach(function(d, i) { d.classList.toggle('active', i === activeIdx); });
      }, 100);
    });
    var autoIdx = 0;
    setInterval(function() {
      autoIdx = (autoIdx + 1) % total;
      cards[autoIdx].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
    }, 4000);
  })();
</script>

