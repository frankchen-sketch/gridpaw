    .signin-prompt-btn:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
    .signin-prompt-later { display: block; margin: 12px auto 0; background: none; border: none; color: var(--gp-stone); font-size: 13px; font-weight: 700; cursor: pointer; text-decoration: underline; }
