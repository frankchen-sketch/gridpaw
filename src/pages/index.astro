    .game-switcher-menu a .game-desc { font-size: 11px; font-weight: 500; color: var(--gp-stone); }
    .game-switcher-menu a:hover { background: var(--gp-cream); color: var(--gp-primary-strong) !important; }
    .game-switcher-menu a.active { color: var(--gp-primary-strong) !important; background: var(--gp-cream-warm); font-weight: 800 !important; }
    @media (max-width: 480px) { .game-switcher:hover .game-switcher-menu { display: none; } .game-switcher-menu.open { display: block; } }
    .hamburger { display: none; background: none; border: 1.5px solid var(--mt-cell-border); border-radius: 8px; padding: 6px 10px; font-size: 18px; cursor: pointer; color: var(--gp-ink); }
    .mobile-nav { display: none; position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.4); }
    .mobile-nav-inner { position: absolute; top: 0; right: 0; width: 280px; height: 100%; background: white; padding: 1.5rem; box-shadow: -4px 0 20px rgba(0,0,0,0.1); }
    .mobile-nav-close { position: absolute; top: 1rem; right: 1rem; background: none; border: none; font-size: 1.5rem; color: var(--gp-ink); cursor: pointer; }
    .mobile-nav-inner a { display: block; padding: 0.75rem 0; font-weight: 700; color: var(--gp-ink); text-decoration: none; border-bottom: 1.5px solid var(--gp-lilac-soft); font-size: 14px; }
    .mobile-nav-inner a:last-child { border-bottom: none; }
    @media (max-width: 480px) { .header-nav { display: none; } .hamburger { display: block; } }
    /* Game Card */
    .game-card { background: white; border-radius: 16px; padding: 12px; box-shadow: 0 2px 12px rgba(78,64,55,0.08); border: 1.5px solid var(--gp-lilac-soft); margin-bottom: 0; }
