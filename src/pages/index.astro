    var dailySize = (dow === 0 || dow === 6) ? 14 : 10;
    var dailyPuzzle = generateDailyPuzzle(today, dailySize);
    if (!dailyPuzzle) { statusEl.textContent = 'Failed to generate daily puzzle.'; return; }
