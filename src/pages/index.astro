    .game-actions .icon-btn:hover .tip { display: block; }
    /* Walkthrough Grid (Level Guides) */
    .walkthrough-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin: 1rem 0; }
    .walkthrough-card { display: flex; flex-direction: column; background: white; border: 1.5px solid #E8E0EB; border-radius: 12px; overflow: hidden; text-decoration: none; color: #3D3D3D; transition: all 0.15s; }
    .walkthrough-card:hover { border-color: #D47A50; box-shadow: 0 4px 12px rgba(212,122,80,0.1); transform: translateY(-2px); }
    .walkthrough-img { width: 100%; aspect-ratio: 4/3; overflow: hidden; background: #E8DDD0; display: flex; align-items: center; justify-content: center; }
    .walkthrough-img img { width: 100%; height: 100%; object-fit: contain; }
    .walkthrough-text { padding: 10px 12px; }
    .walkthrough-text h3 { font-size: 13px; font-weight: 800; margin: 4px 0 2px; }
    .walkthrough-text p { font-size: 11px; color: #9E9590; line-height: 1.4; margin: 0; }
    /* Level Tags */
    .level-tag { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
    .tag-tutorial { background: #B8E8C0; color: #2D6A3F; }
    .tag-medium { background: #FCE883; color: #8B6914; }
    .tag-hard { background: #FF9A9E; color: #8B1A1A; }
    .tag-daily { background: #B3D9FF; color: #1A5A8B; }
    /* Featured Tip */
    .featured-tip { background: white; border: 1.5px solid #E8E0EB; border-radius: 12px; padding: 1.2rem; margin: 1rem 0; }
    .featured-tip-label { font-size: 11px; font-weight: 800; color: #D47A50; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
    .featured-tip h3 { font-size: 15px; font-weight: 900; margin-bottom: 0.5rem; }
    .featured-tip p { font-size: 13px; line-height: 1.7; color: #555; margin-bottom: 0.8rem; }
    .featured-tip-link { font-size: 13px; font-weight: 700; color: #D47A50; text-decoration: none; }
    .featured-tip-link:hover { text-decoration: underline; }
    /* Strategy List */
    .strategy-list { margin: 1rem 0; }
