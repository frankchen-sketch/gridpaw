<script is:inline>
  // Cat color palette (8 unique colors, no repeats per puzzle)
  var CAT_PALETTE = [
    { bg: '#FFB3C6', ear: '#E8A0B5' },  // pink
    { bg: '#CFC2E8', ear: '#B8A8D0' },  // lavender
    { bg: '#FDD09F', ear: '#E8C090' },  // orange
    { bg: '#B3D9FF', ear: '#98C8E8' },  // blue
    { bg: '#B8E8C0', ear: '#98D8A8' },  // mint
    { bg: '#FCE883', ear: '#E8D870' },  // yellow
    { bg: '#FF9A9E', ear: '#E88888' },  // coral
    { bg: '#A0E8E0', ear: '#88D0C8' },  // teal
  ];
  // 15 expression types [eyes, mouth]
  var EXPRESSIONS = [
    { e: ['e-closed','e-closed'], m: 'm-smile' },     // 0 sleepy
    { e: ['e-open','e-open'], m: 'm-smile' },          // 1 happy
    { e: ['e-open','e-closed'], m: 'm-smile' },        // 2 wink
    { e: ['e-angry','e-angry'], m: 'm-frown' },        // 3 angry
    { e: ['e-open','e-open'], m: 'm-open' },           // 4 surprised
    { e: ['e-closed','e-closed'], m: 'm-w' },          // 5 uwu
    { e: ['e-dot','e-dot'], m: 'm-flat' },             // 6 grumpy
    { e: ['e-open','e-closed'], m: 'm-tongue' },       // 7 playful
    { e: ['e-closed','e-closed'], m: 'm-smile' },       // 8 content
    { e: ['e-big','e-big'], m: 'm-small' },            // 9 curious
    { e: ['e-down','e-down'], m: 'm-frown' },          // 10 sad
    { e: ['e-closed','e-closed'], m: 'm-tongue' },     // 11 silly
    { e: ['e-big','e-big'], m: 'm-big-open' },         // 12 shocked
    { e: ['e-open','e-half'], m: 'm-smile' },          // 13 smug
    { e: ['e-closed','e-closed'], m: 'm-pout' },       // 14 pout
  ];
  var colorPool = [];
  var exprIdx = 0;

  // ─── User Attribution (归因) ───────────────────────────────────
  // 首次访问抓 UTM 参数 + referrer + landing page，存 localStorage
  // 登录成功后 POST 到 /api/auth/save-attr 写入 DB
  (function() {
    var ATTR_KEY = 'gp_attr';
    var existing = localStorage.getItem(ATTR_KEY);
    if (existing) return; // 已有数据不覆盖（保存首次访问）

    var p = new URLSearchParams(location.search);
    var attr = {
      utm_source:   p.get('utm_source')   || null,
      utm_medium:   p.get('utm_medium')   || null,
      utm_campaign: p.get('utm_campaign') || null,
      utm_content:  p.get('utm_content')  || null,
      channel:      p.get('channel')      || null,
      referrer:     document.referrer      || null,
      landing:      location.pathname + location.search,
      first_seen_at: Date.now()
    };
    // 只在有至少一个归因信号时保存（纯直接访问不存）
    if (attr.utm_source || attr.utm_medium || attr.utm_campaign ||
        attr.utm_content || attr.channel || attr.referrer) {
      localStorage.setItem(ATTR_KEY, JSON.stringify(attr));
    }
  })();

  function sendAttribution() {
    var raw = localStorage.getItem('gp_attr');
    if (!raw) return;
    try {
      var attr = JSON.parse(raw);
      fetchWithTimeout('/api/auth/save-attr', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(attr)
      }, 5000).then(function(r) {
        if (r.ok) localStorage.removeItem('gp_attr'); // 成功后清除
      }).catch(function() {});
    } catch(e) {}
  }

  function shuffleArray(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
    }
    return arr;
  }

  // Level difficulty system
  function getDifficulty(level) {
    if (level <= 3)  return { label: 'Tutorial',    badge: 'badge-easy',        w: 3, h: 3 };
    if (level <= 10) return { label: 'Easy',        badge: 'badge-easy',        w: 5, h: 5 };
    if (level <= 16) return { label: 'Medium',      badge: 'badge-medium',      w: 5, h: 6 };
    if (level <= 22) return { label: 'Medium-Hard', badge: 'badge-medium-hard', w: 6, h: 6 };
    if (level <= 30) return { label: 'Hard',        badge: 'badge-hard',        w: 7, h: 8 };
    if (level <= 40) return { label: 'Expert',      badge: 'badge-expert',      w: 7, h: 7 };
    if (level <= 50) return { label: 'Master',      badge: 'badge-expert',      w: 8, h: 8 };
    return                  { label: 'Legend',      badge: 'badge-expert',      w: 8, h: 8 };
  }

  // Load saved level from localStorage
  var savedLevel = localStorage.getItem('gridpaw-level');
  var puzzle = null, occupied = [], cellColors = [], rects = [];
  var lives = 3, enhancedNumbers = [], validCells = null;
  var TUTORIAL_MESSAGES = {
    1: '😺 Drag horizontally to cover 3 cells →',
    2: '😺 Drag vertically to cover 3 cells ↓',
    3: '😺 Two numbers — draw one rectangle for each!',
    4: '😺 Last tutorial! Fill the entire grid.'
  };
  var dragging = false, dragStart = null, levelNum = savedLevel ? parseInt(savedLevel) : 1, _cellSize = 56;
  // Timer
  var gameStartTime = null, gameElapsed = 0, gameTimerInterval = null;
  var gameTimerEl = null;
  function formatGameTime(s) { var m = Math.floor(s / 60); var sec = s % 60; return m + ':' + (sec < 10 ? '0' : '') + sec; }
  function startGameTimer() { if (gameStartTime) return; gameStartTime = Date.now(); gameTimerInterval = setInterval(function() { gameElapsed = Math.floor((Date.now() - gameStartTime) / 1000); if (gameTimerEl) gameTimerEl.textContent = formatGameTime(gameElapsed); }, 1000); }
  function stopGameTimer() { if (gameTimerInterval) { clearInterval(gameTimerInterval); gameTimerInterval = null; } }
  function resetGameTimer() { stopGameTimer(); gameStartTime = null; gameElapsed = 0; if (gameTimerEl) gameTimerEl.textContent = '0:00'; }

  // GA4 + Clarity + PostHog tracking helper
  function track(event, params) {
    if (window.gpTrack) window.gpTrack(event, params || {});
    if (typeof window.gtag === 'function') window.gtag('event', event, params || {});
    if (window.posthog && typeof window.posthog.capture === 'function') {
      window.posthog.capture(event, Object.assign({ site: 'gridpaw' }, params || {}));
    }
    if (typeof window.clarity === 'function') {
      window.clarity('event', event);
      if (params) Object.keys(params).forEach(function(k) { window.clarity('set', k, String(params[k])); });
    }
  }

  // ─── Daily streak state machine (shared with /daily page key) ──────
  var DAILY_KEY = 'gridpaw-daily';
  function getToday() { return new Date().toISOString().split('T')[0]; }
  function getYesterdayD() { var d = new Date(); d.setDate(d.getDate() - 1); return d.toISOString().split('T')[0]; }
  function loadDailyState() {
    var s = localStorage.getItem(DAILY_KEY);
    if (!s) return null;
    var d = JSON.parse(s);
    var today = getToday();
    if (d.date === today) return d;
    var lastDate = d.lastPlayedDate || d.date;
    if (lastDate === getYesterdayD()) {
      return { date: today, streak: d.streak, bestStreak: d.bestStreak, solved: false, bestTime: d.bestTime };
    }
    return { date: today, streak: 0, bestStreak: d.bestStreak, solved: false, bestTime: d.bestTime };
  }
  function saveDailyWin(timeSeconds) {
    var today = getToday();
    var st = loadDailyState() || { date: today, streak: 0, bestStreak: 0, bestTime: null };
    if (!st.solved) {
      st.streak = (st.streak || 0) + 1;
      st.bestStreak = Math.max(st.bestStreak || 0, st.streak);
      st.solved = true;
      if (timeSeconds && (!st.bestTime || timeSeconds < st.bestTime)) st.bestTime = timeSeconds;
    }
    st.lastPlayedDate = today;
    st.date = today;
    localStorage.setItem(DAILY_KEY, JSON.stringify(st));
    localStorage.setItem('gridpaw-daily-status', JSON.stringify({ date: today, solved: true, streak: st.streak }));
    return st;
  }

  // Mobile nav
  var mobileNav = document.getElementById('mobile-nav');
  document.getElementById('mobile-menu-btn').addEventListener('click', function() { mobileNav.style.display = 'block'; });
  document.getElementById('mobile-nav-close').addEventListener('click', function() { mobileNav.style.display = 'none'; });
  mobileNav.addEventListener('click', function(e) { if (e.target === mobileNav) mobileNav.style.display = 'none'; });

  var board = document.getElementById('board');
  var victory = document.getElementById('victory');
  var gameOver = document.getElementById('gameOver');
  var statusEl = document.getElementById('status');
  var levelTitle = document.getElementById('levelTitle');
  gameTimerEl = document.getElementById('gameTimer');

  function updateHearts() {
    var heartsEl = document.getElementById('heartsDisplay');
    if (!heartsEl) return;
    var spans = heartsEl.querySelectorAll('.heart');
    for (var i = 0; i < spans.length; i++) {
      spans[i].classList.toggle('lost', i >= lives);
    }
  }
  function newPuzzle() {
    lives = 3; updateHearts();
    gameOver.classList.add('hidden');
    var levelIdx = levelNum - 1;
    var levelDef = typeof LEVEL_DEFS !== 'undefined' ? LEVEL_DEFS[levelIdx] : null;
    if (levelDef) {
      var result = generateFromLevel(levelDef);
      puzzle = result.puzzle;
      enhancedNumbers = result.enhancedNumbers;
      validCells = puzzle.validCells || null;
      var W = puzzle.width, H = puzzle.height;
      occupied = Array.from({ length: H }, function() { return Array(W).fill(false); });
      cellColors = Array.from({ length: H }, function() { return Array(W).fill(null); });
      colorPool = shuffleArray(CAT_PALETTE.slice());
      exprIdx = 0; rects = [];
      var badge = levelDef.isHard ? ' <span class="difficulty-badge badge-hard">🔥 Hard</span>' : (levelDef.isTutorial ? ' <span class="difficulty-badge badge-easy">📖 Tutorial</span>' : '');
      levelTitle.innerHTML = levelDef.label + badge;
      var hintEl = document.getElementById('tutorialHint');
      if (hintEl) {
        if (levelDef.isTutorial && TUTORIAL_MESSAGES[levelDef.tutorialStep]) {
          hintEl.textContent = TUTORIAL_MESSAGES[levelDef.tutorialStep];
          hintEl.classList.remove('hidden');
        } else {
          hintEl.classList.add('hidden');
        }
      }
    } else {
      var diff = getDifficulty(levelNum);
      validCells = null; enhancedNumbers = [];
      puzzle = null;
      for (var i = 0; i < 200; i++) { puzzle = generatePuzzleWithRetry(diff.w, diff.h, 50); if (puzzle) break; }
      if (!puzzle) { statusEl.textContent = 'Failed to generate puzzle.'; return; }
      occupied = Array.from({ length: diff.h }, function() { return Array(diff.w).fill(false); });
      cellColors = Array.from({ length: diff.h }, function() { return Array(diff.w).fill(null); });
      colorPool = shuffleArray(CAT_PALETTE.slice());
      exprIdx = 0; rects = [];
      levelTitle.innerHTML = 'Level ' + levelNum + ' <span class="difficulty-badge ' + diff.badge + '" id="diffBadge">' + diff.label + '</span>';
      var hintEl2 = document.getElementById('tutorialHint');
      if (hintEl2) hintEl2.classList.add('hidden');
    }
    if (rects && rects.length > 0) { track('puzzle_reset', { level: levelNum }); }
    localStorage.setItem('gridpaw-level', String(levelNum));
    if (currentUser && !isDailyMode) postLevel(levelNum);
    board.classList.remove('board-victory');
    resetGameTimer();
    render(); updateStatus();
  }

  function render() {
    if (!puzzle) return;
    var W = puzzle.width, H = puzzle.height;
    var maxBoardWidth = Math.min(window.innerWidth - 32, 480);
    var gap = 3, padding = 8;
    var cellSize = Math.floor((maxBoardWidth - padding * 2 - gap * (W - 1)) / W);
    cellSize = Math.max(28, Math.min(56, cellSize));
    _cellSize = cellSize;
    var fontSize = Math.max(12, Math.min(20, Math.floor(cellSize * 0.36)));
    board.style.gridTemplateColumns = 'repeat(' + W + ', ' + cellSize + 'px)';
    board.style.gridTemplateRows = 'repeat(' + H + ', ' + cellSize + 'px)';
    board.innerHTML = '';
    for (var r = 0; r < H; r++) {
      for (var c = 0; c < W; c++) {
        var cellKey = r + ',' + c;
        var isValid = !validCells || validCells.has(cellKey);
        var cell = document.createElement('div');
        cell.className = 'cell';
        cell.dataset.row = String(r); cell.dataset.col = String(c);
        cell.style.width = cellSize + 'px'; cell.style.height = cellSize + 'px';
        cell.style.fontSize = fontSize + 'px';
        if (!isValid) {
          cell.classList.add('cell-invalid');
          cell.style.visibility = 'hidden';
        } else {
          var num = puzzle.numbers.find(function(n) { return n.row === r && n.col === c; });
          var enhanced = enhancedNumbers ? enhancedNumbers.find(function(n) { return n.row === r && n.col === c; }) : null;
          if (cellColors[r][c]) {
            cell.classList.add('cell-filled'); cell.style.background = cellColors[r][c];
          } else if (num) {
            cell.classList.add('cell-number');
            if (enhanced && enhanced.xReveal && enhanced.xReveal.remaining > 0) {
              cell.classList.add('cell-xreveal');
              cell.innerHTML = '<span class="x-ring">' + enhanced.xReveal.remaining + '</span>';
            } else {
              cell.textContent = String(num.value);
              if (enhanced && enhanced.shapeHint) {
                var shapeDiv = document.createElement('div');
                shapeDiv.className = 'shape-hint shape-hint-' + enhanced.shapeHint.type;
                cell.style.position = 'relative';
                cell.insertBefore(shapeDiv, cell.firstChild);
              }
            }
          } else {
            cell.classList.add('cell-empty');
          }
        }
        board.appendChild(cell);
      }
    }
    // Create cat blocks (one per placed rectangle)
    rects.forEach(function(entry, i) {
      if (!entry || !entry.color || !entry.rect) return; // safety check
      var rect = entry.rect;
      var color = entry.color;
      var faceLeft = entry.faceLeft;
      var expr = entry.expr;

      var block = document.createElement('div');
      block.className = 'cat-block ' + (faceLeft ? 'face-left' : 'face-right');
      block.style.left = (rect.left * (cellSize + gap) + 8) + 'px';
      block.style.top = (rect.top * (cellSize + gap) + 8) + 'px';
      block.style.width = (rect.width * cellSize + (rect.width - 1) * gap) + 'px';
      block.style.height = (rect.height * cellSize + (rect.height - 1) * gap) + 'px';
      block.style.background = color.bg;
      block.style.setProperty('--ear', color.ear);
      block.style.background = color.bg;
      block.style.setProperty('--ear', color.ear);
      if (typeof window.gsap !== 'undefined' && !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
        // 坑：CSS pop-in 动画与 GSAP from 补间同元素竞争 opacity/transform，
        // 补间被杀时内联样式冻结在起始帧 → 猫块永久透明（2026-09-15 实测修复）。
        // GSAP 接管前禁掉 CSS 动画，结束时 clearProps 清内联样式兜底。
        block.style.animation = 'none';
        gsap.from(block, { scale: 0.3, opacity: 0, duration: 0.5, ease: 'back.out(3)', transformOrigin: '50% 100%', clearProps: 'opacity,transform' });
        gsap.to(block, { scaleY: 1.08, scaleX: 0.94, duration: 0.1, ease: 'power1.out', delay: 0.5, yoyo: true, repeat: 1, overwrite: 'auto', clearProps: 'transform' });
      }

      // Face
      var face = document.createElement('div');
      face.className = 'cat-face ' + (faceLeft ? 'face-left' : 'face-right');
      var eyes = document.createElement('div');
      eyes.className = 'cat-eyes';
      var e1 = document.createElement('div'); e1.className = expr.e[0];
      var e2 = document.createElement('div'); e2.className = expr.e[1];
      eyes.appendChild(e1); eyes.appendChild(e2);
      face.appendChild(eyes);
      if (expr.m !== 'm-none') {
        var mouth = document.createElement('div');
        mouth.className = 'cat-mouth ' + expr.m;
        face.appendChild(mouth);
      }
      block.appendChild(face);

      // Number
      var num = document.createElement('div');
      num.className = 'cat-num';
      num.textContent = String(rect.value);
      block.appendChild(num);

      board.appendChild(block);
    });
  }

  function getCell(e) { var t = 'touches' in e ? e.touches[0] || e.changedTouches[0] : e; var el = document.elementFromPoint(t.clientX, t.clientY); if (!el || !el.classList.contains('cell')) return null; return { row: +el.dataset.row, col: +el.dataset.col }; }
  function getSelRect(s, e) { return { top: Math.min(s.row, e.row), left: Math.min(s.col, e.col), height: Math.abs(s.row - e.row) + 1, width: Math.abs(s.col - e.col) + 1, value: 0 }; }
  function highlightCells(rect) {
    document.querySelectorAll('.cell-selecting').forEach(function(el) { el.classList.remove('cell-selecting'); });
    if (!puzzle) return;
    for (var r = rect.top; r < rect.top + rect.height; r++) {
      for (var c = rect.left; c < rect.left + rect.width; c++) {
        if (r < puzzle.height && c < puzzle.width) {
          var key = r + ',' + c;
          if (validCells && !validCells.has(key)) continue;
          var cellEl = board.children[r * puzzle.width + c];
          if (cellEl) cellEl.classList.add('cell-selecting');
        }
      }
    }
  }
  function clearHighlight() { document.querySelectorAll('.cell-selecting').forEach(function(el) { el.classList.remove('cell-selecting'); }); }

  function onStart(e) {
    var cell = getCell(e);
    if (!cell) return;
    // Click on filled cell → remove that cat block
    if (occupied[cell.row][cell.col]) {
      for (var i = rects.length - 1; i >= 0; i--) {
        var r = rects[i].rect;
        if (cell.row >= r.top && cell.row < r.top + r.height && cell.col >= r.left && cell.col < r.left + r.width) {
          var removed = rects.splice(i, 1)[0];
          exprIdx--;
          colorPool.push(removed.color);
          for (var rr = r.top; rr < r.top + r.height; rr++)
            for (var cc = r.left; cc < r.left + r.width; cc++) { occupied[rr][cc] = false; cellColors[rr][cc] = null; }
          render(); updateStatus(); return;
        }
      }
      return;
    }
    if (dragging && dragStart && dragStart.row === cell.row && dragStart.col === cell.col) { dragging = false; dragStart = null; clearHighlight(); return; }
    dragging = true; dragStart = cell;
    startGameTimer();
    if (!window.__firstMoveTracked) { window.__firstMoveTracked = true; track('first_move', { level: levelNum }); }
  }
  function onMove(e) { if (!dragging || !dragStart) return; e.preventDefault(); var cell = getCell(e); if (!cell) return; highlightCells(getSelRect(dragStart, cell)); }
  function updateXReveals() {
    if (!enhancedNumbers) return;
    var W = puzzle.width;
    enhancedNumbers.forEach(function(enhanced) {
      if (enhanced.xReveal && enhanced.xReveal.remaining > 0) {
        enhanced.xReveal.remaining--;
        var cellIdx = enhanced.row * W + enhanced.col;
        var cellEl = board.children[cellIdx];
        if (enhanced.xReveal.remaining === 0) {
          if (cellEl) {
            cellEl.classList.remove('cell-xreveal');
            cellEl.classList.add('cell-number');
            cellEl.textContent = String(enhanced.value);
            if (enhanced.shapeHint) {
              var shapeDiv2 = document.createElement('div');
              shapeDiv2.className = 'shape-hint shape-hint-' + enhanced.shapeHint.type;
              cellEl.style.position = 'relative';
              cellEl.insertBefore(shapeDiv2, cellEl.firstChild);
            }
          }
        } else {
          if (cellEl) {
            var ring = cellEl.querySelector('.x-ring');
            if (ring) ring.textContent = enhanced.xReveal.remaining;
          }
        }
      }
    });
  }
  function showGameOver() {
    stopGameTimer();
    if (typeof SFX !== 'undefined') SFX.error();
    gameOver.classList.remove('hidden');
    track('game_over', { level: levelNum, time: gameElapsed });
  }
  function onEnd(e) {
    try {
    if (!dragging || !dragStart) return; dragging = false;
    var cell = getCell(e); clearHighlight();
    if (!cell) { dragStart = null; return; }
    var sel = getSelRect(dragStart, cell);
    var startCol = dragStart.col;
    dragStart = null;
    if (!puzzle) return;
    var result = validatePlacement(sel, puzzle, occupied);
    if (!result.valid) {
      for (var r = sel.top; r < sel.top + sel.height; r++) for (var c = sel.left; c < sel.left + sel.width; c++) if (r < puzzle.height && c < puzzle.width) { var el = board.children[r * puzzle.width + c]; if (el) { el.classList.add('cell-error'); setTimeout(function(e) { return function() { e.classList.remove('cell-error'); }; }(el), 300); } }
      if (typeof SFX !== 'undefined') SFX.error();
      lives--;
      updateHearts();
      if (lives <= 0) {
        statusEl.textContent = 'No lives left!'; statusEl.style.color = 'var(--mt-error)';
        showGameOver();
        return;
      }
      if (lives === 1) {
        statusEl.textContent = '⚠️ Last chance!'; statusEl.style.color = 'var(--mt-error)';
      } else {
        statusEl.textContent = result.reason || 'Invalid'; statusEl.style.color = 'var(--mt-error)';
      }
      setTimeout(updateStatus, 1500);
    } else {
      if (typeof SFX !== 'undefined') SFX.place();
      if (colorPool.length === 0) colorPool = shuffleArray(CAT_PALETTE.slice());
      var color = colorPool.pop();
      var expr = EXPRESSIONS[exprIdx % EXPRESSIONS.length];
      exprIdx++;
      var faceLeft = startCol <= sel.left;
      var numsInside = puzzle.numbers.filter(function(n) {
        return n.row >= sel.top && n.row < sel.top + sel.height && n.col >= sel.left && n.col < sel.left + sel.width;
      });
      sel.value = numsInside[0].value;
      for (var r = sel.top; r < sel.top + sel.height; r++)
        for (var c = sel.left; c < sel.left + sel.width; c++) {
          occupied[r][c] = true;
          cellColors[r][c] = color.bg;
        }
      rects.push({ rect: sel, color: color, expr: expr, faceLeft: faceLeft });
      updateXReveals();
      render(); checkWin();
    }
    } catch(err) { console.error('[ONEND ERROR]', err.message, err.stack); }
  }

  function updateStatus() {
    if (!puzzle) return;
    var filled = 0, total;
    if (validCells) {
      total = validCells.size;
      validCells.forEach(function(key) {
        var parts = key.split(',');
        if (occupied[+parts[0]][+parts[1]]) filled++;
      });
    } else {
      total = puzzle.height * puzzle.width;
      for (var r = 0; r < puzzle.height; r++)
        for (var c = 0; c < puzzle.width; c++)
          if (occupied[r][c]) filled++;
    }
    statusEl.textContent = filled + ' / ' + total + ' cells · ' + (puzzle.numbers.length - rects.length) + ' cats left · ❤️ ' + lives;
    statusEl.style.color = '';
  }

  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && dragging) { dragging = false; dragStart = null; clearHighlight(); } });
  board.addEventListener('mousedown', onStart); board.addEventListener('mousemove', onMove); board.addEventListener('mouseup', onEnd);
  board.addEventListener('mouseleave', function() { if (dragging) { dragging = false; clearHighlight(); } });
  board.addEventListener('touchstart', onStart, { passive: true }); board.addEventListener('touchmove', onMove, { passive: false }); board.addEventListener('touchend', onEnd);

  function checkWin() {
    if (!puzzle) return;
    var filled = 0, total;
    if (validCells) {
      total = validCells.size;
      validCells.forEach(function(key) {
        var parts = key.split(',');
        if (occupied[+parts[0]][+parts[1]]) filled++;
      });
    } else {
      total = puzzle.height * puzzle.width;
      for (var r = 0; r < puzzle.height; r++)
        for (var c = 0; c < puzzle.width; c++)
          if (occupied[r][c]) filled++;
    }
    console.log('[CHECKWIN] filled=' + filled + ' total=' + total + ' rects=' + rects.length);
    if (filled === total) {
      stopGameTimer();
      console.log('[CHECKWIN] WIN DETECTED! Calling showVictory in 500ms');
      if (typeof SFX !== 'undefined') SFX.win();
      statusEl.textContent = '🎉 Purrfect!'; statusEl.style.color = 'var(--mt-success)';
      board.classList.add('board-victory');
      var dailyWinState = null;
      if (isDailyMode) {
        dailyWinState = saveDailyWin(gameElapsed);
        track('daily_solved', { streak: dailyWinState.streak });
      }
      setTimeout(function() {
        // Tutorial levels: auto-advance without showing victory overlay
        var currentLevelDef = typeof LEVEL_DEFS !== 'undefined' ? LEVEL_DEFS[levelNum - 1] : null;
        if (currentLevelDef && currentLevelDef.isTutorial) {
          levelNum++;
          hintUsesLeft = 3; updateHintBadge();
          track('level_up', { level: levelNum - 1, tutorial: true });
          newPuzzle();
        } else {
          console.log('[TIMEOUT] Calling showVictory now'); showVictory(); if (dailyWinState) syncWinToCloud(dailyWinState, gameElapsed);
        }
      }, 500);
    } else {
      updateStatus();
    }
  }

  function showVictory() {
    console.log('[VICTORY] showVictory called');
    var catsDiv = document.getElementById('victoryCats'); catsDiv.innerHTML = '';
    var usedColors = [];
    rects.forEach(function(entry) { if (entry && entry.color && usedColors.indexOf(entry.color.bg) === -1) usedColors.push(entry.color.bg); });
    usedColors.forEach(function(bg) {
      var div = document.createElement('div');
