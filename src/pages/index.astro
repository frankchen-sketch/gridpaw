    .download-text p { font-size: 14px; line-height: 1.7; color: var(--gp-brown-600); margin-bottom: 1rem; }
    .download-buttons { display: flex; gap: 10px; flex-wrap: wrap; }
    .store-btn { display: inline-flex; align-items: center; gap: 6px; padding: 12px 24px; background: var(--gp-primary-strong); color: white; border-radius: 12px; font-weight: 800; font-size: 14px; text-decoration: none; transition: all 0.15s; }
    .store-btn:hover { background: var(--gp-primary-dark); }
    .store-btn-outline { background: white; color: var(--gp-primary-strong); border: 1.5px solid var(--gp-primary-strong); }
    .store-btn-outline:hover { background: var(--gp-cream-warm); }
    /* Section generic */
    .section { max-width: 720px; margin: 0 auto; padding: 0.5rem 1rem; }
    @media (max-width: 420px) { .walkthrough-grid { grid-template-columns: 1fr; } .download-box { flex-direction: column; text-align: center; } .download-phone { width: 120px; } }

    /* === New mechanics: lives, irregular grid, X-reveal, shape hints === */
    .cell-invalid { visibility: hidden; pointer-events: none; }
    .cell-xreveal { background: var(--gp-blush); position: relative; cursor: default; }
    .x-ring {
      display: flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; border-radius: 50%;
      border: 3px solid var(--mt-primary); font-weight: 900; font-size: 14px;
      color: var(--mt-primary); animation: pulse-ring 2s ease-in-out infinite;
    }
    @keyframes pulse-ring { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.1); opacity: 0.8; } }
    .shape-hint { position: absolute; pointer-events: none; z-index: 0; background: rgba(212,122,80,0.22); border: 2.5px solid rgba(212,122,80,0.5); }
    .shape-hint-square { inset: 10px; border-radius: 4px; }
    .shape-hint-wide { top: 12px; bottom: 12px; left: 8px; right: 8px; border-radius: 3px; }
    .shape-hint-tall { left: 12px; right: 12px; top: 8px; bottom: 8px; border-radius: 3px; }
    .cell-number { position: relative; z-index: 1; }

    .game-over-overlay {
      position: absolute; inset: 0; background: rgba(0,0,0,0.7); z-index: 700;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 16px; border-radius: 12px;
    }
    .game-over-overlay.hidden { display: none; }
