    .hearts .heart.lost { opacity: 0.2; transform: scale(0.8); }
    .tutorial-hint {
      text-align: center; padding: 6px 12px; margin: 0 0 6px;
      font-size: 13px; font-weight: 700; color: var(--mt-secondary);
      background: var(--gp-lilac-bright); border-radius: 8px;
      word-wrap: break-word; overflow-wrap: break-word;
    }
    .tutorial-hint.hidden { display: none; }
  </style>
