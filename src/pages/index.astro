    .strategy-item { display: flex; flex-direction: column; padding: 10px 12px; background: white; border: 1.5px solid #E8E0EB; border-radius: 10px; text-decoration: none; color: #3D3D3D; margin-bottom: 8px; transition: all 0.15s; }
    .strategy-item:hover { border-color: #D47A50; }
    .strategy-item strong { font-size: 13px; font-weight: 800; }
    .strategy-item span { font-size: 11px; color: #9E9590; margin-top: 2px; }
    /* Download Box */
    .download-box { display: flex; gap: 2rem; align-items: center; background: white; border: 1.5px solid #E8DDD0; border-radius: 16px; padding: 2rem; margin: 1rem 0; }
    .download-phone { flex-shrink: 0; width: 200px; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
    .download-phone img { width: 100%; display: block; }
    .download-text { flex: 1; }
    .download-text h2 { font-size: 1.4rem; font-weight: 900; margin-bottom: 0.5rem; }
    .download-text p { font-size: 14px; line-height: 1.7; color: #555; margin-bottom: 1rem; }
    .download-buttons { display: flex; gap: 10px; flex-wrap: wrap; }
    .store-btn { display: inline-flex; align-items: center; gap: 6px; padding: 12px 24px; background: #D47A50; color: white; border-radius: 12px; font-weight: 800; font-size: 14px; text-decoration: none; transition: all 0.15s; }
    .store-btn:hover { background: #c06a40; }
    .store-btn-outline { background: white; color: #D47A50; border: 1.5px solid #D47A50; }
    .store-btn-outline:hover { background: #FFF5F0; }
    /* Section generic */
    .section { max-width: 720px; margin: 0 auto; padding: 0.5rem 1rem; }
    @media (max-width: 420px) { .walkthrough-grid { grid-template-columns: 1fr; } .download-box { flex-direction: column; text-align: center; } .download-phone { width: 120px; } }
  </style>
