---
import SEOHead from '../components/SEOHead.astro';
const title = "GridPaw — Free Cat Puzzle Games Online";
const description = "Play free Shikaku and Akari logic puzzles with cute cats. Daily challenges, multiple difficulty levels, no download needed.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead title={title} description={description} canonical="/" type="website" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <span class="brand-logo">🐱</span>
        <span class="brand-name">
          <span class="big">GridPaw</span>
          <span class="small">Cat Puzzle Games</span>
        </span>
      </a>
      <nav class="nav">
        <a href="/">Shikaku</a>
        <a href="/akari/">Akari</a>
        <a href="/daily/">Daily</a>
      </nav>
    </div>
  </header>

  <main>
    <h1>GridPaw: Free Cat Puzzle Games Online</h1>
    <p>Play two classic Japanese logic puzzles — Shikaku and Akari — with cute cat themes. No download, no account, no payment.</p>

    <section>
      <h2>🧩 Shikaku Puzzle</h2>
      <p>Divide the grid into rectangles, each containing exactly one number. The number tells you how many cells that rectangle covers.</p>
      <a href="/">Play Shikaku →</a>
    </section>

    <section>
      <h2>💡 Akari (Light Up) Puzzle</h2>
      <p>Place glowing cats to light up every cell in the grid. Numbered walls tell you exactly how many cats are adjacent.</p>
      <a href="/akari/">Play Akari →</a>
    </section>

    <section>
      <h2>🔥 Daily Challenge</h2>
      <p>A fresh puzzle every day. Track your streak, earn badges, compete with friends.</p>
      <a href="/daily/">Today's Challenge →</a>
    </section>
  </main>

  <footer>
    <p><a href="/">GridPaw</a> · Free Cat Puzzle Games</p>
    <p>
      <a href="/rules/">Rules</a> ·
      <a href="/tips/">Tips</a> ·
      <a href="/about/">About</a>
    </p>
    <p>© 2026 GridPaw. All rights reserved.</p>
  </footer>
</body>
</html>
