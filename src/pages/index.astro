    @media (max-width: 480px) { .header-nav { display: none; } .hamburger { display: block; } }
    /* Game Card */
    .game-card { background: white; border-radius: 16px; padding: 12px; box-shadow: 0 2px 12px rgba(78,64,55,0.08); border: 1.5px solid #E8E0EB; margin-bottom: 0; }
