    .game-actions .icon-btn { width: 32px; height: 32px; border-radius: 50%; background: white; border: 1.5px solid var(--gp-lilac); display: flex; align-items: center; justify-content: center; font-size: 14px; color: var(--gp-ink); cursor: pointer; transition: all 0.15s; position: relative; }
