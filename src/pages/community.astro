---
import SEOHead from '../components/SEOHead.astro';

const title = "Community & Links — GridPaw";
const description = "Find GridPaw on game platforms, social media, and community forums. Play Shikaku, Akari, and Pictomino puzzles.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead title={title} description={description} canonical="/community/" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --mt-primary: #D47A50;
      --mt-primary-light: #F5E6DA;
      --mt-secondary: #7B6B8A;
      --mt-secondary-light: #E8E0F0;
      --mt-accent: #88C8A8;
      --mt-bg: #FFF8F0;
      --mt-text: #3A2E25;
      --mt-text-light: #8A7B6E;
      --mt-surface: #FFFFFF;
      --mt-border: #E8DDD4;
      --mt-success: #5BA87C;
      --mt-warn: #E8A888;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Nunito', -apple-system, sans-serif;
      background: var(--mt-bg);
      color: var(--mt-text);
      line-height: 1.6;
    }
    .page-wrap {
      max-width: 720px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
    }
    h1 {
      font-size: 2rem;
      font-weight: 800;
      color: var(--mt-primary);
      margin-bottom: 0.5rem;
    }
    .subtitle {
      color: var(--mt-text-light);
      margin-bottom: 2rem;
      font-size: 1.05rem;
    }
    h2 {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--mt-secondary);
      margin: 2rem 0 0.75rem;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid var(--mt-border);
    }
    .link-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .link-list a {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      background: var(--mt-surface);
      border: 1px solid var(--mt-border);
      border-radius: 10px;
      text-decoration: none;
      color: var(--mt-text);
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .link-list a:hover {
      border-color: var(--mt-primary);
      box-shadow: 0 2px 8px rgba(212, 120, 80, 0.12);
    }
    .link-icon {
      font-size: 1.4rem;
      width: 2rem;
      text-align: center;
      flex-shrink: 0;
    }
    .link-info {
      flex: 1;
      min-width: 0;
    }
    .link-name {
      font-weight: 700;
      font-size: 0.95rem;
    }
    .link-desc {
      font-size: 0.82rem;
      color: var(--mt-text-light);
      margin-top: 0.1rem;
    }
    .link-badge {
      font-size: 0.7rem;
      padding: 0.15rem 0.5rem;
      border-radius: 99px;
      background: var(--mt-secondary-light);
      color: var(--mt-secondary);
      font-weight: 700;
      flex-shrink: 0;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 1.5rem;
      color: var(--mt-text-light);
      text-decoration: none;
      font-size: 0.9rem;
    }
    .back-link:hover { color: var(--mt-primary); }
    footer {
      text-align: center;
      margin-top: 3rem;
      font-size: 0.8rem;
      color: var(--mt-text-light);
    }
    footer a { color: var(--mt-text-light); }
    footer a:hover { color: var(--mt-primary); }
  </style>
</head>
<body>
  <div class="page-wrap">
    <a href="/" class="back-link">← Back to GridPaw</a>

    <h1>🐱 Community & Links</h1>
    <p class="subtitle">Find GridPaw across the web — play, share, and connect.</p>

    <!-- Play -->
    <h2>🎮 Play</h2>
    <ul class="link-list">
      <li>
        <a href="/akari/">
          <span class="link-icon">💡</span>
          <div class="link-info">
            <div class="link-name">GridPaw Akari</div>
            <div class="link-desc">Free cat-themed Light Up puzzle with daily challenges</div>
          </div>
        </a>
      </li>
      <li>
        <a href="/">
          <span class="link-icon">📐</span>
          <div class="link-info">
            <div class="link-name">GridPaw Shikaku</div>
            <div class="link-desc">Free cat-themed rectangle partition puzzle</div>
          </div>
        </a>
      </li>
      <li>
        <a href="/pictomino/">
          <span class="link-icon">🧩</span>
          <div class="link-info">
            <div class="link-name">GridPaw Pictomino</div>
            <div class="link-desc">Spatial reasoning puzzle for kids</div>
          </div>
        </a>
      </li>
    </ul>

    <!-- Game Platforms -->
    <h2>🕹️ Game Platforms</h2>
    <ul class="link-list">
      <li>
        <a href="https://meowtrail.itch.io/" target="_blank" rel="noopener">
          <span class="link-icon">🎯</span>
          <div class="link-info">
            <div class="link-name">itch.io</div>
            <div class="link-desc">Play Akari, Shikaku & Pictomino in browser</div>
          </div>
          <span class="link-badge">DR 92</span>
        </a>
      </li>
      <li>
        <a href="https://gamejolt.com/" target="_blank" rel="noopener">
          <span class="link-icon">🎮</span>
          <div class="link-info">
            <div class="link-name">GameJolt</div>
            <div class="link-desc">Free game platform — Akari & Shikaku</div>
          </div>
          <span class="link-badge">DR 78</span>
        </a>
      </li>
      <li>
        <a href="https://www.newgrounds.com/" target="_blank" rel="noopener">
          <span class="link-icon">⭐</span>
          <div class="link-info">
            <div class="link-name">Newgrounds</div>
            <div class="link-desc">Classic game community — Akari & Shikaku</div>
          </div>
          <span class="link-badge">DR 88</span>
        </a>
      </li>
    </ul>

    <!-- Chrome Extension -->
    <h2>🧩 Chrome Extension</h2>
    <ul class="link-list">
      <li>
        <a href="https://chromewebstore.google.com/detail/meowtrail-%E2%80%94-daily-akari-p/mjdplaoanamjdbbpkgccjnhmlgnpcamj" target="_blank" rel="noopener">
          <span class="link-icon">🧩</span>
          <div class="link-info">
            <div class="link-name">GridPaw — Daily Akari Puzzle</div>
            <div class="link-desc">Daily challenge reminders, streak tracking, quick play</div>
          </div>
          <span class="link-badge">Chrome</span>
        </a>
      </li>
    </ul>

    <!-- Social & Community -->
    <h2>💬 Social & Community</h2>
    <ul class="link-list">
      <li>
        <a href="https://www.reddit.com/r/WebGames/" target="_blank" rel="noopener">
          <span class="link-icon">🟠</span>
          <div class="link-info">
            <div class="link-name">r/WebGames</div>
            <div class="link-desc">Reddit community for web-based games</div>
          </div>
          <span class="link-badge">DR 95</span>
        </a>
      </li>
      <li>
        <a href="https://www.reddit.com/r/playmygame/" target="_blank" rel="noopener">
          <span class="link-icon">🟠</span>
          <div class="link-info">
            <div class="link-name">r/playmygame</div>
            <div class="link-desc">Share and discover indie games on Reddit</div>
          </div>
          <span class="link-badge">DR 95</span>
        </a>
      </li>
      <li>
        <a href="https://www.pinterest.com/gridpaw/" target="_blank" rel="noopener">
          <span class="link-icon">📌</span>
          <div class="link-info">
            <div class="link-name">Pinterest</div>
            <div class="link-desc">Puzzle tips, cat visuals, and game updates</div>
          </div>
        </a>
      </li>
    </ul>

    <!-- Build Tools -->
    <h2>🔧 Built With</h2>
    <ul class="link-list">
      <li>
        <a href="https://gridpaw-games.lovable.app" target="_blank" rel="noopener">
          <span class="link-icon">💜</span>
          <div class="link-info">
            <div class="link-name">Lovable</div>
            <div class="link-desc">AI-powered web app builder</div>
          </div>
        </a>
      </li>
      <li>
        <a href="https://furriq.com" target="_blank" rel="noopener">
          <span class="link-icon">🐱</span>
          <div class="link-info">
            <div class="link-name">Furriq</div>
            <div class="link-desc">AI cat breed identifier by photo</div>
          </div>
        </a>
      </li>
    </ul>

    <footer>
      <p><a href="/">GridPaw</a> · <a href="/akari/">Akari</a> · <a href="/pictomino/">Pictomino</a> · <a href="/rules/">Rules</a></p>
      <p style="margin-top:0.3rem">© 2026 GridPaw. All rights reserved.</p>
    </footer>
  </div>
</body>
</html>
