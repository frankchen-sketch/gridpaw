---
import SEOHead from '../../../components/SEOHead.astro';
import GameNav from '../../../components/GameNav.astro';
import SideAd from '../../../components/SideAd.astro';
import InContentAd from '../../../components/InContentAd.astro';
import data from '../../../data/word-kitchen-packs.json';

export function getStaticPaths() {
  return data.packs.flatMap((p: any) =>
    p.levels.map((lvl: any, i: number) => ({
      params: { pack: p.slug, slug: `level-${lvl.level}` },
      props: {
        lvl,
        pack: p,
        prev: i > 0 ? p.levels[i - 1] : null,
        next: i < p.levels.length - 1 ? p.levels[i + 1] : null,
      },
    })),
  );
}

const { lvl, pack, prev, next } = Astro.props;
const packName = pack.name;
const maxLevel = Math.max(...pack.levels.map((l: any) => l.level));
const tray = lvl.letters.toUpperCase().split('');
const keyWord = lvl.key.toUpperCase();
const answers: string[] = lvl.answers ?? [];
const extras: string[] = lvl.extra ?? [];
const hasAnswers = answers.length > 0;
const total = hasAnswers ? answers.length : lvl.words.length;
const longestWord = hasAnswers ? answers[0] : lvl.key;
const hasFull = !!lvl.has_full && keyWord.length === tray.length;

const groupOf = (list: string[]) => {
  const byLen: Record<number, string[]> = {};
  for (const w of list) (byLen[w.length] ||= []).push(w);
  return Object.keys(byLen).map(Number).sort((a, b) => b - a).map((len) => ({ len, words: byLen[len] }));
};
const answerGroups = groupOf(answers);
const extraGroups = groupOf(extras);

// 托盘：按游戏里的「锅」摆位（单环 ≤8 个字母，多则内环）
const N = tray.length;
const outer = N <= 8 ? N : Math.ceil(N / 2);
const needC: Record<string, number> = {};
for (const ch of keyWord.toLowerCase()) needC[ch] = (needC[ch] ?? 0) + 1;
const panTiles = tray.map((ch: string, i: number) => {
  const inOuter = i < outer;
  const idx = inOuter ? i : i - outer;
  const count = inOuter ? outer : N - outer;
  const r = inOuter ? 92 : 50;
  const ang = -Math.PI / 2 + (2 * Math.PI * idx) / count;
  const lc = ch.toLowerCase();
  const used = (needC[lc] ?? 0) > 0;
  if (used) needC[lc] -= 1;
  return { ch, used, cx: 170 + r * Math.cos(ang), cy: 150 + r * Math.sin(ang), size: inOuter ? 36 : 30 };
});
const shownWords = hasAnswers ? answers : lvl.words;
const shownGroups = hasAnswers ? answerGroups : groupOf(lvl.words);
const shortestLen = Math.min(...shownWords.map((w: string) => w.length));
const maxGroupCount = Math.max(...shownGroups.map((g) => g.words.length));

const title = hasFull
  ? `Word Kitchen ${packName} Level ${lvl.level} Answers: ${keyWord}`
  : `Word Kitchen ${packName} Level ${lvl.level} Answers: ${total} Words`;
const description = `Word Kitchen ${packName} Level ${lvl.level} answers: the tray holds ${tray.join(' ')}. The level asks for ${total} words — longest ${keyWord.toUpperCase()} (${keyWord.length} letters)${extras.length ? `, and the same tiles also spell ${extras.length} bonus words` : ''}.`;
const canonical = `/word-kitchen/${pack.slug}/level-${lvl.level}`;

const faq = [
  {
    q: `What is the answer to Word Kitchen ${packName} Level ${lvl.level}?`,
    a: `Level ${lvl.level} of ${packName} uses the tray ${tray.join(', ')} and asks for ${total} words. The longest is ${keyWord.toUpperCase()} (${keyWord.length} letters)${hasFull ? ', which uses every tile' : ''}. The full list, longest first: ${answers.map((w) => w.toUpperCase()).join(', ')}.`,
  },
  {
    q: `How many words are there in ${packName} Level ${lvl.level}?`,
    a: `${hasAnswers ? `${total} answer words fill` : `${total} common words can be spelled from`} this level's tray${extras.length ? `, and ${extras.length} further words are spellable but unconfirmed as bonus words` : ''}. They run from ${longestWord.length} letters down to ${shortestLen}.`,
  },
  {
    q: `Why does the game reject a word I typed?`,
    a: `The tray can spell more words than the level asks for. The ${extras.length} extras listed at the bottom of this page are real words built from the same letters, but the game only accepts the ${total} slot words above unless it counts the word as a bonus.`,
  },
  {
    q: `Is there a faster way to solve a Word Kitchen level?`,
    a: `Yes — type the tray letters into the Word Kitchen solver and it returns every combination that fits, including words that are not on this page. It runs in the browser and needs no download.`,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead
    title={title}
    description={description}
    canonical={canonical}
    type="article"
    breadcrumbTitle={`Word Kitchen ${packName} Level ${lvl.level}`}
  />
  <link rel="alternate" hreflang="en" href={`https://gridpaw.com${canonical}/`} />
  <link rel="alternate" hreflang="x-default" href={`https://gridpaw.com${canonical}/`} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --amber: #D97706; --amber-ink: #A35700; --cream: #FFFBF5; --green: #15803D;
      --text: #3A2F28; --light: #756251; --border: #F2E4D4;
      --shadow: 0 2px 8px rgba(217,119,6,0.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Nunito', -apple-system, sans-serif; background: var(--cream); color: var(--text); min-height: 100vh; }
    .breadcrumb { font-size: 12px; color: var(--light); padding: 14px 16px 0; text-align: center; }
    .breadcrumb a { color: var(--light); text-decoration: none; }
    .breadcrumb a:hover { color: var(--amber-ink); }
    .wrap { max-width: 840px; margin: 0 auto; padding: 1.2rem 1rem 3rem; }
    .wrap h1 { font-size: 1.75rem; line-height: 1.3; margin: 0.6rem 0 0.5rem; }
    .wrap h2 { font-size: 1.3rem; margin: 2rem 0 0.6rem; }
    .wrap h2 .accent { color: var(--amber-ink); }
    .wrap p { line-height: 1.75; color: #555; margin: 0.5rem 0; }
    .wrap a { color: var(--amber-ink); }
    .lede { font-size: 1rem; color: #6b5b4c; }
    .answer-box { background: #fff; border: 2px solid var(--green); border-radius: 12px; padding: 1rem 1.1rem; margin: 1rem 0; box-shadow: var(--shadow); }
    .answer-box .label { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--green); display: block; margin-bottom: 0.45rem; }
    .pan { display: block; width: 100%; max-width: 330px; height: auto; margin: 0.4rem auto 0.6rem; }
    .pan-handle { fill: #2F2A26; }
    .pan-body { fill: #2F2A26; }
    .pan-rim { fill: #453C35; }
    .pan-inner { fill: #38302A; stroke: #574B41; stroke-width: 2; }
    .pan-tile { fill: #FFF3DF; stroke: #E9C48B; stroke-width: 2; }
    .pan-letter { fill: #8A5A12; font-weight: 900; text-anchor: middle; dominant-baseline: middle; font-family: 'Nunito', sans-serif; }
    .pan-tile.used { fill: #DFF3E4; stroke: #15803D; }
    .pan-letter.used { fill: #15803D; }
    .pan-legend { text-align: center; font-size: 0.82rem; color: var(--light); margin: 0 0 0.5rem; }
    .len-chart { background: #fff; border: 1.5px solid var(--border); border-radius: 12px; padding: 0.8rem 1rem; margin: 0.8rem 0; box-shadow: var(--shadow); }
    .len-chart figcaption { font-size: 0.8rem; font-weight: 800; color: var(--light); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
    .len-row { display: flex; align-items: center; gap: 0.6rem; margin: 0.22rem 0; }
    .len-lab { width: 1.2rem; text-align: right; font-weight: 900; font-size: 0.85rem; color: var(--amber-ink); }
    .len-track { flex: 1; background: #FBF3E7; border-radius: 999px; height: 14px; overflow: hidden; }
    .len-bar { display: block; height: 100%; background: linear-gradient(90deg, #E9A23B, #D97706); border-radius: 999px; }
    .len-cnt { width: 1.6rem; font-size: 0.8rem; font-weight: 800; color: var(--light); }
    .len-note { font-size: 0.75rem; color: var(--light); margin-top: 0.4rem; }
    .answer-box p { font-weight: 700; color: var(--text); margin: 0.25rem 0; }
    .answer-box .big { font-size: 1.15rem; }
    .key-word { color: var(--green); }
    .answer-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.5rem 0 0.2rem; padding: 0; }
    .answer-chips li { font-size: 0.95rem; font-weight: 800; letter-spacing: 0.04em; background: #E8F5EC; border: 1px solid #9ED3AE; border-radius: 8px; padding: 0.22rem 0.6rem; color: #15803D; }
    .answer-chips li.lead { background: #15803D; color: #fff; border-color: #15803D; }
    .word-groups { margin: 0.8rem 0; }
    .group { background: #fff; border: 1.5px solid var(--border); border-radius: 12px; padding: 0.8rem 1rem; margin: 0.7rem 0; box-shadow: var(--shadow); }
    .group h3 { font-size: 0.95rem; margin: 0; display: flex; align-items: center; gap: 0.5rem; }
    .group .pill { font-size: 0.7rem; font-weight: 900; background: #FFF0D4; color: var(--amber-ink); border-radius: 999px; padding: 0.1rem 0.55rem; letter-spacing: 0.04em; text-transform: uppercase; }
    .group ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.6rem 0 0; padding: 0; }
    .group li { font-size: 0.92rem; font-weight: 700; letter-spacing: 0.06em; background: #FFFBF2; border: 1px solid #F0DFAE; border-radius: 8px; padding: 0.2rem 0.55rem; color: #6b5320; }
    .group.extra li { background: #FAF7F2; border-color: #E8E0D4; color: #8a7c6c; font-weight: 600; }
    .group .also { font-size: 0.82rem; color: var(--light); margin-top: 0.5rem; }
    /* 与 .fact 同一语言：奶油底 + 细边框。原先 4px 琥珀左边框是 AI 味 side-tab 特征（impeccable L106 报出） */
    .mech { background: #FFF8E6; border: 1px solid #F0DFAE; border-radius: 10px; padding: 0.8rem 1rem; margin: 1rem 0; }
    .mech strong { color: var(--amber-ink); }
    .mech ul { padding-left: 1.2rem; color: #555; margin: 0.4rem 0 0; }
    .mech li { margin-bottom: 0.3rem; line-height: 1.6; }
    .cta { margin: 1.4rem 0; padding: 1rem 1.1rem; background: #fff; border: 2px dashed var(--amber); border-radius: 12px; text-align: center; }
    .cta p { margin: 0.2rem 0; font-weight: 700; color: var(--text); }
    .cta a.btn { display: inline-block; margin-top: 0.5rem; background: var(--amber-ink); color: #fff; font-weight: 800; text-decoration: none; padding: 0.55rem 1.1rem; border-radius: 10px; }
    .pager { display: flex; justify-content: space-between; gap: 0.8rem; margin: 1.6rem 0 0; }
    .pager a { flex: 1; background: #fff; border: 1.5px solid var(--border); border-radius: 12px; padding: 0.7rem 0.9rem; text-decoration: none; color: var(--text); font-weight: 800; font-size: 0.9rem; }
    .pager a:hover { border-color: var(--amber); color: var(--amber-ink); }
    .pager a.next { text-align: right; }
    .pager span { display: block; font-size: 0.7rem; font-weight: 700; color: var(--light); text-transform: uppercase; letter-spacing: 0.05em; }
    details.faq { background: #fff; border: 1.5px solid var(--border); border-radius: 10px; padding: 0.7rem 0.9rem; margin: 0.55rem 0; }
    details.faq summary { font-weight: 800; cursor: pointer; color: var(--text); }
    details.faq p { margin: 0.5rem 0 0; font-size: 0.94rem; }
    .evidence { font-size: 0.8rem; color: var(--light); border-top: 1px solid var(--border); margin-top: 2rem; padding-top: 0.7rem; line-height: 1.6; }
    .video-block { margin: 1.2rem 0; }
    .video-block p { font-size: 0.92rem; }
    .video-block .yt-facade { max-width: 640px; margin: 0.6rem auto 0; }
    .level-strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(58px, 1fr)); gap: 0.4rem; margin: 0.7rem 0; }
    .level-strip a { display: block; text-align: center; background: #fff; border: 1.5px solid var(--border); border-radius: 8px; padding: 0.35rem 0; text-decoration: none; font-weight: 800; font-size: 0.85rem; color: var(--text); }
    .level-strip a:hover { border-color: var(--amber); color: var(--amber-ink); }
    .level-strip a.here { background: #FFF0D4; border-color: var(--amber); color: var(--amber-ink); }
  </style>
</head>
<body>
  <GameNav />
  <div class="breadcrumb">
    <a href="/">Home</a> › <a href="/word-kitchen/">Word Kitchen Answers</a> › <a href={`/word-kitchen/${pack.slug}/`}>{packName}</a> › Level {lvl.level}
  </div>

  <main class="wrap">
    <h1>Word Kitchen {packName} Level {lvl.level} Answers{hasFull ? `: ${keyWord}` : ''}</h1>
    <p class="lede">Tray letters <strong>{tray.join(' ')}</strong> — {hasAnswers ? 'this level asks for' : 'these tiles spell'} <strong>{total}</strong> common words, longest <strong class="key-word">{keyWord}</strong>{hasFull ? ` (all ${tray.length} tiles)` : ` (${keyWord.length} of ${tray.length} tiles)`}.</p>

    <div class="answer-box">
      <span class="label">{hasAnswers ? 'Quick answer — every word in this level' : 'Words this tray can spell'}</span>
      <svg class="pan" viewBox="0 0 360 300" role="img" aria-label={`Tray for this level: ${tray.join(', ')}`}>
        <rect class="pan-handle" x="292" y="140" width="62" height="20" rx="10" />
        <circle class="pan-body" cx="170" cy="150" r="132" />
        <circle class="pan-rim" cx="170" cy="150" r="122" />
        <circle class="pan-inner" cx="170" cy="150" r="112" />
        {panTiles.map((t) => (
          <g>
            <rect class={t.used ? 'pan-tile used' : 'pan-tile'} x={t.cx - t.size / 2} y={t.cy - t.size / 2} width={t.size} height={t.size} rx="8" />
            <text class={t.used ? 'pan-letter used' : 'pan-letter'} x={t.cx} y={t.cy + 1} font-size={t.size * 0.56}>{t.ch}</text>
          </g>
        ))}
      </svg>
      <p class="pan-legend">Green tiles are the ones <strong>{keyWord.toUpperCase()}</strong> takes — {hasFull ? 'all ' + tray.length + ' of them' : keyWord.length + ' of ' + tray.length}.</p>
      <ul class="answer-chips">
        {answers.map((w) => <li class={w === lvl.key ? 'lead' : ''}>{w.toUpperCase()}</li>)}
      </ul>
      <p>{total} {hasAnswers ? 'answers' : 'words'} · longest {longestWord.length} letters · shortest {shortestLen} letters{extras.length ? ` · + ${extras.length} extra words` : ''}</p>
    </div>

    <h2>Answers by <span class="accent">length</span></h2>
    <p>Longest first — the game's slots always include the {longestWord.length}-letter word, and filling the long ones usually reveals the short ones.</p>

    <figure class="len-chart">
      <figcaption>How the {shownWords.length} words spread across word lengths</figcaption>
      {shownGroups.map((g) => (
        <div class="len-row">
          <span class="len-lab">{g.len}</span>
          <span class="len-track"><span class="len-bar" style={`width:${(g.words.length / maxGroupCount) * 100}%`}></span></span>
          <span class="len-cnt">{g.words.length}</span>
        </div>
      ))}
      <p class="len-note">letters on the left · number of words on the right</p>
    </figure>

    <div class="word-groups">
      {answerGroups.map((g) => (
        <div class="group">
          <h3>{g.len} letters <span class="pill">{g.words.length} {g.words.length === 1 ? 'word' : 'words'}</span></h3>
          <ul>
            {g.words.map((w) => <li class={w === lvl.key ? 'is-key' : ''}>{w.toUpperCase()}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <InContentAd />

    {extras.length > 0 && (
      <>
        <h2>More words from the <span class="accent">same tray</span></h2>
        <p>These {extras.length} words can be spelled from the same {tray.length} tiles but are not on this level's answer list, so they will not fill a slot. Word Kitchen pays bonus coins for some off-list words and refuses others — we list the spellable candidates and flag them as unconfirmed rather than pretending they all pay.</p>
        <div class="word-groups">
          {extraGroups.map((g) => (
            <div class="group extra">
              <h3>{g.len} letters <span class="pill">{g.words.length}</span></h3>
              <ul>{g.words.map((w) => <li>{w.toUpperCase()}</li>)}</ul>
            </div>
          ))}
        </div>
      </>
    )}

    <h2>How the <span class="accent">{packName}</span> pack works</h2>
    <div class="mech">
      <p>Word Kitchen does not number levels globally — each pack runs its own <strong>1 to {maxLevel}</strong> count. {packName} is one of those packs, so “Level {lvl.level}” always means <strong>{packName} - {lvl.level}</strong> in the game's header.</p>
      <ul>
        <li><strong>The tray never changes inside a level.</strong> All {tray.length} tiles stay available until the level ends, so every word above can be entered at any point.</li>
        <li><strong>Long words first.</strong> The {longestWord.length}-letter word {keyWord.toUpperCase()} uses {hasFull ? 'the whole tray' : `${keyWord.length} of the ${tray.length} tiles`}; finding it usually unlocks the rest.</li>
        <li><strong>Bonus words are separate.</strong> The game has a book icon for words it accepts off-list; we only publish candidate words we can prove from the tray, marked as unconfirmed.</li>
        <li><strong>Repeats matter.</strong> If a tile appears twice, the word has to use it twice. Every list here is checked against the tray, so nothing on this page is unmakeable.</li>
      </ul>
    </div>

    <div class="cta">
      <p>Letters not matching this level?</p>
      <p>Type any tray into the solver and get every combination instantly.</p>
      <a class="btn" href="/word-kitchen/solver/">Open the Word Kitchen solver →</a>
    </div>

    {pack.video && (
      <div class="video-block">
        <h2>Watch the <span class="accent">{packName}</span> playthrough</h2>
        <p>One continuous run through all {maxLevel} {packName} levels. If a tray on your screen does not match the tiles above, look for this level in the video before trusting any other site.</p>
        <div class="yt-facade" data-yt={pack.video.id} data-title={pack.video.title} role="button" tabindex="0" aria-label={`Play video: ${pack.video.title}`}>
          <img src={`https://i.ytimg.com/vi/${pack.video.id}/maxresdefault.jpg`} alt={pack.video.title} loading="lazy" decoding="async" width="1280" height="720"
            onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${pack.video.id}/hqdefault.jpg'`} />
        </div>
      </div>
    )}

    <h2>Other {packName} levels</h2>
    <div class="level-strip">
      {pack.levels.map((l: any) => (
        <a href={`/word-kitchen/${pack.slug}/level-${l.level}/`} class={l.level === lvl.level ? 'here' : ''}>{l.level}</a>
      ))}
    </div>

    <h2>FAQ</h2>
    {faq.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}

    <div class="pager">
      {prev ? (
        <a href={`/word-kitchen/${pack.slug}/level-${prev.level}/`}>
          <span>Previous</span>
          Level {prev.level} ({prev.letters.toUpperCase()})
        </a>
      ) : <span />}
      {next ? (
        <a class="next" href={`/word-kitchen/${pack.slug}/level-${next.level}/`}>
          <span>Next</span>
          Level {next.level} ({next.letters.toUpperCase()})
        </a>
      ) : <span />}
    </div>

    <SideAd />

    <p class="evidence">
      <strong>Where this comes from:</strong> the tray letters were read off the 1080p recording of the {packName} playthrough by {pack.source.channel} (video {pack.source.video}); the {total}-word answer list was cross-checked against the same tray — every answer has to be spellable from {tray.join(' ')} and no answer may use a letter the tray lacks. The bonus-word lists are generated from the ENABLE dictionary. Wording, layout and solver on this page are original.
    </p>
  </main>
</body>
</html>
