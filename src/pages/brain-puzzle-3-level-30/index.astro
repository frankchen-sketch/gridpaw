const title = "Brain Puzzle 3 Level 30 Answer: Masks Off";
const description = "Brain Puzzle 3 Level 30 answer: every mask off Sweetheart's face in order, with screenshots, video timestamps and notes on which steps need a recheck.";
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is the answer to Brain Puzzle 3 Level 30?", "acceptedAnswer": {"@type": "Answer", "text": "Remove the ice block, golden mask, black eye mask and party hat, then tap through the skincare, ginseng and gold watch reactions, and finally open the pink curtain. The man behind it is the true face and ends the level."}}, {"@type": "Question", "name": "Why does Sweetheart's face keep changing in Level 30?", "acceptedAnswer": {"@type": "Answer", "text": "Each tap strips one more \"mask\" layer, and each gift answer replaces her face with a new exaggerated reaction. The level is a running gag about never seeing the real person until the curtain reveal."}}, {"@type": "Question", "name": "Is this Level 30 walkthrough exact?", "acceptedAnswer": {"@type": "Answer", "text": "The removal order and the curtain reveal are confirmed against full-video frame-by-frame reads. A few of the gift-reaction steps are reconstructed from a single video source, so if one tap looks different on your screen, check the embedded video at that timestamp."}}]};
