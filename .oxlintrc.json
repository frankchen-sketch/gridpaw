{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-useless-escape": "off",
    "no-useless-catch": "off",
    "no-this-alias": "off",
    "unicorn/no-new-array": "off"
  },
  "ignorePatterns": ["dist/**", "public/**", "node_modules/**", ".wrangler/**", ".astro/**"]
}
