#!/usr/bin/env bash
# pre-push：main 只收 fast-forward（2026-11-25 深修）
#  旧规则「只准 refs/heads/main 推」是代理规则，会把合并列车一起挡死；
#  真正危险的是非快进（重写历史）。主树分叉问题改由「部署按 sha」消解。
set -uo pipefail
PROTECTED="refs/heads/main"; ZERO="0000000000000000000000000000000000000000"; BAD=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  [ "$remote_ref" != "$PROTECTED" ] && continue
  [ "$local_sha" = "$ZERO" ] && { echo "✗ 拒绝：删远端 main" >&2; BAD=1; continue; }
  if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "✗ 拒绝：main 非快进推送（会重写历史）" >&2; BAD=1
  fi
done
exit $BAD
